<odoo>
    <record id="estate_property_model" model="ir.model">
        <field name="name">Real Estate Property</field>
        <field name="model">x_estate.property</field>
    </record>

    <record id="state_property_name_field" model="ir.model.fields">
        <field name="model_id" ref="importable_estate.estate_property_model"/>
        <field name="name">x_name</field>
        <field name="field_description">Property name</field>
        <field name="ttype">char</field>
        <field name="required">True</field>
    </record>

    <record id="state_property_expected_price_field" model="ir.model.fields">
        <field name="model_id" ref="importable_estate.estate_property_model"/>
        <field name="name">x_expected_price</field>
        <field name="field_description">Expected price</field>
        <field name="ttype">integer</field>
        <field name="required">True</field>
    </record>
</odoo>
