<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.Counter">
        <div class="d-flex justify-content-center align-items-center gap-2 p-3 border bg-light">
            <span class="fw-bold">Counter: <span class="badge rounded-pill bg-primary ms-1" t-esc="state.value"/>
            </span>
            <button class="btn btn-primary border" t-on-click="increment">Increment</button>
        </div>
    </t>
</templates>
