<?xml version="1.0" encoding="UTF-8" ?>
<t t-name="awesome_owl.counter">
    <div class="p-3">
        <h1 class="text-2xl font-bold mb-4">Counter App</h1>
        <p class="text-lg">Current value:
            <t t-esc="state.value"/>
        </p>
        <button class="btn bg-primary" t-on-click="increment">
            Increment
        </button>
        <span class="mx-2"/>
        <button class="btn bg-secondary" t-on-click="decrement">
            Decrement
        </button>
    </div>
</t>
