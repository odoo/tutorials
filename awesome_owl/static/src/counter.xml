<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.Counter">
        <div class="m-3">
            <t t-out="this.count()"/>
            <button t-on-click="this.increment">+</button>
            <button t-on-click="this.reset">reset</button>
        </div>
    </t>

</templates>