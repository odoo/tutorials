<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div  t-att-class="{'text-decoration-line-through': props.item.isCompleted, 'text-muted': props.item.isCompleted}">
            <span>
                <t t-esc="props.item.id" />. 
            </span>
            <span>
                <t t-esc="props.item.description" />
            </span>
        </div>
    </t>

</templates>
