<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_item">
        <div class="todo-item d-flex align-items-center mb-2" t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
            <input type="checkbox" class="form-check-input me-2" t-att-checked="props.todo.isCompleted" t-on-change="() => props.toggleState(props.todo.id)"/>
            <span class="flex-grow-1"><t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/></span>
            <span class="fa fa-remove text-danger ms-2" style="cursor: pointer;" t-on-click="() => props.removeTodo(props.todo.id)"/>
        </div>
    </t>
</templates>
