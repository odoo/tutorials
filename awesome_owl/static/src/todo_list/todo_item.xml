<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_item">
        <div>
            <input type="checkbox" t-att-id="props.id" t-att-checked="props.isCompleted" name="todo" t-on-change="toggleTodo"/>
            <label style="margin-left: 5px;" t-att-class="{'text-decoration-line-through': props.isCompleted}" t-att-for="props.id">
                <t t-esc="props.id"/>. <t t-esc="props.description"/>
            </label>
            <span class="fa fa-remove" style="margin-left: 5px;" t-on-click="removeTodo" />
        </div>
    </t>

</templates>
