<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem" owl="1">
        <div t-att-class="{'text-decoration-line-through':props.todo.isCompleted, 'text-muted': props.todo.isCompleted}">
            <input t-ref = "checkboxInput" type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="ev => this.toggleState(ev)"  />
            <t t-esc="props.todo.id"/>.
            <t t-esc="props.todo.description"/>
            <span role="button" class="fa fa-remove ms-3 text-danger" t-on-click="delete"/>
        </div>
    </t>
</templates>
