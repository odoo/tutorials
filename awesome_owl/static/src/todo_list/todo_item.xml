<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_item">
        <div class="d-flex gap-2" t-att-class="{'text-muted text-decoration-line-through' : props.todo.isCompleted}">
            <input type="checkbox" t-on-click="() => props.toggleState(props.todo.id)" />
            <div>
                <t t-esc="props.todo.id" /> : <t t-esc="props.todo.description"/>
            </div>
            <span class="fa fa-remove" t-on-click="() => props.removeTodo(props.todo.id)"/>
        </div>
    </t>
</templates>
