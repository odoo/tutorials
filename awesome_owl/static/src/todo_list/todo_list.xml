<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div>
            <input type="text" t-ref="input" t-on-keyup="addTodo" placeholder="Add a todo"/>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" toggleState.bind="toggleState" delete.bind="delete"/>
            </t>
        </div>
    </t>
</templates>
