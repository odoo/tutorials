<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <div class="m-2 p-2 border d-inline-block">
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <p>
                    <TodoItem todo="todo"/>
                </p>
            </t>
        </div>
    </t>

</templates>
