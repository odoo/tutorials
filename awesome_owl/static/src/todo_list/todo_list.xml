<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoList">
        <div class="p-3">
            <input t-ref="myInput" t-on-keyup="ev => this.addTodos(ev)" placeholder="enter new task"/>
        </div>
        <t t-foreach="todos" t-as="todo" t-key="todo.id">
            <div>
                <TodoItem toggleState.bind="toggleState" deleteTodo.bind="deleteTodo" item="todo"/>
            </div>
        </t>
    </t>

</templates>
