<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <input t-ref="todo_input" type="text" placeholder="Enter a new task" t-on-keyup="addTodo" t-model="input.value" />
        <TodoItem t-foreach="todos" t-as="t" t-key="t.id" todo="t" toggleState="toggleState" removeTodo="removeTodo" />
    </t>

</templates>
