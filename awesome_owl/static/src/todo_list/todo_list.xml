<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_list">
        <div class="todo-list bg-light p-3 mt-3 border">
            <h3>Todo List</h3>
            <div class="mb-3">
                <input
                    type="text"
                    class="form-control"
                    placeholder="Add a todo"
                    t-on-keyup="addTodo"
                />
            </div>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </t>
        </div>
    </t>
</templates>
