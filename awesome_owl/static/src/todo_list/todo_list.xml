<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoList">
        <p>Todo List:</p>
        <t t-foreach="todos" t-as="todo" t-key="todo.id">
            <p><t t-esc="todo.id"/>. <t t-esc="todo.description"/></p>
        </t>
    </t>

</templates>