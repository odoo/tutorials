<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="awesome_owl.todo_list">
    <div>
      <input t-ref="taskInput" placeholder="'Enter a new task'"  t-on-keyup="addTodo" />
      <t t-foreach="todos" t-as="todo" t-key="todo.id">
        <TodoItem todo="todo" removeTodo="removeTodo.bind(this)" toggleState="toggleState.bind(this)" />
      </t>
    </div>
  </t>
</templates>
