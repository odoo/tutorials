<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <input type="text" placeholder="Add a todo" t-on-keyup="addTodo" class="form-control mb-3"/>
        <div class="todo-list"  >
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" toggleState="toggleTodo.bind(this)" removeTodo="removeTodo.bind(this)"/>
            </t>
        </div>
    </t>
</templates>