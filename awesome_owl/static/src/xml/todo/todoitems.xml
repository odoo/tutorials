<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="awesome_owl.todoitems">
        <div class="py-1"
            t-att-class="{'text-decoration-line-through text-muted': props.todo.isComplete}">
            <input class="m-3" type="checkbox" t-att-checked="props.todo.isComplete"
                t-on-click="props.onClick" />
            <t t-out="props.todo.description" />
            <span t-on-click="props.onRemove" class="fa fa-remove" />
        </div>
    </t>

</templates>
