<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.counter">
        <div class="p-3">
            <p>Counter: <t t-out="state.value"/></p>
            <div class="d-flex gap-3">
            <button class="btn btn-primary border text-success pr-6" t-on-click="increment">Plus</button>
                <button class="btn btn-primary border text-danger" t-on-click="decrement">Minus</button>
        </div>
        </div>
    </t>

</templates>
