<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.Counter">
        <div class="p-3">
            <span>Counter: <t t-out="state.value"/></span>
            <button class="btn btn-primary ms-2" t-on-click="increment">
                Increment
            </button>
        </div>
    </t>
</templates>