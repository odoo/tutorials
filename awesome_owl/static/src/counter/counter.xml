<?xml version="1.0" encoding="UTF-8" ?>
<t t-name="awesome_owl.Counter">
    <div class="p-3">
        <h1 class="text-2xl font-bold mb-4">Counter App</h1>
        <p class="text-lg">Current value:
            <t t-out="props.value"/>
        </p>
        <button class="btn bg-primary" t-on-click="() => props.onChange(props.value + 1)">
            Increment
        </button>
        <span class="mx-2"/>
        <button class="btn bg-secondary" t-on-click="() => props.onChange(props.value > 0 ? props.value - 1 : 0)">
            Decrement
        </button>
    </div>
</t>

