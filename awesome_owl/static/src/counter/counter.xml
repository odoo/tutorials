<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.Counter">
        <div class="m-2 p-2 border ">

            <span>
                Counter: <t t-esc="state.value"/>
            </span>

            <button class="btn ms-3 bg-primary text-white " t-on-click="increment"> Increment </button>
            <button class="btn ms-3 bg-primary text-white " t-on-click="decrement"> Decrement </button>

        </div>
    </t>

</templates>