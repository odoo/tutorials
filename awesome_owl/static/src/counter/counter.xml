<templates xml:space="preserve">
    <t t-name="awesome_owl.Counter">
        <div class="border rounded p-2 mb-2 d-flex align-items-center gap-3">
            <span>Counter: <t t-esc="state.value"/></span>
            <button class="btn btn-sm btn-secondary" t-on-click="increment">Increment</button>
            <button class="btn btn-sm btn-secondary" t-on-click="decrement">Decrement</button>
            <button class="btn btn-sm btn-danger" t-on-click="reset">Reset</button>
        </div>
    </t>
</templates>
