<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.Counter">
        <div class="card d-inline-block m-2">
            <div class="card-body">
                <p class="card-text">
                    Counter: <t t-esc="state.value"/>  <button class="btn btn-primary m-1" t-on-click="increment">Increment</button>
                </p>
            </div>
        </div>
    </t>
</templates>
