<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.counter">
      <p>Counter: <t t-esc="state.value"/>
          <div>
              <button class="btn btn-primary border" t-on-click="increment">Increment</button>
              <button class="btn btn-primary border" t-on-click="decrement">Decrement</button>
          </div>
      </p>
    </t>

</templates>
