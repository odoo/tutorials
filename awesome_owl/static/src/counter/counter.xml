<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.counter">
        <div class="card d-inline-block m-2" style="width: 18rem; padding: 20px;">
            <p>
                Counter: <t t-esc="state.value"/>
                <button class="btn btn-primary px-3 mx-3" t-on-click="increment" style="background-color: purple; color: white">Increment</button>
            </p>
        </div>
    </t>

</templates>
