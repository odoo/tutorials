<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <div class="container py-4">
            <div class="card shadow-sm border-1" style="max-width: 550px;">
                <div class="card-body p-3">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Enter a new task..." t-on-input="onChangeInput" t-ref="taskInput" t-att-value="this.inputState.value" t-on-keydown="onKeydown"/>
                        <button class="btn text-bg-primary" t-on-click="addTodo">
                            Add
                        </button>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <t t-foreach="this.state.todos" t-as="todo" t-key="todo.id">
                            <TodoItem todo="todo" todoIndex="todo_index" toggleComplete.bind="toggleComplete" removeTodo.bind="removeTodo" />
                        </t>
                    </div>

                    <t t-if="!this.state.todos.length">
                        <div class="text-center text-muted py-5">
                            <i class="fa fa-clipboard-check fa-3x mb-3"/>
                            <p class="mb-0">No tasks available!</p>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
