<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo-item">
        <div t-att-class="{'text-muted text-decoration-line-through': props.todo.isCompleted}">
            <input type="checkbox" t-on-click="() => props.toggleState(props.todo.id)" t-att-checked="props.todo.isCompleted"/>
            <t t-esc="props.todo.id"/>
            <t t-esc="props.todo.description"/>
        </div>
    </t>

</templates>
