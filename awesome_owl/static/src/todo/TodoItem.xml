<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div >
            <p class="d-flex align-items-center justify-content-between py-3 shadow-sm mb-2 rounded border" t-att-class="{'text-muted': props.todo.isCompleted}"> 
                <div class="d-flex align-items-center flex-grow-1 mx-3 gap-3">
                    <input type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="change"/>
                    <div t-att-class="{'text-decoration-line-through': props.todo.isCompleted}">
                        <t t-esc='props.todo.id'/>. 
                        <t t-esc='props.todo.description'/>
                    </div>
                </div>
                <span class="fa fa-remove mx-3" style="color: red" t-on-click="remove"/>
            </p>
        </div>
    </t>

</templates>
