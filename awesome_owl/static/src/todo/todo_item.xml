<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_item">
        <div class="d-inline-block" style="padding: 5px;" t-att-class="{'text-muted': props.todo.isCompleted, 'text-decoration-line-through': props.todo.isCompleted}">
            <t t-out="props.todo.id"/>. <t t-out="props.todo.description"/>
        </div>
    </t>

</templates>
