<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div class="border p-2 mb-1 d-flex align-items-center gap-2" t-att-class="{'text-muted text-decoration-line-through': props.todo.isCompleted}">
            <div>
                <input type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="onToggle"/>
                    <span t-att-class="{ 'text-muted text-decoration-line-through': props.todo.isCompleted }">
                        <strong><t t-esc="props.todo.id"/>.</strong>
                        <t t-esc="props.todo.description"/>
                    </span>
            </div>
            <span class="fa fa-remove text-danger" style="cursor: pointer;" t-on-click="onRemove"/>
        </div>
    </t>

</templates>