<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.todo_item">
        <div class="d-flex column-gap-2" t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : '' ">
            <input class="form-check-input" type="checkbox" t-att-id="props.todo.id" t-att-checked="props.todo.isCompleted" t-on-change="onChange"/>
            <p> <t t-esc="props.todo.id"/> <t t-esc="props.todo.description" /> <span class="text-info"> <t t-esc="props.todo.isCompleted"/> </span></p> 
            <span role="button" class="fa fa-remove text-danger" t-on-click="onRemove"/>          
        </div>
    </t>
</templates>