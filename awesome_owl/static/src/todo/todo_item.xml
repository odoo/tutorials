<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''" class="p-2 border-bottom">
            <input type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="onToggle"/>
            <span><t t-esc="props.todo.id"/>.</span>
            <span><t t-esc="props.todo.description"/></span>
            <span class="fa fa-remove" t-on-click="onRemove"></span>
        </div>
    </t>
</templates>
