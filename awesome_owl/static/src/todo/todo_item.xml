<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem" owl="1">
        <div class="p-2 border-bottom" style="cursor: pointer;" t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''" t-on-click="onClick">
            <span class="badge bg-secondary me-2"><t t-esc="props.todo.id"/></span>
            <t t-esc="props.todo.description"/>
        </div>
    </t>
</templates>
