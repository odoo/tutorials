<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoListView">
        <div class="d-inline-block border p-2 m-2">
            <input class="form-control mb-3" type="text" placeholder="Add a todo" t-on-keyup="addTodo" t-ref="input"/>
            <t t-foreach="model.todos" t-as="todo" t-foreach-index="index" t-key="todo.id">
                <TodoItem todo="todo" index="index" onRemove.bind="removeTodoAt"/>
            </t>
        </div>
    </t>
</templates>
