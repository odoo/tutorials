<templates>
    <t t-name="awesome_owl.TodoList">
        <input type="text" placeholder="Enter a new task" t-on-keyup="addTodo"/>
        <div class="todo-list">
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </t>
        </div>
    </t>
</templates>
