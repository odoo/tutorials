<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <div>
            <input type="text" placeholder="Enter a new task" t-on-keyup="addTodo"/>
            <p t-foreach="state" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </p>
        </div>
    </t>

</templates>
