<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="awesome_owl.todo_list">
    <div class="p-4 border rounded shadow-sm bg-light" style="width:320px">

        <input
            type="text"
            t-ref="input"
            class="form-control mb-2"
            placeholder="Enter a new task"
            t-on-keyup="addTodo"
        />
<!-- 
       <t t-if="">
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" onDelete="deleteTodo" toggleState="toggleTodo"/>
            </t>
       </t> -->

            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <t t-if="todo.isCompleted and showCompleted.value and filtered.value == 'completed'">
                    <TodoItem todo="todo" onDelete="deleteTodo" toggleState="toggleTodo"/>
                </t>
                <t t-elif="!todo.isCompleted and filtered.value == 'active'">
                    <TodoItem todo="todo" onDelete="deleteTodo" toggleState="toggleTodo"/>
                </t>
                <t t-elif="filtered.value == 'all'">
                    <TodoItem todo="todo" onDelete="deleteTodo" toggleState="toggleTodo"/>
                </t>
            </t>

        
        <button t-on-click="() => filterMethod('all')">All</button>
        <button t-on-click="() => filterMethod('active')">Active</button>
        <button t-on-click="() => filterMethod('completed')">Completed</button>


        <h1><button class="btn btn-warning btn-sm mt-2"
                t-on-click="deleteCompletedTodos">Delete Completed Todos</button></h1>

    </div>
</t>

</templates>