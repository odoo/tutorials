<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_list">
        <div class="p-3">
            <div class="mb-2">
                <input
                    type="text"
                    class="form-control"
                    placeholder="Add a todo"
                    t-on-keyup="addTodo"
                />
            </div>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </t>
        </div>
    </t>

</templates>
