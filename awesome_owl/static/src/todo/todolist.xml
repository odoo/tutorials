<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div class="p-3">
            <input class="form-control mb-3" type="text" t-on-keyup="addTodo" placeholder='Enter task' t-ref="input"/>
            <t t-foreach="todos" t-as="i" t-key="i['id']">
                <TodoItem todo="i" />
            </t>
        </div>
    </t>
</templates>
