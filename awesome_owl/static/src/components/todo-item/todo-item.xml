<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div class="form-check mb-1">
            <input type="checkbox" class="form-check-input" t-on-change="toggleState"
                   t-attf-id="toggle-state-{{props.id}}" t-att-checked="props.isCompleted"/>
            <label class="form-check-label ms-1"
                   t-attf-for="toggle-state-{{props.id}}" t-att-class="{'text-decoration-line-through': props.isCompleted}">
                <span t-esc="props.id"></span>.
                <span t-esc="props.description"></span>
                <i class="fa ms-1"
                   t-att-class="{
                       'fa-check text-success': props.isCompleted,
                       'fa-times text-danger': !props.isCompleted,
                   }"/>
                <i class="fa fa-trash text-danger ms-1 cursor-pointer" t-on-click="removeTodo"/>
            </label>
        </div>
    </t>
</templates>