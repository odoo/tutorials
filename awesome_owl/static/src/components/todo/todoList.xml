<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <t t-name="awesome_owl.todoList">
        <div class="border border-black" style="width:150px;" >
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo"/>
            </t>
        </div>
    </t>

</odoo>
