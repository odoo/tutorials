<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div class="mb-2">
            <input class="form-control" placeholder="Enter a new todo item description :D"
                   t-on-keyup="todoOnKeyup" t-ref="todoInput"/>
        </div>

        <div t-foreach="state.todos" t-as="todo" t-key="todo.id">
            <TodoItem id="todo.id" description="todo.description" isCompleted="todo.isCompleted"
                      toggleState.bind="toggleItemState" removeTodo.bind="removeTodo"/>
        </div>
    </t>
</templates>