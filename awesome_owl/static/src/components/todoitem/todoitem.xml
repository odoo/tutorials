<!-- ✅ -->
<t t-name="awesome_owl.todoitem">


    <div class="p-3 container" t-att-class="props.todo.isCompleted ? 'text-success  text-decoration-line-through' : 'text-danger'" t-att-data-id="props.todo.id">
        <div class="row">

            <div class="col">
                <p>
                    <t t-esc="props.todo.id"/>
                </p>
            </div>
            <div class="col">
                <p>
                    <t t-esc="props.todo.title"/>
                </p>
            </div>
            <div class="col">
                <p>
                    <input type="checkbox" t-att-id="props.todo.id" t-att-checked="props.todo.isCompleted" t-on-click="handletoggleState"/>
                    <t t-esc="props.todo.isCompleted"/>
                </p>
            </div>
            <div class="col">
                <p>
                    <input type="checkbox" t-att-id="props.todo.id" t-on-click="handleDelete"/>
                    <span class="fa fa-remove"/>
                </p>
            </div>



        </div>
    </div>
</t>