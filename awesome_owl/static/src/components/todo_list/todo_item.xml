<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_item">
        <div class="d-flex gap-1 mb-1" t-att-class='{"text-muted text-decoration-line-through": props.todo.isCompleted}'>
            <span class="mr-1"><t t-esc="props.todo.id" />.</span>
            <p class="m-0"><t t-esc="props.todo.description" /></p>
        </div>
    </t>

</templates>
