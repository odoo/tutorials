<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="my_module.Todoitem">
        <div class="p-3" t-att-class="(todo.isCompleted) ? 'text-decoration-line-through text-muted' : ''">
           <input t-on-change="toggleState" type="checkbox" t-att-checked="todo.isCompleted"/> <t t-esc="todo.id"/> - <t t-esc="todo.description"/>     <span class="fa fa-remove" t-on-click="removeTodo"/>
        </div>
    </t>

</templates>
