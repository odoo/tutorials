<t t-name="awesome_owl.counter">
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0">Counter</h5>
                <span class="badge rounded-pill fs-6" t-att-class="state.value > 0 ? 'text-bg-success' : (state.value &lt; 0 ? 'text-bg-danger' : 'text-bg-secondary')">
                    <t t-esc="state.value"/>
                </span>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <button class="btn btn-outline-success btn-sm" t-on-click="handleIncrement">
                    <i class="fa fa-plus me-1"/>
 Increment
                </button>
                <button class="btn btn-outline-danger btn-sm" t-on-click="decrement">
                    <i class="fa fa-minus me-1"/>
 Decrement
                </button>
                <button class="btn btn-outline-info btn-sm" t-on-click="multiply">
                    <i class="fa fa-times me-1"/>
 Multiply
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="reset">
                    <i class="fa fa-refresh me-1"/>
 Reset
                </button>
            </div>
        </div>
    </div>
</t>