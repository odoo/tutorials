<t t-name="awesome_owl.card">
    <div class="p-3">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">


                <t t-if="props.slots.title">
                    <h5 class="card-title">
                        <t t-slot="title"/>
                    </h5>
                </t>



                <div class="card-content">
                    <p>
                        <input type="checkbox" t-on-click="toggleState"/>
                        <span class="fa fa-remove"/>
                    </p>
                </div>
                <t t-if="state.isOpen">
                    <h5 class="card-title">
                        <p> You man just close me boy </p>

                        <div class="card-text">
                            <t t-slot="default"/>
                        </div>
                    </h5>
                </t>
            </div>
        </div>
    </div>
</t>