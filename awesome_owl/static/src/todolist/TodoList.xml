<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <input t-ref="input" t-on-keyup="handleAdd" placeholder="Enter a new todo" />
        <div>
            <div t-foreach="this.todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" onToggle.bind="handleToggle" onDelete.bind="handleDelete" />
            </div>
        </div>
    </t>
</templates>
