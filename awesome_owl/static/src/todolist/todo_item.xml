<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.TodoItem">
        <div>
            <div t-att-class="props.todo.isCompleted ? 'text-muted text-decoration-line-through' : ''">
                <input type="checkbox" t-att-id="props.todo.id" t-att-checked="props.todo.isCompleted" t-on-change="onChange"/>
                <t t-esc="props.todo.id"/>.
                <t t-esc="props.todo.description"/>
                <span type="button" class="fa fa-remove" t-on-click="onRemove"/>
            </div>
        </div>
    </t>
</templates>
