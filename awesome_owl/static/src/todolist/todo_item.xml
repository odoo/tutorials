<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todo_item">
        <div class="d-flex gap-2 p-1 align-items-center" 
            t-att-style="props.todo.isCompleted ? 'text-decoration: line-through; color: #999;' : ''">
            
            <input 
                type="checkbox" 
                t-att-checked="props.todo.isCompleted"
                t-on-change="() => props.toggleState(props.todo.id)"
            />
            
            <span t-esc="props.todo.id"/>
            <span t-esc="props.todo.description"/>
            <i
                class="fa fa-times text-danger" 
                style="cursor: pointer;"
                t-on-click="() => props.deleteTodo(props.todo.id)"
                role="button"
            />
        </div>
    </t>
</templates>
