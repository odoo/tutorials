<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <t t-name="awesome_owl.todoitem">
        <div  class="form-check">
            <input  class="form-check-input" type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="toggleState"/>
            <label t-att-class="{'text-muted': props.todo.isCompleted, 'text-decoration-line-through': props.todo.isCompleted}">
                <t t-esc="props.todo.id"/>. <t t-esc="props.todo.description"/>
            </label>
            <span type='button' t-on-click="onDelete" class="fa fa-trash ms-3 text-danger"/>
        </div>
    </t>

</templates>
