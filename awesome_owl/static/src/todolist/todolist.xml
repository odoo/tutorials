<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todolist">
        <div>
            <input placeholder="Enter a new task" t-on-keyup="addTodo" t-ref="todolist_input"/>
            <t t-foreach="this.todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" removeTodo.bind="this.removeTodo"/>
            </t>
        </div>
    </t>

</templates>
