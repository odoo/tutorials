<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.Card">
        <div class="card d-inline-block m-2">
            <div class="card-body">
                <h5 class="card-title"><t t-esc="props.title"/><button class="btn btn-link" t-on-click="toggleOpen">Toggle</button></h5>
                <t t-if="state.isOpen" t-slots="props">
                    <t t-slot="default"/>
                </t>
            </div>
        </div>
    </t>
</templates>
