<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.card">
        <div class="card d-inline-block m-2" style="padding: 20px;">
            <p>
                <h5><t t-out="props.title"/></h5>
                <input type="checkbox" t-att-checked="state.open" t-on-change="toggleState"/>
                <t t-if="state.open">
                    <t t-slot="default"/>
                </t>
            </p>
        </div>
    </t>

</templates>
