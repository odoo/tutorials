<t t-name="awesome_owl.card">
    <div class="card d-inline-block m-2">
        <div class="card-body">
            <h5 class="card-title"><t t-esc="props.title"/></h5>
            <button t-on-click="closeCard">Toggle</button>
            <div class="card-text" t-if="state.open">
                <t t-slot="default"/>
            </div>
        </div>
    </div>
</t>
