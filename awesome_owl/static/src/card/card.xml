<t t-name="awesome_owl.Card">

    <div class="card d-inline-block m-2" style="width:18rem;">
        <div class="card-body">

            <h5 class="card-title">
                <t t-esc="props.title"/>
            </h5>

            <button
                class="btn btn-sm btn-secondary"
                t-on-click="toggle">
                Hide
            </button>

            <t t-if="state.isOpen">
                <div class="card-text">
                    <t t-slot="default"/>
                </div>
            </t>
            
        </div>
    </div>

</t>