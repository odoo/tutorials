<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.Card">
        <div class="card">
            <div class="card-body">

                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <button class="btn btn-sm btn-light invisible" aria-hidden="true">
                        <i class="fa fa-chevron-up"/>
                    </button>

                    <h5 class="card-title mb-0 text-center flex-grow-1"><t t-esc="props.title"/></h5>

                    <button class="btn btn-sm btn-light" t-on-click="toggle">
                        <i t-att-class="state.isOpen ? 'fa fa-chevron-up' : 'fa fa-chevron-down'"/>
                    </button>
                </div>

                <div class="card-text" t-if="state.isOpen">
                    <t t-slot="default"/>
                </div>

            </div>
        </div>
    </t>
</templates>
