<templates xml:space="preserve">
    <t t-name="awesome_owl.Card">
        <div class="card m-3 d-inline-block shadow-sm">
            <div class="card-header">
                <t t-esc="props.title"/>
                <button class="btn btn-secondary" t-on-click="toggle">
                    <t t-if="state.isOpen">Hide</t>
                    <t t-else="">Show</t>
                </button>
            </div>
            <t t-if="state.isOpen">
                <div class="card-body">
                    <t t-slot="default"/>
                </div>
            </t>
        </div>  
    </t>
</templates>
