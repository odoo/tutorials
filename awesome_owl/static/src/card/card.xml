<t t-name="awesome_owl.Card">
    <div class="card d-inline-block m-2" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title">
                <t t-esc="props.title"/>
            </h5>

            <button class="btn ms-3 bg-primary text-white" t-on-click="toggle">
                <t t-if="state.isOpen">Hide</t>
                <t t-else="">Show</t>
            </button>

           <t t-if="state.isOpen">
                <div class="card-body">
                    <t t-slot="default"/>
                </div>
            </t>
        </div>
    </div>
</t>