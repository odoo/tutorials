<templates xml:space="preserve">
    <t t-name="awesome_owl.Card">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title"><t t-out="props.title" /></h5>
                <button class="btn btn-sm btn-outline-primary" t-on-click="toggleContent">
                    <t t-if="state.isOpen">Hide</t>
                    <t t-else="">Show</t>
                </button>
                <p class="card-text" t-if="state.isOpen">
                    <t t-slot="default"/>
                </p>
            </div>
        </div>
    </t>
</templates>
