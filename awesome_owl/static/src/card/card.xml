<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.card">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">

                <t t-if="props.title">
                    <h5 class="card-title">
                        <t t-esc="props.title"/>
                        <button class="btn btn-primary" t-on-click="toggleButton">Toggle</button>
                    </h5>
                </t>

                <!-- Default slot -->
                <t t-slot="default" t-if="this.state.open"/>

            </div>
        </div>
    </t>

</templates>
