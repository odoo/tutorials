<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
<t t-name="awesome_owl.card">
<div class="card d-inline-block m-2" style="width: 18rem;">
    <div class="card-body">
        <h5 class="card-title">
            <t t-out="props.title"/>
        </h5>
        <button class="btn btn-sm btn-primary mb-2" t-on-click="toggleCard">
            <t t-out="state.isOpen ? 'Hide' : 'Show'"/>
            Content
        </button>
        <div t-if="state.isOpen">
            <t t-slot="default"/>
        </div>
    </div>
</div>

</t>
</templates>
