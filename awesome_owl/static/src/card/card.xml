<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.card">
        <div t-name="Card" class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title">
                    <t t-out="props.title"/>
                    <button class="btn" t-on-click="toggle">Toggle</button>
                </h5>
            </div>
            <p class="card-text" t-if="state.isOpen == true">
                <t t-slot="default"/>
            </p>
        </div>
    </t>

</templates>
