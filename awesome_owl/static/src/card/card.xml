<t t-name="awesome_owl.Card">
    <div class="card">
        <div class="card-header">
            <h3><t t-out="props.title"/></h3>
            <button t-on-click="toggleContent">
                <t t-if="state.showContent">Hide</t>
                <t t-else="">Show</t>
            </button>
        </div>
        <div class="card-content" t-if="state.showContent">
            <!-- Slot allows any content: string, HTML, or other components -->
            <t t-slot="default"/>
        </div>
    </div>
</t>