<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
         <div class="o_counter_container" style="display: flex; flex-direction: column; align-items: center;">
             <div style="display: flex; gap: 10px;">
                <Counter onChange="incrementSum"/>
                <Counter onChange="incrementSum"/>
            </div>
            <p>Sum: <t t-esc="state.sum"/></p>
        </div>
        <div class="o_counter_container" style="display: flex; flex-wrap: wrap;">
             <t t-foreach="cards" t-as="card" t-key="card.title">
                <Card title="card.title" content="card.content"/>
            </t>
        </div>
    </t>
</templates>
