<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="p-3">
            hello world
        </div>
        <Counter/>
        <ProductCard name="this.headphone.name" price="this.headphone.price"/>
        <input t-model="this.name" placeholder="Name"/>
        <input t-model="this.email" placeholder="Email"/>
        <t t-out="this.greeting()"/>
        <t t-if="this.isValid()"><span>Valid</span></t>
        <t t-else=""><span>Invalid</span></t>
    </t>

</templates>