<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="counters">
            <div style="display: flex;">
                <Counter onChange.bind="incrementSum"/>
                <Counter onChange.bind="incrementSum"/>
            </div>
            <div class="sum">
                Sum: <t t-esc="state.sum"/>
            </div>
        </div>

        <p>
            <Card title="'card 1'">
                <t t-out="this.html"/>
            </Card>
            <Card title="'card 2'">
                content of card 2
            </Card>
            <Card title="'card 3'">
                <Counter/>
            </Card>
        </p>

        <TodoList/>
    </t>

</templates>
