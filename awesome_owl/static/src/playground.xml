<?xml version="1.0" encoding="UTF-8"?>

<templates>
    <t t-name="awesome_owl.playground">
        <div class="h-100 overflow-auto bg-view">
            <div class="p-3">hello world</div>
            <h1 class="text-center"> sum: <t t-out="this.sum.value" />
            </h1>
            <div
                class="d-flex border-2 border-black gap-4 justify-content-center align-items-center p-2"
                style="border: 2px solid black"
            >
                <Counter onChange.bind="increaseCount" />
                <Counter onChange.bind="increaseCount" />
            </div>
            <Card
                title="'Card 1'" content="this.html"
            />
            <Card
                title="'Card 2'" content="'Content of card 2'"
            />
            <div>
                <TodoList todos="this.todos" />
            </div>
        </div>
    </t>
</templates>
