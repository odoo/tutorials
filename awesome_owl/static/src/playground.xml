<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="card m-3">
            <div class="card-header fw-bold">
                Counter
            </div>
            <div class="card-body">
                <Counter onchange.bind="incrementSum"/>
                <Counter onchange.bind="incrementSum"/>
                <div class="mt-3">
                    <b class="d-flex justify-content-center fs-3">
                        <i>
                            The sum of two counters is:
                            <t t-out="this.sum.value"/>
                        </i>
                    </b>
                </div>
            </div>
        </div>
        <div class="card m-3">
            <div class="card-header fw-bold">
                Card
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-center gap-3">
                    <Card title="'Card - 1'">
                        <t t-set-slot="content">
                            <p style="color:red;"><t t-out="this.state.content1"/></p>
                        </t>
                    </Card>
                    <Card title="'Card - 2'">
                        <t t-set-slot="content">
                            <p style="color:magenta;"><t t-out="this.state.content2"/></p>
                        </t>
                    </Card>
                    <Card title="'Card - 3'">
                        <t t-set-slot="content">
                            <p style="color:violet;"><t t-out="this.state.content3"/></p>
                        </t>
                    </Card>
                </div>
            </div>
        </div>
        <div class="card m-3">
            <div class="card-header fw-bold">
                TodoList <br/>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-center gap-3">
                    <TodoList/>
                </div>
            </div>
        </div>
    </t>
</templates>
