<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="p-3">
            <h2>Owl Components Demo</h2>

            <div class="mb-3">
                <p><strong>Independent Counters:</strong></p>
                <Counter onChange.bind="updateCount1"/>
                <Counter onChange.bind="updateCount2"/>
                <p>Total: <t t-esc="state.count1 + state.count2"/></p>
            </div>

            <div class="d-flex flex-wrap">
                <Card title="'Card 1: Counter'">
                    <Counter onChange.bind="updateCount1"/>
                </Card>

                <Card title="'Card 2: Simple Text'">
                    <p>Hey There! This is plain text content.</p>
                </Card>

                <Card title="'Card 3: Mixed Content'">
                    <p>A card with multiple elements:</p>
                    <Counter onChange.bind="updateCount2"/>
                </Card>
            </div>
            <div class="mt-3">
                <h3>Todo Application</h3>
                <TodoList/>
            </div>
        </div>
    </t>

</templates>