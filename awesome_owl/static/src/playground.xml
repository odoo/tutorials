<t t-name="awesome_owl.Playground">
    <div class="p-3">

        <!-- Card with normal content -->
        <Card title="'Simple Card'">
            <p>Just a basic text card.</p>
        </Card>

        <!-- Card containing a Counter component -->
        <Card title="'Counter Card'">
            <Counter/>
        </Card>

        <!-- Card with multiple components -->
        <Card title="'Multiple Items'">
            <Counter/>
            <p>Some extra text because, I can.</p>
        </Card>

        <!-- Card with a Todo List -->
        <Card title="'Todo List Card'">
            <TodoList/>
        </Card>

    </div>
</t>