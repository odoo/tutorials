<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="playground-container">
            <t t-foreach="state.cards" t-as="card" t-key="card.id">
                <Card title="card.title" folded="card.folded" toggleFold="() => this.toggleFold(card.id)">
                    <Counter t-if="!card.folded" count="card.count" onChange="() => this.increment(card)"/>
                </Card>
            </t>
            <div class="d-flex justify-content-between align-items-center bg-light rounded p-2 mt-2 border">
                <span class="text-uppercase small fw-bold text-muted">Total Score</span>
                <span class="badge rounded-pill">
                    <t t-esc="totalCount"/>
                </span>
            </div>
        </div>
    </t>

</templates>
