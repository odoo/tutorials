<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.Playground">
        <Card title="'Asrij'" content="'Sriramoju'"/>
        this.html = "<div>some content</div>""
        <Card title="'HTML Card'" content="'htmlContent'"/>
        <Counter onChange.bind="incrementSum"/>
        <h3> Total: <t t-esc="state.sum"/></h3>

        <ul>
            <t t-foreach="state.tasks" t-as="task" t-key="task.id">
                <li>
                    <t t-esc="task.name"/>
                </li>
            </t>
        </ul>

        <button t-on-click="addTask">
            Add Task
        </button>
    </t>

</templates>
