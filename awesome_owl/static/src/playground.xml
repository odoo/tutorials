<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="p-3">
            <h1>
                Total Sum:
                <t t-esc="state.sum" />
            </h1>
            <hr />
            <div class="container">
                <Card title="'Card 1'">
                    <Counter onChange.bind="incrementSum" />
                </Card>
            </div>
            <div class="container">
                <Card title="'Card 2'">
                    <Counter onChange="() => this.incrementSum()" />
                </Card>
            </div>
            <div>
                <TodoList />
            </div>
        </div>
    </t>
</templates>