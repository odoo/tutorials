<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <t t-out="this.state.content"/>
        <div style="display:flex; align-items:center; gap:12px;">
            <Counter onChange.bind="calculateSum"/>
            <Counter onChange.bind="calculateSum"/>
            <Counter onChange.bind="calculateSum"/>
        </div>
        <div style="display:flex; align-items:center; gap:12px; margin-top:10px;">
            <p style="font-weight:bold; margin:0;">Sum: <t t-esc="state.sum"/></p>
            <button 
                t-if="state.sum != 0"
                t-on-click="reset"
                style="background:#6a5acd; cursor: pointer; color:white; border:none; padding:8px 18px; border-radius:8px;">
                Reset Sum
            </button>
        </div>
        <TodoList/>
         <div style="display:flex; align-items:center; gap:12px; margin-top:10px;">
            <Card title="'Hello'">
                <t t-slot="default">
                    <Counter onChange.bind="calculateSum"/>
                </t>
            </Card>
            <Card title="'Hello'">
                <t t-slot="default">
                    <p class="card-text"
                    style="background-color: #69db7c;
                            color: black;
                            padding: 10px;
                            margin: 0px;
                            border-radius: 12px;
                            font-size: 1rem;">
                            Hello World
                    </p>
                </t>
            </Card>
        </div>
    </t>
</templates>
