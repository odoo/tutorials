<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <nav class="navbar bg-body-tertiary">
            <div class="container">
                <a class="navbar-brand" href="#">
                    Odoo
                </a>
            </div>
        </nav>
        <div class="container">
            <div class="row mt-2">
                <div class="col">
                    <Card>
                        <t t-set-slot="title">Counter 1</t>
                        <Counter onChange="incrementSum" /></Card>
                </div>
                <div class="col">
                    <Card>
                        <t t-set-slot="title">Counter 2</t>
                        <Counter onChange="incrementSum" />

                    </Card>
                </div>
                <div class="col">
                    <Card>
                        <t t-set-slot="title">Sum</t>
                        <p>The sum is <span t-out="this.state.sum"/></p>
                    </Card>
                </div>
            </div>
            <div class="mt-2">
                <TodoList />
            </div>
        </div>
    </t>
</templates>
