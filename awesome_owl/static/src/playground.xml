<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">
        <div class="d-flex justify-content-center">
            <div class="d-flex flex-column gap-4 p-4 w-100" style="max-width: 1100px;">

                <div class="d-flex justify-content-center gap-4">
                    <Counter onChange.bind="incrementSum"/>
                    <Counter onChange.bind="incrementSum"/>
                </div>

                <div class="fw-bold text-center">
                    Sum: <t t-esc="state.sum"/>
                </div>

                <div class="d-flex justify-content-center gap-4">
                    <!-- <Card title="'First Card'" content="value1"/>
                    <Card title="'Second Card'" content="'content2'"/>
                    <Card title="'Third Card'" content="'content3'"/> -->
                    <Card title="'Card with Counter'">
                        <Counter onChange.bind="incrementSum"/>
                    </Card>
                </div>

                <h2 class="text-center">Todo List</h2>
                <div class="d-flex justify-content-center">
                    <TodoList/>
                </div>

            </div>
        </div>
    </t>

</templates>
