<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.playground">

        <div class="container py-4">

            <h1 class="text-center fw-bold mb-5">
                Chapter 1: Owl Components
            </h1>

            <!-- COUNTERS -->
            <section class="mb-5">
                <h2>1. Counters</h2>
                <hr/>
                <div class="mb-3">
                    <Counter onChange.bind="incrementSum"/>
                    <Counter onChange.bind="incrementSum"/>
                    <Counter onChange.bind="incrementSum"/>
                </div>
                <p>
                    <strong>Sum:</strong>
                    <t t-esc="state.sum"/>
                </p>
            </section>

            <!-- CARDS -->
            <section class="mb-5">
                <h2>2. Cards</h2>
                <hr/>

                <div>
                    <Card title="'My first card'">
                        This is my first card.
                    </Card>

                    <Card title="'Counter Card'">
                        <Counter/>
                    </Card>
                </div>
            </section>

            <!-- TODO LIST -->
            <section class="mb-5">
                <h2>3. Todo List</h2>
                <hr/>
                <TodoList/>
            </section>

        </div>

    </t>

</templates>
