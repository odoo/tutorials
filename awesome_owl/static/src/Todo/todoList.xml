<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_owl.todoList">
        <div class="card d-inline-flex">
            <div class="p-2 d-inline-flex align-items-center gap-3 justify-content-center m-1">
                <span>ToDO List</span>
            </div>
            <div class="d-flex flex-column align-items-start">
                <input class="form-control mb-2" style="width: 18rem;" type="text" placeholder="Enter a new task" t-on-keyup="addTodo" t-ref="input" />
                <t t-foreach="todos" t-as="i" t-key="i.id">
                    <TodoItem todo="i" toggleState.bind="toggleTodo" removeTodo.bind="removeTodo"/>
                </t>
            </div>
        </div>
    </t>

</templates>
