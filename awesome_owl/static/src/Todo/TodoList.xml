<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoList">
        <div class="todo-list">
            <input type="Text" t-ref="todoInput" placeholder="Enter a new task" class="form-control mb-2" t-on-keyup="onKeyup"/>
            <t t-foreach="todos" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" onToggle.bind="toggleTodo" removeTodo.bind="removeTodo"/>
            </t>
        </div>
    </t>
</templates>
