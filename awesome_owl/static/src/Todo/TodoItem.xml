<?xml version="1.0" encoding="UTF-8"?>
<template xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div class="todo-item">
            <div t-att-class="{'text-muted text-decoration-line-through': props.todo.isCompleted}">
                <input type="checkbox" class="m-3" t-on-change="toggleCompleted"/>
                <strong t-esc="props.todo.id"/>
                <t t-esc="props.todo.description"/>
                <span class="fa fa-remove text-danger cursor-pointer ms-2" t-on-click="remove"/>
            </div>
        </div>
    </t>
</template>
