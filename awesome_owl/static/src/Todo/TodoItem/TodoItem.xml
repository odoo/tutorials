<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_owl.TodoItem">
        <div class="fw-bold" t-att-class="{'text-muted text-decoration-line-through': props.todo.isCompleted}">
            <input type="checkbox" t-att-checked="props.todo.isCompleted" t-on-change="onChange"/>
            <span>
                <t t-esc="props.todo.id"/>
            </span>
            .
            <span>
                <t t-esc="props.todo.description"/>
            </span>
            <span class="fa fa-remove text-danger" t-on-click="deleteTodo"/>
        </div>
    </t>
</templates>
