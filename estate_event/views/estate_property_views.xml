<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="estate_property_form_event_button" model="ir.ui.view">
        <field name="name">estate.property.form.event.button</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_open_event" type="object" class="oe_stat_button" icon="fa-calendar">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Event</span>
                    </div>
                </button>

                <button name="action_open_contract" type="object" class="oe_stat_button" icon="fa-file" invisible="state != 'offer_accepted'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Contract</span>
                    </div>
                </button>

            </xpath>

        </field>
    </record>
</odoo>