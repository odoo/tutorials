<odoo>
  <data>

    <record id="action_dashboard" model="ir.actions.client">
      <field name="name">Dashboard</field>
      <field name="tag">awesome_dashboard.dashboard_action</field>
    </record>

    <record id="action_about" model="ir.actions.client">
      <field name="name">about page</field>
      <field name="tag">awesome_dashboard.dashboard_about</field>
    </record>

    <menuitem
      name="Awesome Dashboard"
      id="awesome_dashboard.menu_root"
      groups="base.group_user"
      web_icon="awesome_dashboard,static/description/icon.png"
    />

    <menuitem
      name="Dashboard"
      id="awesome_dashboard.menu_dashboard"
      parent="awesome_dashboard.menu_root"
      action="awesome_dashboard.action_dashboard"
      sequence="1"
    />

    <menuitem
      name="About"
      id="awesome_dashboard.menu_about"
      parent="awesome_dashboard.menu_root"
      action="awesome_dashboard.action_about"
      sequence="2"
    />

  </data>
</odoo>