<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-always-buttons">
                <button type="button" class="btn btn-primary" t-on-click="actionCustomers">Customers</button>
                <button type="button" class="btn btn-primary" t-on-click="actionLeads">Leads</button>
            </t>
            <t t-set-slot="default">
                <DashboardItem title="'Number of new orders this month'">
                    <h1 class="stat_number" t-esc="state.statistics.nb_new_orders"/>
                </DashboardItem>
                <DashboardItem title="'Total amount of new orders this month'">
                    <h1 class="stat_number" t-esc="state.statistics.total_amount"/>
                </DashboardItem>
                <DashboardItem title="'Average amount of t-shirt by order this month'">
                    <h1 class="stat_number" t-esc="state.statistics.average_quantity"/>
                </DashboardItem>
                <DashboardItem title="'Number of cancelled orders this month'">
                    <h1 class="stat_number" t-esc="state.statistics.nb_cancelled_orders"/>
                </DashboardItem>
                <DashboardItem title="'Average time for an order to go from \'new\' to \'sent\' or \'cancelled\''">
                    <h1 class="stat_number" t-esc="state.statistics.average_time"/>
                </DashboardItem>
                <DashboardItem size="2" title="'Ordered T-shirts by size'">
                    <PieChart labels="Object.keys(state.statistics.orders_by_size)" data="Object.values(state.statistics.orders_by_size)"/>
                </DashboardItem>
            </t>
        </Layout>
    </t>

</templates>
