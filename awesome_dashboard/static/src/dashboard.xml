<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="display">
            <t t-set-slot="control-panel-always-buttons">
                <button class="btn btn-primary me-2" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary" t-on-click="openLeads">
                    Leads
                </button>
            </t>
            <div class="d-flex flex-wrap p-3 align-items-start">
                <DashboardItem>
                    <div class="card-body">
                        <h5 class="card-title">Item 1</h5>
                        <p class="card-text">This item uses default size 1 (18rem width).</p>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="card-body">
                        <h5 class="card-title">Item 2</h5>
                        <p class="card-text">This item uses size 2 (36rem width).</p>
                    </div>
                </DashboardItem>
                <hr/>
                <DashboardItem size="2">
                    <div class="card-body text-center">
                        <div class="text-muted fw-bold mb-2">
                            Average amount of t-shirt by order this month
                        </div>
                        <div class="display-4 text-success font-weight-bold" t-out="stats.average_quantity"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="card-body text-center">
                        <div class="text-muted fw-bold mb-2">Average time for an order to go from 'new' to 'sent' or 'cancelled'</div>
                        <div class="display-4 text-success font-weight-bold" t-out="stats.average_time"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="1">
                    <div class="card-body text-center">
                        <div class="text-muted fw-bold mb-2">Number of new orders this month</div>
                        <div class="display-4 text-success font-weight-bold" t-out="stats.nb_new_orders"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="1.5">
                    <div class="card-body text-center">
                        <div class="text-muted fw-bold mb-2">Number of cancelled orders this month</div>
                        <div class="display-4 text-success font-weight-bold" t-out="stats.nb_cancelled_orders"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="card-body text-center">
                        <div class="text-muted fw-bold mb-2">Total amount of new orders this month</div>
                        <div class="display-4 text-success font-weight-bold" t-out="stats.total_amount"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="card-body">
                        <PieChart label="'Shirt orders by size'" data="stats.orders_by_size"/>
                    </div>
                </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
