<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.Dashboard">

        <Layout display="{ controlPanel: {} }">

            <!-- Control panel buttons -->
            <t t-set-slot="control-panel-create-button">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="openCustomers">
                    Customers
                    </button>
                    <button class="btn btn-secondary" t-on-click="openLeads">
                    Leads
                    </button>
                </div>
            </t>
            
                <!-- Dashboard content -->
                <div class="o_dashboard">
                    <div class="container py-4">
                        <div class="d-flex flex-wrap gap-3" t-if="statistics.isReady">

                            <DashboardItem>
                                <p class="o_stat_label">
                            Average amount of t-shirts by order this month
                                </p>
                                <h3 class="o_stat_value" t-esc="statistics.average_quantity"/>
                            </DashboardItem>

                            <DashboardItem size="2">
                                <p class="o_stat_label">
                            Average time for an order to go from ‘new’ to ‘sent’ or ‘cancelled’
                                </p>
                                <h3 class="o_stat_value">
                                    <t t-esc="statistics.average_time"/>
 days
                                </h3>
                            </DashboardItem>

                            <DashboardItem>
                                <p class="o_stat_label">
                            Number of new orders this month
                                </p>
                                <h3 class="o_stat_value" t-esc="statistics.nb_new_orders"/>
                            </DashboardItem>

                            <DashboardItem>
                                <p class="o_stat_label">
                            Total amount of new orders this month
                                </p>
                                <h3 class="o_stat_value">
                                    <t t-esc="statistics.total_amount"/>
                                </h3>
                            </DashboardItem>

                            <DashboardItem>
                                <p class="o_stat_label">
                            Cancelled orders this month
                                </p>
                                <h3 class="o_stat_value" t-esc="statistics.nb_cancelled_orders"/>
                            </DashboardItem>

                            <DashboardItem size="2">
                                <PieChart data="statistics.orders_by_size" />
                            </DashboardItem>
                        </div>
                    </div>
                </div>
        </Layout>
    </t>
</templates>
