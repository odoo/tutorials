<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboardView">
        <Layout
            display="{controlPanel: {}}"
            className="'o_dashboard h-100'"
        >
            <t className = "'m-1'">
                <button class="btn btn-primary m-1" t-on-click="openCustomers">
                    Customers
                </button>

                <button class="btn btn-primary m-1" t-on-click="openLead">
                    Leads
                </button>
            </t>

            <div class="d-flex p-3">
                <DashboardItem>
                    <h3>Number of new orders this month</h3>
                    <h2 t-out="this.state.data.average_quantity" ></h2>
                </DashboardItem>
                <DashboardItem>
                    <h3>Total amount of new orders this month</h3>
                    <h2 t-out="this.state.data.nb_new_orders" ></h2>
                </DashboardItem>
                <DashboardItem>
                    <h3>Average amount of t-shirt by order this month</h3>
                    <h2 t-out="this.state.data.average_quantity">85</h2>
                </DashboardItem>
            </div>
            <div class="w-50 h-50" >
                <PieChart 
                labels="this.state.data.qty_by_size.labels"
                values="this.state.data.qty_by_size.values"/>
            </div>
        </Layout>
    </t>

</templates>