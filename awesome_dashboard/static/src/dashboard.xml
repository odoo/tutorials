<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
            </t>
            <div class="d-flex align-items-start flex-wrap">
                <DashboardItem title="'New Orders This Month'">
                    <t t-esc="state.statistics.nb_new_orders"/>
                </DashboardItem>
                <DashboardItem title="'Total Amount This Month'">
                    <t t-esc="state.statistics.total_amount"/>
                </DashboardItem>
                <DashboardItem title="'Average T-Shirts per Order'">
                    <t t-esc="state.statistics.average_quantity"/>
                </DashboardItem>
                <DashboardItem title="'Cancelled Orders'">
                    <t t-esc="state.statistics.nb_cancelled_orders"/>
                </DashboardItem>
                <DashboardItem title="'Average Order Processing Time'">
                    <t t-esc="state.statistics.average_time"/>
                </DashboardItem>
                <DashboardItem title="'Shirt orders by size'" size="2"> 
                    <PieChart data="state.statistics.orders_by_size" label="'Shirt orders by size'"/>
                </DashboardItem>
            </div>
        </Layout>
    </t>
</templates>
