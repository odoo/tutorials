<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-always-buttons">
                <button type="button" class="btn btn-primary" t-on-click="actionCustomers">Customers</button>
                <button type="button" class="btn btn-primary" t-on-click="actionLeads">Leads</button>
            </t>
            <t t-set-slot="default">
                <DashboardItem>Number of new orders this month <h1 style="color:green; font-weight: bold;" t-esc="state.statistics.nb_new_orders"/></DashboardItem>
                <DashboardItem>Total amount of new orders this month <h1 style="color:green; font-weight: bold;" t-esc="state.statistics.total_amount"/></DashboardItem>
                <DashboardItem>Average amount of t-shirt by order this month <h1 style="color:green; font-weight: bold;" t-esc="state.statistics.average_quantity"/></DashboardItem>
                <DashboardItem>Number of cancelled orders this month <h1 style="color:green; font-weight: bold;" t-esc="state.statistics.nb_cancelled_orders"/></DashboardItem>
                <DashboardItem>Average time for an order to go from 'new' to 'sent' or 'cancelled' <h1 style="color:green; font-weight: bold;" t-esc="state.statistics.average_time"/></DashboardItem>
                <PieChart labels="Object.keys(state.statistics.orders_by_size)" data="Object.values(state.statistics.orders_by_size)"/>
            </t>
        </Layout>
    </t>

</templates>
