<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboardWrapper">
        <Layout t-props="layoutProps">
            <AwesomeDashboard/>
        </Layout>
    </t>

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <div class="d-flex gap-3 p-3">
            <button type="button" class="btn btn-primary" t-on-click="openCustomers">
                Customers
            </button>
            <button type="button" class="btn btn-secondary" t-on-click="openLeads">
                Leads
            </button>
        </div>
    </t>
</templates>