<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomerView">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
            </t>
            <div class="d-flex flex-column">
                <div>
                    <DashboardItem>some content</DashboardItem>
                    <DashboardItem size="2">I love milk</DashboardItem>
                </div>

                <div>
                    <DashboardItem size="2">
                        <div class="text-muted">
                            Average amount of t-shirt by order this month
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <t t-esc="this.stats.average_quantity"/>
                        </div>
                    </DashboardItem>
                    <DashboardItem size="2">
                        <div class="text-muted">
                            Average time for an order to go from 'new' to 'sent' or 'cancelled'
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <t t-esc="this.stats.average_time"/>
                        </div>
                    </DashboardItem>
                    <DashboardItem>
                        <div class="text-muted">
                            Number of new orders this month
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <t t-esc="this.stats.nb_new_orders"/>
                        </div>
                    </DashboardItem>
                </div>

                <div>
                    <DashboardItem>
                        <div class="text-muted">
                            Number of cancelled orders this month
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <t t-esc="this.stats.nb_cancelled_orders"/>
                        </div>
                    </DashboardItem>
                    <DashboardItem>
                        <div class="text-muted">
                            Total amount of new orders this month
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <t t-esc="this.stats.total_amount"/>
                        </div>
                    </DashboardItem>
                    <DashboardItem size="2">
                        <div class="text-muted">
                            Short order by size
                        </div>
                        <div class="fw-bold text-success display-4 mt-2">
                            <PieChart orders_by_size="this.stats.orders_by_size">
                            </PieChart>
                        </div>
                    </DashboardItem>
                </div>
            </div>
        </Layout>
    </t>

</templates>
