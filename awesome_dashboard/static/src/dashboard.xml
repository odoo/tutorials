<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-create-button">
                <button
                  t-on-click="open_customers_view"
                  type="button"
                  class="btn btn-primary"
                  title="Customers"
                >
                    Customers
                </button>
                <button
                  t-on-click="open_leads_view"
                  type="button"
                  class="btn btn-primary"
                  title="Leads"
                >
                    Leads
                </button>
            </t>
            <DashboardItem size="2">
                <p>Average amount of t-shirt by order this month</p>
                <p t-esc="stats.average_quantity || 'Loading'" class="text-center text-success display-6" />
            </DashboardItem>
            <DashboardItem size="2">
                <p>Average time for an order to go from 'new' to 'sent' or 'cancelled'</p>
                <p t-esc="stats.average_time || 'Loading'" class="text-center text-success display-6" />
            </DashboardItem>
            <DashboardItem>
                <p>Number of new orders this month</p>
                <p t-esc="stats.nb_new_orders || 'Loading'" class="text-center text-success display-6" />
            </DashboardItem>
            <DashboardItem>
                <p>Number of cancelled orders this month</p>
                <p t-esc="stats.nb_cancelled_orders || 'Loading'" class="text-center text-success display-6" />
            </DashboardItem>
            <DashboardItem>
                <p>Total amount of new orders this month</p>
                <p t-esc="stats.total_amount || 'Loading'" class="text-center text-success display-6" />
            </DashboardItem>
            <DashboardItem size="2">
                <PieChart label="'Shirt orders by size'" data="stats.orders_by_size" />
            </DashboardItem>
        </Layout>
    </t>

</templates>
