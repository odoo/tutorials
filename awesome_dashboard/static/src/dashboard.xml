<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout
            className="'o_dashboard h-100'"
            display="{controlPanel: {}}"
        >
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary" t-on-click="openLeads">
                    Leads
                </button>
            </t>
            <div>
              <DashboardItem>
                  Average amount of t-shirt by order this month
                  <t t-set-slot="value" t-esc="statistics.average_quantity"/>
              </DashboardItem>
              <DashboardItem size="2">
                  Average time for an order to go from 'new' to 'sent' or 'cancelled'
                  <t t-set-slot="value" t-esc="statistics.average_time"/>
              </DashboardItem>
              <DashboardItem>
                  Number of new orders this month
                  <t t-set-slot="value" t-esc="statistics.nb_new_orders"/>
              </DashboardItem>
            </div>
            <div>
              <DashboardItem>
                  Number of cancelled orders this month
                  <t t-set-slot="value" t-esc="statistics.nb_cancelled_orders"/>
              </DashboardItem>
              <DashboardItem>
                  Total amount of new orders this month
                  <t t-set-slot="value" t-esc="statistics.total_amount"/>
              </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
