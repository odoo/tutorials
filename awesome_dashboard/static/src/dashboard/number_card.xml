<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.NumberCard">
        <div class="p-3">
            <div class="text-muted small text-uppercase mb-1" t-esc="props.title"/>
            <div class="fs-2 fw-bold" t-att-class="props.color" t-esc="props.value"/>
            <div t-if="props.note" class="text-muted small" t-esc="props.note"/>
        </div>
    </t>

</templates>
