<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.gearmenu">
        <Dialog title="'Customize Dashboard'" size="'md'">
            <div class="p-3">
                <p class="text-muted mb-3">Which cards do you want to see?</p>
                <div>
                    <t t-foreach="props.items" t-as="item" t-key="item.id">
                        <label>
                            <input type="checkbox" 
                                   class="form-check-input"
                                   t-att-checked="!this.state.disabledIds.includes(item.id)"
                                   t-on-change="() => this.toggleItem(item.id)"/>
                            <span t-esc="item.description"/>
                        </label>
                    </t>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onApply">Apply</button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
