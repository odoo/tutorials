<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.Awesomedashboard">
        <Layout className="'o_dashboard h-100'" display="{ controlPanel: {} }">
            <t t-set-slot="control-panel-create-button">
                <div class="btn-group">
                    <button class="btn btn-primary" t-on-click="openCustomers">
                        Customers
                    </button>
                    <button class="btn btn-primary" t-on-click="openLeads">
                        Leads
                    </button>
                </div>
            </t>
            <div class="d-flex flex-wrap gap-3 p-3">
                <DashboardItem>
                    <div class="fw-bold">
                        Average amount of t-shirt by order this month
                    </div>
                    <div class="display-4 text-success">
                        <t t-esc="stats.avg_tshirt"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <div class="fw-bold">
                        Average time for an order to go from
                        'new' to 'sent' or 'cancelled'
                    </div>
                    <div class="display-4 text-success">
                        <t t-esc="stats.avg_processing_time"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="fw-bold">
                        Number of new orders this month
                    </div>
                    <div class="display-4 text-success">
                        <t t-if="stats.loading">Loading…</t>
                        <t t-else="">
                            <t t-esc="stats.data.new_orders"/>
                        </t>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="fw-bold">
                        Number of cancelled orders this month
                    </div>
                    <div class="display-4 text-success">
                        <t t-esc="stats.cancelled_orders"/>
                    </div>
                </DashboardItem>
                <DashboardItem>
                    <div class="fw-bold">
                        Total amount of new orders this month
                    </div>
                    <div class="display-4 text-success">
                        <t t-esc="stats.total_amount"/>
                    </div>
                </DashboardItem>
                <DashboardItem size="2">
                    <h5>Shirt orders by size</h5>
                    <PieChart data="stats.data.sales_by_category || {}"/>
                </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
