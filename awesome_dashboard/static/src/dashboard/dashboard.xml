<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: { 'top-left': true, 'bottom-left': true } }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary" t-on-click="openLeads">
                    Leads
                </button>
            </t>
            <t t-set-slot="control-panel-status-indicator">
                <button class="btn btn-light" title="Configuration" t-on-click="openFilterDialog">
                    <i class="fa fa-cog"/>
                </button>
            </t>
            <div class="p-3">
                <h1>Awesome Dashboard</h1>
                <div class="d-flex flex-wrap">
                    <t t-foreach="items" t-as="item" t-key="item.id">
                        <DashboardItem t-if="!state.disabledItems.includes(item.id)" size="item.size || 1">
                            <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                            <t t-component="item.Component" t-props="itemProp"/>
                        </DashboardItem>
                    </t>
                </div>
            </div>
        </Layout>
    </t>
</templates>