<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{controlPanel: {}}" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button t-on-click="handleCustomers" class="btn btn-primary">Customers</button>
                <button t-on-click="handleLeads" class="btn btn-primary">Leads</button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="openSettings" class="">
                    <i class="fa fa-cog"></i>
                </button>
            </t>
            <div class="d-flex flex-wrap" t-if="stats.isReady">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1" t-if="!disabled.includes(item.id)">
                        <t t-set="itemProp" t-value="item.props ? item.props(stats) : {'data': stats}"/>
                        <t t-component="item.Component" t-props="itemProp" />
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>
