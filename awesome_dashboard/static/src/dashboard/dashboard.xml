<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <div class="o_control_panel_main_buttons d-flex gap-1 d-empty-none d-print-none">
            <button type="button" class="btn btn-primary" t-on-click.stop="openCustomers">
                Customers
            </button>
            <button type="button" class="btn btn-primary" t-on-click.stop="openLeads">
                Leads
            </button>
        </div>

        <Layout 
            className="'o_dashboard h-100'"
            display="{controlPanel: {}}"
        >
            <div class="d-flex flex-wrap">
                <DashboardItem size="2">Number of new orders this month: <t t-esc="stats.nb_new_orders"/></DashboardItem>
                <DashboardItem size="2">Total orders: <t t-esc="stats.total_amount"/></DashboardItem>
                <DashboardItem size="2">Average amount of t-shirt by order: <t t-esc="stats.average_quantity"/></DashboardItem>
                <DashboardItem size="2">Average time order goes from NEW to SENT/CANCELLED: <t t-esc="stats.average_time"/></DashboardItem>                
                <DashboardItem size="6">Shirt orders by size: <PieChart stats="stats.orders_by_size"/></DashboardItem>                
            </div>
        </Layout>
    </t>

</templates>
