<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'">
            <div class="o_dashboard_content d-flex align-items-center">
                <div class="o_dashboard_buttons">
                    <button t-on-click="openCustomers" type="button" class="btn btn-primary mr-2">
                        Customers
                    </button>

                    <button t-on-click="openLeads" type="button" class="btn btn-secondary">
                        Leads
                    </button>
                </div>

                <h3 style="margin-left: 20px;">Dashboard</h3>
            </div>
            <DashboardItem size="2">
                <h4>Average amount</h4>
                <p t-esc="statistics.average_quantity"/>
            </DashboardItem>
            <DashboardItem size="2">
            <h4>Average Time</h4>
                <p t-esc="statistics.average_time"/>
            </DashboardItem>
            <DashboardItem size="2">
                <h4>Number of new orders</h4>
                <p t-esc="statistics.nb_new_orders"/>
            </DashboardItem>
            <DashboardItem size="2">
                <h4>Number of cancelled orders</h4>
                <p t-esc="statistics.nb_cancelled_orders"/>
            </DashboardItem>
            <DashboardItem size="2">
                <h4>Total amount</h4>
                <p t-esc="statistics.total_amount"/>
            </DashboardItem>
            <DashboardItem size="2">
                <t t-if="statistics.isReady">
                    <PieChart title="'Shirts orders by size'" data="statistics.orders_by_size"/>
                </t>
            </DashboardItem>

        </Layout>
    </t>

</templates>
