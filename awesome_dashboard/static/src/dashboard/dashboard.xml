<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
    <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
        <t t-set-slot='layout-buttons'>
            <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
            <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
        </t>
        <div class="d-flex p-4 flex-wrap">
            <DashboardItem>
                Average amount of t-shirt by order this month
                <h1><b><t t-esc="state.stats.average_quantity"/></b></h1>
            </DashboardItem>
            <DashboardItem>
                Average time for an order to go from 'new' to 'sent' or 'cancelled'
                <h1><b><t t-esc="state.stats.average_time"/></b></h1>
            </DashboardItem>
            <DashboardItem>
                Number of new orders this month
                <h1><b><t t-esc="state.stats.nb_new_orders"/></b></h1>
            </DashboardItem>
            <DashboardItem>
                Number of cancelled orders this month
                <h1><b><t t-esc="state.stats.nb_cancelled_orders"/></b></h1>
            </DashboardItem>
            <DashboardItem>
                Total amount of new orders this month
                <h1><b><t t-esc="state.stats.total_amount"/></b></h1>
            </DashboardItem>
            <DashboardItem size="2">
                 <PieChart data="state.stats.orders_by_size"/> 
            </DashboardItem>
        </div>
    </Layout>
    </t>

</templates>
