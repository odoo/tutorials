<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="display">
            <t t-set-slot="control-panel-bottom-left">
                <button class="btn btn-primary" t-on-click="openCustomerView">Load Customers</button>
                <button class="btn btn-secondary ms-2" t-on-click="openLeads">Load Leads</button>
            </t>
            
            <div class="o_dashboard_content p-3">
                <div class="row">
                    <t t-foreach="items" t-as="item" t-key="item.id">
                        <DashboardItem size="item.size || 1">
                            <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                            
                            <t t-component="item.Component" t-props="itemProp" />
                        </DashboardItem>
                    </t>
                    </div>
            </div>
        </Layout>
    </t>

</templates>
