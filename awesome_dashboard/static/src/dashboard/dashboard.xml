<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout
            display="{controlPanel: {}}"
            className="'o_dashboard h-100'"
        >
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">
                    <t t-esc="labels.customers"/>
                </button>
                <button class="btn btn-primary ms-2" t-on-click="openLeads">
                    <t t-esc="labels.leads"/>
                </button>
                <button class="btn btn-primary ms-2" t-on-click="openSettings" t-att-title="labels.settings">
                    <i class="fa fa-gear" role="img" t-att-aria-label="labels.settings"/>
                </button>
            </t>
            <div class="d-flex flex-wrap gap-3 p-3">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProp"
                           t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                        <t t-component="item.Component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>
</templates>
