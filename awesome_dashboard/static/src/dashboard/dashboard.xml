<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <t t-set="statistics" t-value="this.reporting.statistics()"/>
        <Layout display="{ controlPanel: {buttons: true} }" className="'o_dashboard h-100'">
            <t t-set-slot="control-panel-buttons">
                <button class="btn btn-primary" t-on-click="this.openCustomersKanbanView">Customers</button>
                <button class="btn btn-primary" t-on-click="this.openLeadsView">Leads</button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="this.openConfigDialog" class="btn p-0 ms-1 border-0">
                    <i class="oi" data-icon="settings"/>
                </button>
            </t>
            <div class="d-flex flex-wrap" t-if="statistics">
                <t t-foreach="this.items()" t-as="item" t-key="item.id">
                    <DashboardItem  t-if="!this.disabledItems().includes(item.id)" size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                        <t t-component="item.Component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>
</templates>
