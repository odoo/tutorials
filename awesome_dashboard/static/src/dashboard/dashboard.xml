<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary" t-on-click="openLeads">
                    Leads
                </button>
            </t>
            <AwesomeDashboardItem t-if="stats.isReady">
                <div>Average amount of t-shirt by order this month</div>
                <div
                    class="text-success text-center"
                    t-out="stats.average_quantity"
                />
            </AwesomeDashboardItem>
            <AwesomeDashboardItem size="2" t-if="stats.isReady">
                <div>
                    Average time for an order to go from 'new' to 'sent' or
                    'cancelled'
                </div>
                <div
                    class="text-success text-center"
                    t-out="stats.average_time"
                />
            </AwesomeDashboardItem>
            <AwesomeDashboardItem t-if="stats.isReady">
                <div>Number of new orders this month</div>
                <div
                    class="text-success text-center"
                    t-out="stats.nb_new_orders"
                />
            </AwesomeDashboardItem>
            <AwesomeDashboardItem t-if="stats.isReady">
                <div>Number of cancelled orders this month</div>
                <div
                    class="text-success text-center"
                    t-out="stats.nb_cancelled_orders"
                />
            </AwesomeDashboardItem>
            <AwesomeDashboardItem t-if="stats.isReady">
                <div>Total amount of new orders this month</div>
                <div
                    class="text-success text-center"
                    t-out="stats.total_amount"
                />
            </AwesomeDashboardItem>
            <AwesomeDashboardItem t-if="stats.isReady">
                <div>Shirt orders by size</div>
                <PieChart data="stats.orders_by_size" />
            </AwesomeDashboardItem>
        </Layout>
    </t>
</templates>
