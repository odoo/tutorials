<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="{ controlPanel: {} }">
            <t t-set-slot="control-panel-always-buttons">
                <button class="btn btn-primary me-2" t-on-click="openCustomers">
                    Customers
                </button>
                <button class="btn btn-primary me-2" t-on-click="openLeads">
                    Leads
                </button>
                 <button class="btn btn-secondary" t-on-click="openConfigurationDialog">
                    <i class="fa fa-gear"/>
                </button>
            </t>

            <div class="d-flex flex-wrap mt-1" t-if="this.statistics.data">
                <DashboardItem>
                    <div class="text-center">
                        Number of new orders this month
                        <p t-out="this.statistics.data.nb_new_orders" class="fs-1 fw-bold text-success"/>
                    </div>
                </DashboardItem>

                <DashboardItem>
                    <div class="text-center">
                        Total amount of new orders this month
                        <p t-out="this.statistics.data.total_amount" class="fs-1 fw-bold text-success"/>
                    </div>
                </DashboardItem>

                <DashboardItem>
                    <div class="text-center">
                        Average amount of t-shirt by order this month
                        <p t-out="this.statistics.data.average_quantity" class="fs-1 fw-bold text-success"/>
                    </div>
                </DashboardItem>

                <DashboardItem>
                    <div class="text-center">
                        Number of cancelled orders this month
                        <p t-out="this.statistics.data.nb_cancelled_orders" class="fs-1 fw-bold text-success"/>
                    </div>
                </DashboardItem>

                <DashboardItem>
                    <div class="text-center">
                        Average time for an order to go from ‘new’ to ‘sent’ or ‘cancelled’
                        <p t-out="this.statistics.data.average_time" class="fs-1 fw-bold text-success"/>
                    </div>
                </DashboardItem>

                <DashboardItem>
                    <div class="text-center">
                        Shirt order by size
                        <PieChart items="this.statistics.data.orders_by_size"/>
                    </div>
                </DashboardItem>
            </div>
        </Layout>
    </t>

</templates>
