<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.dashboard">
        <Layout display="display" className="&apos;o_dashboard h-100&apos;">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary mx-1 p-2" t-on-click="customerView">Customer</button>
                <button class="btn btn-primary mx-1 p-2" t-on-click="leadsView">Leads</button>
            </t>
            <div>
                <DashboardItem size="1">
                    Some Content
                </DashboardItem>
                <DashboardItem size="2">
                    I want to buysome
                </DashboardItem>
                <DashboardItem size="1">
                    Some Content
                </DashboardItem>
            </div>
            <div class="d-flex flex-wrap" t-if="statistics.isReady">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statistics): {&apos;data&apos;: statistics}"/>
                        <t t-component="item.component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>
</templates>