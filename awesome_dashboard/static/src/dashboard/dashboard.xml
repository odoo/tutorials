<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="display" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">All Leads</button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="openConfiguration" class="btn fa fa-cog"/>
            </t>
            <div class="o_dashboard_card d-flex flex-wrap column-gap-2 row-gap-2 p-3" t-if="stats.isReady">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size='item.size || 2'>
                        <t t-set="itemProp" t-value="item.props ? item.props(stats) : {'data':stats}"/>
                        <t t-component="item.Component" t-props="itemProp"/>
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

    <t t-name="awesome_dashboard.ConfigurationDialog">
        <Dialog title="'Dashboard Items Configuration'">
            Which Items do you wish to see?
            <t t-foreach="items" t-as="item" t-key="item.id">
                <CheckBox value="item.enabled" onChange="(ev) => this.onChange(ev,item)">
                    <t t-esc="item.description"/>
                </CheckBox>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="done">
                    Done
                </button>
            </t>
        </Dialog>
    </t>

</templates>
