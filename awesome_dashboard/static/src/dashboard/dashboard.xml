<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <!-- Buttons -->
            <t t-set-slot="layout-buttons">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="openCustomer">
                    Customers
                    </button>
                    <button class="btn btn-secondary" t-on-click="openLeads">
                    Leads
                    </button>
                </div>
            </t>
            <!-- Settings -->
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="openConfiguration" class="btn btn-light border">
                Settings
                </button>
            </t>
            <!-- Loading -->
            <t t-if="state.loading">
                <div class="d-flex justify-content-center mt-5">
                    <div class="spinner-border text-primary"/>
                </div>
            </t>
            <!-- Dashboard -->
            <t t-else="">
                <div class="o_dashboard">
                    <div class="container py-3">
                        <div class="d-flex flex-wrap gap-3" t-if="statistics.isReady">
                            <t t-foreach="items" t-as="item" t-key="item.id">
                                <DashboardItem t-if="!state.disabledItems.includes(item.id)" size="item.size || 1">
                                    <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                                    <t t-component="item.Component" t-props="itemProp"/>

                                </DashboardItem>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </Layout>
    </t>
    <t t-name="awesome_dashboard.ConfigurationDialog">
        <Dialog title="'Dashboard items configuration'">
            <div class="mb-2">
            Which cards do you wish to see ?
            </div>

            <t t-foreach="items" t-as="item" t-key="item.id">
                <CheckBox value="item.enabled" onChange="(ev) => this.onChange(ev, item)">
                    <t t-esc="item.description"/>
                </CheckBox>
            </t>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="done">
                Done
                </button>
            </t>
        </Dialog>
    </t>
</templates>
