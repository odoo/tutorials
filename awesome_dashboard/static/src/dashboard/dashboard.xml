<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="{ controlPanel: {} }">
            <t t-set-slot="control-panel-create-button">
                <button class="btn btn-primary" t-on-click="openCustomers">Customers</button>
                <button class="btn btn-primary" t-on-click="openLeads">Leads</button>
            </t>
            <div class="p-2 d-flex flex-wrap gap-3" t-if="this.state.stats">
                <NumberCard size="1.5" data="this.state.stats.nb_new_orders" description="'Number of new orders this month'" />
                <NumberCard size="1.5" data="this.state.stats.total_amount" description="'Total amount of new orders this month'" />
                <NumberCard size="1.5" data="this.state.stats.average_quantity" description="'Average amount of t-shirt by order this month'" />
                <NumberCard size="1.5" data="this.state.stats.nb_cancelled_orders" description="'Number of cancelled orders this month'" />
                <NumberCard size="1.5" data="this.state.stats.average_time" description="'Average time for an order to go from \'new\' to \'sent\' or \'cancelled\''" />
                <PieChartCard size="2" data="this.state.stats.orders_by_size" />
            </div>
        </Layout>
    </t>

</templates>
