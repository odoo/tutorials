<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.DashboardSettingsDialog">
        <Dialog title="props.title">
            <div class="mb-2 fw-bold"><t t-esc="props.introLabel"/></div>
            <div class="d-flex flex-column gap-1">
                <t t-foreach="props.items" t-as="it" t-key="it.id">
                    <label class="form-check">
                        <input class="form-check-input" type="checkbox" t-att-checked="state.checkedById[it.id]" t-on-change="toggle.bind(this, it.id)"/>
                        <span class="form-check-label ms-2"><t t-out="it.description"/></span>
                    </label>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-on-click="apply"><t t-esc="props.applyLabel || 'Apply'"/></button>
            </t>
        </Dialog>
    </t>
</templates>
