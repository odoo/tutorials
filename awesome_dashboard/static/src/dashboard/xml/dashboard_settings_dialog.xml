<templates xml:space="preserve">
    <t t-name="awesome_dashboard.DashboardSettingsDialog">
        <Dialog title="'Dashboard Settings'">
            <div class="p-3">
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <div class="form-check">
                        <input type="checkbox"
                            t-att-checked="state.checked[item.id]"
                            t-on-change="() => this.toggle(item.id)"
                            class="form-check-input"
                            t-att-id="'dashboard_item_' + item.id"/>
                        <label t-att-for="'dashboard_item_' + item.id"
                            class="form-check-label">
                            <t t-esc="item.description"/>
                        </label>
                    </div>
                </t>
            </div>
            <div t-slot="footer">
                <button class="btn btn-primary" t-on-click="apply">
                    Apply
                </button>
            </div>
        </Dialog>
    </t>
</templates>