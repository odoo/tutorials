<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.SettingsDialog">
        <Dialog>
            <div class="model-body">
                <h3>What cards you want to show?</h3>
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <h4>
                        <input class="form-check-input"
                            t-att-checked="!state.hidden.includes(item.id)"
                            t-on-change="onToggle"
                            t-att-data-id="item.id"
                            type="checkbox"/>
                        <t class="m-3" t-out="item.description"/>
                    </h4>
                </t>
                <div class="btn btn-primary" t-on-click="apply">
                    Apply
                </div>
            </div>
        </Dialog>
    </t>

</templates>

