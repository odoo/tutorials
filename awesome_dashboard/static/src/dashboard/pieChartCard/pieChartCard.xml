<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.pieChartCard">
        <div class="p-3">
            <h3 style="color: black;"><t t-esc="props.title"/></h3>
            <PieChart values="props.values" onSelect="(label) => this.onSelectLabel(label)"/>
        </div>
    </t>

</templates>
