<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.pie_chart_card">
        <t t-if="props.title !== undefined">
            <p>
                <t t-out="props.title" />
            </p>
        </t>
        <PieChart labels="props.labels" datasets="props.datasets" />
    </t>
</templates>
