<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.DashboardSettingsDialog">

        <Dialog title="'Dashboard Settings'">

            <t t-foreach="props.items" t-as="item" t-key="item.id">

                <div class="form-check">

                    <input type="checkbox" class="form-check-input" t-att-checked="isChecked(item.id)" t-on-change="(ev) => this.toggleItem(item.id, ev)"/>

                    <label class="form-check-label">
                        <t t-esc="item.description"/>
                    </label>

                </div>
            </t>

            <t t-set-slot="footer">

                <button class="btn btn-primary" t-on-click="apply">
                    Apply
                </button>
            </t>

        </Dialog>

    </t>

</templates>