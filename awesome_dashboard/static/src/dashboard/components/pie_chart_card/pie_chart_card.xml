<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.PieChartCard">
        <div class="card m-2" t-att-style="'width: ' + (18 * props.size) + 'rem;'">
            <div class="card-body">
                <h5 class="card-title" t-esc="props.title"/>
                    <PieChart t-if="props.ordersBySize" ordersBySize="props.ordersBySize"/>
            </div>
        </div>
    </t>
    
</templates>
