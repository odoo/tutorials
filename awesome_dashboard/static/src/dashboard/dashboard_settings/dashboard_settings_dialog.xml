<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.DashboardSettingsDialog">
        <Dialog title="'Dashboard items'" size="'md'">
            <div class="list-group">
                <t t-foreach="props.items" t-as="item" t-key="item.id">
                    <label class="list-group-item d-flex align-items-center gap-2">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            t-att-checked="state[item.id]"
                            t-on-change="(event) => this.onToggle(item.id, event)"
                        />
                        <span t-out="this.getDescription(item)"/>
                    </label>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
                <button class="btn btn-primary" t-on-click="apply">Apply</button>
            </t>
        </Dialog>
    </t>

</templates>
