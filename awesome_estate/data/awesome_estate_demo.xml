<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!--
        Lean demo seed for awesome_estate (feature + edge coverage).

        Logins (password always 123456):
          user     → Marc Demo (Real Estate / User — salesperson)
          tech1    → Ravi Kumar (Real Estate / Technician)
          tenant1  → Anita Patel (Portal — tenant)

        Company: My Company, currency INR.

        Edge matrix:
          Properties: new | offer_received | offer_accepted | sold | canceled
          Offers: multi-buyer clean | accepted | suspicious (same partner×2)
                  | same partner once on other house (NOT auto-flagged)
          Maintenance: assigned+subtasks | in_progress+cost | done+costs | canceled
    -->

    <!-- ================================================================ -->
    <!-- COMPANY — INR                                                    -->
    <!-- ================================================================ -->

    <record id="base.main_company" model="res.company">
        <field name="name">My Company</field>
        <field name="currency_id" ref="base.INR"/>
    </record>

    <!-- ================================================================ -->
    <!-- PARTNERS — natural people names (not Buyer One / Tech One)       -->
    <!-- ================================================================ -->

    <record id="partner_user" model="res.partner">
        <field name="name">Marc Demo</field>
        <field name="email">marc.demo@example.com</field>
    </record>
    <record id="partner_tech1" model="res.partner">
        <field name="name">Ravi Kumar</field>
        <field name="email">ravi.kumar@example.com</field>
    </record>
    <record id="partner_tenant1" model="res.partner">
        <field name="name">Anita Patel</field>
        <field name="email">anita.patel@example.com</field>
    </record>
    <record id="partner_buyer1" model="res.partner">
        <field name="name">Neha Shah</field>
        <field name="email">neha.shah@example.com</field>
    </record>
    <record id="partner_buyer2" model="res.partner">
        <field name="name">Arjun Mehta</field>
        <field name="email">arjun.mehta@example.com</field>
    </record>
    <!-- Places two offers on Villa Suspicious → is_suspicious -->
    <record id="partner_buyer_dup" model="res.partner">
        <field name="name">Vikram Desai</field>
        <field name="email">vikram.desai@example.com</field>
    </record>

    <!-- ================================================================ -->
    <!-- USERS — password 123456                                          -->
    <!-- ================================================================ -->

    <record id="user_user" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Marc Demo</field>
        <field name="login">user</field>
        <field name="password">123456</field>
        <field name="partner_id" ref="partner_user"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.link(ref('base.main_company'))]"/>
        <field name="group_ids" eval="[Command.set([
            ref('base.group_user'),
            ref('group_estate_user'),
        ])]"/>
    </record>

    <record id="user_tech1" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Ravi Kumar</field>
        <field name="login">tech1</field>
        <field name="password">123456</field>
        <field name="partner_id" ref="partner_tech1"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.link(ref('base.main_company'))]"/>
        <field name="group_ids" eval="[Command.set([
            ref('base.group_user'),
            ref('group_estate_technician'),
        ])]"/>
    </record>

    <record id="user_tenant1" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Anita Patel</field>
        <field name="login">tenant1</field>
        <field name="password">123456</field>
        <field name="partner_id" ref="partner_tenant1"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[Command.link(ref('base.main_company'))]"/>
        <field name="group_ids" eval="[Command.set([ref('base.group_portal')])]"/>
    </record>

    <!-- ================================================================ -->
    <!-- TYPES & TAGS                                                     -->
    <!-- ================================================================ -->

    <record id="property_type_house" model="awesome.estate.property.type">
        <field name="name">House</field>
        <field name="sequence">1</field>
    </record>
    <record id="property_type_apartment" model="awesome.estate.property.type">
        <field name="name">Apartment</field>
        <field name="sequence">2</field>
    </record>
    <record id="property_type_villa" model="awesome.estate.property.type">
        <field name="name">Villa</field>
        <field name="sequence">3</field>
    </record>

    <record id="property_tag_cozy" model="awesome.estate.property.tag">
        <field name="name">Cozy</field>
        <field name="color">4</field>
    </record>
    <record id="property_tag_renovated" model="awesome.estate.property.tag">
        <field name="name">Renovated</field>
        <field name="color">7</field>
    </record>
    <record id="property_tag_pool" model="awesome.estate.property.tag">
        <field name="name">Pool</field>
        <field name="color">3</field>
    </record>

    <!-- ================================================================ -->
    <!-- PROPERTIES                                                       -->
    <!-- Create as new first; offers use create() (escalation + flags).   -->
    <!-- Terminal states applied after related offers (see rewrites).     -->
    <!-- ================================================================ -->

    <!-- A: empty new — live create / garden UX -->
    <record id="property_new" model="awesome.estate.property">
        <field name="name">House New</field>
        <field name="description">Empty listing for live demos (no offers yet).</field>
        <field name="postcode">560001</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="expected_price">500000</field>
        <field name="bedrooms">3</field>
        <field name="living_area">180</field>
        <field name="facades">2</field>
        <field name="garage" eval="True"/>
        <field name="garden" eval="True"/>
        <field name="garden_area">45</field>
        <field name="garden_orientation">north</field>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_cozy')])]"/>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- B: competing bids, different partners (NOT suspicious) -->
    <record id="property_multi_offer" model="awesome.estate.property">
        <field name="name">Villa Multi Offer</field>
        <field name="description">Two different buyers. Use Accept Best.</field>
        <field name="postcode">560002</field>
        <field name="property_type_id" ref="property_type_villa"/>
        <field name="expected_price">2000000</field>
        <field name="bedrooms">5</field>
        <field name="living_area">400</field>
        <field name="facades">4</field>
        <field name="garage" eval="True"/>
        <field name="garden" eval="True"/>
        <field name="garden_area">200</field>
        <field name="garden_orientation">south</field>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_pool'), ref('property_tag_renovated')])]"/>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- C: will become offer_accepted after offer -->
    <record id="property_accepted" model="awesome.estate.property">
        <field name="name">House Accepted</field>
        <field name="description">Accepted offer path; ready for Sold / account invoice.</field>
        <field name="postcode">560003</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="expected_price">750000</field>
        <field name="bedrooms">3</field>
        <field name="living_area">160</field>
        <field name="facades">2</field>
        <field name="garage" eval="True"/>
        <field name="garden" eval="True"/>
        <field name="garden_area">30</field>
        <field name="garden_orientation">east</field>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_renovated')])]"/>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- D: will become sold after offer -->
    <record id="property_sold" model="awesome.estate.property">
        <field name="name">Apartment Sold</field>
        <field name="description">Sold listing (buyer + selling price set).</field>
        <field name="postcode">560004</field>
        <field name="property_type_id" ref="property_type_apartment"/>
        <field name="expected_price">350000</field>
        <field name="bedrooms">2</field>
        <field name="living_area">90</field>
        <field name="facades">1</field>
        <field name="garage" eval="False"/>
        <field name="garden" eval="False"/>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- E: canceled + archived -->
    <record id="property_canceled" model="awesome.estate.property">
        <field name="name">House Canceled</field>
        <field name="description">Withdrawn listing (archived).</field>
        <field name="postcode">560005</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="expected_price">100000</field>
        <field name="bedrooms">0</field>
        <field name="living_area">500</field>
        <field name="facades">1</field>
        <field name="garage" eval="False"/>
        <field name="garden" eval="False"/>
        <field name="state">canceled</field>
        <field name="active" eval="False"/>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- F: same partner twice → suspicious -->
    <record id="property_suspicious" model="awesome.estate.property">
        <field name="name">Villa Suspicious</field>
        <field name="description">Same partner two offers → both is_suspicious.</field>
        <field name="postcode">560006</field>
        <field name="property_type_id" ref="property_type_villa"/>
        <field name="expected_price">1000000</field>
        <field name="bedrooms">4</field>
        <field name="living_area">300</field>
        <field name="facades">3</field>
        <field name="garage" eval="True"/>
        <field name="garden" eval="True"/>
        <field name="garden_area">100</field>
        <field name="garden_orientation">south</field>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- G: same partner as F but only ONE offer here → NOT auto-flagged -->
    <record id="property_single_dup" model="awesome.estate.property">
        <field name="name">House Single Bid</field>
        <field name="description">Buyer Dup once only — not suspicious alone.</field>
        <field name="postcode">560007</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="expected_price">300000</field>
        <field name="bedrooms">2</field>
        <field name="living_area">100</field>
        <field name="facades">2</field>
        <field name="garage" eval="True"/>
        <field name="garden" eval="False"/>
        <field name="state">new</field>
        <field name="salesperson_id" ref="user_user"/>
    </record>

    <!-- ================================================================ -->
    <!-- OFFERS                                                           -->
    <!-- Prices escalate where multiple on same property.                 -->
    <!-- Properties are kept at 'new' in XML because create() guards     -->
    <!-- block offers on sold/canceled/offer_accepted properties.        -->
    <!-- State rewrites would create a fragile ordering dependency:      -->
    <!-- if the rewrite record appeared before the offer in XML, the     -->
    <!-- property would already be offer_accepted when the offer tries   -->
    <!-- to create, causing a ValidationError.                          -->
    <!-- ================================================================ -->

    <!-- Multi-offer villa: two partners (clean) -->
    <record id="offer_multi_1" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_multi_offer"/>
        <field name="partner_id" ref="partner_buyer1"/>
        <field name="price">1850000</field>
        <field name="validity">7</field>
    </record>
    <record id="offer_multi_2" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_multi_offer"/>
        <field name="partner_id" ref="partner_buyer2"/>
        <field name="price">1950000</field>
        <field name="validity">14</field>
    </record>

    <!-- Accepted path -->
    <record id="offer_accepted_1" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_accepted"/>
        <field name="partner_id" ref="partner_buyer1"/>
        <field name="price">720000</field>
        <field name="validity">7</field>
        <field name="status">accepted</field>
    </record>
    <record id="property_accepted" model="awesome.estate.property">
        <field name="state">offer_accepted</field>
        <field name="selling_price">720000</field>
        <field name="buyer_id" ref="partner_buyer1"/>
    </record>

    <!-- Sold path (offer first while still new, then mark sold) -->
    <record id="offer_sold_1" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_sold"/>
        <field name="partner_id" ref="partner_buyer2"/>
        <field name="price">360000</field>
        <field name="validity">7</field>
        <field name="status">accepted</field>
    </record>
    <record id="property_sold" model="awesome.estate.property">
        <field name="state">sold</field>
        <field name="selling_price">360000</field>
        <field name="buyer_id" ref="partner_buyer2"/>
    </record>

    <!-- Suspicious: same partner, escalating prices; flag explicit for -u reseed -->
    <record id="offer_sus_1" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_suspicious"/>
        <field name="partner_id" ref="partner_buyer_dup"/>
        <field name="price">900000</field>
        <field name="validity">7</field>
        <field name="is_suspicious" eval="True"/>
    </record>
    <record id="offer_sus_2" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_suspicious"/>
        <field name="partner_id" ref="partner_buyer_dup"/>
        <field name="price">950000</field>
        <field name="validity">7</field>
        <field name="is_suspicious" eval="True"/>
    </record>

    <!-- Refused offer on multi-offer villa (decoration-danger visible) -->
    <record id="offer_refused" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_multi_offer"/>
        <field name="partner_id" ref="partner_buyer1"/>
        <field name="price">2000000</field>
        <field name="validity">7</field>
        <field name="status">refused</field>
    </record>

    <!-- Same partner once on another house — not flagged -->
    <record id="offer_single_dup" model="awesome.estate.property.offer">
        <field name="property_id" ref="property_single_dup"/>
        <field name="partner_id" ref="partner_buyer_dup"/>
        <field name="price">290000</field>
        <field name="validity">7</field>
    </record>

    <!-- ================================================================ -->
    <!-- MAINTENANCE (+ subtasks + cost lines)                            -->
    <!-- currency defaults from company (INR). Explicit for clarity.      -->
    <!-- ================================================================ -->

    <!-- Assigned + mixed subtasks (progress partial) -->
    <record id="maint_assigned" model="awesome.estate.property.maintenance">
        <field name="name">Bathroom pipe leak</field>
        <field name="property_id" ref="property_new"/>
        <field name="issue_type">plumbing</field>
        <field name="priority">3</field>
        <field name="requester_id" ref="partner_tenant1"/>
        <field name="is_tenant" eval="True"/>
        <field name="technician_id" ref="user_tech1"/>
        <field name="description">Slow leak under bathroom sink.</field>
        <field name="estimate_cost">1500.0</field>
        <field name="currency_id" ref="base.INR"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">assigned</field>
    </record>
    <record id="subtask_pipe" model="awesome.estate.property.maintenance.subtask">
        <field name="maintenance_id" ref="maint_assigned"/>
        <field name="name">Replace pipe joint</field>
        <field name="state">in_progress</field>
        <field name="sequence">10</field>
        <field name="technician_id" ref="user_tech1"/>
        <field name="planned_hours">2.0</field>
        <field name="cost">500.0</field>
    </record>
    <record id="subtask_faucet" model="awesome.estate.property.maintenance.subtask">
        <field name="maintenance_id" ref="maint_assigned"/>
        <field name="name">Inspect faucet</field>
        <field name="state">done</field>
        <field name="sequence">20</field>
        <field name="technician_id" ref="user_tech1"/>
        <field name="planned_hours">0.5</field>
        <field name="effective_hours">0.5</field>
        <field name="cost">0.0</field>
    </record>
    <record id="subtask_pending" model="awesome.estate.property.maintenance.subtask">
        <field name="maintenance_id" ref="maint_assigned"/>
        <field name="name">Final pressure test</field>
        <field name="state">pending</field>
        <field name="sequence">30</field>
        <field name="technician_id" ref="user_tech1"/>
        <field name="planned_hours">1.0</field>
    </record>
    <record id="cost_pipe_parts" model="awesome.estate.property.maintenance.cost">
        <field name="maintenance_id" ref="maint_assigned"/>
        <field name="name">Pipe fittings</field>
        <field name="amount">200.0</field>
    </record>

    <!-- In progress + cost only (no subtasks → progress 0) -->
    <record id="maint_in_progress" model="awesome.estate.property.maintenance">
        <field name="name">Window sticking</field>
        <field name="property_id" ref="property_multi_offer"/>
        <field name="issue_type">structural</field>
        <field name="priority">2</field>
        <field name="requester_id" ref="partner_tenant1"/>
        <field name="is_tenant" eval="True"/>
        <field name="technician_id" ref="user_tech1"/>
        <field name="description">Frame does not close flush.</field>
        <field name="estimate_cost">3000.0</field>
        <field name="currency_id" ref="base.INR"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">in_progress</field>
    </record>
    <record id="cost_window_hw" model="awesome.estate.property.maintenance.cost">
        <field name="maintenance_id" ref="maint_in_progress"/>
        <field name="name">Window hardware</field>
        <field name="amount">800.0</field>
    </record>

    <!-- Done: subtask + cost lines (actual_cost = sum) -->
    <record id="maint_done" model="awesome.estate.property.maintenance">
        <field name="name">AC not cooling</field>
        <field name="property_id" ref="property_accepted"/>
        <field name="issue_type">electricity</field>
        <field name="priority">3</field>
        <field name="requester_id" ref="partner_buyer1"/>
        <field name="is_tenant" eval="False"/>
        <field name="technician_id" ref="user_tech1"/>
        <field name="description">Service completed; refrigerant refilled.</field>
        <field name="estimate_cost">2000.0</field>
        <field name="currency_id" ref="base.INR"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="close_date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="state">done</field>
    </record>
    <record id="subtask_ac_done" model="awesome.estate.property.maintenance.subtask">
        <field name="maintenance_id" ref="maint_done"/>
        <field name="name">Service unit</field>
        <field name="state">done</field>
        <field name="technician_id" ref="user_tech1"/>
        <field name="planned_hours">3.0</field>
        <field name="effective_hours">2.5</field>
        <field name="cost">600.0</field>
    </record>
    <record id="cost_ac_gas" model="awesome.estate.property.maintenance.cost">
        <field name="maintenance_id" ref="maint_done"/>
        <field name="name">Refrigerant refill</field>
        <field name="amount">1200.0</field>
    </record>
    <record id="cost_ac_labor" model="awesome.estate.property.maintenance.cost">
        <field name="maintenance_id" ref="maint_done"/>
        <field name="name">Labor</field>
        <field name="amount">400.0</field>
    </record>

    <!-- Canceled ticket on sold property -->
    <!-- <record id="maint_canceled" model="awesome.estate.property.maintenance">
        <field name="name">Paint touch-up</field>
        <field name="property_id" ref="property_sold"/>
        <field name="issue_type">painting</field>
        <field name="priority">1</field>
        <field name="requester_id" ref="partner_buyer2"/>
        <field name="description">Canceled — buyer will repaint after handover.</field>
        <field name="estimate_cost">500.0</field>
        <field name="currency_id" ref="base.INR"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">canceled</field>
        <field name="close_date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
    </record> -->

    <!-- Unassigned new ticket (assign in UI) -->
    <record id="maint_new" model="awesome.estate.property.maintenance">
        <field name="name">Garden light out</field>
        <field name="property_id" ref="property_single_dup"/>
        <field name="issue_type">electricity</field>
        <field name="priority">2</field>
        <field name="requester_id" ref="partner_tenant1"/>
        <field name="is_tenant" eval="True"/>
        <field name="description">Outdoor light not working — not assigned yet.</field>
        <field name="estimate_cost">1000.0</field>
        <field name="currency_id" ref="base.INR"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">new</field>
    </record>

</data>
</odoo>
