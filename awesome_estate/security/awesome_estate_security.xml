<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        User        → sales: properties, offers, types, tags
        Technician  → maintenance; read properties/offers
        Admin/root  → in User group so the app menus show (Odoo hides menus without group)
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_estate">
        <field name="name">Real Estate</field>
        <field name="description">Manage properties, offers, and maintenance requests.</field>
        <field name="placeholder">View</field>
        <field name="category_id" ref="base.module_category_services"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_estate_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">5</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="comment">Sales access: properties and offers.</field>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="group_estate_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="sequence">8</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="comment">Maintenance on assigned tickets; can open property forms (read).</field>
    </record>

    <data noupdate="1">

        <record id="awesome_estate_rule_maintenance_company" model="ir.rule">
            <field name="name">Estate Maintenance: multi-company</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <!-- Technician: only own maintenance -->
        <record id="awesome_estate_rule_maintenance_technician" model="ir.rule">
            <field name="name">Technician: own maintenance requests</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance"/>
            <field name="domain_force">[
                '|', ('requester_id', '=', user.partner_id.id),
                     ('technician_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_estate_technician'))]"/>
        </record>

        <record id="awesome_estate_rule_subtask_technician" model="ir.rule">
            <field name="name">Technician: own subtasks</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance_subtask"/>
            <field name="domain_force">[
                '|',
                    ('technician_id', '=', user.id),
                    '|',
                        ('maintenance_id.technician_id', '=', user.id),
                        ('maintenance_id.requester_id', '=', user.partner_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_estate_technician'))]"/>
        </record>

        <record id="awesome_estate_rule_cost_technician" model="ir.rule">
            <field name="name">Technician: own maintenance cost lines</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance_cost"/>
            <field name="domain_force">[
                '|', ('maintenance_id.requester_id', '=', user.partner_id.id),
                     ('maintenance_id.technician_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_estate_technician'))]"/>
        </record>

        <!-- Portal: own maintenance only -->
        <record id="awesome_estate_rule_maintenance_portal" model="ir.rule">
            <field name="name">Portal: own maintenance</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance"/>
            <field name="domain_force">[('requester_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="awesome_estate_rule_subtask_portal" model="ir.rule">
            <field name="name">Portal: own maintenance subtasks</field>
            <field name="model_id" ref="model_awesome_estate_property_maintenance_subtask"/>
            <field name="domain_force">[('maintenance_id.requester_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>

</odoo>
