<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="awesome_estate_property_maintenance_subtask_view_list" model="ir.ui.view">
        <field name="name">awesome.estate.property.maintenance.subtask.list</field>
        <field name="model">awesome.estate.property.maintenance.subtask</field>
        <field name="arch" type="xml">
            <list editable="top" multi_edit="1"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'canceled'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="maintenance_id" optional="show"/>
                <field name="technician_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="badge" optional="show"/>
                <field name="planned_hours" optional="hide"/>
                <field name="effective_hours" optional="hide"/>
                <field name="cost" widget="monetary" optional="hide"/>
            </list>
        </field>
    </record>

</odoo>
