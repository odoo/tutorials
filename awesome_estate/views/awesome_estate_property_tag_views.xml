<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="awesome_estate_property_tag_view_list" model="ir.ui.view">
        <field name="name">awesome.estate.property.tag.list</field>
        <field name="model">awesome.estate.property.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="True">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="awesome_estate_property_tag_view_form" model="ir.ui.view">
        <field name="name">awesome.estate.property.tag.form</field>
        <field name="model">awesome.estate.property.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="awesome_estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">awesome.estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
