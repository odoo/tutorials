<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- List View -->
    <record id="awesome_estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">awesome.estate.property.offer.list</field>
        <field name="model">awesome.estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                  decoration-success="status == 'accepted'"
                  decoration-bf="status == 'accepted'"
                  decoration-danger="status == 'refused'"
                  decoration-warning="is_suspicious">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="create_date" optional="hide"/>
                <field name="validity" optional="hide"/>
                <field name="date_deadline" optional="show"/>
                <field name="is_suspicious" column_invisible="1"/>
                <field name="status" widget="badge" optional="show"
                         decoration-success="status == 'accepted'"
                         decoration-danger="status == 'refused'"/>
                <field name="status" column_invisible="1"/>
                <button name="action_accept" type="object" icon="fa-check" title="Accept"
                        invisible="status in ['accepted', 'refused'] or is_suspicious"/>
                <button name="action_refuse" type="object" icon="fa-times" title="Refuse"
                        invisible="status in ['accepted', 'refused'] or is_suspicious"/>
                <button name="action_mark_suspicious" type="object" icon="fa-flag"
                        title="Mark as Suspicious" invisible="is_suspicious or status in ('accepted', 'refused')"
                        confirm="Mark this offer as suspicious for review?"/>
                <button name="action_clear_suspicious" type="object" icon="fa-flag-o"
                        class="text-warning" title="Clear Suspicious Flag"
                        invisible="not is_suspicious or status in ('accepted', 'refused')"
                        confirm="Clear the suspicious flag on this offer?"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="awesome_estate_property_offer_view_search" model="ir.ui.view">
        <field name="name">awesome.estate.property.offer.search</field>
        <field name="model">awesome.estate.property.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <separator/>
                <filter name="filter_pending" string="Pending"
                        domain="[('status', '=', False)]"/>
                <filter name="filter_accepted" string="Accepted"
                        domain="[('status', '=', 'accepted')]"/>
                <filter name="filter_refused" string="Refused"
                        domain="[('status', '=', 'refused')]"/>
                <separator/>
                <filter name="filter_suspicious" string="Suspicious"
                        domain="[('is_suspicious', '=', True)]"/>
                <filter name="filter_not_suspicious" string="Not Suspicious"
                        domain="[('is_suspicious', '=', False)]"/>
                <separator/>
                <filter name="groupby_status" string="Status"
                        context="{'group_by': 'status'}"/>
                <filter name="groupby_partner" string="Partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="groupby_property" string="Property"
                        context="{'group_by': 'property_id'}"/>
                <filter name="groupby_create_month" string="Creation Month"
                        context="{'group_by': 'create_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- Form View -->
    <record id="awesome_estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">awesome.estate.property.offer.form</field>
        <field name="model">awesome.estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" string="Accept" type="object"
                            invisible="status in ['accepted', 'refused'] or is_suspicious"
                            class="btn-primary"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="status in ['accepted', 'refused'] or is_suspicious"/>
                    <button name="action_mark_suspicious" string="Mark Suspicious" type="object"
                            invisible="is_suspicious or status in ('accepted', 'refused')"
                            confirm="Mark this offer as suspicious for review?"/>
                    <button name="action_clear_suspicious" string="Clear Suspicious Flag" type="object"
                            invisible="not is_suspicious or status in ('accepted', 'refused')"
                            confirm="Clear the suspicious flag on this offer?"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning d-flex align-items-center"
                         invisible="not is_suspicious" role="alert">
                        <i class="fa fa-flag me-2" title="Suspicious"/>
                        <span>
                            This offer is marked as <strong>suspicious</strong>
                            (duplicate bids from the same partner, or manual review).
                            Clear the flag only if the bid is legitimate.
                        </span>
                    </div>
                    <group>
                        <group string="Offer Details">
                            <field name="price"/>
                            <label for="partner_id"/>
                            <div class="o_row">
                                <i class="fa fa-flag text-warning" role="img"
                                   title="Suspicious offer"
                                   aria-label="Suspicious"
                                   invisible="not is_suspicious"/>
                                <field name="partner_id" nolabel="1"/>
                            </div>
                            <field name="property_id"/>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"
                                     decoration-success="status == 'accepted'"
                                     decoration-danger="status == 'refused'"/>
                            <field name="is_suspicious" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="awesome_estate_property_offer_action_all" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">awesome.estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="awesome_estate_property_offer_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create offers on properties and track negotiations.
            </p>
        </field>
    </record>

</odoo>
