<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- List View -->
    <record id="awesome_estate_property_view_list" model="ir.ui.view">
        <field name="name">awesome.estate.property.list</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="postcode"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="total_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="awesome_estate_property_view_form" model="ir.ui.view">
        <field name="name">awesome.estate.property.form</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold" string="Sold" type="object"
                            invisible="state in ['sold', 'canceled', 'offer_accepted']"/>
                    <button name="action_sold" string="Sold" type="object"
                            invisible="state not in ['offer_accepted']"
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['sold', 'canceled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </div>
                    <group>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="salesperson_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area"
                                           invisible="not garden"/>
                                    <field name="garden_orientation"
                                           invisible="not garden"/>
                                    <field name="total_area"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="price"/>
                                            <field name="partner_id"/>
                                            <field name="status"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="awesome_estate_property_view_search" model="ir.ui.view">
        <field name="name">awesome.estate.property.search</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="tag_ids"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <separator/>
                <filter
                    name="available" string="Available"
                    domain="[('state', 'in', ['new', 'offer_received'])]"
                />
                <filter
                    name="best_price"
                    string="Best Price"
                    domain="[('best_price', '>', 1000)]"
                />
                <group name="groupby">
                    <filter
                        name="groupby_postcode" string="Postcode"
                        context="{'group_by': 'postcode'}"
                    />
                    <filter
                        name="groupby_type" string="Type"
                        context="{'group_by': 'property_type_id'}"
                    />
                    <filter
                        name="groupby_salesperson" string="Salesperson"
                        context="{'group_by': 'salesperson_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="awesome_estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">awesome.estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem
        id="awesome_estate_root_menu"
        name="Real Estate"
    />
    <menuitem
        id="awesome_estate_first_level_menu"
        name="Properties"
        parent="awesome_estate_root_menu"
    />
    <menuitem
        id="awesome_estate_property_menu"
        name="Properties"
        parent="awesome_estate_first_level_menu"
        action="awesome_estate_property_action"
    />

</odoo>
