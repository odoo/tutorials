<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- List View -->
    <record id="awesome_estate_property_view_list" model="ir.ui.view">
        <field name="name">awesome.estate.property.list</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="postcode"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="awesome_estate_property_view_form" model="ir.ui.view">
        <field name="name">awesome.estate.property.form</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="salesperson_id"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                            <field name="garage"/>
                            <field name="garden"/>
                        </group>
                    </group>
                    <group>
                        <group string="Garden">
                            <field name="garden_area"/>
                            <field name="garden_orientation"/>
                        </group>
                        <group string="Tags">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="price"/>
                                            <field name="partner_id"/>
                                            <field name="status"/>
                                            <field name="property_id" invisible="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="awesome_estate_property_view_search" model="ir.ui.view">
        <field name="name">awesome.estate.property.search</field>
        <field name="model">awesome.estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="tag_ids"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <separator/>
                <filter name="available" string="Available"
                        domain="[('state', 'in', ['new', 'offer_received'])]"/>
                <group name="groupby">
                    <filter name="groupby_postcode" string="Postcode"
                            context="{'group_by': 'postcode'}"/>
                    <filter name="groupby_type" string="Type"
                            context="{'group_by': 'property_type_id'}"/>
                    <filter name="groupby_salesperson" string="Salesperson"
                            context="{'group_by': 'salesperson_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="awesome_estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">awesome.estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="awesome_estate_root_menu" name="Real Estate"/>
    <menuitem id="awesome_estate_first_level_menu" name="Properties" parent="awesome_estate_root_menu"/>
    <menuitem id="awesome_estate_property_menu" name="Properties" parent="awesome_estate_first_level_menu" action="awesome_estate_property_action"/>

</odoo>
