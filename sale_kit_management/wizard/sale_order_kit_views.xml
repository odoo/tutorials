<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_kit_form_wizard" model="ir.ui.view">
        <field name="name">sale.order.kit.form</field>
        <field name="model">sale.order.kit</field>
        <field name="arch" type="xml">
            <form string="Kit Configurator">
                <sheet>

                    <group>
                        <group>
                            <label string="Kit Product" class="o_form_label me-2"
                                for="parent_product" />
                            <field name="parent_product" readonly="1" nolabel="1" />
                        </group>
                        <group>
                            <field name="kit_total_price" widget="monetary" readonly="1" />
                            <field name="has_kit_subproducts" column_invisible="1" />
                        </group>
                    </group>

                    <separator string="Sub Products" />
                    <field name="kit_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="product_id" string="Product" />
                            <field name="kit_unit_qty" string="Kit Unit Qty"
                                decoration-info="product_id" />
                            <field name="price_unit" string="Price" />
                            <field name="amount" string="Amount" readonly="1" />
                        </list>
                    </field>


                </sheet>
                <footer>
                    <button string="Add to Order Line"
                        name="action_add_to_sol"
                        type="object"
                        class="btn btn-primary"
                        data-hotkey="q" />
                    <button string="Confirm"
                        name="action_confirm"
                        type="object"
                        class="btn btn-secondary"
                        invisible="has_kit_subproducts"
                        data-hotkey="x" />
                </footer>
            </form>
        </field>
    </record>
</odoo>