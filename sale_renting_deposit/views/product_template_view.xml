<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_rental_deposit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.rental.deposit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="inside">
                <field name="is_deposit_required" invisible="not rent_ok" />
                <field name="deposit_amount" invisible="not is_deposit_required" widget="monetary" />
            </xpath>
        </field>
    </record>

</odoo>