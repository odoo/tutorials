<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_market_view_report_list" model="ir.ui.view">
            <field name="name">market.view.report.list</field>
            <field name="model">market.view.report</field>
            <field name="arch" type="xml">
                <list string="Market View" create="0" edit="0" delete="0">
                    <field name="partner_id"/>
                    <field name="partner_status_id"/>
                    <field name="phone"/>
                    <field name="city"/>
                    <field name="street"/>
                    <field name="company_category_id"/>
                    <field name="capacity_tons"/>
                    <field name="product_tmpl_id"/>
                    <field name="dosage_per_ton"/>
                    <field name="potential_monthly_demand"/>
                    <field name="monthly_result"/>
                    <field name="difference_in_demand"/>
                    <field name="sales_manager_id"/>
                </list>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_market_view_report" model="ir.actions.act_window">
            <field name="name">Market View</field>
            <field name="res_model">market.view.report</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_market_view_report_list"/>
            <field name="context">{}</field>
        </record>

        <!-- Contacts -> Reporting (root) -->
        <menuitem id="menu_contacts_reporting_root"
                  name="Reporting"
                  parent="contacts.menu_contacts"
                  sequence="70"
        />

        <!-- Contacts -> Reporting -> Market View -->
        <menuitem id="menu_market_view_report"
                  name="Market View"
                  parent="menu_contacts_reporting_root"
                  action="action_market_view_report"
                  sequence="10"
        />

    </data>
</odoo>
