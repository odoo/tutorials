<odoo>
    <record id="view_partner_products_view_list" model="ir.ui.view">
        <field name="name">partner.products.view.list</field>
        <field name="model">partner.products.view</field>
        <field name="arch" type="xml">
            <list string="Products" create="0" edit="0" delete="0">
                <field name="product_tmpl_id" widget="many2one"/>
                <field name="dosage_per_ton"/>
<!--                <field name="company_category_id"/>-->
            </list>
        </field>
    </record>

    <record id="action_partner_products_view" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">partner.products.view</field>
        <field name="view_mode">list</field>
        <field name="context">{'group_by': ['company_category_id']}</field>
    </record>
</odoo>
