<odoo>
  <record id="view_partner_status_tree" model="ir.ui.view">
    <field name="name">res.partner.status.tree</field>
    <field name="model">res.partner.status</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="view_partner_status_form" model="ir.ui.view">
    <field name="name">res.partner.status.form</field>
    <field name="model">res.partner.status</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="sequence"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_partner_status" model="ir.actions.act_window">
    <field name="name">Partner Statuses</field>
    <field name="res_model">res.partner.status</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Put it under Contacts configuration -->
  <menuitem id="menu_partner_status_root"
            name="Partner Statuses"
            parent="base.menu_config"
            action="action_partner_status"
            sequence="50"/>
</odoo>
