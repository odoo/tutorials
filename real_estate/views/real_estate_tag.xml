<odoo>
    <data>
        <record id="real_estate_tag_tree" model="ir.ui.view">
            <field name="name">real.estate.tag.tree</field>
            <field name="model">real.estate.tag</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="real_estate__tag_form" model="ir.ui.view">
            <field name="name">real.estate.tag.form</field>
            <field name="model">real.estate.tag</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="real_estate_tag_action">
            <field name="name">Property Tag</field>
            <field name="res_model">real.estate.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="rewal_estate_tag_menu"
                  name="Property Tags"
                  parent="real_estate_menu_configuration"
                  action="real_estate_tag_action"/>
    </data>
</odoo>
