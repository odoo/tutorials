<odoo>

    <record id="real_estate_property_investor_view_tree" model="ir.ui.view">
        <field name="name">real.estate.property.investor.view.tree</field>
        <field name="model">real.estate.property.investor</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record id="real_estate_property_investor_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.investor.view.form</field>
        <field name="model">real.estate.property.investor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_property_investor_action_view" model="ir.actions.act_window">
        <field name="name">Property Investor</field>
        <field name="res_model">real.estate.property.investor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
