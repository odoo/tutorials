<odoo>

    <record id="real_estate_property_type_view_tree" model="ir.ui.view">
        <field name="name">real.estate.property.type.view.tree</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <record id="real_estate_property_type_view_form" model="ir.ui.view">
        <field name="name">real.estate.property.type.view.form</field>
        <field name="model">real.estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(real_estate_property_offer_action_view_state_button)d"
                                type="action"
                                icon="fa-tag">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="offer_count" string="Offers" widget="statinfo"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Property Details">
                            <group>
                                <field name="property_ids">
                                    <list editable="bottom" default_order="expected_price desc">
                                        <field name="name"/>
                                        <field name="expected_price"/>
                                        <field name="stage"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="real_estate_property_type_action_view" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">real.estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
