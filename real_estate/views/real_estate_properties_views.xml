<odoo>

    <record id="real_estate_view_list" model="ir.ui.view">
        <field name="name">real.estate.view.list</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="best_price"/>
                <field name="total_area"/>
            </list>
        </field>
    </record>

    <record id="real_estate_view_form" model="ir.ui.view">
        <field name="name">real.estate.view.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_sold"
                        type="object"
                        string="Sold"
                        class="btn-primary"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        class="btn-secondary"
                    />
                    <field name="stage" widget="statusbar"
                           options="{'clickable': False}"
                           statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="living_area"/>
                            <field name="garden_area"/>
                            <field name="total_area" readonly="1"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="expected_price"/>
                            <field name="best_price" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Extra Info">
                            <group>
                                <group string="Email">
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_orientation"/>
                                </group>
                                <group string="Marketing">
                                    <field name="bedrooms"/>
                                    <field name="bathrooms"/>
                                    <field name="facades"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offer_ids" nolabel="0"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="selling_price" readonly="1"/>
                                <field name="buyer_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_view_search" model="ir.ui.view">
        <field name="name">real.estate.view.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="best_price"/>
                <field name="total_area"/>
                <filter
                    string="Active"
                    name="active_record"
                    domain="[('active', '=', True)]"
                />
                <filter
                    string="Garden orientation"
                    name="name"
                    domain="['|','&amp;',('garden_orientation', '=' , 'north'),
                    ('garden_orientation', '=' , 'south'),
                    ('name', '=' , 'test')]"
                />
                <group>
                    <filter
                        string="Orientation"
                        name="garden_orientation"
                        context="{'group_by': 'garden_orientation'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="real_estate_action_view" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">list,form</field>
          <field name="context">
            {

                'search_default_active_record': 1,
            }
            </field>
    </record>

</odoo>
