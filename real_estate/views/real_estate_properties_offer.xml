<odoo>
    <data>

        <record id="real_estate_property_offer_tree" model="ir.ui.view">
            <field name="name">real.estate.property.offer.tree</field>
            <field name="model">real.estate.property.offer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="price"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="property_id"/>
                </list>
            </field>
        </record>

        <record id="real_estate_property_offer_form" model="ir.ui.view">
            <field name="name">real.estate.property.offer.form</field>
            <field name="model">real.estate.property.offer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="status"/>
                            <field name="property_id"/>
                        </group>
                    </sheet>

                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="real_estate_property_offer_action">
            <field name="name">Property Offer</field>
            <field name="res_model">real.estate.property.offer</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="rreal_estate_property_offer_menu"
                  name="Property Offers"
                  parent="real_estate_main_menu"
                  action="real_estate_property_offer_action"/>


    </data>
</odoo>