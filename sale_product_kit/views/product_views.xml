<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_kit_form_view_inherit_product_template" model="ir.ui.view">
        <field name="name">product.kit.form.inherit.product.template</field>
        <field name="model">product.template</field>
        <field name="priority">5</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="is_kit"/>
                <field name="sub_product_ids" widget='many2many_tags' invisible="not is_kit"/>
            </xpath>
        </field>
    </record>

</odoo>
