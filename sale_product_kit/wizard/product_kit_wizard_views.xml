<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id='product_kit_wizard_view_form' model='ir.ui.view'>
        <field name='name'>product.kit.wizard.form</field>
        <field name='model'>product.kit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="wizard_line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="sub_product_id"/>
                        <field name="quantity"/>
                        <field name="price"/>
                    </list>
                </field>
                <footer>
                    <button string="Add" type="object" name="add_sub_product_value" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
