<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.ClientAction">
        <div class="p-3">
            <div class="d-inline-block">
                <b>Clicks: <ClickValue/></b>
                <button class="btn btn-secondary fa fa-plus ms-1" t-on-click="() => this.clicker.increment(9)"/>
            </div>

            <br/><h1>Bots</h1>

            <div class="d-inline-block" t-if="this.clicker.level >= 1">
                <a><t t-esc="this.clicker.clickBots"/>x Clickbots (10 clicks/10s)</a>
                <button class="btn btn-primary ms-1" t-on-click="() => this.clicker.purchaseClickBot()" t-att-disabled="this.clicker.clicks &lt; 1000">
                    Buy ClickBot (1000)
                </button>
            </div>
        </div>
    </t>
</templates>
