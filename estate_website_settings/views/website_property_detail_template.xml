<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="property_detail_template">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-6">
                        <img
                            src="/web/static/img/placeholder.png"
                            class="img-fluid rounded"
                        />
                    </div>
                    <div class="col-md-6">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <h1>
                                    <t t-esc="property.name"/>
                                </h1>

                                <p class="text-muted">
                                    <t t-esc="property.description"/>
                                </p>

                                <p>
                                    <strong>Expected Price:</strong>
                                    <t t-esc="property.expected_price"/> ₹
                                </p>

                                <p>
                                    <strong>Bedrooms:</strong>
                                    <t t-esc="property.bedrooms"/>
                                </p>

                                <p>
                                    <strong>Living Area:</strong>
                                    <t t-esc="property.living_area"/> sqm
                                </p>

                                <p>
                                    <strong>Seller:</strong>
                                    <t t-esc="property.seller_id.name"/>
                                </p>

                                <p>
                                    <strong>Available From:</strong>
                                    <t t-esc="property.date_availability.strftime('%d %B %Y')"/>
                                </p>
                                <button
                                    id="create_offer_button"
                                    type="button"
                                    class="btn btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#offerModal">
                                    Create Offer
                                </button>

                            </div>

                        </div>

                        <div class="modal fade" id="offerModal" tabindex="-1">

                            <div class="modal-dialog">
                                <div class="modal-content">

                                    <div class="modal-header">
                                        <h5 class="modal-title">
                                            Add Offer for
                                            <t t-out="property.name"/>
                                        </h5>
                                        <button
                                            type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"/>
                                    </div>

                                    <div class="modal-body">

                                        <form method="post"
                                              t-att-action="'/properties/%s/create_offer' % property.id">

                                            <input
                                                type="hidden"
                                                name="csrf_token"
                                                t-att-value="request.csrf_token()"/>

                                            <div class="mb-3">
                                                <label>Name</label>

                                                <input
                                                    type="text"
                                                    class="form-control"
                                                    t-att-value="request.env.user.partner_id.name"
                                                    readonly="readonly"/>
                                            </div>

                                            <div class="mb-3">
                                                <label class="form-label">
                                                    Offer Price
                                                </label>

                                                <input
                                                    type="number"
                                                    name="price"
                                                    class="form-control"
                                                    required="required"/>
                                            </div>

                                            <button
                                                type="submit"
                                                class="btn btn-success">
                                                Submit
                                            </button>

                                            <button
                                                type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">
                                                Cancel
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
