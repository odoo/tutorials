<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_estate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.estate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Real Estate" name="estate">
                    <block title="Real Estate">
                        <setting id="estate_invoicing"
                                help="Generate invoices for sold properties">
                            <field name="module_estate_account"/>
                        </setting>
                        <setting id="estate_auction"
                                help="Enable automated auction management">
                            <field name="module_estate_auction"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
