    <field name="property_id" ref="estate.estate_property_id1"/>
    <field name="price">1000000</field>
    <field name="validity">14</field>
  </record>

  <record id="estate_property_offer_id2" model="estate.property.offer">
    <field name="partner_id" ref="base.res_partner_12"></field>
    <field name="property_id" ref="estate.estate_property_id1"/>
    <field name="price">1500000</field>
    <field name="validity">14</field>
  </record>

  <record id="estate_property_offer_id3" model="estate.property.offer">
    <field name="partner_id" ref="base.res_partner_2"></field>
    <field name="property_id" ref="estate.estate_property_id1"/>
    <field name="price">1500001</field>
    <field name="validity">14</field>
  </record>

  <function model="estate.property.offer" name="accept_offer">
