<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="big_villa_offer_1" model="estate.property.offer">
            <field name="partner_id" ref="azure_interior"/>
            <field name="property_id" ref="estate_property_big_villa"/>
            <field name="price">10000</field>
            <field name="date_deadline" eval="datetime.now() + relativedelta(days=14)"/>
        </record>

        <record id="big_villa_offer_2" model="estate.property.offer">
            <field name="partner_id" ref="azure_interior"/>
            <field name="property_id" ref="estate_property_big_villa"/>
            <field name="price">1500000</field>
            <field name="date_deadline" eval="datetime.now() + relativedelta(days=14)"/>
        </record>

        <record id="big_villa_offer_3" model="estate.property.offer">
            <field name="partner_id" ref="azure_interior"/>
            <field name="property_id" ref="estate_property_big_villa"/>
            <field name="price">1500001</field>
            <field name="date_deadline" eval="datetime.now() + relativedelta(days=14)"/>
        </record>

        <function model="estate.property.offer" name="action_refuse_offer">
            <value eval="[ref('big_villa_offer_1'), ref('big_villa_offer_2')]"/>
        </function>
        <function model="estate.property.offer" name="action_accept_offer">
            <value eval="[ref('big_villa_offer_3')]"/>
        </function>
    </data>
</odoo>