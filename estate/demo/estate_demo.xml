<odoo>
    <record id="estate_property_demo1" model="estate.property">
        <field name="name">Big Villa</field>
        <field name="state">new</field>
        <field name="description">A nice and big villa</field>
        <field name="property_type_id" ref="property_type_residential"/>
        <field name="postcode">12345</field>
        <field name="date_availability">2020-02-02</field>
        <field name="expected_price">1600000</field>
        <field name="bedrooms">6</field>
        <field name="living_area">100</field>
        <field name="facades">4</field>
        <field name="garage">True</field>
        <field name="garden">True</field>
        <field name="garden_area">100000</field>
        <field name="garden_orientation">south</field>
    </record>

    <record id="estate_property_demo2" model="estate.property">
        <field name="name">Trailer home</field>
        <field name="state">cancelled</field>
        <field name="description">Home in a trailer park</field>
        <field name="property_type_id" ref="property_type_residential"/>
        <field name="postcode">54321</field>
        <field name="date_availability">1970-01-01</field>
        <field name="expected_price">100000</field>
        <field name="selling_price">120000</field>
        <field name="bedrooms">1</field>
        <field name="living_area">10</field>
        <field name="facades">4</field>
        <field name="garage">False</field>
    </record>

    <record id="estate_property_demo3" model="estate.property">
        <field name="name">Liege Land</field>
        <field name="state">new</field>
        <field name="description">New land in Liege</field>
        <field name="property_type_id" ref="property_type_land"/>
        <field name="postcode">4000</field>
        <field name="date_availability">2026-11-10</field>
        <field name="expected_price">200000</field>
        <field name="offer_ids" eval="[
            Command.create({
                'partner_id': ref('base.res_partner_12'),
                'price': 180000,
                'validity': 10,
            }),
        ]"/>
    </record>

    <record id="estate_property_offer_demo1" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="property_id" ref="estate_property_demo1"/>
        <field name="price">10000</field>
        <field name="date_deadline" eval="(datetime.now() + relativedelta(days=10)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="estate_property_offer_demo2" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="property_id" ref="estate_property_demo1"/>
        <field name="price">1500000</field>
        <field name="date_deadline" eval="(datetime.now() + relativedelta(days=7)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="estate_property_offer_demo3" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="property_id" ref="estate_property_demo1"/>
        <field name="price">1500001</field>
        <field name="date_deadline" eval="(datetime.now() + relativedelta(days=14)).strftime('%Y-%m-%d')"/>
    </record>

    <function model="estate.property.offer" name="action_accept_offer">
        <value eval="[ref('estate_property_offer_demo3')]"/>
    </function>
</odoo>
