<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="estate_property_type_apartment" model="estate.property.type">
        <field name="name">Apartment</field>
    </record>

    <record id="estate_property_tag_tag1" model="estate.property.tag">
        <field name="name">tag1</field>
    </record>
    <record id="estate_property_tag_tag3" model="estate.property.tag">
        <field name="name">tag3</field>
    </record>
    <record id="estate_property_tag_tag2" model="estate.property.tag">
        <field name="name">tag2</field>
    </record>

    <record id="estate_property_1" model="estate.property">
        <field name="name">Apartment</field>
        <field name="description">Apartment</field>
        <field name="expected_price">12000</field>
        <field name="state">cancelled</field>
        <field name="property_type_id" ref="estate_property_type_apartment"/>
        <field name="tag_ids" eval="[Command.link(ref('estate_property_tag_tag1')),
                                     Command.link(ref('estate_property_tag_tag2')),
                                     Command.link(ref('estate_property_tag_tag3'))]"/>
    </record>

    <record id="estate_property_2" model="estate.property">
        <field name="name">rental house</field>
        <field name="description">house</field>
        <field name="expected_price">12000</field>
        <field name="state">offer_accepted</field>
    </record>

    <record id="estate_property_3" model="estate.property">
        <field name="name">villa</field>
        <field name="description">villa</field>
        <field name="expected_price">12000</field>
        <field name="state">sold</field>
    </record>

    <record id="estate_property_4" model="estate.property">
        <field name="name">duplex</field>
        <field name="description">duplex</field>
        <field name="expected_price">12000</field>
        <field name="state">offer_received</field>
    </record>

    <record id="estate_property_buyer_1" model="res.partner">
        <field name="name">Sampath</field>
    </record>

    <record id="estate_property_buyer_2" model="res.partner">
        <field name="name">htapmas</field>
    </record>

    <record id="estate_property_offer_1" model="estate.property.offer">
        <field name="price">123123123</field>
        <field name="property_id" ref="estate_property_1"/>
        <field name="partner_id" ref="estate_property_buyer_1"/>
    </record>

    <record id="estate_property_offer_2" model="estate.property.offer">
        <field name="price">123123123</field>
        <field name="property_id" ref="estate_property_4"/>
        <field name="partner_id" ref="estate_property_buyer_2"/>
    </record>

    


</odoo>
