<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_property_offer_1" model="estate.property.offer">
        <field name="price">10000</field>
        <field name="validity">14</field>
        <field name="property_id" ref="demo_property_1"/>
        <field name="partner_id" ref="base.res_partner_12"/>
    </record>
    <record id="demo_property_offer_2" model="estate.property.offer">
        <field name="price">1500000</field>
        <field name="validity">14</field>
        <field name="property_id" ref="demo_property_1"/>
        <field name="partner_id" ref="base.res_partner_12"/>
    </record>
    <record id="demo_property_offer_3" model="estate.property.offer">
        <field name="price">1500001</field>
        <field name="validity">14</field>
        <field name="property_id" ref="demo_property_1"/>
        <field name="partner_id" ref="base.res_partner_10"/>
    </record>

    <function model="estate.property.offer" name="action_confirm">
        <value eval="[ref('demo_property_offer_2')]"/>
    </function>

    <function model="estate.property.offer" name="action_refuse">
        <value eval="[ref('demo_property_offer_3'), ref('demo_property_offer_1')]"/>
    </function>


</odoo>