<odoo>
    <record id="10K_offer_big_villa" model="estate.property.offer">
        <field name="property_id" ref="estate.property_big_villa"/>
        <field name="partner_id" ref="base.main_company"/>
        <field name="price">10000</field>
        <field name="validity">14</field>
        <field name="date_deadline" eval="datetime.now()"/>
    </record>

    <record id="mid_offer_big_villa" model="estate.property.offer">
        <field name="property_id" ref="estate.property_big_villa"/>
        <field name="partner_id" ref="base.main_company"/>
        <field name="price">1500000</field>
        <field name="validity">14</field>
        <field name="date_deadline" eval="datetime.now()"/>
    </record>

    <record id="best_offer_big_villa" model="estate.property.offer">
        <field name="property_id" ref="estate.property_big_villa"/>
        <field name="partner_id" ref="base.main_company"/>
        <field name="price">1500001</field>
        <field name="validity">14</field>
        <field name="date_deadline" eval="datetime.now()"/>
    </record>

    <function model="estate.property.offer" name="action_refuse_offer">
        <value eval="[ref('mid_offer_big_villa'), ref('10K_offer_big_villa')]"/>
    </function>

    <function model="estate.property.offer" name="action_accept_offer">
        <value eval="[ref('best_offer_big_villa')]"/>
    </function>

</odoo>
