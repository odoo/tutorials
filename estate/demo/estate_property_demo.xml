<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_big_villa" model="estate.property">
        <field name="name">Big Villa</field>
        <field name="property_type_id" ref="estate_property_type_residential" />
        <field name="state">new</field>
        <field name="description">A nice and big villa</field>
        <field name="postcode">12345</field>
        <field name="date_availability">2020-02-02</field>
        <field name="expected_price">1600000</field>
        <field name="bedrooms">6</field>
        <field name="living_area">100</field>
        <field name="facades">4</field>
        <field name="garage" eval="True" />
        <field name="garden" eval="True" />
        <field name="garden_area">100000</field>
        <field name="garden_orientation">south</field>
    </record>

    <record id="estate_property_trailer_home" model="estate.property">
        <field name="name">Trailer home</field>
        <field name="property_type_id" ref="estate_property_type_residential" />
        <field name="state">canceled</field>
        <field name="description">Home in a trailer park</field>
        <field name="postcode">54321</field>
        <field name="date_availability">1970-01-01</field>
        <field name="expected_price">100000</field>
        <field name="selling_price">120000</field>
        <field name="bedrooms">1</field>
        <field name="living_area">10</field>
        <field name="facades">4</field>
        <field name="garage" eval="False" />
    </record>

    <record id="estate_property_offer_1" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_12" />
        <field name="property_id" ref="estate_property_big_villa" />
        <field name="price">1600000</field>
        <field name="validity">14</field>
    </record>

    <record id="estate_property_offer_2" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_12" />
        <field name="property_id" ref="estate_property_big_villa" />
        <field name="price">1700000</field>
        <field name="validity">14</field>
    </record>

    <record id="estate_property_offer_3" model="estate.property.offer">
        <field name="partner_id" ref="base.res_partner_2" />
        <field name="property_id" ref="estate_property_big_villa" />
        <field name="price">1700001</field>
        <field name="validity">14</field>
    </record>

    <record id="estate_property_townhouse" model="estate.property">
        <field name="name">City Townhouse</field>
        <field name="property_type_id" ref="estate_property_type_residential" />
        <field name="state">new</field>
        <field name="description">Modern townhouse in the city center</field>
        <field name="postcode">1000</field>
        <field name="date_availability"
            eval="(DateTime.today() + relativedelta(days=30)).strftime('%Y-%m-%d')" />
        <field name="expected_price">350000</field>
        <field name="bedrooms">3</field>
        <field name="living_area">140</field>
        <field name="facades">2</field>
        <field name="garage" eval="True" />
        <field name="garden" eval="False" />
        <field name="offer_ids"
            eval="[
            Command.create({
                'partner_id': ref('base.res_partner_12'),
                'price': 350000,
                'validity': 14,
            }),
            Command.create({
                'partner_id': ref('base.res_partner_2'),
                'price': 365000,
                'validity': 14,
            }),
        ]" />
    </record>

    <function name="action_accept" model="estate.property.offer">
        <value eval="[ref('estate_property_offer_1')]" />
    </function>

    <function name="action_refuse" model="estate.property.offer">
        <value eval="[ref('estate_property_offer_2', 'estate_property_offer_3')]" />
    </function>
</odoo>
