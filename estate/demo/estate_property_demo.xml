<odoo>

    <record id="estate_property_demo_1" model="estate.property">
        <field name="name">Villa</field>
        <field name="expected_price">250000</field>
        <field name="living_area">120</field>
        <field name="garden">True</field>
        <field name="garden_area">50</field>
        <field name="state">new</field>
        <field name="property_type_id" ref="property_type_villa"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_luxury')])]"/>
    </record>

    <record id="estate_property_demo_2" model="estate.property">
        <field name="name">Apartment</field>
        <field name="expected_price">150000</field>
        <field name="living_area">80</field>
        <field name="state">offer_received</field>
        <field name="property_type_id" ref="property_type_apartment"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_new')])]"/>
    </record>

    <record id="estate_property_demo_3" model="estate.property">
        <field name="name">Family House</field>
        <field name="expected_price">200000</field>
        <field name="living_area">110</field>
        <field name="state">offer_accepted</field>
        <field name="property_type_id" ref="property_type_house"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_renovated')])]"/>
    </record>

    <record id="estate_property_demo_4" model="estate.property">
        <field name="name">Beach Villa</field>
        <field name="expected_price">500000</field>
        <field name="living_area">200</field>
        <field name="state">sold</field>
        <field name="property_type_id" ref="property_type_villa"/>
        <field name="tag_ids" eval="[(6, 0, [ref('property_tag_luxury')])]"/>
    </record>

    <record id="estate_property_demo_5" model="estate.property">
        <field name="name">Old Town House</field>
        <field name="expected_price">90000</field>
        <field name="living_area">70</field>
        <field name="state">cancelled</field>
        <field name="property_type_id" ref="property_type_house"/>
    </record>

</odoo>