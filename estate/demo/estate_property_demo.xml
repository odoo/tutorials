<odoo>
  <record id="estate_property_big_villa" model="estate.property">
    <field name="name">Big Villa</field>
    <field name="state">new</field>
    <field name="description">A nice and big villa</field>
    <field name="postcode">12345</field>
    <field name="expected_price">1600000</field>
    <field name="selling_price">1440000</field>
    <field name="bedrooms">6</field>
    <field name="living_area">100</field>
    <field name="facades">4</field>
    <field name="garage">True</field>
    <field name="garden">True</field>
    <field name="garden_area">100000</field>
    <field name="garden_orientation">south</field>
    <field name="property_type_id" ref="estate_property_type_residential"/> 
    <field name="date_availability" eval="(DateTime.now() + relativedelta(months=+3)).strftime('%Y-%m-%d')"/>
  </record>

  <record id="estate_property_trailer_home" model="estate.property">
    <field name="name">Trailer home</field>
    <field name="state">canceled</field>
    <field name="description">Home in a trailer park</field>
    <field name="postcode">54321</field>
    <field name="expected_price">100000</field>
    <field name="bedrooms">1</field>
    <field name="living_area">10</field>
    <field name="facades">4</field>
    <field name="garage">False</field>
    <field name="garden">False</field>
    <field name="property_type_id" ref="estate_property_type_residential"/>
    <field name="date_availability" eval="(DateTime.now() + relativedelta(months=+1)).strftime('%Y-%m-%d')"/>
  </record>

  <record id="estate_property_small_villa" model="estate.property">
    <field name="name">Small Villa</field>
    <field name="state">new</field>
    <field name="description">A nice and small villa</field>
    <field name="postcode">12345</field>
    <field name="expected_price">1600000</field>
    <field name="selling_price">1440000</field>
    <field name="bedrooms">6</field>
    <field name="living_area">100</field>
    <field name="facades">4</field>
    <field name="garage">True</field>
    <field name="garden">True</field>
    <field name="garden_area">100000</field>
    <field name="garden_orientation">south</field>
    <field name="property_type_id" ref="estate_property_type_residential"/> 
    <field name="date_availability" eval="(DateTime.now() + relativedelta(months=+3)).strftime('%Y-%m-%d')"/>
    <field name="offer_ids" eval="[
        Command.create({
            'price': 12345,
            'validity': 14,
            'partner_id': ref('base.res_partner_12'),
        }),
        Command.create({
            'price': 54321,
            'validity': 10,
            'partner_id': ref('base.res_partner_6'),
        }),
    ]"/>
  </record>

  <record id="estate_offer_big_villa_10000" model="estate.property.offer">
    <field name="price">10000</field>
    <field name="validity">14</field>
    <field name="partner_id" ref="base.res_partner_12"/>
    <field name="property_id" ref="estate_property_big_villa"/>
  </record>

  <record id="estate_offer_big_villa_15000" model="estate.property.offer">
    <field name="price">15000</field>
    <field name="validity">14</field>
    <field name="partner_id" ref="base.res_partner_12"/>
    <field name="property_id" ref="estate_property_big_villa"/>
  </record>

  <record id="estate_offer_big_villa_1500001" model="estate.property.offer">
    <field name="price">1500001</field>
    <field name="validity">14</field>
    <field name="partner_id" ref="base.res_partner_18"/>
    <field name="property_id" ref="estate_property_big_villa"/>
  </record>
  
  <function model="estate.property.offer" name="action_refuse_offer">
      <value eval="[ref('estate_offer_big_villa_10000')]"/>
  </function>

  <function model="estate.property.offer" name="action_refuse_offer">
      <value eval="[ref('estate_offer_big_villa_15000')]"/>
  </function>

  <function model="estate.property.offer" name="action_accept_offer">
      <value eval="[ref('estate_offer_big_villa_1500001')]"/>
  </function>

</odoo>
