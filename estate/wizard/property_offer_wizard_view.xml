<odoo>

    <record id="view_property_offer_wizard_form" model="ir.ui.view">
        <field name="name">property.offer.wizard.form</field>
        <field name="model">property.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Offer">
                <group>
                    <field name="property_ids" readonly="1"/>
                    <field name="partner_id"/>
                    <field name="price"/>
                    <field name="validity"/>
                </group>

                <footer>
                    <button name="action_create_offer"
                            type="object"
                            string="Done"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
