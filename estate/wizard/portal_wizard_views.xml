<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_view" model="ir.ui.view">
        <field name="name">Offers on Property Type</field>
        <field name="model">offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Offer by Types">
                <group>
                    <field name="property_type_id" />
                    <field name="offer_price" />
                    <field name="partner_id" />
                </group>
            </form>
        </field>
    </record>

    <record id="estate_property_wizard_action" model="ir.actions.act_window">
        <field name="name">Estate Property Wizard</field>
        <field name="res_model">offer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="estate.model_estate_property" />
    </record>
</odoo>
