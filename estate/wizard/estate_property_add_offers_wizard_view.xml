<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_add_offers_wizard_form_view" model="ir.ui.view">
        <field name="name">estate.property.add.offers.wizard.form</field>
        <field name="model">estate.property.add.offers.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Enter property price range">
                        <group>
                            <field name="starting_range" />
                        </group>
                        <group>
                            <field name="ending_range" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create_edit':true, 'no_create':true}"/>
                        </group>
                        <group>
                            <field name="offer_price" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Make offers" name="add_offers" type="object" class="btn btn-primary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="estate_property_add_offers_wizard" model="ir.actions.act_window">
        <field name="name">Add Offers</field>
        <field name="res_model">estate.property.add.offers.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{'search_default_available':True}</field>
        <field name="target">new</field>
    </record>

</odoo>
