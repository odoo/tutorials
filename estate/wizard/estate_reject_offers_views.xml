<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_reject_offers" model="ir.actions.act_window">
        <field name="name">estate.reject.offers</field>
        <field name="res_model">estate.property.reject.offers</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="estate_property_reject_offer_form_view" model="ir.ui.view">
        <field name="name">estate.reject.offer.form.view</field>
        <field name="model">estate.property.reject.offers</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="minimum_price" />
                </group>
                <footer>
                    <button string="reject" name="action_reject_offers" type="object"
                        class="oe_highlight" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
