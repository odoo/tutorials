<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="offer_send_wizard_form" model="ir.ui.view">
            <field name="name">estate.send.offer.wizard.form</field>
            <field name="model">estate.offer.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="property_type_id" />
                        <field name="offer_price" />
                        <field name="customer_id" />
                    </group>
                    <footer>
                        <button
                            string="Create" name="do_action" type="object"
                            class="oe_highlight" data-hotkey="q"
                        />
                        <button
                            string="Cancel" class="btn btn-secondary"
                            special="cancel" data-hotkey="x"
                        />
                    </footer>
                </form>
            </field>
        </record>

        <record id="offer_send_wizard_action" model="ir.actions.act_window">
            <field name="name">Create Mass Order</field>
            <field name="res_model">estate.offer.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_estate_property" />
        </record>
    </data>
</odoo>
