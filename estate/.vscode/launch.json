{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/odoo/odoo-bin",
            "args": [
                "--addons-path=addons,../enterprise/,../tutorials/",
                "-d",
                "rd-demo",
                "-u",
                "estate",
                "--dev",
                "all",
                "--http-interface=127.0.0.1"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
