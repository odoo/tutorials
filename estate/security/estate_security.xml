<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_real_estate" model="ir.module.category">
        <field name="name">Real Estate</field>
        <field name="description">Real Estate Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="res_groups_privilege_real_estate" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="estate.module_category_real_estate"/>
    </record>

    <record id="group_real_estate_agent" model="res.groups">
        <field name="name">Real Estate Agent</field>
        <field name="privilege_id" ref="estate.res_groups_privilege_real_estate"/>
    </record>

    <record id="group_real_estate_manager" model="res.groups">
        <field name="name">Real Estate Manager</field>
        <field name="privilege_id" ref="estate.res_groups_privilege_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('estate.group_real_estate_agent'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_real_estate_maintenance" model="res.groups">
        <field name="name">Real Estate Maintenace</field>
        <field name="privilege_id" ref="estate.res_groups_privilege_real_estate"/>
    </record>
</odoo>
