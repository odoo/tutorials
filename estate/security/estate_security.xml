<odoo>

    <record model="ir.module.category" id="module_category_estate">
        <field name="name">Estate</field>
        <field name="sequence">10</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_estate">
        <field name="name">Estate</field>
        <field name="category_id" ref="estate.module_category_estate"/>
    </record>

    <record id="group_estate_admin" model="res.groups">
        <field name="name">Estate Administrator</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[(4, ref('event.group_event_manager'))]"/>
    </record>

    <record id="group_estate_agent" model="res.groups">
        <field name="name">Estate Agent</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
    </record>

    <record id="group_estate_manager" model="res.groups">
        <field name="name">Estate Manager</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <field name="implied_ids" eval="[(4, ref('event.group_event_user'))]"/>
    </record>

</odoo>
