<odoo>
    <record id="estate_property_rule_portal" model="ir.rule">
        <field name="name">Portal: Own Properties</field>
        <field name="model_id" ref="model_estate_property" />
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
