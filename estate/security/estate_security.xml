<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record model="ir.module.category" id="module_real_estate">
        <field name="name">Estate</field>
        <field name="sequence">90</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_estate">
        <field name="name">Estate</field>

        <field name="category_id" ref="module_real_estate"/>
    </record>

    <record id="group_estate_agent" model="res.groups">
        <field name="name">Real Estate Agent</field>
        <field name="sequence">10</field>


        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>

    </record>

    <record id="group_estate_manager" model="res.groups">
        <field name="name">Estate Manager</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_estate"/>
        <!-- REMOVED: users field - not supported in Odoo 19 -->
        <!-- Admin/root users are automatically included via implied_ids -->
        <!-- You can assign users through Settings > Users & Companies > Groups -->
    </record>

    <!-- ==================== Record Rules ==================== -->

    <data noupdate="1">

        <!-- Manager Full Access Property -->
        <record id="estate_rule_manager_property_all" model="ir.rule">
            <field name="name">Estate Manager Property Full Access</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('estate.group_estate_manager'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Agent Property Access -->
        <record id="estate_rule_agent_property_rw" model="ir.rule">
            <field name="name">Estate Agent Property Read Write</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('estate.group_estate_agent'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Manager Offer Full Access -->
        <record id="estate_rule_manager_offer_all" model="ir.rule">
            <field name="name">Estate Manager Offer Full Access</field>
            <field name="model_id" ref="estate.model_estate_property_offer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('estate.group_estate_manager'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Agent Draft Offer Access -->
        <record id="estate_rule_agent_offer_draft" model="ir.rule">
            <field name="name">Estate Agent Draft Offer Access</field>
            <field name="model_id" ref="estate.model_estate_property_offer"/>
            <field name="domain_force">[('status', '=', False)]</field>
            <field name="groups" eval="[
                (4, ref('estate.group_estate_agent'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Agent Confirmed Offer Access -->
        <record id="estate_rule_agent_offer_confirmed" model="ir.rule">
            <field name="name">Estate Agent Confirmed Offer Access</field>
            <field name="model_id" ref="estate.model_estate_property_offer"/>
            <field name="domain_force">[('status', '=', True)]</field>
            <field name="groups" eval="[
                (4, ref('estate.group_estate_agent'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>

</odoo>