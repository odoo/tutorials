<odoo>

    <record model="ir.module.category" id="module_category_real_estate_brokerage">
        <field name="name">Estate</field>
        <field name="sequence">100</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_agent">
        <field name="name">Role</field>
        <field name="category_id" ref="module_category_real_estate_brokerage"/>
    </record>

    <record id="estate_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id" ref="res_groups_privilege_agent"/>
    </record>

    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_agent"/>
    </record>

    <record id="estate_property_rule_user" model="ir.rule">
        <field name="name">estate.property.user</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="domain_force">[
        '|', ('user_id', '=', user.id),
             ('user_id', '=', False)
    ]</field>
        <field name="groups" eval="[(4, ref('estate_group_user'))]"/>
    </record>

</odoo>
