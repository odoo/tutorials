<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define the Category -->
    <record id="module_category_real_estate_brokerage" model="ir.module.category">
        <field name="name">Real Estate</field>
        <field name="sequence">20</field>
    </record>

    <!-- Real Estate group privilege -->
    <record id="groups_privilege_real_estate"
        model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="category_id"
            ref="base.module_category_real_estate_brokerage" />
    </record>

    <!--  Agent group -->
    <record id="estate_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id"
            ref="groups_privilege_real_estate" />
    </record>

    <!-- Manager group -->
    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id"
            ref="groups_privilege_real_estate" />
        <!--Implied
        ids means pseudo-inherit; also include agent group rights -->
        <field name="implied_ids"
            eval="[Command.link(ref('estate_group_user'))]" />
    </record>

</odoo>