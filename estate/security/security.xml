<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="groups_privilege_real_estate" model="res.groups.privilege">
        <field name="name">Real Estate</field>
        <field name="category_id" ref="base.module_category_real_estate_brokerage" />
    </record>

    <record id="estate_group_agent" model="res.groups">
        <field name="name">Agent</field>
        <field name="privilege_id" ref="groups_privilege_real_estate" />
    </record>

    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="groups_privilege_real_estate" />
        <field name="implied_ids" eval="[(4, ref('estate_group_agent'))]" />
    </record>

    <!-- rules -->
    <record id="estate_property_rule_agent" model="ir.rule">
        <field name="name">Rule which limits agents to only being able to see or modify properties which have no salesperson, or for which they are the salesperson.</field>
        <field name="model_id" ref="estate.model_estate_property" />
        <field name="domain_force">['|', ('salesman_id', '=', user.id), ('salesman_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('estate_group_agent'))]" />
    </record>

    <record id="estate_property_rule_manager" model="ir.rule">
        <field name="name">Manager can see all properties</field>
        <field name="model_id" ref="estate.model_estate_property" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('estate_group_manager'))]" />
    </record>
    <!-- multi company rules -->
    <record id="estate_property_company_rule" model="ir.rule">
        <field name="name">Estate Property Multi-Company Rule</field>
        <field name="model_id" ref="estate.model_estate_property" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>