<odoo>
    <record model="ir.module.category" id="module_category_estate">
            <field name="name">Estate</field>
            <field name="sequence">99</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_estate_users">
        <field name="name">Real Estate User Type</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="estate.module_category_estate"/>
    </record>

    <record id="res_group_estate_manager" model="res.groups">
        <field name="name">Real Estate Manager </field>
        <field name="sequence">101</field>
        <field name="privilege_id" ref="res_groups_privilege_estate_users"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">This user has admin right in the estate app</field> 
    </record>
    <record id="res_group_estate_agent" model="res.groups">
        <field name="name">Real Estate Agent </field>
        <field name="sequence">101</field>
        <field name="privilege_id" ref="res_groups_privilege_estate_users"/>
        <field name="comment">This user has admin right in the estate app</field> 
    </record>
    <record id="rule_limited_read_estate_agent" model="ir.rule">
        <field name="name">Limits estat agent to there own properties</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="perm_read" eval="False"/>
        <field name="groups" eval="[Command.link(ref('estate.res_group_estate_agent'))]"/>
        <field name="domain_force">
            [
            '|', ('seller_id','=', user.id), ('seller_id', '=', False)
            ]
        </field>
    </record>
    <record id="rule_limited_read_estate_company" model="ir.rule">
        <field name="name">Limits estat agent to there own properties in there own companies</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="groups" eval="[Command.link(ref('estate.res_group_estate_agent'))]"/>
        <field name="domain_force">
            [
            ('company_id','=', company_id)
            ]
        </field>
    </record>
</odoo>
