<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="estate_groups_privilege" model="res.groups.privilege">
            <field name="name">Real Estate</field>
            <field name="category_id" ref="base.module_category_real_estate_brokerage"/>
        </record>

        <record id="estate_group_user" model="res.groups">
            <field name="name">Agent</field>
            <field name="privilege_id" ref="estate_groups_privilege"/>
        </record>

        <record id="estate_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="estate_groups_privilege"/>
            <field name="implied_ids" eval="[(4, ref('estate_group_user'))]"/>
        </record>

        <record id="base.menu_apps" model="ir.ui.menu">
            <field name="group_ids" eval="[(6, 0, [ref('estate_group_manager'), ref('base.group_system')])]"/>
        </record>

        <record id="estate_rule_property_agent_own" model="ir.rule">
            <field name="name">Estate properties: agent own or unassigned</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[Command.link(ref('estate.estate_group_user'))]"/>
            <field name="domain_force">['|', ('salesman_id', '=', user.id), ('salesman_id', '=', False)]</field>
        </record>

        <record id="estate_rule_property_manager_all" model="ir.rule">
            <field name="name">Estate properties: manager full access</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
            <field name="groups" eval="[Command.link(ref('estate.estate_group_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <record id="estate_rule_property_multicompany" model="ir.rule">
            <field name="name">Estate properties: multi-company restriction</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
