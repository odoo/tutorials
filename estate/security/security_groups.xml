<?xml version="1.0" encoding="UTF-8"?>
    <odoo>
        <record id="estate_property_option" model="res.groups.privilege">
            <field name="name">Real Estate</field>
        </record>
        <record id="estate.property_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="privilege_id" ref="estate_property_option"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
        <record id="estate.property_agent" model="res.groups">
            <field name="name">Agent</field>
            <field name="privilege_id" ref="estate_property_option"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="estate.property_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="estate_property_option"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="estate.property_maintainance_staff" model="res.groups">
            <field name="name">Maintainance Staff</field>
            <field name="privilege_id" ref="estate_property_option"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </odoo>
