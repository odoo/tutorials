<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_own_records_rule" model="ir.rule">
        <field name="name">estate.property: user: read only own records</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="domain_force">[('salesman_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('estate.group_demo_user'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>