<odoo>
    <template id="report_property_offer_sub">
        <t t-if="property.offer_ids">
            <table class="table table-light table-striped">
                <thead>
                    <tr>
                        <th>Price</th>
                        <th>Partner</th>
                        <th>Validity (days)</th>
                        <th>Deadline</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="offers" t-value="property.mapped('offer_ids')"/>
                    <tr t-foreach="offers" t-as="offer">
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.partner_id"/>
                        </td>
                        <td>
                            <span t-field="offer.validity"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            No offer yet
        </t>
    </template>
    <template id="report_property_offers">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 id="title">
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Expected Price:</strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div>
                            <strong>Salesman:</strong>
                            <span t-field="property.salesperson_id"/>

                        </div>
                        <div>
                            <strong>Status:</strong>
                            <span t-field="property.state"/>

                        </div>
                        <t t-call="estate.report_property_offer_sub">
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="report_estate_property_offer_user_template">
        <t t-foreach="docs" t-as="saleman">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <strong>Saleman :</strong>
                            <span t-field="saleman.name"/>
                        </h2>
                        <t t-foreach="saleman.property_ids" t-as="property">
                            <h3>
                                <span t-field="property.name"/>
                            </h3>
                            <div>
                                <strong>Expected Price:</strong>
                                <span t-field="property.expected_price"/>
                            </div>
                            <div>
                                <strong>Salesman:</strong>
                                <span t-field="property.salesperson_id"/>

                            </div>
                            <div>
                                <strong>Status:</strong>
                                <span t-field="property.state"/>

                            </div>
                            <t t-call="estate.report_property_offer_sub">
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>