<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_property_offers_template">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-if="property.seller_id">
                            <h2>
                                <strong>Salesman: </strong>
                                <span t-field="property.seller_id"/>
                            </h2>
                        </t>
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div>
                            <strong>Status: </strong>
                            <span t-field="property.state"/>
                        </div>
                        <t t-call="estate.report_property_offers_table"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_property_offers_table">
        <t t-set="offers" t-value="property.offer_ids"/>
        <t t-if="offers">
            <table class="table">
                <thead>
                    <tr>
                        <th><strong>Price</strong></th>
                        <th><strong>Partner</strong></th>
                        <th><strong>Validity (days)</strong></th>
                        <th><strong>Deadline</strong></th>
                        <th><strong>Status</strong></th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="offers" t-as="offer">
                        <td>
                            <span t-field="offer.price"/>
                        </td>
                        <td>
                            <span t-field="offer.partner_id"/>
                        </td>
                        <td>
                            <span t-field="offer.validity"/>
                        </td>
                        <td>
                            <span t-field="offer.date_deadline"/>
                        </td>
                        <td>
                            <span t-field="offer.status"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
        <t t-else="">
            <p>This property has no offers yet.</p>
        </t>
    </template>

    <template id="report_user_property_offers_template">
        <t t-foreach="docs" t-as="salesman">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <strong>Properties for: </strong>
                            <span t-field="salesman.name"/>
                        </h2>
                        <t t-if="salesman.property_ids">
                            <div t-foreach="salesman.property_ids" t-as="property">
                                <h3>
                                    <span t-field="property.name"/>
                                </h3>
                                <div>
                                    <strong>Expected Price: </strong>
                                    <span t-field="property.expected_price"/>
                                </div>
                                <div>
                                    <strong>Status: </strong>
                                    <span t-field="property.state"/>
                                </div>
                                <t t-call="estate.report_property_offers_table"/>
                            </div>
                        </t>
                        <t t-else="">
                            <p>This salesperson has no visible properties.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
