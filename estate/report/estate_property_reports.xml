<odoo>
    <record id="estate_property_offers" model="ir.actions.report">
        <field name="name">Estate Property Offers</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate.report_property_offers_template</field>
        <field name="print_report_name">'Estate Property - %s' % (object.name or 'Attendee').replace('/','')</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
