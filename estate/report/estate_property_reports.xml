<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_property_offers" model="ir.actions.report">
        <field name="name">Property Offers Report</field>
        <field name="model">estate_property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate.report_property_offers_document</field>
        <field name="print_report_name">'Property Offers - %s' % (object.name or 'Property').replace('/','')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>

    <record id="report_user_offers" model="ir.actions.report">
        <field name="name">Salesman Offers Report</field>
        <field name="model">res.users</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate.report_user_offers_document</field>
        <field name="print_report_name">'Salesman Offers - %s' % (object.name or 'Salesman').replace('/','')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_type">report</field>
    </record>
</odoo>