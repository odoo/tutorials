<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_offers_table">
        <table class="table">
            <thead>
                <tr>
                    <th>Price</th>
                    <th>Partner</th>
                    <th>Validity</th>
                    <th>Deadline</th>
                    <th>State</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="property.offer_ids" t-as="offer">
                    <td><span t-field="offer.price"/></td>
                    <td><span t-field="offer.partner_id"/></td>
                    <td><span t-field="offer.validity"/></td>
                    <td><span t-field="offer.date_deadline"/></td>
                    <td><span t-field="offer.status"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_property_offers">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Salesperson: </strong>
                            <span t-field="property.salesperson_id"/>
                        </div>
                        <div>
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>

                        <div class="status_container">
                            <strong>Status: </strong>
                            <span t-field="property.state"/>
                        </div>

                        <t t-if="property.offer_ids">
                            <t t-call="estate.report_offers_table"/>
                        </t>

                        <t t-else="">
                            <h2><strong>No offers have been made for this property yet.</strong></h2>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_users_properties">
        <t t-foreach="docs" t-as="user">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        
                        <h1>
                            <strong>Salesperson: </strong>
                            <span t-field="user.name"/>
                        </h1>

                        <t t-if="user.property_ids">
                            <t t-foreach="user.property_ids" t-as="property">
                                
                                <h2>
                                    <span t-field="property.name"/>
                                </h2>

                                <div>
                                    <strong>Expected Price: </strong>
                                    <span t-field="property.expected_price"/>
                                </div>

                                <div>
                                    <strong>Status: </strong>
                                    <span t-field="property.state"/>
                                </div>

                                <t t-if="property.offer_ids">
                                    <t t-call="estate.report_offers_table"/>
                                </t>

                                <t t-else="">
                                    <p>No offers have been made for this property yet.</p>
                                </t>
                                   
                            </t>
                        </t>
                        
                        <t t-else="">
                            <strong>This salesperson has no properties assigned to them.</strong>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
