<odoo>
    <template id="report_property_offers_table">
        <table class="table table-sm table-borderless" >
            <thead>
                <tr>
                    <th><strong>Price</strong></th>
                    <th><strong>Partner</strong></th>
                    <th><strong>Validity (days)</strong></th>
                    <th><strong>Deadline</strong></th>
                    <th><strong>State</strong></th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="offers" t-as="offer">
                    <td>
                        <span t-field="offer.price"/>
                    </td>
                    <td>
                        <span t-field="offer.partner_id"/>
                    </td>
                    <td>
                        <span t-field="offer.validity"/>
                    </td>
                    <td>
                        <span t-field="offer.date_deadline"/>
                    </td>
                    <td>
                        <span t-field="offer.state"/>
                    </td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_property_offers_template">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="property.name"/>
                        </h2>
                        <div>
                            <strong>Salesperson: </strong>
                            <span t-field="property.salesperson"/>
                        </div>
                        <div>
                            <strong>Expected Price: </strong>
                            <span t-field="property.expected_price"/>
                        </div>
                        <div name="status">
                            <strong>Status: </strong>
                            <span t-field="property.state"/>
                        </div>
                        <t t-set="offers" t-value="property.mapped('offer_ids')"/>
                        <div t-if="offers">
                            <t t-call="estate.report_property_offers_table"/>
                        </div>
                        <div t-else="">
                            <strong>No offer for this property.</strong>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
