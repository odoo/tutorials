<odoo>
    <template id="report_estate_property_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Property Report</h2>
                        <p>
                            <strong>Name:</strong>
                            <span t-field="o.name"/>
                        </p>
                        <p>
                            <strong>Description:</strong>
                            <span t-field="o.description"/>
                        </p>
                        <p>
                            <strong>Property Type:</strong>
                            <span t-field="o.property_type_id.name"/>
                        </p>
                        <p>
                            <strong>Bedrooms:</strong>
                            <span t-field="o.bedrooms"/>
                        </p>
                        <p>
                            <strong>Living Area:</strong>
                            <span t-field="o.living_area"/> m²
                        </p>
                        <p>
                            <strong>Expected Price:</strong>
                            <span t-field="o.expected_price"/>
                        </p>
                        <p>
                            <strong>Status:</strong>
                            <span t-field="o.state"/>
                        </p>
                        <h3>Tags</h3>
                        <ul>
                            <t t-foreach="o.tag_ids" t-as="tag">
                                <li>
                                    <span t-field="tag.name"/>
                                </li>
                            </t>
                        </ul>
                        <h3>Offers</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Buyer</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.offer_ids" t-as="offer">
                                    <tr>
                                        <td>
                                            <span t-field="offer.partner_id.name"/>
                                        </td>
                                        <td>
                                            <span t-field="offer.price"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
