<odoo>
    <template id="report_property_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="o.name" />
                        </h2>

                        <div class="row mt32 mb32">
                            <div class="col-3">
                                <strong>Expected Price</strong>
                                <p t-field="o.expected_price" />
                            </div>
                            <div class="col-3">
                                <strong>Selling Price</strong>
                                <p t-field="o.selling_price" />
                            </div>
                            <div class="col-3">
                                <strong>Status</strong>
                                <p t-field="o.state" />
                            </div>
                            <div class="col-3">
                                <strong>Salesperson</strong>
                                <p t-field="o.salesperson_id" />
                            </div>
                        </div>

                        <div class="mt32">
                            <h3>Offers</h3>

                            <t t-if="o.offer_ids">
                                <table class="table table-sm mt16">
                                    <thead>
                                        <tr>
                                            <th>Price</th>
                                            <th>Partner</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.offer_ids" t-as="offer">
                                            <td>
                                                <span t-field="offer.price" />
                                            </td>
                                            <td>
                                                <span t-field="offer.partner_id" />
                                            </td>
                                            <td>
                                                <span t-field="offer.status" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-else="">
                                <div class="alert alert-info mt16">
                                    <strong>No offers have been made for this property yet.</strong>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
