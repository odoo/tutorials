<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="table_estate_offers">
        <t t-name="estate.table_estate_offers">
            <tr t-foreach="property.offer_ids" t-as="offer">
                <td>
                    <span t-field="offer.price" />
                </td>
                <td>
                    <span t-field="offer.partner_id" />
                </td>
                <td>
                    <span t-field="offer.status" />
                </td>
            </tr>
        </t>
    </template>

    <template id="report_property_offers">
        <t t-foreach="docs" t-as="property">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="bg-info text-light p-1">
                            <span t-field="property.name" />
                        </h2>
                        <div class="row mt16">
                            <div class="col-4">
                                <strong>Status:</strong>
                                <span t-field="property.state" />
                            </div>
                            <div class="col-4">
                                <strong>Expected Price:</strong>
                                <span t-field="property.expected_price" />
                            </div>
                            <div class="col-4">
                                <strong>Selling Price:</strong>
                                <span t-field="property.selling_price" />
                            </div>
                        </div>
                        <div class="mt16">
                            <strong>Salesperson:</strong>
                            <span t-field="property.salesperson_id" />
                        </div>
                        <div class="mt16">
                            <strong>Buyer:</strong>
                            <span t-field="property.buyer_id" />
                        </div>
                        <t t-if="property.offer_ids">
                            <h3 class="mt32">Offers</h3>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Price</th>
                                        <th>Buyer</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-call="estate.table_estate_offers" />
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="mt16">
                                No offers have been submitted for this property yet.
                            </p>
                        </t>
                    </div>
                </t>
            </t>

        </t>
    </template>

    <template id="report_user_properties">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="user">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2> Properties handled by <span t-field="user.name" />
                        </h2>
                        <t t-set="properties"
                            t-value="env['estate.property'].search([('salesperson_id','=',user.id)])" />
                        <t t-if="properties">
                            <t t-foreach="properties" t-as="property">
                                <h3 class="mt16">
                                    <span t-field="property.name" />
                                </h3>
                                <p> Expected Price: <span t-field="property.expected_price" />
                                </p>
                                <p> Selling Price: <span t-field="property.selling_price" />
                                </p>
                                <t t-if="property.offer_ids">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Price</th>
                                                <th>Buyer</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-call="estate.table_estate_offers" />
                                        </tbody>
                                    </table>
                                </t>
                            </t>
                        </t>
                        <t t-else="">
                            <p>No properties assigned.</p>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
