<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_tag_list_view" model="ir.ui.view">
        <field name="name">estate.property.tag.list</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="estate_tag_form_view" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
        <form string="Test">
            <sheet>
                <h1 class="mb32">
                    <field name="name"/>
                </h1>
            </sheet>
        </form>
        </field>
    </record>

    <record id="estate_properties_tag_view_search" model="ir.ui.view">
        <field name="name">estate.property.tag.view.search</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
            </search>
        </field>
    </record> 

    <record id="test_model_action2" model="ir.actions.act_window">
        <field name="name">Property tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>