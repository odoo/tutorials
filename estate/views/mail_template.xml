<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_template_property_sold" model="mail.template">
        <field name="name">Property: Sold Notification</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="subject">Property Sold: {{ object.name }}</field>
        <field name="email_from">{{ user.email_formatted }}</field>
        <field name="partner_to">{{ object.buyer.id }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.buyer.name"/>,</p>
                <p>Congratulations! The property <strong><t t-out="object.name"/></strong> has been successfully marked as sold.</p>
            </div>
        </field>
    </record>

</odoo>
