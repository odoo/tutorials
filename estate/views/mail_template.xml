<?xml version='1.0' encoding='utf-8'?>

<odoo>
    <record id="mail_template_offer_accepted" model="mail.template">
        <field name="name">Mail Group: Mailing offer accepted</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="use_default_to" eval="False"/>
        <field name="subject">Offer accepted</field>
        <field name="description">Offer accepted</field>
        <field name="email_to">{{ object.buyer_id.email }}</field>
        <field name="email_from">vishwassinhvihol@gmail.com</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                Hello,
                <br/>
                    Your offer is accepted <strong t-out="object.name or ''"></strong>.
                <br/>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
