<?xml version='1.0' encoding='utf-8'?>

<odoo>
    <record id="mail_template_offer_accepted" model="mail.template">
        <field name="name">Property: Offer Accepted</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="subject">Congratulations! Your offer for {{ object.name }} was accepted</field>
        <field name="email_to">{{ object.buyer_id.email }}</field>
        <field name="body_html" type="html">
            <div style="font-family: sans-serif; font-size: 14px; color: #333;">
                <p>Hello <strong t-out="object.buyer_id.name"></strong>,
                </p>

                <p>We are excited to inform you that your offer for <strong t-out="object.name "></strong> has been <strong>Accepted</strong>!
                </p>
                <p>
                    <strong t-out="object.selling_price">Agreed Price:</strong>
                </p>

                <p>Our team will reach out shortly with the next steps for the legal documentation.</p>

                <p style="margin-top: 24px;">
                    Best regards,<br/>
                <strong t-out="object.salesperson_id.name or 'The Real Estate Team'"></strong>
            </p>
        </div>
    </field>
</record>
</odoo>
