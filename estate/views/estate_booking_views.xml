<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">estate.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_booking_view_list" model="ir.ui.view">
        <field name="name">estate.booking.view.list</field>
        <field name="model">estate.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="booking_number"/>
                <field name="booking_date"/>
                <field name="expiry_date"/>
                <field name="property_id"/>
                <field name="buyer_id"/>
                <field name="final_price" sum="Total Price"/>
                <field name="total_paid_amount" sum="Total Paid"/>
                <field name="remaining_amount" sum="Total Remaining"/>
                <field name="booking_status" widget="badge" decoration-info="booking_status == 'pending'" decoration-success="booking_status in ('booked', 'completed')" decoration-danger="booking_status == 'expired'" decoration-muted="booking_status == 'cancelled'"/>
                <field name="payment_status" widget="badge" decoration-danger="payment_status == 'pending'" decoration-warning="payment_status == 'partial'" decoration-success="payment_status in ('booking_paid', 'fully_paid')"/>
            </list>
        </field>
    </record>

    <record id="estate_booking_view_form" model="ir.ui.view">
        <field name="name">estate.booking.view.form</field>
        <field name="model">estate.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register_payment" string="Register Payment" type="object" class="oe_highlight" invisible="booking_status not in ('pending', 'booked')"/>
                    <button name="action_cancel" string="Cancel Booking" type="object" invisible="booking_status in ('completed', 'cancelled', 'expired')" confirm="Are you sure you want to cancel this booking?"/>
                    <field name="booking_status" widget="statusbar" statusbar_visible="pending,booked,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="booking_number" placeholder="New"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="buyer_email"/>
                        </group>
                        <group>
                            <field name="seller_id"/>
                            <field name="seller_contact"/>
                        </group>
                        <group>
                            <field name="booking_date"/>
                            <field name="expiry_date"/>
                        </group>  
                    </group>
                    <group>
                        <group>
                            <field name="final_price"/>
                            <field name="booking_percentage"/>
                            <field name="booking_amount"/>
                        </group>
                    <group>
                            <field name="total_paid_amount"/>
                            <field name="remaining_amount"/>
                            <field name="payment_status" widget="badge" decoration-danger="payment_status == 'pending'" decoration-warning="payment_status == 'partial'" decoration-success="payment_status in ('booking_paid', 'fully_paid')"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
</odoo>
