<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_booking_list"
        model="ir.ui.view">
        <field name="name">estate.property.booking.list</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <list create="0" edit="0"
                decoration-danger="state == 'cancel'"
            >
                <field name="name" />
                <field name="property_id"
                    domain="[('state', '=', 'offer_accepted')]"
                    options="{'no_create': True}" />

                <field name="partner_id" />
                <field name="sold_price" />
                <field name="booking_amount" />
                <field name="remaining_amount" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="estate_property_booking_form" model="ir.ui.view">
        <field name="name">estate.property.booking.form</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button
                        name="action_pay_booking_amount"
                        type="object"
                        string="Pay Booking Amount"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_pay_remaining_amount"
                        type="object"
                        string="Pay Remaining Amount"
                        class="btn-primary"
                        invisible="state != 'booked'"
                    />
                    <button
                        name="action_cancel_booking"
                        type="object"
                        string="Cancel Booking"
                        class="btn-secondary"
                        invisible="state in ('done','cancel')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,booked,done,cancel"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" readonly="1" />
                            <field name="partner_id" readonly="1" />
                            <field name="booking_date" />
                        </group>
                        <group>
                            <field name="sold_price" readonly="1" />
                            <field name="booking_amount" readonly="1" />
                            <field name="remaining_amount" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payment_ids"
                                readonly="state == 'cancel' or property_id.state == 'cancelled'">
                                <list>
                                    <field name="name" />
                                    <field name="payment_type" />
                                    <field name="amount" />
                                    <field name="payment_method" />
                                    <field name="payment_date" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_estate_property_booking"
        model="ir.actions.act_window">
        <field name="name">Property Bookings</field>
        <field name="res_model">estate.property.booking</field>
        <field name="view_mode">list,form</field>

    </record>
</odoo>
