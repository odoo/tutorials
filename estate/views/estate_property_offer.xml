<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_search" model="ir.ui.view">
        <field name="name">estate.property.offer.view.search</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <search string="Search Offers">
                <field name="property_id" />
                <field name="partner_id" />
                <separator />
                <group>
                    <filter string="Partner" name="partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Property" name="property" context="{'group_by':'property_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <div class="oe_title">
                        <h2 class="mb16">
                            <field name="price" />
                        </h2>
                    </div>
                    <group>
                        <field name="property_id" />
                        <field name="partner_id" />
                        <field name="deadline" />
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" sample="1">
                <field name="price" />
                <field name="status" />
                <field name="property_id" />
                <field name="partner_id" />
                <field name="deadline" widget="remaining_days"/>
                <field name="deadline" string="Date" />
            </list>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
