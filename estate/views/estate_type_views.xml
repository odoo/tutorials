<odoo>

    <!-- Action for stat button: filters offers by the current property type -->
    <record id="estate_offer_action_by_type" model="ir.actions.act_window">
        <field name="name">Estate Offers</field>
        <field name="res_model">estate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="estate_type_action" model="ir.actions.act_window">
        <field name="name">Estate Types</field>
        <field name="res_model">estate.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_type_list_view" model="ir.ui.view">
        <field name="name">Estate Types List</field>
        <field name="model">estate.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="estate_type_form_view" model="ir.ui.view">
        <field name="name">Estate Types Form</field>
        <field name="model">estate.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="%(estate_offer_action_by_type)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-money"
                        >
                            <field name="offer_count" widget="statinfo" string="Offers"/>
                        </button>
                    </div>
                    <group>
                        <h1>
                            <field name="name" />
                        </h1>
                    </group>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids">
                                <list>
                                    <field name="name" string="Title" />
                                    <field name="expected_price" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
