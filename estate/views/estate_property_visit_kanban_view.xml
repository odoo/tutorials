<?xml version="1.0"?>
<odoo>
    <record id="estate_property_visit_kanban_view" model="ir.actions.act_window">
        <field name="name">Real-estate Property"s</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,form,list</field>
    </record>
    <record id="model_name_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <field class="fw-bolder" name="name"/>
                            </div>
                            <div class="col-4 text-end">
                                <strong>type: </strong>
                                <field class="badge rounded-pill" name="property_type_id"/>
                            </div>
                        </div>
                        <div>
                        <t t-if="record.state.raw_value=='offer accepted'">
                            <div>
                                <strong>selling price: </strong>
                                <field name="selling_price"/>
                            </div>
                        </t>
                            
                        <t t-if="record.state.raw_value=='offer received'">
                            <div>
                            <strong>expected: </strong>
                            <field name="expected_price"/>
                            </div>
                        </t>

                            <div>
                            <strong>max offer: </strong>
                            <field name="max_offer_price"/>
                            </div>
                        </div>
                        <div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                    <t t-name="new">
                        </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>