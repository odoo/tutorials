<?xml version="1.0"?>
<odoo>
    <record id="estate_offer_list" model="ir.ui.view">
        <field name="name">Offers</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price" />
                <field name="partner_id" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="estate_offer_form" model="ir.ui.view">
        <field name="name">Offers</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="price" />
                        <field name="partner_id" />
                        <field name="status" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
