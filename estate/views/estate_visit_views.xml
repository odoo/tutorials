<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_visit_action" model="ir.actions.act_window">
        <field name="name">Property Visits</field>
        <field name="res_model">estate.visit</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule a new property visit!
            </p>
            <p>
                Manage property visit time slots, customers, assigned agents, and ratings.
            </p>
        </field>
    </record>

    <record id="estate_visit_view_list" model="ir.ui.view">
        <field name="name">estate.visit.view.list</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <list string="Property Visits">
                <field name="property_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <field name="date_time"/>
                <field name="rating"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'scheduled'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="estate_visit_view_form" model="ir.ui.view">
        <field name="name">estate.visit.view.form</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <form string="Property Visit">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,completed,cancelled" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="property_id" placeholder="Select Property..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="agent_id"/>
                        </group>
                        <group>
                            <field name="date_time"/>
                            <field name="rating"/>
                        </group>
                    </group>
                    <group string="Feedback &amp; Notes">
                        <field name="feedback" placeholder="Enter visit feedback or notes here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_visit_view_calendar" model="ir.ui.view">
        <field name="name">estate.visit.view.calendar</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <calendar string="Property Visits" date_start="date_time" color="property_id">
                <field name="property_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="estate_visit_view_search" model="ir.ui.view">
        <field name="name">estate.visit.view.search</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <search string="Property Visits">
                <field name="property_id"/>
                <field name="customer_id"/>
                <field name="agent_id"/>

                <filter name="state_scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="state_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <separator/>

                <group>
                    <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_by_agent" string="Agent" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
