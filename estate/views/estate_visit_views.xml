<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <record id="estate_visit_view_list" model="ir.ui.view">
        <field name="name">estate.visit.list</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <list string="Property Visits">
                <field name="property_id"/>
                <field name="visitor_id"/>
                <field name="start_time" string="Visit Date"/>
                <field name="status"/>
                <field name="salesperson_id"/>
                <field name="reminder_sent"/>
            </list>
        </field>
    </record>


    <record id="estate_visit_view_form" model="ir.ui.view">
        <field name="name">estate.visit.form</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <form string="Property Visits">
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="visitor_id"/>
                        <field name="start_time"/>
                        <field name="status"/>
                        <field name="salesperson_id"/>
                        <field name="reminder_sent"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="estate_calendar_view" model="ir.ui.view">
        <field name="name">estate.visit.calendar</field>
        <field name="model">estate.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="start_time" date_stop="end_time" color="salesperson_id">
                <field name="property_id" string="Property Name"/>
                <field name="visitor_id"/>
                <field name="start_time"/>
                <field name="status"/>
                <field name="salesperson_id"/>
            </calendar>
        </field>
    </record>


    <record id="estate_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">estate.visit</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
</odoo>
