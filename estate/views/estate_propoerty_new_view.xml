<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_new_action" model="ir.actions.act_window">
        <field name="name">Create Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">form</field>
    </record>

    <record id="estate_property_new_form" model="ir.ui.view">
        <field name="name">estate.property.new.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="tag_ids"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string ="Description">
                            
                            <field name="description"/>
                            <group>
                            <group>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="bedrooms"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="active"/>
                            </group>
                            </group>
                        </page>
                        <page string ="Offers">
                            <field name="offer_ids">
                                <list string="Offers" editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                </list> 
                            </field>
                        </page>

                        <page string= "Other Information">
                            <group>
                            <group>
                                <field name="garage"/>
                                <field name="total_area"/>
                            </group>
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
