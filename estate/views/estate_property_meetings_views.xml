<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="estate_property_meeting_view_list" model="ir.ui.view">
        <field name="name">estate.property.meeting.list</field>
        <field name="model">estate.property.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"></field>
                <field name="property_id" />
                <field name="meeting_date" />
            </list>
        </field>
    </record>

    <record id="estate_property_meeting_view_form" model="ir.ui.view">
        <field name="name">estate.property.meeting.form</field>
        <field name="model">estate.property.meeting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="done"
                        type="object"
                        string="Done"
                        class="btn-primary"
                        invisible="state != 'schedule'" />

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="new,schedule,done,cancelled"
                        options="{'clickable': '1'}"
                    />
                </header>

                <sheet>
                    <group>
                        <field name="property_id" />
                        <field name="meeting_date" />
                        <field name="state" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_meeting_view_calendar" model="ir.ui.view">
        <field name="name">estate.property.meeting.calendar</field>
        <field name="model">estate.property.meeting</field>
        <field name="arch" type="xml">
            <calendar string="Meetings"
                date_start="meeting_date"
                color="property_id">
                <field name="property_id" />
                <field name="meeting_date" />
            </calendar>
        </field>
    </record>

    <record id="estate_property_meeting_action" model="ir.actions.act_window">
        <field name="name">Meetings</field>
        <field name="res_model">estate.property.meeting</field>
        <field name="view_mode">list,form,calendar</field>

    </record>
</odoo>
