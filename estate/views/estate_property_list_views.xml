<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="estate_property_view_list" model="ir.ui.view">
    <field name="name">estate.property.view.list</field>
    <field name="model">estate.property</field>
    <field name="arch" type="xml">
      <list string="Properties">
        <field name="name" string="Title"/>
        <field name="postcode" string="Postcode"/>
        <field name="bedrooms" string="Bedrooms"/>
        <field name="living_area" string="Area (sqm)"/>
        <field name="expected_price" widget="monetary"/>
        <field name="selling_price" widget="monetary"/>
        <field name="date_availability" string="Available"/>
      </list>
    </field>
  </record>
</odoo>
