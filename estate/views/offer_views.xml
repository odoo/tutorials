<?xml version="1.0" ?>
<odoo>

    <!-- ACTIONS -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">estate.property.offer action</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- VIEWS -->
    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list
                    decoration-success="status == 'accepted'"
                    decoration-danger="status == 'refused'"
            >
                <field name="partner_id"/>
                <field name="price"/>
                <field name="status"/>
                <field name="date_deadline"/>
                <button name="action_set_accepted"
                        title="Accept offer"
                        icon="fa-check"
                        type="object"
                        invisible="status != False"
                />
                <button name="action_set_refused"
                        title="Refuse offer"
                        icon="fa-close"
                        type="object"
                        invisible="status != False"
                />
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="estate.property.offer">
                <header>
                    <button name="action_set_accepted"
                            icon="fa-check"
                            class="oe_highlight"
                            type="object"
                            string="Accept"
                            invisible="not id or status != False"
                    />
                    <button name="action_set_refused"
                            icon="fa-close"
                            class=""
                            type="object"
                            string="Refuse"
                            invisible="not id or status != False"
                    />
                </header>
                <sheet>

                    <group>
                        <field name="property_name" string="Property Title"/>
                        <field name="property_type_name" string="Type"/>
                        <field name="property_price" string="Expected Price"/>
                        <field name="property_postcode" string="Postcode"/>
                    </group>

                    <group>
                        <group>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="date_deadline"/>
                            <field name="validity"/>
                        </group>
                    </group>
                    <group>
                        <field name="status"
                               invisible="not id"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
