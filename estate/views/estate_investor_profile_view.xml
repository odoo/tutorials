<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Form View -->
    <record id="estate_property_investor_view_form" model="ir.ui.view">
        <field name="name">estate.property.investor.view.form</field>
        <field name="model">estate.property.investor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_investor_view_list" model="ir.ui.view">
        <field name="name">estate.property.investor.view.list</field>
        <field name="model">estate.property.investor</field>
        <field name="arch" type="xml">
            <list editable='bottom'>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action window -->
    <record id="estate_property_investor_action" model="ir.actions.act_window">
        <field name="name">Property investors</field>
        <field name="res_model">estate.property.investor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
