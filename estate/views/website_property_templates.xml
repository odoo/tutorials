<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="properties_page_template" name="Estate Properties">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4">
                <h1 class="mb-4 fw-bold">Estate Properties</h1>

                <form method="get" action="/properties" class="card card-body mb-4 shadow-sm">
                    <div class="row g-3 align-items-end">
                        
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Sale Mode</label>
                            <select name="sale_mode" class="form-select">
                                <option value="all" t-att-selected="selected_sale_mode == 'all'">All Modes</option>
                                <option value="regular" t-att-selected="selected_sale_mode == 'regular'">Regular</option>
                                <option value="auction" t-att-selected="selected_sale_mode == 'auction'">Auction</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Min Price</label>
                            <input type="number" name="min_price" class="form-control" placeholder="Min Price" t-att-value="min_price"/>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Max Price</label>
                            <input type="number" name="max_price" class="form-control" placeholder="Max Price" t-att-value="max_price"/>
                        </div>

                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>

                    </div>
                </form>

                <div class="row g-4">
                    <t t-if="properties">
                        <t t-foreach="properties" t-as="property">
                            <div class="col-md-4">
                                <div class="card h-100 shadow-sm border-0">
                                    
                                    <img src="/web/static/img/placeholder.png" class="card-img-top object-fit-cover" style="height: 200px;"/>
                                    
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="card-title fw-bold mb-0" t-out="property.name"/>
                                            <span t-if="property.sale_mode == 'auction'" class="badge bg-warning text-dark">Auction</span>
                                        </div>

                                        <p class="card-text text-muted mb-3">
                                            Expected Price: <strong t-out="property.expected_price"/>
                                        </p>

                                        <div class="mt-auto">
                                            <a t-attf-href="/properties/#{property.id}" class="btn btn-outline-primary w-100">
                                                View Details
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </t>
                    </t>

                    <t t-else="">
                        <div class="col-12 text-center py-5">
                            <h4 class="text-muted">No properties found matching your filter criteria.</h4>
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <template id="properties_detail_template" name="Property Details">
        <t t-call="website.layout">
            <div id="wrap" class="container py-4">
                <div t-if="request.params.get('offer_submitted')" class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    Your offer has been submitted successfully!
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="fw-bold mb-1" t-out="property.name"/>
                        <p class="text-muted mb-0" t-out="property.description"/>
                    </div>
                    <div t-if="property.sale_mode == 'auction' and property.auction_end_time" class="text-end">
                        <span class="js_auction_timer fs-2 fw-bold text-primary" t-att-data-auction-end="property.auction_end_time"/>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-5">
                        <img src="/web/static/img/placeholder.png" class="img-fluid rounded shadow-sm w-100" style="max-height: 400px; object-fit: cover;"/>
                    </div>
                    <div class="col-md-7">
                        <ul class="list-group list-group-flush fs-5 mb-4">
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>Expected Price:</strong> <span t-out="property.expected_price"/>
                            </li>
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>Bedrooms:</strong> <span t-out="property.bedrooms"/>
                            </li>
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>Living Area:</strong> <span t-out="property.living_area"/> m²
                            </li>
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>State:</strong> <span t-out="dict(property._fields['state'].selection).get(property.state) or property.state"/>
                            </li>
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>Salesperson:</strong> <span t-out="property.salesperson_id.name"/>
                            </li>
                            <li class="list-group-item bg-transparent ps-0">
                                <strong>Available from:</strong> <span t-out="property.date_availability"/>
                            </li>
                        </ul>

                        <a t-attf-href="/properties/#{property.id}/offer" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                            create offer
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="property_create_offer_template" name="Add Offer">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-6">
                        <div class="card shadow-sm border-0 p-4 rounded-3">
                            <h2 class="text-center mb-4 fw-bold">Add Offer for <t t-out="property.name"/></h2>
                            <form action="/property/offer/submit" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="property_id" t-att-value="property.id"/>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">name :</label>
                                    <input type="text" class="form-control" t-att-value="partner.name" readonly="readonly"/>
                                </div>

                                <div class="mb-4">
                                    <label for="amount" class="form-label fw-semibold">amount:</label>
                                    <input type="number" step="0.01" class="form-control" id="amount" name="price" placeholder="Enter amount" required="required"/>
                                </div>

                                <div class="d-flex justify-content-center gap-3">
                                    <button type="submit" class="btn btn-primary px-4 rounded-pill">Submit</button>
                                    <a t-attf-href="/properties/#{property.id}" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="property_offer_success_template" name="Offer Placed Success">
        <t t-call="website.layout">
            <div id="wrap" class="container py-5 text-center">
                <div class="card shadow-sm border-0 p-5 mx-auto rounded-3" style="max-width: 650px;">
                    <div class="mb-3 text-success fs-1">
                        <i class="fa fa-check-circle"/>
                    </div>
                    <h4 class="fw-bold mb-4 text-dark lh-base">
                        Congratulations! Your offer has been successfully placed. We will notify you of the results as soon as the auction concludes
                    </h4>
                    <div class="mt-2">
                        <a t-if="property" t-attf-href="/properties/#{property.id}" class="btn btn-primary px-4 rounded-pill">Back to Property</a>
                        <a href="/properties" class="btn btn-outline-secondary px-4 rounded-pill ms-2">View All Properties</a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
