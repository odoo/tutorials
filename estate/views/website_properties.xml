<odoo>

    <template id="website_properties" name="Estate Shop">
        <t t-call="website.layout">
            <div class="container">
                <t t-call="website.website_search_box_input">
                    <t t-set="search" t-value="search" />
                </t>
                <div class="row">
                    <t t-foreach="properties" t-as="property">
                        <div class="col m-2">
                            <div class="card ">
                                <img t-attf-src="/web/image/estate.property/#{property.id}/image"
                                    class="card-img-top" />
                                <div class="card-body">
                                    <h6 class="card-title">
                                        <t t-esc="property.name" />
                                    </h6>
                                    <t t-esc="property.expected_price" />
                                    <small>
                                        <t t-esc="property.bedrooms" /> Bedrooms </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="d-flex justify-content-center mt-4">
                    <t t-call="website.pager" />
                </div>
            </div>
        </t>
    </template>

</odoo>
