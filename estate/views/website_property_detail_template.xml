<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="property_detail_template">
        <t t-call="website.layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-6">
                        <img
                            src="/web/static/img/placeholder.png"
                            class="img-fluid rounded"
                        />
                    </div>

                    <div class="col-md-6">
                        <h1>
                            <t t-esc="property.name"/>
                        </h1>
                        <p class="text-muted">
                            <t t-esc="property.description"/>
                        </p>
                        <p>
                            <strong>Expected Price:</strong>
                            <t t-esc="property.expected_price"/> ₹
                        </p>
                        <p>
                            <strong>Bedrooms:</strong>
                            <t t-esc="property.bedrooms"/>
                        </p>
                        <p>
                            <strong>Living Area:</strong>
                            <t t-esc="property.living_area"/> sqm
                        </p>
                        <p>
                            <strong>Total Area:</strong>
                            <t t-esc="property.total_area"/> sqm
                        </p>
                        <p>
                            <strong>Garden:</strong>
                            <t t-esc="property.garden"/>
                        </p>
                        <p t-if="property.garden">
                            <strong>Garden Area:</strong>
                            <t t-esc="property.garden_area"/> sqm
                        </p>
                        <p t-if="property.garden">
                            <strong>Garden Orientation:</strong>
                            <t t-esc="property.garden_orientation"/>
                        </p>
                        <p>
                            <strong>Property Type:</strong>
                            <t t-esc="property.property_type_id.name"/>
                        </p>
                        <p>
                            <strong>Seller:</strong>
                            <t t-esc="property.seller_id.name"/>
                        </p>
                        <p>
                            <strong>Available From:</strong>
                            <t t-esc="property.date_availability"/>
                        </p>
                        <p>
                            <strong>State:</strong>
                            <t t-esc="property.state"/>
                        </p>
                        <button
                            type="button"
                            class="btn btn-primary mt-3">
                            Create Offer
                        </button>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
