<?xml version="1.0"?>
<odoo>
    <!-- Root menu -->
    <menuitem
        id="estate_menu"
        name="Real Estate"/>

    <!-- Advertisements menu -->
    <menuitem
        id="estate_property_menu"
        name="Advertisements"
        parent="estate_menu"
        sequence="1"/>

    <menuitem
        id="estate_property_menu_action"
        action="estate_property_action_view_list"
        parent="estate_property_menu"
        sequence="1"/>

    <!-- Settings menu -->
    <menuitem
        id="estate_settings_menu"
        name="Settings"
        parent="estate_menu"
        sequence="2"/>

    <menuitem
        id="estate_settings_menu_types"
        action="estate_property_type_action_view_list"
        parent="estate_settings_menu"
        sequence="1"/>

    <menuitem
        id="estate_settings_menu_tags"
        action="estate_property_tag_action_view_list"
        parent="estate_settings_menu"
        sequence="2"/>

</odoo>
