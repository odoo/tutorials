<odoo>
    <record id="estate_property_issue_action" model="ir.actions.act_window">
        <field name="name">Property Issue</field>
        <field name="res_model">estate.property.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_issue_view_list" model="ir.ui.view">
        <field name="name">estate.property.issue.view.list</field>
        <field name="model">estate.property.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="issue_type"/>
                <field name="priority"/>
                <field name="buyer_id"/>
                <field name="salesman_id"/>
                <field name="staty"/>
                <field name="resolved_date"/>
            </list>
        </field>
    </record>

    <record id="estate_property_issue_view_form" model="ir.ui.view">
        <field name="name">estate.property.issue.view.form</field>
        <field name="model">estate.property.issue</field>
        <field name="arch" type="xml">
            <form>
            <header>
            <button name="action_resolve" type="object" string="Resolved" invisible="staty in ('resolved', 'canceled')"/>
            <button name="action_cancel" type="object" string="Cancel" invisible="staty in ('resolved', 'canceled')"/>
            <field name="staty" widget="statusbar" statusbar_visible="new,in_progress,resolved,canceled"/>
        </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Issue Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="buyer_id"/>
                            <field name="salesman_id"/>
                            <field name="issue_type"/>
                            <field name="is_overdue"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="create_date" string= "Reported date"/>
                            <field name="resolved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description_issue"/>
                            </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_issue_stat_action" model="ir.actions.act_window">
        <field name="name">Property Issue</field>
        <field name="res_model">estate.property.issue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>
</odoo>
