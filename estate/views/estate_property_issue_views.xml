<odoo>
    <record id="estate_property_issue_action" model="ir.actions.act_window">
        <field name="name">Property Issue</field>
        <field name="res_model">estate.property.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_estate_property_issue_list" model="ir.ui.view">
        <field name="name">estate.property.issue.list</field>
        <field name="model">estate.property.issue</field>
        <field name="arch" type="xml">
            <list string="Properties"> 
                <field name="name"/>
                <field name="property_id" />
                <field name="partner_id" />
                <field name="salesman_id"/>
                <field name="issue_type"/>
                <field name="description" />
                <field name="state"/>
                <field name="priority" />
                <field name="create_date"/>
                <field name="resolved_date" />
                <field name="is_overdue" />
            </list>
        </field>
    </record>

    <record id="view_estate_property_issue_form" model="ir.ui.view">
        <field name="name">estate.property.issue.form</field>
        <field name="model">estate.property.issue</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                <header>
                    <button name="action_resolved" type="object" string="resolve"/>
                    <button name="action_cancel" type="object" string="cancel"/>
                    <field name="state" widget="statusbar"/>
                </header>
                    <h1>
                        <field name="name" readonly="state == 'resolved'"/>
                    </h1>
                    <group>
                        <group>
                            <field name="property_id" readonly="state == 'resolved'" />
                            <field name="partner_id" readonly="state == 'resolved'"/>
                            <field name="salesman_id" readonly="state == 'resolved'"/>
                            <field name="issue_type" readonly="state == 'resolved'"/>
                        </group>
                        <group>
                            <field name="priority" readonly="state == 'resolved'"/>
                            <field name="create_date" readonly="state == 'resolved'"/>
                            <field name="resolved_date" />
                            <field name="is_overdue" />
                        </group>
                        <notebook>
                            <page name="deccription" string="deccription">
                                <field name="description" readonly="state == 'resolved'"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
