<odoo>
    <record id="view_estate_offer_wizard_form" model="ir.ui.view">
        <field name="name">estate.offer.wizard.form</field>
        <field name="model">estate.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Offers">
                <group>
                    <field name="partner_id"/>
                    <field name="price"/>
                    <field name="validity"/>
                </group>
                <footer>
                    <button name="action_create_offers"
                            type="object"
                            string="Create"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="estate_property_action_server_create_offer" model="ir.actions.server">
        <field name="name">Create Offer</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
    action = {
        "type": "ir.actions.act_window",
        "res_model": "estate.offer.wizard",
        "view_mode": "form",
        "target": "new",
        "context": {"active_ids": records.ids}
    }
        </field>
    </record>
    <record id="action_estate_offer_wizard" model="ir.actions.act_window">
        <field name="name">Create Offer</field>
        <field name="res_model">estate.offer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
