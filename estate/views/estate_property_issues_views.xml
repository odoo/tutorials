<odoo>
    <record id="estate_property_issues_list_view" model="ir.ui.view">
        <field name="name">estate.property.issues</field>
        <field name="model">estate.property.issues</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="issue_type"/>
                <field name="reported_by"/>
                <field name="assigned_to"/>
                <field name="reported_date"/>
                <field name="resolved_date" readonly='1'/>
                <field name="is_overdue"/>
            </list>
        </field>
    </record>

    <record id="estate_property_issues_view_form" model="ir.ui.view">
        <field name="name">estate.property.issues.form</field>
        <field name="model">estate.property.issues</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_resolve"
                        type="object"
                        string="Resolve"
                        invisible="issue_state in ('resolved', 'cancelled')"/>
                    <button name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="issue_state in ('resolved', 'cancelled')"/>
                    <field name="issue_state"
                        widget="statusbar"
                        statusbar_visible="new,in progress,resolved"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="priority" widget="priority"/>
                        <field name="description"/>
                        <field name="property_id"/>
                        <field name="issue_type"/>
                        <field name="reported_by"/>
                        <field name="assigned_to"/>
                        <field name="reported_date"/>
                        <field name="resolved_date"/>
                        <field name="is_overdue"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_issues_action_stat" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">estate.property.issues</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>
</odoo>
