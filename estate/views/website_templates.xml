<odoo>
    <record id="menu_estate_properties" model="website.menu">
        <field name="name">Properties</field>
        <field name="url">/properties</field>
        <field name="parent_id" ref="website.main_menu" />
        <field name="sequence" type="int">55</field>
    </record>

    <template id="properties_page_view" name="Properties">
        <t t-call="website.layout">
            <div class="container">
                <t t-if="properties">
                    <h1 class="mb-4">Properties</h1>
                    <div class="row">
                        <t t-foreach="properties" t-as="prop">
                            <div class="col-md-4 mb-4">
                                <div class="card">
                                    <div class="card-body">

                                        <div
                                            class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="card-title m-0" t-field="prop.name" />
                                            <t t-set="color_map"
                                                t-value="{
                                                    'new': 'info',
                                                    'offer_received': 'warning',
                                                    'cancelled': 'mute'
                                                }" />
                                            <span t-field="prop.state"
                                                t-attf-class="badge rounded-pill text-black bg-{{ color_map.get(prop.state, 'danger') }}" />
                                        </div>

                                        <p class="card-text"> Price: <span
                                                t-field="prop.expected_price" /></p>

                                        <t t-if="prop.offer_ids">
                                            <div class="mt-3 border-top pt-2">
                                                <strong class="text-muted text-uppercase small">
                                                    Offers</strong>
                                                <ul class="list-group list-group-flush mt-1">
                                                    <t t-foreach="prop.offer_ids" t-as="offer">
                                                        <li class="list-group-item px-0 py-2">
                                                            <div
                                                                class="d-flex justify-content-between align-items-center">
                                                                <div> Customer: <span
                                                                        t-field="offer.partner_id"
                                                                        class="fw-bold text-dark" /></div>
                                                                <t t-if="offer.status == 'accepted'">
                                                                    <span t-field="offer.status"
                                                                        class="badge bg-success rounded-pill" />
                                                                </t>
                                                                <t t-else="">
                                                                    <span t-field="offer.status"
                                                                        class="badge bg-danger rounded-pill" />
                                                                </t>
                                                            </div>
                                                            <div> Offer Price: <span
                                                                    t-field="offer.price"
                                                                    class="text-dark" /></div>
                                                            <div class="small text-muted mt-1">
                                                                <i class="fa fa-clock-o" />
                                                                Validity: <span
                                                                    t-field="offer.validity" /> days </div>
                                                        </li>
                                                    </t>
                                                </ul>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-else="">
                    <div class="text-center mt-5">
                        <h1>No properties available</h1>
                        <p class="text-muted">Check back later for new listings.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
