<odoo>
    <record id="estate_property_maintanance_action" model="ir.actions.act_window">
        <field name="name">Maintanance</field>
        <field name="res_model">estate.property.maintanance</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_maintanance_view_list" model="ir.ui.view">
        <field name="name">estate.property.maintanance.list</field>   
        <field name="model">estate.property.maintanance</field>
        <field name="arch" type="xml">
            <list string="Maintanance">
                <field name="title"/>
                <field name="description"/>
                <field name="technision"/>
                <field name="created_by"/>
                <field name="request_date"/>
                <field name="estimate_cost"/>
                <field name="actual_cost"/>
                <field name="state"/>
                <field name="priority"/>
            </list>
        </field>
    </record>
    <record id="estate_property_maintanance_view_form" model="ir.ui.view">
        <field name="name">estate.property.maintanance.form</field>   
        <field name="model">estate.property.maintanance</field>
        <field name="arch" type="xml">
            <form string="Maintanance">
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state in ('new','progress','done','cancelled')"/>
                    <button name="action_stop" type="object" string="Stop" invisible="state in ('new','assign','cancelled','done')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assign,progress,done,cancelled"/> 
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="description"/>
                            <field name="technision"/>
                            <field name="created_by"/>
                            <field name="request_date"/>
                        </group>
                        <group>
                            <field name="estimate_cost" readonly="state in ('new','progress','done','cancelled')"/>
                            <field name="actual_cost" readonly="state in ('new','progress','assign','cancelled')"/>
                            <field name="state"/>
                            <field name="priority"/>
                            <field name="property_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
