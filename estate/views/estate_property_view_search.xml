<odoo>
    <record id='estate_property_view_search' model='ir.ui.view'>
        <field name='name'>estate.property.search</field>
        <field name='model'>estate.property</field>
        <field name='arch' type='xml'>
            <search>
                <field name='name' string="Title"/>
                <field name='postcode'/>
                <field name='expected_price'/>
                <field name='bedrooms'/>
                <field name='living_area' filter_domain="[('living_area','&gt;=',self)]"/>
                <field name='facades'/>

                <filter name='filter_available_properties' string="Available Properties" domain="['|',('state','=','new'),('state','=','offer_received')]"/>
                <filter name='groupby_postcode' string="Postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>
</odoo>