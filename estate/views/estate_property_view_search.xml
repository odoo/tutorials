<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field
                    name="living_area"
                    filter_domain="[('living_area', '>=', self)]"
                />
                <field name="facades"/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'received')]"/>
                <filter string="Postcode" name="by_postcode" context="{'group_by': 'postcode'}"/>

                <filter string="House" name="house" domain="[('property_type_id.name', '=', 'House')]"/>
                <filter string="Apartment" name="apartment" domain="[('property_type_id.name', '=', 'Apartment')]"/>
                <filter string="Property Type" name="by_property_type" context="{'group_by': 'property_type_id'}"/>
            </search>
        </field>
    </record>
</odoo>