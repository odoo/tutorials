<odoo>

    <record id="view_property_offer_wizard_form" model="ir.ui.view">
        <field name="name">property.offer.wizard.form</field>
        <field name="model">estate.property.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Offer">
                <group>
                    <field name="partner_id"/>
                    <field name="price"/>
                </group>
                <footer>
                    <button name="action_apply_offer"
                            type="object"
                            string="Apply Offer"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_property_offer_wizard_multi" model="ir.actions.act_window">
        <field name="name">Add Offer</field>
        <field name="res_model">estate.property.offer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
