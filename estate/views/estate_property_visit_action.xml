<?xml version="1.0"?>
<odoo>
    <record id="estate_property_visit_action" model="ir.actions.act_window">
        <field name="name">estate_property_visit</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_visit_list_view" model="ir.ui.view">
        <field name="name">estate.property.visit.list.view</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list string="visits">
                <field name="property_id"/>
                <field name="visitor_id"/>
                <field name="date"/>
                <field name="comment"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="estate_property_visit_form_view" model="ir.ui.view">
        <field name="name">estate.property.visit.form.view</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form string="visit">
                <sheet>
                    <field name="state" widget="statusbar" options="{'clickable':1}"/>
                    <group>
                        <field name="property_id"/>
                        <field name="visitor_id"/>
                        <field name="date"/>
                        <field name="comment"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>