<odoo>

    <record id="view_estate_contract_form" model="ir.ui.view">
        <field name="name">estate.contract.form</field>
        <field name="model">estate.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>

            
                    <button name="action_send_for_signature"
                            type="object"
                            string="Send for Signature"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

        
                    <button name="action_check_signed"
                            type="object"
                            string="Check Signed"
                            invisible="state != 'sent'"/>

                    <field name="state" widget="statusbar"/>

                </header>

                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="buyer_id"/>
                        <field name="seller_id"/>
                        <field name="sign_request_id"/>
                        <field name="offer_id"/>
                        <field name="offer_price"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="action_estate_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">estate.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', context.get('default_property_id'))]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>

    <record id="view_estate_contract_list" model="ir.ui.view">
        <field name="name">estate.contract.list</field>
        <field name="model">estate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="buyer_id"/>
                <field name="seller_id"/>
                <field name="offer_id"/>
                <field name="offer_price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

</odoo>