<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="estate_property_menu_root" name="Real Estate"/> <!-- it is to show in the dashboard-->

    <!-- sequence is used to control the order, a lower sequence number comes before the higher one. -->
    <!-- every menuitem shoud have an action defined, without action the menuitem will not be displayed -->

    <menuitem id="estate_menu_property" 
            parent="estate_property_menu_root" 
            name="Properties"
            sequence="10"  
    />
   <menuitem id="estate_menu_discussion1" 
            parent="estate_menu_property" 
            name="discussion1"
            action="estate_property_action"
    /> 
    <menuitem id="estate_menu_property2" 
            parent="estate_property_menu_root" 
            name="Properties2"
            sequence="2"
    />
    <menuitem id="estate_menu_discussion2" 
            parent="estate_menu_property2" 
            name="discussion2"
            action="estate_property_action"
    />
    <menuitem id="estate_menu_discussion3" 
            parent="estate_menu_property2" 
            name="discussion3"
            action="estate_property_action2"
    />
</odoo>
