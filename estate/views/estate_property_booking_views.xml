<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_active_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">estate.property.booking</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_booking_action" model="ir.actions.act_window">
        <field name="name">Property Booking</field>
        <field name="res_model">estate.property.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_booking_view_list" model="ir.ui.view">
        <field name="name">estate.property.booking.list</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <list string="Property Bookings">
                <field name="name"/>
                <field name="property_id"/>
                <field name="buyer_id"/>
                <field name="amount" widget="monetary"/>
                <field name="total_paid" widget="monetary"/>
                <field name="remaining_amount" widget="monetary"/>
                <field name="payment_status" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="estate_property_booking_view_form" model="ir.ui.view">
        <field name="name">estate.property.booking.form</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <form string="Property Booking">
                <header>
                    <field name="property_state" invisible="1"/><!-- property_state is invisible because it is only used for button visibility conditions -->
                    <button name="action_confirm_sale" type="object" string="Confirm Sale &amp; Send Email" class="btn-primary" invisible="payment_status != 'paid' or property_state == 'sold'"/>
                    <button name="action_set_active" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/>
                    <button name="action_set_cancelled" type="object" string="Cancel" invisible="state in ('cancelled', 'sold') or property_state == 'sold'"/>
                    <button name="action_pay_now" type="object" string="Pay Now" class="btn-primary" invisible="payment_status == 'paid' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="invoices_count == 0">
                            <field name="invoices_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="is_near_expiry" invisible="1"/><!-- Hidden field used for conditional logic -->
                    <field name="is_expired" invisible="1"/><!-- Hidden field used for conditional logic -->
                    <div class="alert alert-warning text-center fw-bold mb-3" role="alert" invisible="not is_near_expiry">
                        Warning: This booking is approaching its expiration date!
                    </div>
                    <div class="alert alert-danger text-center fw-bold mb-3" role="alert" invisible="not is_expired">
                        Alert: This booking has EXPIRED!
                    </div>
                    <group>
                        <group string="Property Details">
                            <field name="property_id" domain="[('state', '=', 'offer_accepted')]"/>
                            <field name="create_date"/>
                            <field name="expired_date"/>
                            <field name="days_to_expiry"/>
                        </group>
                        <group string="Accepted Offer Details">
                            <field name="offer_id"/>
                            <field name="buyer_id"/>
                            <field name="selling_price" string="Offered Price" widget="monetary"/>
                            <field name="payment_status" widget="badge"/>
                        </group>
                    </group>
                    <group string="Booking Payment Summary">
                        <group>
                            <field name="amount" widget="monetary" string="Booking Advance (10%)"/>
                            <field name="selling_price" widget="monetary" string="Total Property Price"/>
                        </group>
                        <group>
                            <field name="total_paid" widget="monetary"/>
                            <field name="remaining_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments History">
                            <field name="payment_ids" readonly="1">
                                <list string="Payments">
                                    <field name="payment_date"/>
                                    <field name="payment_method"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="invoice_id" widget="many2one"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
