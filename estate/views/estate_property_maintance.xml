<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="estate_proprty_maintance" model="ir.actions.act_window">
        <field name="name">Estate Property Maintance</field>
        <field name="res_model">estate.property.maintance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_maintance_list_view" model="ir.ui.view">
        <field name="name">estate.property.maintance.list</field>
        <field name="model">estate.property.maintance</field>
        <field name="arch" type="xml">
            <list>
                <field name="issue" />
                <field name="agent_ids" />
                <field name="property_id" />
                <field name="create_date" string="Date" />
                <field name="price" />
                <button name="action_in_progress" type="object" title="In Progress" icon="fa-play" />
                <button name="action_done" type="object" title="Done" icon="fa-check" />
                <field name="status" />
            </list>
        </field>
    </record>

</odoo>