<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_type" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_form" model="ir.ui.view">
        <field name="name">Property Type Form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action"
                            name="%(estate_property_offer_action)d">
                            <field name="offer_count" widget="statinfo" string="Offers" />
                        </button>
                    </div>
                    <h1>
                        <field name="name" placeholder="Property Type"></field>
                    </h1>
                    <field name="property_ids">
                        <list>
                            <field name="name" string="Title" />
                            <field name="expected_price" string="Expected Price" />
                            <field name="state" string="Status" />
                        </list>
                    </field>
                </sheet>
            </form>

        </field>
    </record>

    <record id="estate_property_type_list" model="ir.ui.view">
        <field name="name">Property Type List</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" string="Title" />
            </list>
        </field>
    </record>

</odoo>