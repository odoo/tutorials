<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Action -->
    <record id="estate_property_type_model_action" model="ir.actions.act_window">
      <field name="name">Estate Property Type action</field>
      <field name="res_model">estate_property_type_model</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- List View -->
    <record id="view_estate_property_type_model_list" model="ir.ui.view">
      <field name="name">estate.property.type.model.list</field>
      <field name="model">estate_property_type_model</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="property_ids"/>
        </list>
      </field>
    </record>

    <!-- Form View -->
    <record id="view_estate_property_type_model_form" model="ir.ui.view">
      <field name="name">estate.property.type.model.form</field>
      <field name="model">estate_property_type_model</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <group>
                <field name="name"/>
              </group>
            </group>
            <notebook>
              <page string="Properties">
                <field name="property_ids">
                  <list>
                    <field name="name" />
                    <field name="expected_price" />
                  </list>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Search View -->
    <record id="view_estate_property_type_model_search" model="ir.ui.view">
      <field name="name">estate.property.type.model.search</field>
      <field name="model">estate_property_type_model</field>
      <field name="arch" type="xml">
        <search string="Search Properties">
          <field name="name" string="Property Type"></field>
        </search>
      </field>
    </record>
  </data>
</odoo>
