<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">estate.property.maintenance</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_property_maintenance_list" model="ir.ui.view">
        <field name="name">estate.property.maintenance.list</field>
        <field name="model">estate.property.maintenance</field>
        <field name="arch" type="xml">
            <list string="maintenance list">
                <field name="name" string="Issue"/>
                <field name="property_id" string="Property"/>
                <field name="technician_id" string="Technician"/>
                <field name="priority"/>
                <field name="stage"/>
            </list>
        </field>
    </record>

    <record id="estate_property_maintenance_form" model="ir.ui.view">
        <field name="name">estate.property.maintenance.form</field>
        <field name="model">estate.property.maintenance</field>
        <field name="arch" type="xml">
            <form string="maintenance">
                <header>
                    <button name="action_assign_technician" type="object" string="Assign Technician" invisible="stage != 'new'"/>
                    <button name="action_done" type="object" string="Done" invisible="stage != 'new'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="stage != 'new'"/>
                    <field name="stage" widget="statusbar"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" string="Issue"/>
                    </h1>
                    <group>
                        <field name="description"/>
                        <field name="property_id" string="Property"/>
                        <field name="technician_id" string="Technician"/>
                        <field name="priority"/>
                        <field name="stage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_maintenance_kanban" model="ir.ui.view">
        <field name="name">estate.property.maintenance.kanban</field>
        <field name="model">estate.property.maintenance</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" sample="1">
                <field name="name"/>
                <field name="stage"/>
                <progressbar field="stage" colors="{'planned': 'success', 'today': 'warning', 'overdue': 'danger'}"/>
                <templates>
                    <t t-name="card">
                        <field name="name"/>
                        <field name="description"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
