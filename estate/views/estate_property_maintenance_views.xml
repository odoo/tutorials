<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">estate.property.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new maintenance request!
            </p>
        </field>
    </record>
    <record id="estate_property_maintenance_view_list" model="ir.ui.view">
        <field name="name">estate.property.maintenance.view.list</field>
        <field name="model">estate.property.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests">
                <field name="name"/>
                <field name="property_id"/>
                <field name="maintenance_type"/>
                <field name="requester_id"/>
                <field name="request_date"/>
                <field name="technician_id"/>
                <field name="estimated_cost"/>
                <field name="tentative_cost"/>
                <field name="final_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="estate_property_maintenance_view_form" model="ir.ui.view">
        <field name="name">estate.property.maintenance.view.form</field>
        <field name="model">estate.property.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_assign" type="object" string="Assign" invisible="state != 'new'"/>
                    <button name="action_start" type="object" string="Start Work" invisible="state != 'assigned'"/>
                    <button name="action_stop" type="object" string="Complete Work" invisible="state != 'started'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,started,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Roof Repair"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="maintenance_type"/>
                            <field name="other_type" invisible="maintenance_type != 'other'"/>
                            <field name="requester_id"/>
                            <field name="request_date"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="estimated_cost"/>
                            <field name="tentative_cost"/>
                            <field name="final_cost"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe the maintenance issue..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>