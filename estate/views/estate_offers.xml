<odoo>

    <record id="estate_offer_action" model="ir.actions.act_window">
        <field name="name">Estate Offers</field>
        <field name="res_model">estate.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Default/global views: used by Offers menu action — show property_id -->
    <record id="estate_offer_list_view" model="ir.ui.view">
        <field name="name">Estate Offer List</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <list
                    editable="bottom"
                    decoration-danger="status == 'refused'"
                    decoration-success="status == 'accepted'"
                >
                <field name="price" />
                <field name="partner_id" />
                <field name="property_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <field name="status" optional="hide" />
                <button name="action_accept" string="Accept" type="object" icon="fa-check" groups="estate.group_manager" />
                <button name="action_refuse" string="Refuse" type="object" icon="fa-times" groups="estate.group_manager" />
            </list>
        </field>
    </record>

    <record id="estate_offer_form_view" model="ir.ui.view">
        <field name="name">Estate Offer Form</field>
        <field name="model">estate.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="property_id" />
                        <field name="price" />
                        <field name="status" />
                        <field name="validity" />
                        <field name="date_deadline" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
