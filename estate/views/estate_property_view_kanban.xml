<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="0">
                <field name="state"/>
                <field name="best_price"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column gap-2">
                            <field name="name" class="fw-bold"/>
                            <p>
                                Expected Price: <field name="expected_price"/>
                            </p>
                            <p t-if="record.best_price.raw_value > 0">
                                Best Offer: <field name="best_price"/>
                            </p>
                            <p t-if="record.state.raw_value == 'accepted'">
                                Selling Price: <field name="selling_price"/>
                            </p>
                            <field name="property_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': true}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>