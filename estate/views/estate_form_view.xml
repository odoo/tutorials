<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_form_view" model="ir.ui.view">
        <field name="name">estate.form.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button name="action_sold" type="object" string="Sold"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="state" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>

                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description" string="Description"/>
                                    <field name="bedrooms" string="Bedrooms"/>
                                    <field name="living_area" string="Living Area"/>
                                    <field name="facades" string="Facades"/>
                                    <field name="garage" string="Garage"/>
                                    <field name="garden" string="Garden"/>
                                    <field name="garden_area" string="Garden Area"/>
                                    <field name="garden_orientation" string="Garden Orientation"/>
                                    <field name="total_area" string="Total Area (sqm)"/>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids"/>
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="buyer_id" string="Buyer"/>
                                    <field name="salesperson_id" string="Salesperson"/>
                                </group>
                            </page>
                        </notebook>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
