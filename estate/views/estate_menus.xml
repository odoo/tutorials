<?xml version="1.0"?>
<odoo>
    <menuitem id="estate_menu_root" name="Real Estate">
        <menuitem id="estate_advertisements_menu" name="Advertisements">
            <!-- the value of the action property is the id of the record action we want to target -->
            <!-- estate_property_views.xml -->
            <!-- It also fetch the value in the tag with the field with the property name of value name -->
            <menuitem id="estate_advertisements_menu_property_moder_action" action="estate_property_model_action"/>
        </menuitem>
        <menuitem id="estate_settings_menu" name="Settings">
            <menuitem id="estate_settings_menu_property_type_action" action="estate_property_type_model_action"/>
            <menuitem id="estate_settings_menu_property_tag_action" action="estate_property_tag_model_action"/>
        </menuitem>
    </menuitem>
</odoo>
