<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_property_payment_form" model="ir.ui.view">
        <field name="name">estate.property.payment.form</field>
        <field name="model">estate.property.payment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Payment" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="booking_id"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_estate_property_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">estate.property.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
