<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="estate_users_companies_form" model="ir.ui.view">
        <field name="name">estate_users_companies</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="Properties for Sale" name="properties_for_sale">
                    <field name="property_ids" context="{'tree_view_ref': 'estate.estate_property_view_list'}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
