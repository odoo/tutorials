<odoo>
    <record id='estate_property_view_form' model='ir.ui.view'>
        <field name='name'>estate.property.form</field>
        <field name='model'>estate.property</field>
        <field name='arch' type='xml'>
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" string="Sold"/>
                    <button name="action_cancelled" type="object" string="Cancelled"/>
                    <field name='state' widget='statusbar' options="{'clickable': 1}" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <h1>
                        <field name='name'/>
                    </h1>
                    <field name='property_tag_ids' widget='many2many_tags' placeholder="Property Tags" options="{'create':False,'color_field':'color'}"/>
                    <separator/>
                    <group>
                        <group>
                            <field name='property_type_id'/>
                            <field name='postcode'/>
                            <field name='date_availability'/>
                        </group>
                        <group>
                            <field name='expected_price'/>
                            <field name='best_price'/>
                            <field name='selling_price'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details">
                            <group>
                                <field name='description'/>
                                <field name='bedrooms'/>
                                <field name='living_area'/>
                                <field name='facades'/>
                                <field name='garage'/>
                                <field name='garden'/>
                                <field name='garden_area'/>
                                <field name='garden_orientation'/>
                                <field name='total_area'/>

                            </group>
                        </page>
                        <page string="Offers">
                            <field name='property_offer_ids'/>
                            <group>
                            </group>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name='buyer_id'/>
                                <field name='salesman_id'/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>