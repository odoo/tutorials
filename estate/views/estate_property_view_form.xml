<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Test">
                <header>
                    <button name="action_property_sold" type="object" string="Sold" invisible="state in ('cancelled', 'sold')"/>
                    <button name="action_property_cancelled" type="object" string="Cancel" invisible="state in ('cancelled', 'sold')"/>
                    <field name="state" string="state" widget="statusbar"/>
                </header>
                <sheet>
                    
                    <div class="oe_title">
                        <div>
                            <label for="name"/>
                        </div>
                        <h1 class="mb32">
                            <field name="name" class="mb16"/>
                        </h1>
                        <field name="active" invisible="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="best_offer"/>
                        </group>
                        <group>
                            <field name="postcode"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                        </group>
                        <group>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="tags_id" string="Tags" widget="many2many_tags"/>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garage" string="Garage"/>
                                <field name="garden" string="Garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" string="Garden Orientation" invisible="not garden"/>
                                <field name="total_area" string="Total Area (sqm)"/>
                                
                                
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'cancelled')">
                                <list editable="bottom" decoration-warning="status == 'refused'"
                                                        decoration-success="status == 'accepted'">
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status" invisible="status in ('accepted', 'refused')"/>
                                    <field name="date_deadline"/>
                                    <field name="validity"/>
                                    <button name="action_accept" string="accept" type="object" icon="fa-check" invisible="status in ('accepted', 'refused')"/>
                                    <button name="action_refuse" string="refuse" type="object" icon="fa-times" invisible="status in ('accepted', 'refused')"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="salesman_id" string="Salesman"/>
                                <field name="buyer_id" string="Buyer"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>