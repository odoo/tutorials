<?xml version="1.0"?>
<odoo>

    <record id="estate_property_active_visits_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">estate.property.visits</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_visits_action" model="ir.actions.act_window">
        <field name="name">Property Visits</field>
        <field name="res_model">estate.property.visits</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_visits_list" model="ir.ui.view">
        <field name="name">estate.property.visits.list</field>
        <field name="model">estate.property.visits</field>
        <field name="arch" type="xml">
            <list string="Visits">
                <field name="name"/>
                <field name="property_id" string="Property"/>
                <field name="customer"/>
                <field name="sales_person"/>
                <field name="time_slot" string="Slot"/>
            </list>
        </field>
    </record>

    <record id="estate_property_visits_form" model="ir.ui.view">
        <field name="name">estate.property.visits.form</field>
        <field name="model">estate.property.visits</field>
        <field name="arch" type="xml">
            <form string="Visits">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="property_id" string="Property" invisible="context.get('default_property_id')"/>
                        <field name="customer"/>
                        <field name="sales_person"/>
                        <field name="rating" widget="priority"/>
                        <field name="time_slot" string="Slot"/>
                        <field name="feedback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
