<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_visits" model="ir.ui.view">
        <field name="name">estate.property.visits.list </field>
        <field name="model">estate.property.visits</field>
        <field name="arch" type="xml">
            <list string="Visits" >
                <field name = "property_id"/>
                <field name = "agent"/>
                <field name = "customer"/>
                <field name="visit_date"/>
                <field name="status_of_visit"/>
                <field name="rating"/>
                <field name="time_slot"/>
            </list>
        </field>
    </record>
    <record id="estate_property_visits_form" model="ir.ui.view">
        <field name="name">estate.property.visits.form </field>
        <field name="model">estate.property.visits</field>
        <field name="arch" type="xml">
            <form string="Visits">
                <header>
                    
                </header>
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="agent"/>
                        <field name="customer"/>
                        <field name="visit_date"/>
                    </group>
                    <group>
                        <field name="status_of_visit"/>
                        <field name="rating"/>
                        <field name="time_slot"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id= "estate_property_visits_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">estate.property.visits</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_visits_action_property" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">estate.property.visits</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
    </record>
</odoo>