<odoo>
    <record id="estate_property_offer_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list.view</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
                <button name="save_offer" string="Confirm" type="object" icon="fa-check"/>
                <button name="cancel_offer" string="Cancel" type="object" icon="fa-times"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>           
        </field>
        
    </record>
</odoo>
