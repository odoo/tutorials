<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">name</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
        <!-- <field name="context">{'create': False}</field> -->
    </record>
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="accept_offer" type="object" icon="fa-check" class="btn-success" string="Accept" groups="estate.group_real_estate_manager" invisible="status"/>
                <button name="reject_offer" type="object" icon="fa-times" class="btn-danger" string="Reject" groups="estate.group_real_estate_manager" invisible="status"/>
            </list>
        </field>
    </record>
</odoo>
