<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="property_list_template" name="Property List">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>Available Properties</h1>

                <div class="row">
                    <t t-foreach="properties" t-as="property">
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>
                                        <!-- <a t-att-href="'/properties/%s' % property.id"> -->
                                        <a t-att-href="'/properties/%s' % slug(property)">
                                            <t t-esc="property.name"/>
                                        </a>
                                    </h5>
                                    <p>
                                        Expected Price:
                                        <t t-esc="property.expected_price"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <template id="property_detail_template" name="Property Detail">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>
                    <t t-esc="property.name"/>
                </h1>

                <p>
                    <strong>Expected Price:</strong>
                    <t t-esc="property.expected_price"/>
                </p>

                <p>
                    <strong>Description:</strong>
                    <t t-esc="property.description"/>
                </p>

                <p>
                    <strong>State:</strong>
                    <t t-esc="property.state"/>
                </p>
                <a href="/properties">Back to list</a>
            </div>
        </t>
    </template>

    <template id="dynamic_filter_template_property_cards_estate" name="Dynamic Property Cards">
        <div class="row">
            <t t-foreach="records" t-as="record">
                <div class="col-md-4 mb-3">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="position-relative">
                            <img src="/estate/static/src/img/villa.avif" class="card-img-top" alt="Property"/>
                            <span class="badge bg-primary position-absolute top-0 end-0 m-3">For Sale</span>
                        </div>
                        <div class="card-body">
                            <h4 class="card-title text-primary" t-if="show_price">
                                $<t t-esc="record._record.expected_price"/>
                            </h4>
                            <h5 class="fw-bold">
                                <t t-esc="record._record.name"/>
                            </h5>
                            <p class="text-muted small">
                                <i class="fa fa-map-marker me-1"/>
                                <t t-esc="record._record.description or 'No description available'"/>
                            </p>
                            <hr/>
                            <div class="d-flex justify-content-between text-muted">
                                <span t-if="record._record.bedrooms">
                                    <i class="fa fa-bed me-1"/>
                                    <t t-esc="record._record.bedrooms"/> Beds
                                </span>
                                <span t-if="record._record.living_area">
                                    <i class="fa fa-arrows-alt me-1"/>
                                    <t t-esc="record._record.living_area"/> sqft
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </template>
</odoo>
