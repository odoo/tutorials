<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="property_list_template" name="Property List">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>Available Properties</h1>

                <div class="row">
                    <t t-foreach="properties" t-as="property">
                        <div class="col-md-4 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <h5>
                                        <!-- <a t-att-href="'/properties/%s' % property.id"> -->
                                        <a t-att-href="'/properties/%s' % slug(property)">
                                            <t t-esc="property.name"/>
                                        </a>
                                    </h5>
                                    <p>
                                        Expected Price:
                                        <t t-esc="property.expected_price"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

            </div>
        </t>
    </template>

    <template id="property_detail_template" name="Property Detail">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h1>
                    <t t-esc="property.name"/>
                </h1>

                <p>
                    <strong>Expected Price:</strong>
                    <t t-esc="property.expected_price"/>
                </p>

                <p>
                    <strong>Description:</strong>
                    <t t-esc="property.description"/>
                </p>

                <p>
                    <strong>State:</strong>
                    <t t-esc="property.state"/>
                </p>
                <a href="/properties">Back to list</a>
            </div>
        </t>
    </template>
</odoo>
