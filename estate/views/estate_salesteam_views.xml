<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="estate_property_salesteam_action" model="ir.actions.act_window">
            <field name="name">Users &amp; Companies</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="estate_salesteam_view_form" model="ir.ui.view">
            <field name="name">res.users.view.form.inherit.estate</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='page_security']" position="after">
                    <page name="properties" string="Real Estate Properties">
                        <field name="property_ids" />
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
