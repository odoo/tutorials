<?xml version="1.0"?>
<odoo>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="price"/>
                <field name="partner"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept_offer" string="Accept" type="object" icon="fa-check"/>
                <button name="action_refuse_offer" string="Refuse" type="object" icon="fa-times"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer-view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
