<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="List view" editable="bottom" decoration-danger="status=='rejected'" decoration-success="status=='accepted'">
                <field name="price"/>
                <field name="partner_id"/>
                <button name="action_accept_offer" type="object" title="Accept" icon="check" invisible="status in ('accepted', 'rejected')"/>
                <button name="action_reject_offer" type="object" title="Reject" icon="close" invisible="status in ('accepted', 'rejected')"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="property_type_id"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Form view">
                <sheet>
                    <group>
                        <field name="price"/>
                    </group>
                    <group>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="status"/>
                    </group>
                    <group>
                        <field name="date_deadline"/>
                    </group>
                    <group>
                        <field name="validity"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
