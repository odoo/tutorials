<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_estate_property_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list</field>
        <field name="domain">[('property_type_ids', '=', active_id)]</field>
    </record>

    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                <sheet>
                    <field name="price"/>
                    <field name="partner_ids" string="Partner"/>
                    <field name="status" string="Status"/>
                    <button name="action_to_accept_offer" type="object" icon="fa-check" title="Accept Offer"
                            class="btn-success"/>
                    <button name="action_to_reject_offer" type="object" icon="fa-times" title="Refused Offer"
                            class="btn-danger"/>
                    <field name="date_deadline"/>
                    <field name="validity"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="bottom" decoration-success="status == 'accepted'"
                  decoration-danger="status == 'refused'">
                <field name="price"/>
                <field name="partner_ids"/>
                <field name="status"/>
                <button name="action_to_accept_offer" type="object" title="Accept Offer" icon="fa-check"
                        invisible="status"/>
                <button name="action_to_reject_offer" type="object" title="Refused Offer" icon="fa-times"
                        invisible="status"/>
                <field name="date_deadline"/>
                <field name="validity"/>
                <field name="property_type_ids"/>
            </list>
        </field>
    </record>
</odoo>
