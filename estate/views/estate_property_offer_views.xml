<?xml version="1.0"?>
    <odoo>
        <!-- List view of the estate offer -->
        <record id="estate_properties_offer_list_view" model="ir.ui.view">
            <field name="name">estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Offers" >
                    <field name="price" string="Price"/>
                    <field name="partner_id" string="Partner"/>
                    <field name="validity" string="Validity"/>
                    <field name="date_deadline"/>
                    <button name="action_accept" type="object"  icon="fa-check"/>
                    <button name="action_refuse" type="object"  icon="fa-times"/>
                    <field name="status" string="Status"/>
                </list>
            </field>
        </record>
</odoo>
