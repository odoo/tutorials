<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="bottom"
                decoration-success="status == 'accepted'" decoration-danger="status == 'rejected'">
                <field name="partner_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <field name="status" readonly="true" />
                <button name="action_accept" type="object" icon="fa-check" title="accept"
                    invisible="status" />
                <button name="action_refuse" type="object" icon="fa-times" title="reject"
                    invisible="status" />
                <field name="price" />
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <sheet>
                    <group>
                        <field name="price" />
                        <field name="status" />
                        <field name="partner_id" />
                        <field name="validity" />
                        <field name="date_deadline" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id','=',active_id)]</field>
    </record>

</odoo>
