<odoo>
    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers">
                <field name="price" string="Price"/>
                <field name="partner_id" string="Buyer"/>
                <field name="state" string="Status"/>
                <button name="action_set_accepted" type="object" string="Accept" invisible="state in('accepted', 'refused')"/>
                <button name="action_set_refused" type="object" string="Refused" invisible="state in('accepted', 'refused')"/>
                <field name="validity"/>
                <field name="date_deadline" string="Deadline"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Edit Property">
                <sheet>
                    <group>
                        <field name="price" string="Price"/>
                        <field name="partner_id" string="Buyer"/>
                        <field name="state" string="Status"/>
                        <field name="validity"/>
                        <field name="date_deadline" string="Deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
