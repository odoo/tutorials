<?xml version="1.0"?>
<odoo>
    <!-- Configuration/Offer -->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="buyer_id"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list 
            string="Offers" 
            editable="top"
            decoration-success="state == 'accepted'"
            decoration-danger="state == 'refused'"
            >
                <field name="create_date" optional="show" string="Offer Date"/>
                <field name="price"/>
                <field name="buyer_id" optional="show"/>
                <field name="validity" optional="show"/>
                <field name="date_deadline" optional="show"/>
                <button name="action_accept" title="Accept" type="object" icon="check" invisible="state == 'accepted' or state == 'refused'"/>
                <button name="action_refuse" title="Refuse" type="object" icon="close" invisible="state == 'accepted' or state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
</odoo>
