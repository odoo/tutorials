<odoo>
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="New Offer">
                <group>
                    <header>
                        <button name="action_set_offer_status_accepted" type="object" string="Accept" icon="fa-check"/>
                        <button name="action_set_offer_status_refused" type="object" string="Refuse" icon="fa-times"/>
                    </header>
                </group>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="1">
                <field name="price"/>
                <field name="partner_id" class="text-right"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_set_offer_status_accepted" type="object" string="Accept" icon="fa-check"
                        invisible="status"/>
                <button name="action_set_offer_status_refused" type="object" string="Refuse" icon="fa-times"
                        invisible="status"/>
                <field name="status"/>
            </list>
        </field>
    </record>
</odoo>