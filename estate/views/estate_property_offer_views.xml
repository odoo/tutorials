<?xml version="1.0"?>
<odoo>
    
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property Offers">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="status"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Channel" decoration-danger="status in ('refused')" decoration-success="status in ('accepted')" editable="bottom">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="property_id" />
                <field name="property_type_id" />
                <field name="validity"/>
                <button name="action_accept" string="Accept" type="object" icon="fa-check" invisible="status"/>
                <button name="action_refuse" string="Refuse" type="object" icon="fa-times" invisible="status"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>
</odoo>

