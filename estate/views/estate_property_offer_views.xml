<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
    </record>
    <record id="estate_property_type_offer_action" model="ir.actions.act_window">
        <field name="name">Offers by Property Type</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="property_offers" decoration-muted="status == 'refused'">
                <field name="partner_id"/>
                <field name="price"/>
                <field name="status"/>
            </list>
        </field>
    </record>
</odoo>