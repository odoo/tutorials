<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <list string="Offers">
                <field name="price"/>
                <field name="partner_id"/>
                <button name="action_accept" type="object" title="Accept" icon="fa-check"/>
                <button name="action_refuse" type="object" title="Refuse" icon="fa-close"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property Offer">
                <sheet>
                    <group>
                        <group>
                            <field name="price">Price</field>
                            <field name="partner_id">Partner</field>
                        </group>
                        <group>
                            <field name="status">Status</field>
                            <field name="property_id">Property</field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>