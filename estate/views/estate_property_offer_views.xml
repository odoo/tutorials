<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_offer_action_all" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" editable="bottom" decoration-danger="status == 'rejected'" decoration-success="status == 'accepted'">
                <field name="property_id" readonly="1"/>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="date_deadline"/>
                <field name="validity"/>
                <field name="status"/>
                <button name="action_accept" type="object" title="Accept" icon="fa-check" invisible="status"/>
                <button name="action_reject" type="object" title="Reject" icon="fa-times" invisible="status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="accepted,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="price"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="validity"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
