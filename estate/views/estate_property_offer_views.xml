<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="List View">
            <field name="price" width="200px"/>
            <field name="partner_id" width="400px"/>
            <field name="validity" width="200px"/>
            <field name="date_deadline" width="150px"/>
            <button name="accept_offer" type="object" icon="fa-check"/>
            <button name="refuse_offer" type="object" icon="fa-times"/>
            <field name="status"/>
            </list>
        </field>
    </record>
</odoo>
