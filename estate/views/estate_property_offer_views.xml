<?xml version="1.0" ?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offer" create="property_id.state in ['new', 'offer_received']" editable="bottom"
                  decoration-danger="status=='refused'" decoration-success="status=='accepted'">
                <field name="price" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="validity" optional="show"/>
                <field name="date_deadline" optional="show"/>
                <button name="action_accept_offer" type="object" icon="check" title="check" invisible="status"/>
                <button name="action_refuse_offer" type="object" icon="close" title="close" invisible="status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <sheet string="Property Offer">
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_action_from_property_type" model="ir.actions.act_window">
        <field name="name">Property Offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
