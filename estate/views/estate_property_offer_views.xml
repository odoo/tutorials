<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="New Estate offer">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="buyer_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Estates offer">
                <field name="price"/>
                <field name="buyer_id"/>
                <field name="validity"/>
                <button name="action_confirm" title="Confirm" type="object" icon="check"/>
                <button name="action_cancel" title="Cancel" type="object" icon="cancel"/>
                <field name="date_deadline"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <!-- Configuration/Estate offer/test Menu -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Estate offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>