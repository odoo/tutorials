<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list
                editable="bottom"
                decoration-danger="status == 'refused'"
                decoration-success="status == 'accepted'"
            >
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept" title="Accept" type="object" icon="fa-check" invisible="status"/>
                <button name="action_refuse" title="Refuse" type="object" icon="fa-times" invisible="status"/>
                <field name="status" invisible="1" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <header>
                    <button name="action_accept" type="object" string="Accept" invisible="status"/>
                    <button name="action_refuse" type="object" string="Refuse" invisible="status"/>
                </header>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
