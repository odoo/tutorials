<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_offers_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
    </record>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="is_suspicious">
                <field name="is_suspicious" readonly="1"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <field name="is_suspicious" invisible="1"/> <!-- Required for ribbon widget -->
                    <widget name="web_ribbon" title="Suspicious" bg_color="text-bg-danger" invisible="not is_suspicious"/>
                    <group>
                        <field name="property_id"/>
                        <field name="partner_id"/>
                        <field name="price"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                        <field name="create_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>