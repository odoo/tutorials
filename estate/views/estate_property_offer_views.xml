<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="price"/>
                    <field name="partner_id" string="Partner"/>
                    <field name="status" string="Status"/>
                    <button name="action_to_accept_offer" type="object" icon="fa-check" title="Accept Offer"
                            class="btn-success"/>
                    <button name="action_to_reject_offer" type="object" icon="fa-times" title="Refused Offer"
                            class="btn-danger"/>
                    <field name="date_deadline"/>
                    <field name="validity"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="bottom">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
                <button name="action_to_accept_offer" type="object" title="Accept Offer" icon="fa-check"/>
                <button name="action_to_reject_offer" type="object" title="Refused Offer" icon="fa-times"/>
                <field name="date_deadline"/>
                <field name="validity"/>
            </list>
        </field>
    </record>
</odoo>
