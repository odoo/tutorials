<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property offer">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="status"/>
                        <field name="create_date"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="property_type_id"/>           
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="status=='accepted'" decoration-danger="status=='refused'">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status" optional="hide"/>
                <field name="create_date"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept_offer" type="object" string="Accept" invisible="not status"/>
                <button name="action_refuse_offer" type="object" string="Refuse" invisible="not status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_offers_type_action" model="ir.actions.act_window">
        <field name="name">Property Offers for a given type</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
</odoo>