<?xml version="1.0"?>
<odoo>
    <!-- views -->
    <record id="estate_property_offer_action_menu_view" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_offer_action_stat_button" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>

        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <!-- view config -->
    <!--MENU LIST-->
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_group_by="estate_property_id"
                  decoration-success="status=='accepted'"
                  decoration-danger="status=='refused'">
                <field name="estate_property_id" string="Property"/>
                <field name="property_type_id" string="Type"/>
                <field name="price"/>
                <field name="buyer_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <!-- RELATED LIST-->
    <record id="estate_property_offer_view_list_from_property" model="ir.ui.view">
        <field name="name">estate.property.offer.related.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom"
                decoration-success="status=='accepted'"
                decoration-danger="status=='refused'">

                <field name="price"/>
                <field name="buyer_id"/>
                <field name="validity" string="Validity (days)"/>
                <field name="date_deadline"/>

                <button name="action_accept_offer" string="Accept" type="object" icon="fa-check"
                        invisible="status == 'accepted' or status == 'refused'"/>
                <button name="action_refuse_offer" string="Refuse" type="object" icon="fa-times"
                        invisible="status == 'accepted' or status == 'refused'"/>
            </list>
        </field>
    </record>

    <!-- RELATED FORM-->
    <record id="estate_property_offer_view_form_from_property" model="ir.ui.view">
        <field name="name">estate.property.offer.related.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Make Offer">
                <group>
                    <field name="buyer_id" string="Partner"/>
                    <field name="price" string="Price"/>
                    <field name="validity" string="Validity (days)"/>
                    <field name="date_deadline"/>
                    <field name="status"/>
                </group>
            </form>
        </field>
    </record>
</odoo>