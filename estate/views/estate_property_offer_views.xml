<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="SplishSplosh" editable="bottom"
            decoration-danger="status=='refused'"
            decoration-success="status=='accepted'"
            >
                <field name="price"/>
                <button name="accept_button" type="object" icon="fa-check" invisible="status in ['accepted', 'refused']" title="Accept"/>
                <button name="refuse_button" type="object" icon="fa-times" invisible="status in ['accepted', 'refused']" title="Refuse"/>
                <field name="partner_id" string="Partner"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>
</odoo>
