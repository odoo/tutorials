<?xml version="1.0"?>
<odoo>
    <record id="view_estate_property_offer_tree" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers">
                <field name="price"/>
                <field name="partner_id"/>
                <button name="action_accept_offer" string="Accept" type="object" icon="check"/>
                <button name="action_refuse_offer" string="Refuse" type="object" icon="close"/>
                <field name="status"/>
                <field name="validity"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>
</odoo>
