<odoo>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name='name'>estate.property.offer.view.list</field>
        <field name='model'>estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Channel" expand="1">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accepted" type="object" icon="fa-check" title="Accept"/>
                <button name="action_refused" type="object" icon="fa-close" title="Refuse"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name='name'>estate.property.offer.view.form</field>
        <field name='model'>estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name='name'>Property Offer</field>
        <field name='res_model'>estate.property.offer</field>
        <field name='view_mode'>list,form</field>
    </record>

</odoo>
