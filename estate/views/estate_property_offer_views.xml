<?xml version="1.0"?>
<odoo>
    <!-- List -->
    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="list" editable="bottom" open_form_view="True" 
                decoration-success="offer_status == 'accepted'" 
                decoration-danger="offer_status == 'refused'">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/> <!-- ComputedField with Inverse Function -->
                <button name="action_accept" string="Accept" type="object" icon="fa-check" invisible="offer_status"/>
                <button name="action_refuse" string="Refuse" type="object" icon="fa-times" invisible="offer_status"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/> <!-- ComputedField with Inverse Function -->
                        <field name="offer_status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
