<?xml version="1.0"?>
<odoo>
    <!-- property offer menu action -->
    <record id="property_offer_model_action" model="ir.actions.act_window">
        <field name="name">Property Offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-danger="status == 'refused'"
                  decoration-success="status == 'accepted'">
                <field name="price"/>
                <field name="partner_id" string="Partner"/>
                <field name="validity" string="Validity (days)"/>
                <field name="date_deadline" string="Deadline"/>
                <button name="action_accepted" title="Accept" type="object" icon="check" invisible="status"/>
                <button name="action_refused" title="Refuse" type="object" icon="close" invisible="status"/>
            </list>
        </field>
    </record>

    <record id="property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer">
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id" string="Partner"/>
                        <field name="validity"/>
                        <field name="date_deadline" string="Deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
