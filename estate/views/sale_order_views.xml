<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_sale_order_form_delivered_percent" model="ir.ui.view">
        <field name="name">sale.order.form.delivered.percent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="after">
                <field name="delivered_percent" 
                       optional="hidden" 
                       readonly="qty_delivered_method != 'manual'"/>
            </xpath>
        </field>
    </record>
</odoo>
