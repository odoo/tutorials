<?xml version="1.0" ?>
<odoo>

    <!-- ACTIONS -->
    <record id="customer_action" model="ir.actions.act_window">
        <field name="name">Customer action</field>
        <field name="res_model">customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- VIEWS -->
    <record id="customer_view_tree" model="ir.ui.view">
        <field name="name">customer.list</field>
        <field name="model">customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </list>
        </field>
    </record>


    <record id="customer_view_form" model="ir.ui.view">
        <field name="name">customer.form</field>
        <field name="model">customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <div>
                        <h1 class="mb32">
                            <field name="name" placeholder="Customer name" class="mb16"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
