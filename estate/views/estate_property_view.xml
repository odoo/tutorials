<?xml version="1.0"?>
<odoo>
        <record id="estate_model_action" model="ir.actions.act_window">
            <field name="name">Real-estate Property"s</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="estate_property_list_view" model="ir.ui.view">
            <field name="name">estate.property.list.view</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="Tests">
                    <field name="name"/>
                    <field name="last_seen"/>
                    <field name="bedrooms"/>
                    <field name="state"/>
                </list>
            </field>
        </record>
        <record id="estate_property_form_view" model="ir.ui.view">
            <field name="name">estate.property.form.view</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Test">
                    <sheet>
                        <group>
                                <field name="name"/>
                                <field name="last_seen"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="property_type_id"/><!-- experimented -->
                                    <field name="postcode"/>
                                    <field name="date_availability"/>
                                    <field name="expected_price"/>
                                    <field name="selling_price"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="state"/>
                                    <field name="garden_area"/>
                                    <field name="garden_orientation"/>
                                    <field name="total_area"/>
                                </group>
                            </page>
                            <page string="others">
                                <group>
                                    <field name="description"/>
                                    <field name="active"/>
                                    <field name="salesperson_id"/>
                                    <field name="buyer_id"/>
                                </group>
                            </page>
                            <page string="offers">
                                <field name="offer_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="estate_property_view_search" model="ir.ui.view">
            <field name="name">estate.property.search.view</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="name"/>
                    <field name="postcode"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <filter string="available" name="active" domain="[('active','=','True')]"/>
                    <filter string="new property" name="state" domain="[('state','=','new')]"/>
                    <filter string="2bhk" name="bedrooms" domain="[('bedrooms','=','2')]"/>
                    <filter string="greater than 3bhk" name="bedrooms" domain="[('bedrooms','&gt;','3')]"/>
                    <!-- experimented-->
                    <filter string="new or 2bhk" name="new_or_2bhk" domain="['|',('state','=','new'),'|',('bedrooms','=','2'),('active','=',False)]"/>
                </search>
            </field>
        </record>
</odoo>
