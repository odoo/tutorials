<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_estate_property" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="description" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="bedrooms" />
                <field name="living_rooms" />
                <field name="facades" />
                <field name="garage" />
                <field name="garden" />
                <field name="garden_area" />
                <field name="garden_orientation" />
            </list>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_estate" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,graph,form</field>
    </record>

    <menuitem id="estate_menu_root" name="Real Estate By Smit Patel" sequence="10" web_icon="estate,static/description/icon.png"/>

    <!-- Child Menu -->
    <menuitem id="estate_menu_estates" name="My Estates" parent="estate_menu_root" sequence="1" action="action_estate"/>
</odoo>
