<?xml version="1.0"?>
<odoo>
    <record id="res_users_list_view" model="ir.ui.view">
        <field name="name">res.users.list.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="property_ids"/>
            </field>
        </field>
    </record>

    <record id="res_users_form_view" model="ir.ui.view">
        <field name="name">res.users.form.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Real Estate Properties" name="real_estate_properties">
                    <field name="property_ids"/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
