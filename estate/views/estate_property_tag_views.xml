<odoo>
    <record id="estate_property_tag_action1" model="ir.actions.act_window">
        <field name="name">Property tags</field>
        <field name="res_model">estate.property_tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_tag_view_list" model="ir.ui.view">
        <field name="name">estate_property_tag_list</field>
        <field name="model">estate.property_tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="estate_property_tag_view_form" model="ir.ui.view">
        <field name="name">estate_property_tag_form</field>
        <field name="model">estate.property_tag</field>
        <field name="arch" type="xml">
            <form>
                <div class="oe_title">
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
            </form>
        </field>
    </record>
</odoo>
