<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="test_estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">Property Tag</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="test_estate_property_tag_list_view" model="ir.ui.view">
        <field name="name">estate.property.tag.list</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list string="Property Tags Registered" editable="bottom">
                <field name="name" string="Type"/>
            </list>
        </field>
    </record>

    <record id="test_estate_property_tag_form_view" model="ir.ui.view">
        <field name="name">estate.property.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <form string="Property Type Form">
                <sheet>
                    <h1>
                        <group>
                            <field name="name" string="Tag"/>
                        </group>
                    </h1>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_estate_property_tag_search_view" model="ir.ui.view">
        <field name="name">estate.property.tag.search</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tag">
                <field name="name" string="Tag"/>
            </search>
        </field>
    </record>
</odoo>