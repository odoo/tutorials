<odoo>
    <record id="estate_property_tags_action" model="ir.actions.act_window">
        <field name="name">Property tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_tags_list_view" model="ir.ui.view">
        <field name="name">estate.property.tags.list.view</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list string="Channel" editable="top">
                <field name="name" />
            </list>
        </field>
    </record>
</odoo>