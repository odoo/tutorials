<odoo>
    <record id="res_users_view_form_estate" model="ir.ui.view">
        <field name="name">res_users.form.inherit.estate</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook[@colspan=4]" position="inside">
                <page name="realestate_properties" string="Real Estate Properties">
                    <field name="property_ids" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>