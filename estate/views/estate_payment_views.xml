<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_payment_form" model="ir.ui.view">
        <field name="name">estate.payment.form</field>
        <field name="model">estate.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estate_payment_list" model="ir.ui.view">
        <field name="name">estate.payment.list</field>
        <field name="model">estate.payment</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="action_estate_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">estate.payment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
