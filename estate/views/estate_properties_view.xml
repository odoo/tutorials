<odoo>
    <record id="estate_view_list" model="ir.ui.view">
        <field name="name">estate.properties.list</field>
        <field name="model">estate.properties</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="postcode"/>
            </list>
        </field>
    </record>
    <record id="estate_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.properties</field>
        <field name="view_mode">list</field>
    </record>
</odoo>