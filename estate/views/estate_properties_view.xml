<odoo>
    <record id="estate_properties_view_list" model="ir.ui.view">
        <field name="name">estate.properties.view.list</field>
        <field name="model">estate.properties</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title" width="130px"/>
                <field name="postcode" width="130px"/>
                <field name="bedrooms" width="130px"/>
                <field name="living_area" string="Living Area (sqm)" width="130px"/>
                <field name="expected_price" width="130px"/>
                <field name="selling_price" width="130px"/>
                <field name="date_availability" string="Available From" width="130px"/>
                <field name="total_area" width="130px"/>
                <field name="description" string="Description" width="130px" optional="hide"/>
                <field name="facades" width="130px" optional="hide"/>
                <field name="garage" width="130px" optional="hide"/>
                <field name="garden" width="130px" optional="hide"/>
                <field name="garden_area" string="Garden Area" width="130px" optional="hide"/>
                <field name="garden_orientation" string="Garden Orientation" width="130px" optional="hide"/>
                <field name="active" string="Unarchived" width="130px" optional="hide"/>
                <field name="state" string="Status" width="130px" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_properties_view_form" model="ir.ui.view">
        <field name="name">estate.properties.view.form</field>
        <field name="model">estate.properties</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <div>
                        <group>
                            <group>
                                <field name="property_type_id"/>
                                <field name="property_type_colour"/>
                            </group>
                            <group>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="selling_price"/>                        
                            </group>
                            <group>
                                <field name="active"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="best_price"/>
                            </group>
                        </group>
                    </div>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_properties_view_search" model="ir.ui.view">
        <field name="name">estate.properties.view.search</field>
        <field name="model">estate.properties</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="description"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
                <field name="active"/>
                <field name="state"/>
                <filter string="Demo" name="helloo" domain="[('active', '=', False)]"/>
                <filter string="Unvailable" name="archived" domain="[('active', '=', False)]"/>
                <filter string="Search Domain" name="search_domain" domain="['|', ('bedrooms', '&gt;', '1'), ('garage', '=', True)]"/>
                <!-- <separator/> -->
                <filter string="Postcode" name="postcode" domain="[('postcode', 'ilike', '1')]"/>
                <separator/>
                <filter string="Budget Finder" name="budget" domain="[('expected_price', '&lt;=', 500000)]"/>
                <filter string="PC 1000" name="pc_1000" domain="[('postcode', '=', 1000)]"/>
                <filter string="Big House" name="big_house" domain="[('bedrooms', '&gt;', 3)]"/>
                <filter string="Outdoorsy" name="outdoor" domain="[('garden', '=', True), ('garage', '=', True)]"/>
                <separator/>
                <filter string="Location" name="location" domain="['|', ('postcode', '=', 1000), ('postcode', '=', 2000)]"/>
                <filter string="Flexible" name="flexible" domain="['|', ('bedrooms', '&gt;', 3), ('living_area', '&gt;', 200)]"/>
                <filter string="Available" name="available" domain="['|', ('state', 'ilike', 'new'), ('state', 'ilike', 'offer received')]"/>
                <separator/>
                <filter string="Not Sold" name="not_sold" domain="[('state', '!=', 'sold')]"/>
                <group>
                    <filter string="Number of bedrooms" name="bedrooms" context="{'group_by': 'bedrooms'}"/>
                    <separator/>
                    <filter string="Garage" name="garage" context="{'group_by': 'garage'}"/>
                    <separator/>
                    <filter string="Date Available" name="date_available" context="{'group_by': 'date_availability:month'}"/>
                    <separator/>
                    <filter string="Garage" name="garage" context="{'group_by': 'garage'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="estate_properties_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.properties</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1, 'search_default_flexible': 1}</field>
    </record>
</odoo>
