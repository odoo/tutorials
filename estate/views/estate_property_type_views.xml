<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_action_offers" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id.type_id', '=', active_id)]</field>
    </record>

    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">estate.property.type.view.list</field>
        <field name="model">estate.type</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">estate.property.type.view.form</field>
        <field name="model">estate.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                type="action"
                                name="%(estate_property_type_action_offers)d"
                                icon="fa-money">
                            <field name="offer_count" string="Offers" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <notebook>
                            <page string="Properities">
                                <group>
                                    <field name="property_ids" nolabel="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="expected_price"/>
                                            <field name="state"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>