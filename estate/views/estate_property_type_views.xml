<?xml version="1.0"?>
<odoo>
    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">Property Types</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Properties">
                <header>
                    <!-- This looks a bit cursed, maybe there's a way to make it cleaner? -->
                    <button name="action_open_related_offers" type="object" icon="fa-money" class="oe_stat_button oe_right" invisible="offer_count == 0"> Offers: <field name="offer_count"/></button> 
                </header>
                <h1>
                    <field name="name"></field>
                </h1>
                <field name="property_ids">
                    <list>
                        <field name="name"/>
                        <field name="expected_price"/>
                        <field name="state"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
