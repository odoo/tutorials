<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <data>
        <record id="estate_property_type_views_form" model="ir.ui.view">
            <field name="name">estate_property_type_views_form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="name" />
                        </h1>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="estate_type_search_view">
            <field name="name">estate_type_search_view</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <separator />
                    <filter string="Type" name="name" />
                    <group>
                        <filter string="Nmae" name="name" context="{'group_by':'name'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="estate_property_type_views" model="ir.actions.act_window">
            <field name="name">Property Types</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>