<?xml version="1.0"?>
<odoo>

    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Type</field>
        <field name="res_model">estate_property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">estate_properties.type.view.list</field>
        <field name="model">estate_property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">estate_property.type.view.form</field>
        <field name="model">estate_property.type</field>
        <field name="arch" type="xml">
            <form string="Estate Property Type">
                <sheet>
                    <h1><field name="name"/></h1>
                    <notebook>
                        <page name="Properties">
                            <field name="property_ids">
                                <list create="false" delete="false">
                                    <field name="name"/>
                                    <field name="expected_price"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
