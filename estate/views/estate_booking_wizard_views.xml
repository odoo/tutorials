<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_estate_booking_wizard_form" model="ir.ui.view">
        <field name="name">estate.booking.wizard.form</field>
        <field name="model">estate.booking.wizard</field>
        <field name="arch" type="xml">

            <form string="Book Property">

                <group>
                    <field name="property_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="sold_price" readonly="1"/>
                    <field name="booking_percentage"/>
                    <field name="booking_amount" readonly="1"/>
                    <field name="remaining_amount" readonly="1"/>
                </group>

                <footer>
                    <button
                        name="action_confirm_booking"
                        string="Confirm Booking"
                        type="object"
                        class="btn btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>

            </form>

        </field>
    </record>

</odoo>