<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_wizard" model="ir.actions.act_window">
        <field name="name">Launch the Wizard</field>
        <field name="res_model">estate.property.offer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="estate_property_offer_form_wizard" model="ir.ui.view">
        <field name="name">estate_property_offer_form_wizard</field>
        <field name="model">estate.property.offer.wizard</field>
        <field name="arch" type="xml">
            <form string="offers">
                <sheet>
                    <group string="Offer Details">
                        <field name="price"/>
                        <field name="partner_id"/>
                        <footer>
                            <button name="action_create_offers" type="object" class="btn btn-primary">add</button>
                        </footer>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>