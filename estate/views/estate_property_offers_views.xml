<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offers_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="price"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offers_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="price desc">
                <field name="partner_id"/>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button
                    name="action_accept_offer"
                    type="object"
                    icon="fa-check"
                    title="Accept"
                    invisible="is_button_hidden"
                />
                <button
                    name="action_refuse_offer"
                    type="object"
                    icon="fa-times"
                    title='Refused'
                    invisible="is_button_hidden"
                />
                <field name="status" readonly="1"/>
                <control>
                    <create string="Add an Offer"/>
                </control>
            </list>
        </field>
    </record>
</odoo>
