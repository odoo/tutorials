<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_offers_form" model="ir.ui.view">
        <field name="name">estate.property.view.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_offers_list" model="ir.ui.view">
        <field name="name">estate.property.view.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept" type="object" icon="check" title="Accept"/>
                <button name="action_refuse" type="object" icon="close" title="Refuse"/>
                <field name="status"/>
            </list>
        </field>
    </record>
</odoo>
