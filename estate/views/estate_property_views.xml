<?xml version='1.0'?>
<odoo>
    <record id='estate_property_action' model='ir.actions.act_window'>
        <field name='name'>All Properties</field>
        <field name='res_model'>estate.property</field>
        <field name='view_mode'>list,form</field>
    </record>

    <record id='estate_property_view_list' model='ir.ui.view'>
        <field name='name'>estate.property.list</field>
        <field name='model'>estate.property</field>

        <field name='arch' type='xml'>
            <list>
                <field name='name' width='auto'/>
                <field name='postcode' width='auto'/>
                <field name='bedrooms' width='auto'/>
                <field name='living_area' string='Living Area (sqm)' width='auto'/>
                <field name='expected_price' width='auto'/>
                <field name='selling_price' width='auto'/>
                <field name='date_availability' width='auto'/>
            </list>
        </field>
    </record>

    <record id='estate_property_view_form' model='ir.ui.view'>
        <field name='name'>estate.property.form</field>
        <field name='model'>estate.property</field>

        <field name='arch' type='xml'>
            <form>
                <header>
                    <button name="action_sold" type="object" string="Sold" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" class="oe_highlight"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Estate Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" placeholder="Select a tag."/>
                    </group>


                    <group>
                        <group>
                            <field name="state" readonly="1" />
                            <field name="type_id" placeholder="eg. House"/>
                            <field name='postcode' placeholder="eg. 1234"/>
                            <field name='date_availability'/>
                        </group>

                        <group>
                            <field name='expected_price'/>
                            <field name="best_offer"/>
                            <field name='selling_price'/>
                        </group>
                    </group>

                    <notebook>
                        <page string='Description'>
                            <group>
                                <field name="description" placeholder="Write a short description of the property."/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation" placeholder="Select an orientation."/>
                                <field name="total_area" text="Total Area (sqm)"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id" placeholder="Select the buyer."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <filter name="state"
                        string="Available"
                        domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"
                />

                <filter name="postcode"
                        string="Postcode"
                        context="{'group_by':'postcode'}"
                />
            </search>
        </field>
    </record>
</odoo>
