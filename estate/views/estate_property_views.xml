<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate action</field>
        <field name="res_model">estate.property</field>
        <field name="context">{'search_default_available': True}</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban string="Properties (kanban)" default_group_by="property_type_id" groups_draggable='0' records_draggable='0'>
                <templates>
                    <t t-name="card">
                        <h1>
                            <field name="name"/>
                        </h1>
                        <field name="state"/>
                        <separator/>
                        <div>
                            Expected price: <field name="expected_price"/>
                        </div>
                        <separator/>
                        <div invisible="not best_offer">
                            Best offer: <field name="best_offer"/>
                        </div>
                        <separator/>
                        <div invisible="not selling_price">
                            Selling price: <field name="selling_price"/>
                        </div>
                        <separator/>
                        <div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'on_tag_click': 'edit_color'}"/>
                        </div>
                     </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="List of properties"
                  decoration-success="state in ['accepted', 'received']"
                  decoration-bf="state == 'accepted'"
                  decoration-muted="state == 'sold'"
            >
                <field name="name"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="state"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_set_sold" type="object" string="Sell it!" class="oe_highlight" invisible="state == 'sold'"/>
                    <button name="action_set_cancelled" type="object" string="Cancel" class="oe_highlight" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,received,accepted,sold"/>
                </header>
                <h1>
                    <field name="name"/>
                </h1>
                <separator/>
                <group>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </group>
                <group>
                    <field name="property_type_id" options="{'no_create': true, 'no_open': true}"/>
                </group>
                <group>
                    <group>
                        <field name="postcode"/>
                    </group>
                     <group>
                        <field name="date_availability" optional="hide"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="expected_price"/>
                    </group>
                    <group>
                        <field name="selling_price"/>
                    </group>
                    <group>
                        <field name="best_offer"/>
                    </group>
                </group>
                <notebook>
                    <page string="Description">
                        <group>
                            <field name="description"/>
                            <field name="bedrooms"/>
                            <field name="living_area"/>
                            <field name="facades"/>
                            <field name="garage"/>
                            <field name="garden"/>
                            <field name="garden_area" invisible="garden == False"/>
                            <field name="garden_orientation" invisible="garden == False"/>
                            <field name="state"/>
                            <field name="active"/>
                            <field name="total_area"/>
                        </group>
                    </page>
                    <page string="Offers">
                        <group>
                            <field name="offer_ids" readonly="state in ['accepted', 'cancelled', 'sold']"/>
                        </group>
                    </page>
                    <page string="Other info">
                        <group>
                            <field name="salesperson_id"/>
                            <field name="buyer_id"/>
                        </group>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Property">
                <field name="name"/>
                <field name="postcode"/>
                <field name="property_type_id"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"
                       filter_domain="[('living_area', '>=', self)]"
                       string="With living area greater or equal to (sqm)"
                />
                <field name="facades"/>

                <filter
                        name="filter_available"
                        string="Available"
                        domain="['|', ('state', '=', 'new'), ('state', '=', 'received'), ]"
                />

                <group name="group_by">
                    <filter name="group_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
