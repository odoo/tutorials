<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">View Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="available_from"/>
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <header>
                        <button name="action_sold" string="Sold" type="object" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <h1>
                        <field name="name" string="Ttile"/>
                    </h1>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <group>
                        <group>
                            <field name="postcode"/>
                            <field name="property_type_id"/>
                            <field name="available_from"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="total_area"/>
                                <field name="garden_orientation"/>
                            </group>
                        </page>
                        <page string="Sales">
                            <group>
                                <field name="buyer_id"/>
                                <field name="user_id"/>
                            </group>
                        </page>
                        <page string="offers">
                            <field name="offer_ids">
                                <list>
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>
                                    <button name="accept_offer" type="object" icon="fa-check" string="Accept" attrs="{'invisible':[('status', '!=', 'pending')]}"/>
                                    <button name="reject_offer" type="object" icon="fa-times" class="btn-danger" title="Refuse Offer" attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Estate Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="garden_orientation"/>
                <field name="state"/>
                <separator/>
                <filter name="available" string="Available" domain="[
                    '|',
                    ('state', '=', 'new'),
                    ('state', '=', 'offer_received')
                    ]" />
                <separator/>
                <filter name="group_by_garden" string="group by garden" context="{'group_by': 'garden'}" />
            </search>
        </field>
    </record>
</odoo>
