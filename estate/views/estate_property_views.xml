<odoo>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Tests">
                <field name="name" string="Title"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="property_tags_ids" widget="many2many_tags"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Test">
                <header>
                    <button name="action_mark_as_sold" type="object" string="SOLD"/>
                    <button name="action_mark_as_canceled" type="object" string="CANCEL"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" nolabel="1" limit="80"/>
                    </group>
                    <group>
                        <field name="property_tags_ids" nolabel="1" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="state" string="Status"/>
                        </group>
                        <group>
                            <field name="property_type_id" string="Property Type"/>
                        </group>
                        <group>
                            <field name="postcode" string="Postcode"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price"/>
                        </group>
                        <group>
                            <field name="best_offer" string="Best Offer"/>
                        </group>
                        <group>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="selling_price" string="Selling Price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garage" string="Garage"/>
                                <field name="garden" string="Garden"/>
                                <field name="garden_area" string="Garden Area (sqm)"/>
                                <field name="garden_orientation" string="Garden Orientation"/>
                                <field name="total_area" string="Total Area (sqm)"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Ohter Info">
                            <group>
                                <field name="seller_id" string="Salesman"/>
                                <field name="buyer_id" string="Buyer"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Tests">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="facades" string="Facades"/>

                <filter string="Available" name="state" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]"/>
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Real estates</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>