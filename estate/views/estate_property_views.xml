<?xml version="1.0"?>
<odoo>
    <!--_________________________________________   WINDOW ACTION _________________________________________-->

    <record id="test_property_action" model="ir.actions.act_window">
        <field name="name">Property Action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>

        <field name="context">{'search_default_available_properties':1}</field>
    </record>


    <!--_________________________________________ LIST VIEW _________________________________________-->
    <record id="real_estate_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Tags" decoration-danger="state and state == 'cancelled'" limit="20" decoration-success="state and state == 'offer_accepted'">
                <field name="name" string="Property Title"/>
                <field name="postcode" width="96px"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades" optional="hide"/>
                <field name="garage" widget="checkbox" optional="hide" width="36px"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
            </list>
        </field>
    </record>

    <!--_________________________________________   FORM VIEW _________________________________________-->
    <record id="real_estate_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <header>
                    <field name="state" widget="statusbar" class="oe_inline_end" statusbar_visible="new,offer_accepted,offer_received,sold,cancelled" options="{'clickable': True}"/>
                    <button name="action_property_sold" type="object" string="Sold" class="btn-primary" />
                    <button name="action_property_cancelled" type="object" string="Cancel"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Property Title"/>
                    </h1>
                    <label for="tag_ids"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                    <separator/>
                    <group>
                        <group>
                            <field name="property_type_id"/>
                            <field name="selling_price"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="postcode" width="96px" class="oe_inline oe_left"/>
                            <field name="expected_price" class="oe_inline oe_right"/>
                            <field name="best_price" class="oe_inline oe_right"/>

                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" placeholder=" Brief description of the real estate property"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage" widget="checkbox"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="total_area"/>
                                <field name="garden_orientation" widget="radio"/>
                            </group>
                        </page>
                        <page name="offers" string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesman" widget="many2one_avatar_user"/>
                                <field name="buyer" widget="many2one_avatar_user"/>

                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--_________________________________________   SEARCH VIEW _________________________________________-->


    <record id="view_real_estate_search" model="ir.ui.view">
        <field name="name">real.estate.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <separator/>
                <filter string="Date Availability" name="Date Availability" date="date_availability"/>
                <filter name="available_properties" string="Available" domain="['|', ('state','=','offer_received'), ('state','=','new')]"/>
                <group>
                    <filter string="Postcode" name="group_by_postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
