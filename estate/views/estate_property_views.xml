<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="estate_property_view" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_propert_list_view" model="ir.ui.view">
        <field name="name">Estate property list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title" />
                <field name="postcode" string="Postcode" />
                <field name="bedrooms" string="Bedrooms" />
                <field name="living_area" string="Living area (sqm)" />
                <field name="expected_price" string="Expected Price" />
                <field name="selling_price" string="Selling Price" />
                <field name="date_availability" string="Available From" />
                <field name="property_type_id" string="Property type" />
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">Estate property from view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_on_sold_button" type="object" string="SOLD" />
                    <button name="action_on_cancel_button" type="object" string="CANCEL" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name" />
                        </h1>
                        <h5>
                            <group>
                                <field name="tag_id" widget="many2many_tags" />
                            </group>
                        </h5>
                    </div>
                    <group>
                        <group>
                            <field name="state" string="Status"
                                readonly="state in ['sold', 'cancelled']" />
                            <field name="property_type_id" string="Property type" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_price" string="Best Offer" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description" string="Description" />
                                    <field name="bedrooms" string="Bedrooms" />
                                    <field name="living_area" string="Living area (sqm)" />
                                    <field name="facades" string="Facades" />
                                    <field name="garage" string="Garage" />
                                    <field name="garden" string="Garden" />
                                    <field name="garden_area" string="Garden area (sqm)" />
                                    <field name="garden_orientation" string="Garden Orientation" />
                                    <field name="total_area" string="Total Area (sqm)" />
                                </group>
                            </page>
                            <page string="offer">
                                <field name="offer_ids">
                                    <list>
                                        <field name="price" string="Price" />
                                        <field name="partner_id" string="partner" />
                                        <field name="validity" string="Validity (days)" />
                                        <field name="date_deadline" string="Deadline" />
                                        <button name="action_property_sold" type="object" string=""
                                            icon="fa-check" />
                                        <button name="action_property_cancel" type="object"
                                            string="" icon="fa-times" />
                                        <field name="status" string="Status" />
                                    </list>
                                </field>
                            </page>
                            <page string="Other info">
                                <group>
                                    <field name="salesperson" string="Salesman" />
                                    <field name="buyer" string="Buyer" />
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">search.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title" />
                <field name="postcode" string="Postcode" />
                <field name="expected_price" string="Expected Price" />
                <field name="bedrooms" string="Bedrooms" />
                <field name="living_area" string="Living area (sqm)" />
                <field name="facades" string="Facades" />
                <filter name="group_by_postcode" string="Postcode"
                    context="{'group_by': 'postcode'}" />
                <filter name="filter_availability" string="Availability"
                    domain="[('state','=','new'),('state','=','offer_received')]" />
                <field name="property_type_id" string="Property type" />
            </search>
        </field>

    </record>
</odoo>