<?xml version="1.0"?>
<odoo>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" />
                <separator />

            </search>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_set_as_sold" type="object" string="Sold" invisible="stage in ['sold','cancelled']"/>
                    <button name="action_set_as_cancelled" type="object" string="Cancel" invisible="stage in ['sold','cancelled']"/>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Sold" bg_color="text-bg-success" invisible="stage != 'sold'"/>
                    <div class="oe_title">
                        <group col="2">
                            <group>
                                <h1 class="mb16">
                                    <field name="name" placeholder="Apartment Bellevue"/>
                                </h1>
                            </group>
                            <group>
                                <field name="tag_ids" class="mb16" widget="many2many_tags" options="{'color_field': 'color'}" />
                            </group>
                        </group>
                    </div>
                    <group col="2">
                        <group>
                            <field name="property_type_id" />
                            <field name="postcode" />
                            <field name="available_from" />
                            <field name="total_area" />
                        </group>
                        <group>
                            <field name="expecting_price" options="{'currency_field': 'currency_id'}" />
                            <field name="best_offer" widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="selling_price" options="{'currency_field': 'currency_id'}" />
                            <field name="currency_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedroom_number" invisible="not property_livable" />
                                <field name="living_area" invisible="not property_livable" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" invisible="not garden" />
                                <field name="garden_orientation" invisible="not garden" />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="seller_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" sample="1">
                <field name="name" />
                <field name="property_type_id" />
                <field name="expecting_price" />
                <field name="selling_price" />
                <field name="bedroom_number" />
                <field name="total_area" />
                <field name="stage" />
            </list>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
