<odoo>
    <record id="estate_property_action1" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">estate_property</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate_property_list</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_available" string="Available From"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate_property_form</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="property_tag_ids" widget="many2many_tags"/>
                        <group>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_available" string="Available from"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area (sqm)"/>
                                <field name="garden_orientation"/>
                                <field name="total_area" string="Total Area (sqm)"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesman_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_estate_view_search" model="ir.ui.view">
        <field name="name">estate_property_search</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <separator/>
                <filter name="available_properties" string="Available properties"
                        domain="[('state','in', ('offerRecieved','new'))]"/>
                <separator/>
                <filter name="group_by_postcode" string="Post code" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>
</odoo>

