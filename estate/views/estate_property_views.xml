<odoo>
    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties"
                decoration-bf="state == 'accepted'"
                decoration-success="state in ('offer_received','accepted')"
                decoration-muted="state == 'sold'"
                decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="state"/>
                <field name="tag_ids" 
                    widget="many2many_tags" 
                    options="{'color_field': 'color',
                    'on_tag_click': 'edit_color'}"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price" optional="hide"/>
                <field name="date_availability" string="Available from" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Edit Property">
                <header>
                    <button name="action_set_sold"
                            type="object"
                            string="Sold"
                            class="btn-primary"
                            invisible="state in ('sold', 'cancelled')"/>

                    <button name="action_set_cancelled"
                            type="object"
                            string="Cancel"
                            invisible="state in ('sold', 'cancelled')"/>

                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="new,offer_received,sold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tag_ids" 
                                widget="many2many_tags" 
                                options="{'color_field': 'color',
                                'on_tag_click': 'edit_color'}"/>
                            <field name="postcode"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                            <field name="date_availability"/>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Details">
                                <group>
                                    <field name="property_type"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area" string="Living Area (sqm)"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="state"/>
                                </group>
                                <group invisible="not garden">
                                    <field name="garden_area" string="Garden Area (sqm)"/>
                                    <field name="garden_orientation"/>
                                </group>
                                <group>
                                    <field name="total_area"/>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids"/>
                            </page>
                            <page string="More infos">
                                <field name="user_id"/>
                                <field name="partner_id"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="THIS A TEST">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" operator=">="/>
                <field name="facades"/>
                <separator/>
                    <filter string="new or sold" name="state" domain="[('state', 'in', ['new', 'sold'])]"/>
                    <filter name="available" string="Available" domain="[('state', 'not in', ['sold', 'cancelled'])]"/>
                <group>
                    <filter string="By postcode" name="group_by_postcode" context="{'group_by':'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban  
                default_group_by="property_type"
                records_draggable="False"
                groups_draggable="False">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name"/>
                        <div>
                            Expected price: <field name="expected_price"/>
                        </div>
                        <div t-if="record.state.raw_value =='offer_received'">
                            Best price: <field name="best_price"/>
                        </div>
                        <div t-if="record.state.raw_value =='sold'">
                            Selling price: <field name="selling_price"/>
                        </div>
                        <field name="tag_ids"
                            widget="many2many_tags" 
                            options="{'color_field': 'color',
                                'on_tag_click': 'edit_color'}"/>
                        <div t-if="record.state.raw_value == 'new'">
                            <p><b>NEW</b></p>
                        </div>
                    </t>
                </templates>                
            </kanban>
        </field>
    </record>

    <record id="estate_property_kanban_action" model="ir.actions.act_window">
        <field name="name">kanban</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban, form, list</field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate test action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_report_action" model="ir.actions.act_window">
        <field name="name">Available Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="estate_property_view_search"/>
        <field name="context">{'search_default_available':1}</field>
    </record>
</odoo>
