<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Real Estate Properties</field>
        <field name="res_model">x_estate.property</field>    
        <field name="view_mode">list,form</field>
    </record>

     <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name" width="200"/>
                <field name="x_postcode" width="100"/>
                <field name="x_bedrooms"/>
                <field name="x_living_area"/>
                <field name="x_expected_price"/>
                <field name="x_selling_price"/>
                <field 
                    name="x_date_availability"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <form string="Form">
                <sheet>
                    <div class="oe_title mb32">
                        <h1 class="mb16">
                            <field name="x_name"/>
                        </h1>
                        <field 
                            name="x_property_tag_ids" 
                            widget="many2many_tags" 
                        />
                        <field name="x_api_published" />
                    </div>
                    <group>
                        <group>
                            <field name="x_property_type_id"/>
                            <field name="x_postcode"/>
                            <field name="x_date_availability"/>
                        </group>
                        <group>
                            <field name="x_expected_price"/>
                            <field name="x_selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="x_description"/>
                                    <field name="x_bedrooms"/>
                                    <field name="x_living_area"/>
                                    <field name="x_facades"/>
                                    <field name="x_garage"/>
                                </group>
                                <group>
                                    <field name="x_garden"/>
                                    <field name="x_garden_area" invisible="not x_garden"/>
                                    <field name="x_garden_orientation" invisible="not x_garden"/>
                                    <field name="x_total_area"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <field 
                                name="x_property_offer_ids"
                                context="{'list_view_ref': 'estate.estate_property_offer_list'}"
                            />
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="x_user_id"/>
                                <field name="x_partner_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
