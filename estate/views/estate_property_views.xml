<odoo>
    <record id="estate_property_action1" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="view_mode">list,form</field>
        <field name="res_model">estate_property</field>
        <field name="context">{'search_default_available_properties': True}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate_property_list</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <list decoration-bf="state=='offerAccepted'" decoration-muted="state=='sold'"
                  decoration-success="state in ['offerRecieved','offerAccepted']">
                <field name="state" column_invisible="True"/> <!-- Required for decoration-bf, decoration-muted and decoration-success on the list element -->
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="property_tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_available" string="Available From" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate_property_form</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="mark_property_sold" type="object" string="Sold" class="btn-link"
                            invisible="state in ['cancelled','sold']"/>
                    <button name="mark_property_cancelled" type="object" string="Cancelled" class="btn-link"
                            invisible="state in ['cancelled','sold']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offerRecieved,offerAccepted,sold"
                           options="{'clickable':1}"/></header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="property_tag_ids" widget="many2many_tags" options="{'color_field':'color'}"/>
                        <group>
                            <field name="property_type_id" options="{'no_create':True, 'no_open':True}"/>
                            <field name="postcode"/>
                            <field name="date_available" string="Available from"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area" string="Total Area (sqm)"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state not in ['new','offerRecieved']"/>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesman_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_estate_view_search" model="ir.ui.view">
        <field name="name">estate_property_search</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area','>=',self)]"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <separator/>
                <filter name="available_properties" string="Available properties"
                        domain="[('state','in', ('offerRecieved','new'))]"/>
                <separator/>
                <filter name="group_by_postcode" string="Post code" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>
</odoo>
