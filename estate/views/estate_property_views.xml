<?xml version="1.0"?>
<odoo>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
    </record>

    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name" string="Title"></field>
                <field name="postcode"></field>
                <field name="bedrooms"></field>
                <field name="living_area" string="Living Area (sqm)"></field>
                <field name="expected_price"></field>
                <field name="selling_price"></field>
                <field name="date_availability" string="Available From"></field>
            </list>
        </field>
    </record>

    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                     <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name" placeholder="Property Name" class="mb16"></field>
                        </h1>
                     </div>
                    <group>
                        <group>
                            <field name="postcode"></field>
                            <field name="date_availability" string="Available From"></field>
                        </group>
                        <group>
                            <field name="expected_price"></field>
                            <field name="selling_price"></field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"></field>
                                <field name="bedrooms"></field>
                                <field name="living_area" string="Living Area (sqm)"></field>
                                <field name="facades"></field>
                                <field name="garage"></field>
                                <field name="garden"></field>
                                <field name="garden_area" string="Garden Area (sqm)"></field>
                                <field name="garden_orientation"></field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
</odoo>
