<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- LIST VIEW -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.list.view</field>
        <!-- Model to which this view is linked -->
        <field name="model">estate.property</field>
        <!-- Architecture of the view written in XML -->
        <field name="arch" type="xml">
            <!-- string = title shown in UI -->
            <list string="Properties"
                  decoration-success="state in ['offer_accepted', 'sold']"
                  decoration-bf="state == 'offer_received'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="property_type_id" class="w-50"/>
                <field name="postcode" class="w-50"/>
                <field name="bedrooms" class="w-50"/>
                <field name="living_area" class="w-50"/>
                <field name="expected_price" class="w-50"/>
                <field name="selling_price" optional="hide"/>
                <field name="salesperson_id"/>
                <field name="buyer_id"/>
                <field name="state"/>
                <field name="best_price"/>
                <field name="date_availability" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM VIEW ============ -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" string="Sold"
                            class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>
                </header>
                <sheet>
                    <!-- Title at top -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                        <field name="tag_ids"
                               placeholder="Property tags"
                               widget="many2many_tags"
                               options="{'color_field': 'color'}"/>
                    </div>
                    <!-- Two-column main group -->
                    <group>
                        <group string="Property Details">
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group string="Pricing">
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                            <!--                            <field name="state"/>-->
                            <field name="active"/>
                        </group>
                    </group>
                    <!-- Notebook tabs -->
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <field name="salesperson_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids"/>
                            <field name="salesperson_id"/>
                            <field name="buyer_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--     SEARCH VIEW-->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <!-- Searchable fields -->
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="facades"/>
                <field name="garden_orientation"/>
                <field name="active"/>
                <field name="state"/>
                <field name="buyer_id"/>
                <field name="best_price" operator=">="/>
                <!-- filter -->
                <filter string="Archived" domain="[('active', '=', False)]" name="archive"/>
                <filter string="1 Bedroom &amp; 1 Garage" name="1BG"
                        domain="[('bedrooms', '=',1),('garage', '=', True)]"/>
                <filter string="Postcode" name="postcode" domain="[('postcode', '/', '1')]"/>
                <separator/>
                <filter string="Under Budget" name="budget" domain="[('expected_price', '&lt;=', 500000)]"/>
                <separator/>
                <filter string="Available" name="available"
                        domain="[('state', 'in', ('new', 'offer_received'))]"/>
                <separator/>
                <filter string="Expensive" name="highest_price"
                        domain="[('expected_price', '&gt;',1000000 )]"/>
                <separator/>
                <!-- Group by shortcuts -->
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
                    <separator/>
                    <filter string="Number of bedrooms" name="bedrooms" context="{'group_by': 'bedrooms'}"/>
                    <separator/>
                    <filter string="Garage" name="garage" context="{'group_by': 'garage'}"/>
                    <separator/>
                    <filter string="Date Available" name="date_available"
                            context="{'group_by': 'date_availability:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>
