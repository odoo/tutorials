<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state in ['offer_received','offer_accepted']"
                decoration-bf="state == 'offer_accepted'"
                decoration-muted="state == 'sold'"
            >
                <field name="property_type_id" string="Property Type" />
                <field name="name" string="Title" />
                <field name="postcode" />
                <field name="tag_ids" widget="many2many_tags"
                    options="{'color_field': 'color'}" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" optional="hide" />
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="properties">
                <header>
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"
                        options="{'clickable': '1'}"
                    />

                    <button string="Sold" name="sold" type="object" class="btn-success" />
                    <button string="Cancel" name="cancel" type="object" class="btn-danger" />
                    <button string="Accept Best" name="accept_best_offer" type="object" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                            name="%(estate_property_meeting_action)d"
                            type="action"
                            icon="fa-tag">
                            <field name="meeting_count" string="meetings" widget="statinfo" />
                        </button>
                    </div>
                    <group name="name">
                        <field name="state" />
                        <field name="property_type_id" string="Property Type"
                            options="{'no_create': True,'no_create_edit':True}" />
                        <field name="name" />
                        <field name="tag_ids" widget="many2many_tags"
                            options="{'color_field': 'color'}" />
                        <field name="postcode" />
                        <field name="date_availability" />
                        <field name="best_price" string="Best Price" />
                    </group>
                    <group>
                        <field name="expected_price" string="Expected Price" />
                        <field name="selling_price" string="Selling Price" />
                    </group>
                    <notebook>
                        <page name="Description" string="Description">
                            <group name="name" string="Enter the required fields">
                                <field name="description" string="Description" />
                                <field name="bedrooms" string="Bedrooms" />
                                <field name="living_area" string="Living Area" />
                                <field name="facades" string="Facades" />
                                <field name="garage" string="Garage" />
                                <field name="garden" string="Garden" />
                                <field name="garden_area" string="Garden Area" />
                                <field name="garden_orientation" string="Garden Orientation" />
                                <field name="total_area" string="Total Area" />
                            </group>
                        </page>
                        <page name="Offers" string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom"
                                    decoration-danger="status == 'offer_rejected'"
                                    decoration-success="status == 'offer_accepted'">
                                    <field name="price" />
                                    <field name="partner_id" />
                                    <field name="status" />

                                    <button string="accept"
                                        name="accept"
                                        type="object"
                                        icon="fa-check"
                                        class="btn-success"
                                        invisible="status in ['offer_accepted', 'offer_rejected']" />

                                    <button string="reject"
                                        name="reject"
                                        type="object"
                                        icon="fa-times"
                                        class="btn-danger"
                                        invisible="status in ['offer_accepted', 'offer_rejected']" />

                                </list>
                            </field>
                        </page>
                        <page name="other_info" string="Other Info">
                            <group>
                                <field name="salesman_id" string="Salesman" />
                                <field name="buyer_id" string="Buyer" />
                            </group>
                        </page>

                        <page string="Requests">
                            <field name="request_ids">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="technician_id" />
                                    <field name="estimated_cost" />
                                    <field name="state" />

                                    <button name="action_start"
                                        type="object"
                                        string="Start"
                                        invisible="state != 'assigned'"
                                        class="btn-primary" />

                                    <button name="action_stop"
                                        type="object"
                                        string="Stop"
                                        invisible="state != 'inprogress'"
                                        class="btn-success" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>

                <filter
                    name="available"
                    string="Available"
                    domain="[
                        '|',
                        '|',
                        ('state', '=', 'new'),
                        ('state', '=', 'offer_received'),
                        ('active','=', 'True')
                    ]"
                />
                <field name="name" string="Title" />
                <field name="postcode" string="Postcode" />
                <field name="expected_price" string="Expected Price" />
                <field name="bedrooms" string="Bedrooms" />
                <field name="living_area" string="Living Area"
                    filter_domain="[('living_area', '>=', self)]"
                />
            </search>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
