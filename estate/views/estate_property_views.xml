<odoo>
    <record id="estate_model_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">estate_model</field>
    </record>

    <!-- listview -->
    <record id="estate_model_list" model="ir.ui.view">
        <field name="name">estate_model.list</field>
        <field name="model">estate_model</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="name" />
                <field name="property_type_id" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
            </list>
        </field>
    </record>

    <!-- formview -->
    <record id="estate_model_form" model="ir.ui.view">
        <field name="name">estate_model.form</field>
        <field name="model">estate_model</field>
        <field name="arch" type="xml">
            <form>

                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="property_tag_id" widget="many2many_tags" string="Property Tag"/>
                            <field name="property_type_id" />
                            <field name="postcode" />
                            <field name="expected_price" />
                        </group>
                        <group>
                            <field name="date_availability" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description" />
                                    <field name="bedrooms" />
                                    <field name="living_area" />
                                    <field name="facades" />
                                </group>
                                <group>
                                    <field name="garage" />
                                    <field name="garden" />
                                    <field name="garden_orientation" />
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offers_id" string=""/>
                            </group>
                        </page>
                        <page string="More Info">
                            <group>
                                <field name="partner_id" string="Salesperson"/>
                                <field name="buyer_id" string="Buyer"/>
                            </group>

                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <!-- search view -->
    <record id="estate_model_search" model="ir.ui.view">
        <field name="name">estate_model.search</field>
        <field name="model">estate_model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <field name="last_seen" />
                <field name="selling_price" />
                <field name="last_seen" />
                <field name="garden" />
                <field name="garage" />
                <filter string="State" name="state" domain="['|', ('state', '=', 'new') ,('state', '=', 'offer received')]" />
                <filter string="Garage" name="garage" domain="[('garage', '=', True)]" />
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by': 'postcode'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>
