<odoo>
    <record id="estate_property_action_view" model="ir.actions.act_window">
        <field name="name">estate.property.main.action</field>
        <field name="res_model">estate.property</field>
        <field name="context">{'search_default_available': True, 'search_default_current': True}</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state in ('offer received', 'offer accepted')"
                decoration-bf="state=='offer accepted'"
                decoration-muted="state=='sold'">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" optional="hide" />
            </list>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="last_seen" />
                <field name="living_area" string="Living Area"
                    filter_domain="[('living_area', '>=', self)]" />
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" />
                <filter string="Available properties" name="available"
                    domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]" />
                <group>
                    <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban create="False" edit="False" default_group_by="property_type_id"
                records_draggable="False">
                <field name="state" />
                <templates>
                    <t t-name="card">
                        <div>
                            <h3>
                                <field name="name" />
                            </h3>
                            <field name="expected_price" />
                            <field name="tags_ids" widget="many2many_tags"
                                options="{'color_field': 'color'}" />
                            <div t-if="record.state.raw_value == 'offer received'">
                                <field name="best_price" />
                            </div>
                            <div t-if="record.state.raw_value == 'offer accepted'">
                                <field name="selling_price" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold" type="object" string="Sold"
                        invisible="state not in ('offer received', 'offer accepted', 'new')" />
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state not in ('offer received', 'offer accepted', 'new')" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="mb16" />
                        </h1>
                        <field name="tags_ids" widget="many2many_tags"
                            options="{'color_field': 'color'}" class="mb16" />
                    </div>
                    <group>
                        <group>
                            <field name="state" />
                            <field name="property_type_id"
                                options="{'no_create': True, 'no_open': True}" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_price" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" invisible="garden == False" />
                                <field name="garden_orientation" invisible="garden == False" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"
                                readonly="state in ('offer accepted', 'sold', 'cancelled')" />
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>