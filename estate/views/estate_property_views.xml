<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.estate</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.estate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="type_id" records_draggable="0">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold fs-5 mb-1">
                            <field name="name"/>
                        </div>
                        <div class="text-muted mb-1">
                            Expected Price: <field name="expected_price"/>
                        </div>
                        <div t-if="record.state.raw_value == 'offer_received'" class="text-success fw-bold">
                            Best Offer: <field name="best_offer"/>
                        </div>
                        <div t-if="record.state.raw_value == 'offer_accepted'" class="text-primary fw-bold">
                            Selling Price: <field name="selling_price"/>
                        </div>
                        <footer class="pt-2 mt-auto">
                            <field name="tag_ids" options="{'color_field': 'color'}"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.estate</field>
        <field name="arch" type="xml">
            <list string="Properties"
                  decoration-success="state in ['offer_received', 'offer_accepted']"
                  decoration-bf="state == 'offer_accepted'"
                  decoration-muted="state == 'sold'"
            >
                <field name="name" string="Title" />
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.estate</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Create Property">
                <header>
                    <button string="Sold" title="Mark as sold" name="action_sell_property" type="object" invisible="state in ['sold', 'cancelled']"/>
                    <button string="Cancel" title="Mark as cancelled" name="action_cancel_property" type="object" invisible="state in ['sold', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new, offer_received, offer_accepted, sold"/>
                </header>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <separator/>
                    <group>
                        <group>
                            <field name="type_id" options="{'no_create': true}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_offer"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offer_ids" nolabel="1" readonly="state in ['offer_accepted', 'sold', 'cancelled']">
                                    <list editable="bottom" decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="validity"/>
                                        <field name="date_deadline"/>
                                        <button title="Accept offer" name="action_accept_offer" type="object" icon="fa-check" invisible="status"/>
                                        <button title="Refuse Offer" name="action_refuse_offer" type="object" icon="fa-times" invisible="status"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.estate</field>
        <field name="arch" type="xml">
            <search string="Estate Property Search">
                <field name="name"/>
                <field name="expected_price"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <field name="living_area" filter_domain="[('living_area', '&gt;=', self)]"/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"></filter>
                <group>
                    <filter string="Group by postcode" name="group_by_postcode" context="{'group_by':'postcode'}" ></filter>
                </group>
            </search>
        </field>
    </record>
</odoo>
