<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name" string="Title" width="150px" />
                <field name="estate_property_tag_ids" widget="many2many_tags"/>
                <field name="postcode" string="Postcode" width="100px"/>
                <field name="estate_property_type_id" string="Property Type"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area"/>
                <field name="expected_price" string="Expected Price" widget="monetary"/>
                <field name="selling_price" string="Selling Price"  widget="monetary"/>
                <field name="date_availability" string="Available From"/>
            </list>
            </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="My new house"/>
                        </h1>
                    </div>
                    <group>
                        <field name="estate_property_tag_ids" widget="many2many_tags"/>
                        <group string="Key Information">
                            <field name="estate_property_type_id" string="Property Type"/>
                            <field name="postcode" placeholder="e.g. 1000"/>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group string="Pricing">
                            <field name="expected_price" widget="monetary"/>
                            <field name="best_price" string="Best Offer" widget="monetary"/>
                            <field name="selling_price" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation" string="Garden Orientation"/>
                                <field name="total_area" string="Total Area " />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="estate_property_offer_ids">
                                <list string="offers list" >
                                    <field name='price'/>
                                    <field name='partner_id' width="150px"/>
                                    <field name="date_deadline" string="Deadline"/>
                                    <field name="validity"/>
                                    <field name='status' width="150px"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group col="4">
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Property">
                <field name="name" string="Title"/>
                <field name="estate_property_type_id" string="Property Type"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <separator/>
                <filter string="Available" name="available" domain="['|',('state', '=', 'new'),('state', '=', 'offer_received')]"/>                
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>
</odoo>
