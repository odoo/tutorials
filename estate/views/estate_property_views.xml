<?xml version="1.0"?>
<odoo>
    
    <record id="estate_property_model_action" model="ir.actions.act_window">
        <field name ="name">Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available':True}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Property list" decoration-bf="state == 'offer_accepted'" decoration-success="state == 'offer_accepted' or state == 'offer_recieved'" decoration-muted="state == 'sold'">
                <field name="name"/>
                <field name ="postcode"/>
                <field name ="bedrooms"/>
                <field name ="expected_price"/>
                <field name ="selling_price"/>
                <field name ="date_availability" optional="True"/>
            </list>
        </field>
    </record>

    <record id="estate_property_model_form" model="ir.ui.view">
        <field name ="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property list">
                <header>
                    <button name="sell_property" type="object" string="Sell" invisible="state == 'sold' or state == 'cancelled'"/>
                    <button name="cancel_property" type="object" string="Cancel" invisible="state == 'sold' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <h1 class="mb32">
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create_edit': true, 'no_quick_creat':true, 'no_create':true}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly=" state == 'sold' or state =='cancelled' or state == 'offer_accepted'"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="company_id"/>
                                <field name="buyer_id"/>
                                <field name="seller_id"/>   
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_model_search" model="ir.ui.view">
        <field name ="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Property search">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area','>=',int(self))]"/>
                <field name="facades"/>
                <filter string="Available" name="available" domain="['|',('state','=','Offer_Received'),('state','=','New')]"/>
                <filter string="Postcodes" name="postcodes" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <record id="estate_property_model_kanban" model="ir.ui.view">
        <field name ="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_edit='False' group_delete='False' groups_draggable='False' records_draggable='False'>
                <field name='state'/>
                <templates>
                    <t t-name="card">
                        <div>
                            <field name="name"/>
                            <p></p>
                            <field name="expected_price" string="Expected Price"/>
                            <div t-if="record.state.raw_value != 'new'">
                                <field name="best_price" string="Best Price"/>
                                <div t-if="record.state.raw_value != 'offer_received'">
                                    <field name="selling_price" string="Selling Price"/>
                                </div>
                            </div>
                            
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
