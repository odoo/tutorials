<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="500"/>
                <field name="property_type_id" width="100"/>
                <field name="postcode" width="100"/>
                <field name="tag_ids" widget="many2many_tags" width="100"/>
                <field name="bedrooms" width="100"/>
                <field name="living_area" width="100"/>
                <field name="expected_price" width="100"/>
                <field name="selling_price" width="100"/>
                <field name="date_availability" width="100"/>
                <field name="state" width="100"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold" string="Sold" type="object" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Property Name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="property_type_id"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garden"/>
                                <field name="garage"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area"/>
                                <field name="active"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"/>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                        </page>
                        <page string="Maintenance">
                            <field name="property_maintenance_ids">
                                <list create="False" edit="False"> 
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="priority"/>
                                    <field name="user_id"/>
                                    <field name="actual_cost"/>
                                    <field name="state"/>  
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="state"/>
                <progressbar field="state" colors='{"sold": "success", "cancelled": "danger", "new": "info", "offer_received": "warning", "offer_accepted": "success"}'/>
                <templates>
                    <t t-name="card">
                        <div>
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                        </div>
                        <div class="mt4">
                            Expected Price: <field name="expected_price"/>
                        </div>
                        <div t-if="record.state.raw_value == 'offer_received'">
                            Best Offer: <field name="best_price"/>
                        </div>          
                        <div t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                            Selling Price: <field name="selling_price"/>
                        </div>
                        <div class="mt4">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Property Search">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <filter string="Available" name="available" domain="[('state', 'in', ('new', 'offer_received'))]"/>
                <separator/>
                <filter string="Has garden" name="has_garden" domain="[('garden','=',True)]"/>
                <filter string="Has garage" name="has_garage" domain="[('garage','=',True)]"/>
                <group>
                    <filter string="Postcode" name="postcode" domain="[]" context="{'group_by': 'postcode'}"/>
                    <filter string="Property Type" name="property_type_id" domain="[]" context="{'group_by': 'property_type_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
