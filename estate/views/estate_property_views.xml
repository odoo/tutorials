<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action_view" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view"> 
        <field name="name">estate.property.view.search</field> 
        <field name="model">estate.property</field> 
        <field name="arch" type="xml">
        <search>
            <field name="name" string="Estate" />
            <field name="selling_price" />
            <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area', '%gt;=', self)]" />
            <separator />
            <filter string="Available" name="available" domain="[('state', 'not in', ('sold', 'cancelled'))]"/> 
            <group> 
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode', 'residual_visible':True}"/> 
            </group> 
        </search> 
        </field> 
    </record> 

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'sold'" decoration-success="state == 'received'" decoration-bf="state == 'accepted'">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" optional="True" />
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <group invisible="state == 'sold' or state == 'cancelled'">
                    <button type="object" name="action_state_sold" string="Sold" />
                    <button type="object" name="action_state_cancel" string="Cancel" />
                    </group>
                    <field name="state" string="" widget="statusbar" statusbar_visible="new,received,accepted,sold" />
                </header>
                <sheet>
                    <div>
                        <group class="mb-5">
                            <field name="name" string="" required="True" placeholder="My new house" class="fs-1" />
                            <field name="tag_ids" string="" widget="many2many_tags" options="{'color_field': 'color'}" />
                        </group>
                        <group>
                            <group>
                                <field name="property_type_id" options="{'no_quick_create': True, 'no_create_edit': True}" />
                                <field name="postcode" />
                                <field name="date_availability" string="Available From" />
                            </group>
                            <group>
                                <field name="expected_price" required="True" />
                                <field name="best_price" />
                                <field name="selling_price" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description" />
                                    <field name="bedrooms" />
                                    <field name="living_area" string="Living Area (sqm)" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden" />
                                    <field name="garden_area" string="Garden Area (sqm)" invisible="not garden" />
                                    <field name="garden_orientation" invisible="not garden" />
                                    <field name="total_area" string="Total Area (sqm)" />
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_ids" readonly="state in ('sold', 'cancelled')" />
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="seller_id" string="Salesman" />
                                    <field name="buyer_id" />
                                </group>
                            </page>
                        </notebook>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="False">
                <templates>
                    <t t-name="card" class="gap-1">
                        <field name="name" class="fw-bolder text-dark" />
                        <div>
                            <span>Expected Price: </span>
                            <field name="expected_price" />
                        </div>
                        <div t-if="record.best_price.raw_value">
                            <span>Best Price: </span>
                            <field name="best_price"/>
                        </div>
                        <div t-if="record.selling_price.raw_value">
                            <span>Selling Price: </span>
                            <field name="selling_price"/>
                        </div>
                        <field name="tag_ids" string="" widget="many2many_tags" options="{'color_field': 'color'}" />
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
