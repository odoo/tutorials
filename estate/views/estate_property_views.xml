<?xml version="1.0"?>
<odoo>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,kanban,form,search</field>
        <field name="context">{'search_default_available': True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
              This is a simple window action test.
          </p>
        </field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state=='offer_received' or state=='offer_accepted'"
                decoration-bf="state=='offer_accepted'"
                decoration-muted="state=='sold'"
            >
                <field name="name"/>
                <field name="type"/>
                <field name="tags" widget="many2many_tags"/>
                <field name="postcode"/>
                <field name="date_availability" optional="True"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button name="action_sell_property" string="Sold" type="object" invisible="state != 'new' and state != 'offer_received'"/>
                    <button name="action_sell_property" string="Sold" type="object" invisible="state != 'offer_accepted'" class="oe_highlight"/>
                    <button name="action_cancel_property" string="Cancel" type="object" invisible="state == 'sold' or state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group>
                        <group>
                            <field name="type" can_create="false" can_write="false" options="{'no_create_edit': true, 'no_open': true}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="garden==False"/>
                                <field name="garden_orientation" invisible="garden==False"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offers" readonly="state!='new' and state!='offer_received'"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="seller"/>
                                <field name="buyer"/>
                            </group>
                        </page>
                    </notebook>
                    <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>
                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="type" records_draggable="False" groups_draggable="False">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <h2>
                                <field name="name"/>
                            </h2>
                            Expected Price: <em><field name="expected_price"/></em>
                            <div t-if="record.state.raw_value == 'offer_received' or record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                                Best Price: <field name="best_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold'">
                                Selling Price: <field name="selling_price"/>
                            </div>
                            <field name="tags" widget="many2many_tags"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Property Search">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '&gt;=', self)]"/>
                <field name="facades"/>
                <field name="type"/>
                <field name="state"/>
                <filter name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]" />
                <group>
                    <filter string="Postcode" name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
