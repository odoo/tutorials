<?xml version="1.0"?>
<odoo>
    <record id="estate_properties_view" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record id="estate_properties_types_view" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_properties_tags_view" model="ir.actions.act_window">
        <field name="name">Property Tags</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_properties_offers_view" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <record id="estate_property_type_view_tree" model="ir.ui.view">
        <field name="name">estate.property.types.list</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Name"/>
            </list>
        </field>
    </record>

    <record id="estate_properties_view_tree" model="ir.ui.view">
        <field name="name">estate.properties.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" 
                decoration-success="state in ['offer_received', 'offer_accepted']" 
                decoration-bf="state in ['offer_accepted']"
                decoration-muted="state in ['sold']">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price"/>
                <field name="date_availability" string="Available From" optional="yes"/>
                
            </list>
        </field>
    </record>

    <record id="estate_properties_view_kanban" model="ir.ui.view">
        <field name="name">estate.properties.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id">
                <field name="state"/>
                <field name="property_type_id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <main class="ms-2">
                            <field name="name" class="fw-bold"/>
                            <div>
                                Expected price:
                                <field name="expected_price"/>
                            </div>
                            <t t-if="record.state == 'offer_received'">
                                <div>
                                    Best offer:
                                    <field name="best_price" />
                                </div>
                            </t>
                            <t t-if="record.state == 'offer_accepted'">
                                <div>
                                    Selling price:
                                    <field name="selling_price" />
                                </div>
                            </t>
                            <div>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_types_view_form" model="ir.ui.view">
        <field name="name">estate.property.types.form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Estate Property Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(estate.estate_properties_offers_view)d" type="action" class="oe_stat_button" invisible="not offer_count">
                            <field name="offer_count" string="Offers" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name"/>
                        </div>
                        <h1 class="mb32">
                            <field name="name" class="mb16"/>
                        </h1>
                    </div>
                    <notebook>
                            <page string="Properties" name="properties">
                                <group>
                                    <field name="property_ids">
                                        <list>
                                            <field name="name"/>
                                            <field name="expected_price"/>
                                            <field name="state"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_properties_view_form" model="ir.ui.view">
        <field name="name">estate.properties.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button name="action_sold" type="object" string="Sold" invisible="state in ['sold', 'cancelled']"/>
                    <button name="action_cancelled" type="object" string="Cancel" invisible="state in ['sold', 'cancelled']"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name"/>
                        </div>
                        <h1 class="mb32">
                            <field name="name" class="mb16"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </div>
                    <group>
                        <group name="date">
                            <field name="property_type_id" string="Property Type" options="{'no_create': true}"/>
                            <field name="postcode" string="Postcode"/>
                            <field name="date_availability" string="Available from"/>
                        </group>
                        <group name="price">
                            <field name="expected_price" string="Expected Price"/>
                            <field name="best_price" string="Best Offer"/>
                            <field name="selling_price" string="Selling Price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <group name="datums">
                                    <field name="description" string="Description"/>
                                    <field name="bedrooms" string="Bedrooms"/>
                                    <field name="living_area" string="Living Area (sqm)"/>
                                    <field name="garage" string="Garage"/>
                                    <field name="garden" string="Garden"/>
                                    <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                    <field name="garden_orientation" string="Garden Orientation" invisible="not garden"/>
                                    <field name="total_area" string="Total Area (sqm)"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids" readonly="state in ['offer_accepted', 'sold', 'cancelled']"/>
                        </page>
                        <page string="Other Info" name="other">
                            <group>
                                <group name="contacts">
                                    <field name="salesman_id" string="Salesman"/>
                                    <field name="buyer_id" string="Buyer"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offers_view_tree" model="ir.ui.view">
        <field name="name">estate.property.offer</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="top"
                decoration-danger="status in ['refused']"
                decoration-success="status in ['accepted']">
                <field name="price" />
                <field name="partner_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <button name="action_confirm" string="Confirm" type="object" icon="fa-check" invisible="status"/>
                <button name="action_cancel" string="Cancel" type="object" icon="fa-times" invisible="status"/>
            </list>
        </field>
    </record>

    <record id="estate_property_tags_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tags.list</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list string="Property Tags" editable="top">
                <field name="name" />
            </list>
        </field>
    </record>


    <record id="estate_property_offers_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <group>
                        <group name="general">
                            <field name="price" />
                            <field name="partner_id" />
                            <field name="validity" />
                            <field name="date_deadline" />
                            <field name="status" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_properties_search" model="ir.ui.view">
        <field name="name">estate.properties.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Properties">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area', '>', self)]"/>
                <field name="facades" string="Facades"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Available" name="available" domain="[('state', 'in', ['new', 'offer_received'])]"/>
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by': 'postcode', 'residual_visible': True}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
