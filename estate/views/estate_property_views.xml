<?xml version="1.0"?>
<odoo>
    <record id="test_model_action" model="ir.actions.act_window">
        <field name="name">Test action</field>
        <field name="res_model">home.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">property</field>
        <field name="res_model">estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_tag_action" model="ir.actions.act_window">
        <field name="name">tag</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">

        <field name="name">estate.property.view.list</field>
        <field name="model">home.plan</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name='name'/>
                <field name = "description"/>
                <field name='property_type_id'/>
                <field name= "expected_price"/>
                <field name= "bedrooms"/>
                <field name= "State"/>
                <field name= "last_seen"/>
            </list>

        </field>
    </record>


    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">home.plan</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                        <h1>
                            <field name='name'/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name= "property_tag_id" widget="many2many_tags"/>
                            <field name='property_type_id'/>
                            <field name='postcode'/>
                            <field name = 'date_availability'/>
                        </group>
                        <group>
                            <field name='expected_price'/>
                            <field name='selling_price'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">

                            <group>

                                <group>
                                    <field name="description"/>
                                    <field name='bedrooms'/>
                                    <field name='facades'/>
                                    <field name='Garage'/>
                                    <field name='Garden_orientation_direction'/>
                                    <field name="living_area"/>
                                    <field name='State'/>
                                    <field name='Garden'/>
                                    <field name='Garden_area' invisible= "not Garden"/>
                                    <field name='active' />

                                </group>
                                <group>

                                </group>
                            </group>
                        </page>
                        <page string='Sale'>

                        </page>



                        <page string="Other Info">
                            <group>

                                <group>
                                    <field name='Salesman'/>
                                    <field name='Buyer' />
                                </group>

                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">home.plan</field>
        <field name="arch" type="xml">
            <search string="Home">
                <field name = 'bedrooms'  string ='bedrooms' filter_domain="[('bedrooms', '>=', self )]" />
                <field name = 'name'/>
                <!-- <field name ='property_type_id' string='property type'/> -->
                <field name="expected_price" />
                <separator/>
                <filter string="offer received" name="offer received" domain="[('State','in',['New','new', 'offer received', 'Offer Received'])]"/>
                <filter string="location" name='active' context="{'group_by': 'postcode'}"/>
                <separator/>
            </search>
        </field>
    </record>

</odoo>
