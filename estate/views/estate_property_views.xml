<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="name"/>
                <field name="postcode"/>
                <field name="date_availability" optional="hide"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="bedroom"/>
                <field name="living_area"/>
                <field name="tag_ids"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="My New House">
                <header>
                    <button name="sell" type="object" string="Sell" invisible="state in ('sold', 'cancelled')"/>
                    <button name="cancel" type="object" string="Cancel" invisible="state in ('sold', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1 class="mb32">
                        <field name="name" class="mb16"/>
                    </h1>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="postcode"> </field>
                            <field name="date_availability"> </field>
                        </group>
                        <group>
                            <field name="expected_price"> </field>
                            <field name="best_price"> </field>
                            <field name="selling_price"> </field>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"> </field>
                                <field name="bedroom"> </field>
                                <field name="living_area"> </field>
                                <field name="facades"> </field>
                                <field name="garden"> </field>
                                <field name="garden_area" invisible="not garden"> </field>
                                <field name="garden_orientation" invisible="not garden"> </field>
                                <field name="property_type_id" options="{'no_create_edit':True, 'no_create':True}"> </field>
                                <field name="total_area"> </field>
                            </group>
                        </page>
                        <page string="Offers">
                            <group>
                                <field name="offer_ids" readonly="state in ('sold', 'cancelled')"> </field>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id"> </field>
                                <field name="buyer_id"> </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Delivery Carrier">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="date_availability"/>
                <field name="expected_price"/>
                <field name="bedroom"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <filter name="postcode" context="{'group_by':'postcode'}"/>
                <filter name="Available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]"/>
            </search>
        </field>
    </record>


</odoo>
