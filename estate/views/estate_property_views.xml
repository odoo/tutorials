<?xml version="1.0" ?>
<odoo>


    <!-- VIEWS -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties"
                    decoration-success="state in ('new', 'offer_accepted')"
                    decoration-muted="state == 'sold'"
                    decoration-danger="state == 'cancelled'"
            >
                <field name="name"/>
                <field name="postcode" optional="show"/>
                <field name="bedrooms"  optional="show"/>
                <field name="living_area" optional="show"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_set_sold"
                            icon="fa-check"
                            class="oe_highlight"
                            type="object"
                            string="Mark as sold"
                            invisible="not id and state != 'offer_accepted'"
                    />
                    <button name="action_set_cancelled"
                            icon="fa-close"
                            class="btn-danger"
                            type="object"
                            string="Cancel"
                            invisible="not id or state == 'sold'"
                            confirm="Are you sure you want to cancel this property ?"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_accepted,sold"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Sold"
                            bg_color="text-bg-success"
                            invisible="state != 'sold'"/>

                    <widget name="web_ribbon"
                            title="Cancelled"
                            bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1 class="mb32">
                            <field name="name" placeholder="Prop name" class="mb16"/>
                        </h1>
                    </div>
                    <div>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>

                        <group>
                            <field name="state" readonly="1"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="postcode"/>
                            <field name="estate_property_type_id" options="{'no_create': true, 'no_open': true}"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price" invisible="not offer_ids"/>
                            <field name="selling_price"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <separator/>
                                <field name="has_garden"/>
                                <field name="garden_area"
                                       invisible="not has_garden"/>
                                <field name="garden_orientation"
                                       invisible="not has_garden"/>
                                <field name="total_area"/>
                            </group>

                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'cancelled')"/>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="customer_id"/>
                                <field name="salesman_id"/>
                                <field name="currency_id"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>

                <filter string="South Facing" name="only_south"
                        domain="[('garden_orientation', '=', 'south')]"/>
                <filter string="Luxury" name="luxury"
                        domain="[('expected_price', '&gt;', '750000')]"/>
                <filter string="Available" name="available"
                        domain="[('state', 'in', ['new', 'offer_received'])]"/>

                <filter string="Orientation" name="garden_orientation"
                        context="{'group_by':'garden_orientation'}"/>
                <separator/>
                <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode'}"/>

            </search>
        </field>
    </record>


    <!-- ACTIONS -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

</odoo>
