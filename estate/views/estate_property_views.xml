<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="postcode"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Sold" name="action_sold" type="object" class="btn-primary"/>
                    <button string="Cancel" name="action_cancel" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expected_price"/>
                            <field name="bedrooms"/>
                            <field name="property_type_id" />
                            <field name="living_area"/>
                            <field name="facades"/>
                            <field name="best_price" readonly="1"/>
                            <!-- <field name="total_area" readonly="1"/> -->
                            <field name="total_area"/>
                        </group>
                        <group>
                            <field name="selling_price" readonly="1"/>
                            <field name="postcode"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="date_availability"/>
                            <field name="garden"/>
                            <field name="garden_area"/>
                            <field name="garden_orientation"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group >
                                <group>
                                    <field name="seller_id"/>
                                    <field name="buyer_id"/>
                                </group>
                            </group>
                        </page>
                        <page name="Offers" string="Offers">
                            <group >
                                <group>
                                    <field name="offer_ids"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <filter name="available" string="Available" domain="[('state', 'in', ['new', 'offer_received'])]" />
                <filter name="expensive" string="Expensive" domain="[('expected_price', '>', 50000)]" />
                <group >
                    <filter name="group_by_postcode" string="Postcode" context="{'group_by': 'postcode'}" />
                    <filter name="group_by_bedroom" string="Bedrooms" context="{'group_by': 'bedrooms'}" />
                </group>
            </search>
        </field>
    </record>
</odoo>
