<?xml version="1.0" encoding="UTF-8"?>


<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name"> Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title"/>
                <field name="property_type_id"></field>
                <field name="property_tag_ids"  widget="many2many_tags"/>
                 <field name="description"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability"/>
                <field name="total_area"/>
                

            </list>
        </field>
    </record> property_tag_id = fields.Many2many("res.partner")
    
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate_property_search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="My attributes">
                <field name="name"></field>
                <field name="property_tag_ids" widget="many2many_tags"></field>
                <field name="property_offer_ids"></field>
                <field name="postcode"></field>
                <field name="expected_price"></field>
                <field name="bedrooms"></field>
                <field name="living_area"></field>
                <field name="facades"></field> 
                <field name="total_area"></field>
                <field name="best_price"></field>
        
                <filter name="state" string="Status"  domain="['|',('state','=', 'new'),('state','=','offer_received')]"/>  
                <filter name="postcode" string="Postcode" context="{'group_by': 'postcode'}" />        
            </search>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="My Living Rooms">
                <sheet>
                <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Title"/>
                            <field name="property_tag_ids" widget="many2many_tags"/>
                        </h1>
                    </div>
                <group>
                    <group>
                        
                        
                        <field name="property_type_id"></field>
                        <field name="postcode"></field>
                        <field name="date_availability"></field>
                    </group>
                    <group>
                        <field name="expected_price"></field>
                        <field name="best_price"></field>
                        <field name="selling_price"></field>
                    </group>
                </group>
            <notebook>
                <page string="Description">
                <group>
                    <field name="description"></field>
                    <field name="bedrooms"></field>
                    <field name="living_area"></field>
                    <field name="facades"></field>
                    <field name="garage"></field>
                    <field name="garden"></field>
                    <field name="garden_area"></field>
                    <field name="garden_orientation"></field>
                    <field name="total_area"></field>
                </group>
                </page>

                 <page string="Offers">
                <group>
                    <field name="expected_price"></field>
                    <field name="salesman_id"></field>
                    <field name="validity"></field>
                    <field name="date_deadline"></field>
                    <field name="state"></field>

                    
                </group>
                </page>
                
                 <page string="Other Info">
                <group>
                    <field name="salesman_id"></field>
                    <field name="buyer_id"></field>
                    
                </group>
                </page>
                
            </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
