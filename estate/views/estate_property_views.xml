<odoo>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'offer received' or state == 'offer accepted'" decoration-bf="state == 'offer accepted'" decoration-muted="state == 'sold'">
                <field name="name" string="Title"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="tag_ids" options="{'color_field': 'color'}" widget="many2many_tags"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field optional="hide" name="date_availability"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Test">
                <header>
                    <button name="action_mark_as_sold" type="object" string="SOLD" invisible="state == 'sold' or state == 'canceled'"/>
                    <button name="action_mark_as_canceled" type="object" string="CANCEL" invisible="state == 'sold' or state == 'canceled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new, offer received, offer accepted, sold"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" nolabel="1" limit="80"/>
                    </group>
                    <group>
                        <field name="tag_ids" nolabel="1" options="{'color_field': 'color'}" widget="many2many_tags"/>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': true}" string="Property Type"/>
                        </group>
                        <group>
                            <field name="postcode" string="Postcode"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price"/>
                        </group>
                        <group>
                            <field name="best_offer" string="Best Offer"/>
                        </group>
                        <group>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group>
                            <field name="selling_price" string="Selling Price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garage" string="Garage"/>
                                <field name="garden" string="Garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" string="Garden Orientation" invisible="not garden"/>
                                <field name="total_area" string="Total Area (sqm)"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state == 'offer accepted' or state == 'sold' or state == 'canceled'"/>
                        </page>
                        <page string="Ohter Info">
                            <group>
                                <field name="seller_id" string="Salesman"/>
                                <field name="buyer_id" string="Buyer"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable = "0">
                <field name="offer_ids"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <field name="name"/>
                            <div>
                                <span style="margin-right: 3px;">Expected Price:</span>
                                <field name="expected_price"/>
                            </div>
                            <div t-if="record.offer_ids.raw_value">
                                <span style="margin-right: 3px;">Best Price:</span>
                                <field name="best_offer"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer accepted'
                            or record.state.raw_value == 'sold'">
                                <span style="margin-right: 3px;">Selling Price:</span>
                                <field name="selling_price"/>
                            </div>
                            <div>
                                <field name="tag_ids"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Tests">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"
                    filter_domain="[('living_area', '&gt;=', self)]"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="facades" string="Facades"/>

                <filter name="available" string="Available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]"/>
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Real estates</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
</odoo>