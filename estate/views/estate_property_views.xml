<?xml version="1.0" ?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate action</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="bedrooms" string="Bderooms"/>
                <field name="living_area" string="Living area (sqm)"/>
                <field name="expected_price" string="Expected price"/>
                <field name="selling_price" string="Selling price"/>
                <field name="date_availability" string="Available from"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <sheet>
                    <div>
                        <h1 class="mb32">
                            <field name="name" placeholder="Your property name" class="mb16"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="postcode" string="Postcode"/>
                            <field name="date_availability" string="Available from"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected price"/>
                            <field name="selling_price" string="Selling price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garage" string="Garage"/>
                                <field name="garden" string="Garden area (sqm)"/>
                                <field name="garden_orientation" string="Garden orientation"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>

                <filter string="South Facing" name="only_south"
                        domain="[('garden_orientation', '=', 'south')]"/>
                <filter string="Luxury" name="luxury"
                        domain="[('selling_price', '&gt;', '750000')]"/>
                <filter string="Available" name="available"
                        domain="[('state', 'in', ['new', 'offer_received'])]"/>

                <filter string="Orientation" name="garden_orientation"
                        context="{'group_by':'garden_orientation'}"/>
                <separator/>
                <filter string="Postcode" name="postcode"
                        context="{'group_by':'postcode'}"/>

            </search>
        </field>
    </record>

</odoo>