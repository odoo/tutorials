<odoo>
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="name"/>
                <field name="postcode"/>
                <field name="selling_price"/>
                <field name="best_offer"/>
                <field name="expected_price"/>
                <field name="date_availability"/>
                <field name="type"/>
                <field name="tag_ids"/>
                <field name="total_area"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sold_property" string="Sold" type="object" class="oe_highlight"/>
                    <button name="action_cancel_property" string="Cancel" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="postcode"/>
                            <field name="expected_price"/>
                        </group>
                        <group>
                            <field name="date_availability"/>
                            <field name="selling_price"/>
                            <field name="best_offer" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="garden"/>
                            <field name="garden_area" invisible="not garden"/>
                            <field name="garden_orientation" invisible="not garden"/>
                            <field name="total_area" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                                <list>
                                    <field name="price"/>
                                    <field name="buyer_id"/>
                                    <field name="date_deadline"/>
                                    <field name="validity"/>
                                    <field name="offer_status"/>
                                    <field name="buyer_id"/>
                                    <button name="action_accept_offer" title="Accept Offer" type="object" icon="fa-check"/>
                                    <button name="action_reject_offer" title="Reject Offer" type="object" icon="fa-close"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <filter name="available" string="Available" domain="[('status', '=', 'new')]"/>
                <separator/>
                <filter name="group_by_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
            </search>
        </field>
    </record>
    
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
</odoo>
