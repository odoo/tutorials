<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel" decoration-success="state in ('offer_received', 'offer_accepted')" decoration-muted="state == 'sold'" decoration-bf="state == 'offer_accepted'">
                <field name="name"/>
                <field name="postcode" string="Postcode"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price" string="Expected Price"/>
                <field name="selling_price" string="Selling Price"/>
                <field name="date_availability" string="Available From" optional="true"/>
            </list>
            </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="New House">
                <header>
                    <button name="action_mark_as_sold" type="object" string="Sold" invisible="state == 'cancelled'"/>
                    <button name="action_cancel_sale" type="object" string="Cancel" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property name..."/>
                        </h1>
                    </div>
                    <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <group>
                        <group string="Key Information">
                            <field name="estate_type_id" string="Property Type"/>
                            <field name="postcode" placeholder="e.g. 1000"/>
                            <field name="date_availability" string="Available From"/>
                        </group>
                        <group string="Pricing">
                            <field name="expected_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="selling_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_area"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detailed Description">
                            <group>
                                <field name="description" placeholder="Add an attractive description..." nolabel="1"/>
                            </group>
                            <group col="4">
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" force_save="1">
                                <list editable="bottom" >
                                    <field name='price'/>
                                    <field name='partner_id'/>
                                    <field name='validity'/>
                                    <field name='date_deadline'/>
                                    <button name="action_accept_offer" type="object" string="Accept"/>
                                    <button name="action_refuse_offer" type="object" string="Refuse"/>
                                    <field name='property_type_id'/>
                                </list>
                            </field>
                        </page>
                        <page string="Other">
                            <group col="4">
                                <field name="state"/>
                                <field name="active"/>
                                <field name="buyer_id"/>
                                <field name="salesperson_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Estate Property">
                <field name="name"/>
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm) greater than" filter_domain="[('living_area', '&gt;', self)]"/>
                <field name="living_area" string="Living Area (sqm) smaller than" filter_domain="[('living_area', '&lt;', self)]"/>
                <field name="facades"/>
                <separator/>
                <filter string="Available" name="available" domain="['|',('state', '=', 'new'),('state', '=', 'offer_received')]"/>
                <filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
            </search>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estate_type_id" groups_draggable="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold col">
                            <h5>
                                <field name="name"/>
                            </h5>
                        </div>
                        <div>
                            <div class="text-muted">
                                Expected Price:
                                <field name="expected_price" widget="monetary"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted'" class="text-muted">
                                Selling Price:
                                <field name="selling_price" widget="monetary"/>
                            </div>
                        </div>
                        <div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
