<?xml version='1.0'?>
<odoo>
    <record id='estate_property_action' model='ir.actions.act_window' context="{'search_default_state':1}">
        <field name='name'>All Properties</field>
        <field name='res_model'>estate.property</field>
        <field name='view_mode'>list,form</field>
    </record>

    <record id='estate_property_view_list' model='ir.ui.view'>
        <field name='name'>estate.property.list</field>
        <field name='model'>estate.property</field>

        <field name='arch' type='xml'>
            <list
                    decoration-success="state in ['offer_received', 'offer_accepted']"
                    decoration-bf="state == 'offer_accepted'"
                    decoration-muted="state == 'sold'"
            >
                <field name='name'/>
                <field name="type_id"/>
                <field name='postcode'/>
                <field name="tag_ids" widget="many2many_tags" placeholder="Select a tag."/>
                <field name='bedrooms'/>
                <field name='living_area' string='Living Area (sqm)'/>
                <field name='expected_price'/>
                <field name='selling_price'/>
                <field name='date_availability' optional="hide"/>
            </list>
        </field>
    </record>

    <record id='estate_property_view_form' model='ir.ui.view'>
        <field name='name'>estate.property.form</field>
        <field name='model'>estate.property</field>

        <field name='arch' type='xml'>
            <form>
                <header>
                    <button name="sold_action" type="object" string="Sold" class="oe_highlight"
                            invisible='state == "sold" or state == "cancelled"'/>
                    <button name="cancel_action" type="object" string="Cancel" class="oe_highlight"
                            invisible='state == "sold" or state == "cancelled"'/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Estate Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" placeholder="Select a tag."
                               options="{'color_field': 'color'}"/>
                    </group>


                    <group>
                        <group>
                            <field name="type_id" placeholder="eg. House" options="{'no_create': True}"/>
                            <field name='postcode' placeholder="eg. 1234"/>
                            <field name='date_availability'/>
                        </group>

                        <group>
                            <field name='expected_price'/>
                            <field name="best_offer"/>
                            <field name='selling_price'/>
                        </group>
                    </group>

                    <notebook>
                        <page string='Description'>
                            <group>
                                <field name="description" placeholder="Write a short description of the property."/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" invisible='not garden'/>
                                <field name="garden_orientation" placeholder="Select an orientation."/>
                                <field name="total_area" text="Total Area (sqm)"/>
                            </group>
                        </page>

                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ['offer_accepted', 'sold', 'cancelled']"/>
                        </page>

                        <page string="Other Info">
                            <group>
                                <field name="salesman_id"/>
                                <field name="buyer_id" placeholder="Select the buyer."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"
                       filter_domain='["|", ("living_area", ">", self), ("living_area", "=", self)]'/>
                <field name="facades"/>

                <filter name="postcode"
                        string="Postcode"
                        context="{'group_by':'postcode'}"
                />

                <filter name="state"
                        string="Available"
                        domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"
                />
            </search>
        </field>
    </record>
</odoo>
