<?xml version="1.0" encoding="UTF-8"?>
<!-- the root elements of the data file -->
<odoo>
    <record id="estate_property_views_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">realestate.estate.properties</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="realestate_property_custom_view" model="ir.ui.view">
        <field name="name">realestate.property.form</field>
        <field name="model">realestate.estate.properties</field>
        <field name="arch" type="xml">
            <form string="Custom description form">
                <sheet>
                    <h1 class="oe_title mb32">
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                                <field name="living_area" />
                                <field name="facades" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" />
                                <field name="garden_orientation" />
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>

    </record>

    <record id="estate_property_views_list" model="ir.ui.view">
        <field name="name">realestate.property.list</field>
        <field name="model">realestate.estate.properties</field>
        <field name="arch" type="xml">
            <list string="Channel">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
            </list>
        </field>
    </record>

    <record id="estate_property_views_filter" model="ir.ui.view">
        <field name="name">realestate.property.filter</field>
        <field name="model">realestate.estate.properties</field>
        <field name="arch" type="xml">
            <search string="Filter string">
                <field name="name" />
                <field name="bedrooms" />
                <field name="facades" />
                <field name="postcode" />
                <field name="living_area" />
                <field name="expected_price" />
                <separator />
                <filter string="Available properties" name="available"
                    domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]" />
                <group>
                    <filter string="Group be postcode" name="postcode"
                        context="{'group_by': 'postcode'}" />
                </group>
            </search>
        </field>
    </record>

</odoo>