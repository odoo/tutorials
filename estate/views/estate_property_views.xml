<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_state': 1}</field>
    </record>

    <record id="email_template_sold" model="mail.template">
        <field name="name">Estate Property: Sold</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="email_from">{{ object.buyer_id.email}}</field>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Your Property
                    <t>
                        <span style="font-weight: bold;" t-out="object.name"></span>
                    </t>
                    with selling price
                    <t>
                        <span style="font-weight: bold;" t-out="object.selling_price"></span>
                    </t>
                    Has been sold to
                    <t>
                        <span style="font-weight: bold;" t-out="object.buyer_id.name"></span>
                    </t>
                </p>
            </div>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'sold'" decoration-success="state in ('o_received','o_accepted')" decoration-bf="state == 'o_accepted'">
                <field name="name"/>
                <field name="postcode"/>
                <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="date_availability" optional="hide"/>
                <field name="expected_price"/>
            </list>
        </field>
    </record>

    <!-- Form View-->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="estate_property_form">
                <header>
                    <button string="Sold" name="action_sold_property" type="object" invisible="state in ('sold', 'cancelled')"/>
                    <button string="Cancel" name="action_cancel_property" type="object" invisible="state in ('sold', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,o_accepted,o_received,sold" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': true}"/>
                            <field name="tags_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                            </group>
                            <group>
                                <group>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                </group>
                                <group>
                                    <field name="garden"/>
                                    <field name="garden_area" invisible="not garden"/>
                                    <field name="garden_orientation" invisible="not garden"/>
                                    <field name="total_area"/>
                                </group>
                            </group>
                        </page>
                        <page name="offer" string="Offers">
                            <field name="offer_ids" readonly="state in ('o_accepted', 'sold', 'cancelled')">
                                <list editable="bottom" decoration-danger="status == 'refused'" decoration-success="status == 'accepted'">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <button type="object" name="action_offer_accept" title="Accept" icon="fa-check" invisible="status"/>
                                    <button type="object" name="action_offer_reject" title="Reject" icon="fa-close" invisible="status"/>
                                </list>
                            </field>
                        </page>
                        <page name="info" string="Other Info">
                            <group>
                                <field name="seller_id" widget="many2one_avatar_user"/>
                                <field name="buyer_id" widget="many2one_avatar_user"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Kanban View-->
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <widget name="web_ribbon" id="cancelled_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                        <widget name="web_ribbon" id="sold_ribbon" title="Sold" bg_color="text-bg-success" invisible="state != 'sold'"/>
                        <h2>
                            <field name="name" class="fw-bold fs-5"/>
                        </h2>
                        <div>
                            Expected Price:
                            <field name="expected_price"/>
                        </div>
                        <div t-if="record.state.raw_value == 'o_received'">
                            Best Price:
                            <field name="best_price"/>
                        </div>
                        <div t-if="record.state.raw_value == 'o_accepted'">
                            Selling Price:
                            <field name="selling_price"/>
                        </div>
                        <field name="tags_ids" widget="many2many_tags"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search  -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>

        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>

                <separator/>

                <filter name="achieved" string="Achieved" domain="[('active', '=', 'False')]"/>
                <filter name="state" string="Available" domain="['|', ('state', '=', 'new'), ('state', '=', 'o_received')]"/>
                <filter name="group_by_garden" string="With Garden" context="{'group_by': 'garden'}"/>
                <filter name="group_by_garage" string="With Garage" context="{'group_by': 'garage'}"/>
                <filter name="group_by_postcode" string="By Postcode" context="{'group_by': 'postcode'}"/>
                <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
</odoo>
