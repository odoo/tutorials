<?xml version="1.0"?>
<odoo>
    <record id="model_menu_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">
        {
            'search_default_Active':1 
        }
        </field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel" editable="bottom" open_form_view="True" decoration-success="state in ['offer_received','offer_accepted']" decoration-muted="state=='sold'" 
            decoration-bf=" state == 'offer_accepted'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name = "date_availability" optional="hide"/>
                <field name= "property_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name= "property_type_id"/>
                <field name= "postcode"/>
                <field name= "expected_price"/>
                <field name= "bedrooms"/>
                <field name= "state"/>
                <field name= "last_seen"/>
                <field name= "best_price"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property Form">
                <header>
                    <button name="action_sold" type="object" string="Sold" invisible="state == 'sold'"/>
                    <button name="action_Cancel" type="object" string="Cancel" invisible="state == 'sold'"/>
                    <field name="state" widget="statusbar" options="{'clickable':'1'}" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <group>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="property_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" />
                            <field name="property_type_id" widget="selection"/>
                            <field name="postcode"/>
                            <field name ="date_availability"/>
                            <field name="total_maintenance_cost"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area" invisible= "not garden"/>
                                    <field name="garden_orientation_direction" invisible= "not garden"/>
                                    <field name="living_area"/>
                                    <field name="total_area"/>
                                    <field name="active"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offer">
                            <field name="offer_ids" readonly="state in ['offer_accepted','offer_received','sold']">
                                <list editable="top" decoration-success="status=='accepted'" decoration-danger="status=='refused'">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name ="validity"/>
                                    <field name ="date_deadline"/>
                                    <button name="action_confirm" title="confirm" type="object" icon="fa-check" invisible="status=='refused'"/>
                                    <button name="action_cancel" title="cancel" type="object" icon="fa-times" invisible="status=='refused'"/>
                                </list>
                            </field>
                        </page>
                        <page string = "Maintenance">
                        <field name="maintenance_ids">
                                <list editable="top">
                                    <field name="title"/>
                                    <field name="cost"/>
                                    <field name ="status"/>
                                    <button name="action_approved" title="approved" type="object" icon="fa-check" invisible="status=='done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <group>
                                    <field name="salesman_id"/>
                                    <field name="buyer_id" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Home">
                <field name = "bedrooms"  string ="bedrooms" filter_domain="[('bedrooms', '>=', self )]" />
                <field name = "living_area" string="living area" filter_domain="[('living_area', '>=', self)]"/>
                <field name = "name"/>
                <field name="expected_price"/>
                <separator/>
                <filter string="offer received" name="offerReceived" domain="[('state','in',('new', 'offer_received'))]"/>
                <filter string="Active" name="Active" domain="[('active', '=', 'True')]"/>
                <filter string="location" name="location" context="{'group_by': 'postcode'}"/>
                <filter string="best_price" name="best_price" domain="[('best_price', '&lt;', 100)]"/>
                <separator/>
            </search>
        </field>
    </record>
</odoo>
