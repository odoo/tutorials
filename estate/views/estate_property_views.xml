<?xml version="1.0"?>
<odoo>
	<record id="estate_property_list_view" model="ir.ui.view">
		<field name="name">estate.property.list</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
			<list string="Properties" decoration-success="state in ('offer_accepted', 'offer_received')" decoration-bf="state in ('offer_accepted')" decoration-muted="state in ('sold')">
				<field name="name" string="Title"/>
				<field name="property_type_id"/>
				<field name="postcode"/>
				<field name="bedrooms"/>
				<field name="living_area" string="Living Area (sqm)"/>
				<field name="expected_price" />
				<field name="selling_price" />
				<field name="date_availability" string="Available From" optional="hide" />
			</list>
		</field>
	</record>
	<record id="estate_property_form_view" model="ir.ui.view">
		<field name="name">estate.property.form</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
			<form string="Property">
				<header>
					<button name="action_sold_property" type="object" string="Sold" class="oe_highlight" invisible="state in ('sold','cancelled','new','offer_received')"/>
					<button name="action_sold_property" type="object" string="Sold" class="disabled" invisible="state in ('sold','cancelled','offer_accepted')"/>
					<button name="action_cancel_offer" type="object" string="Cancel" invisible="state in ('sold','cancelled')" 
                            confirm="Are you sure do you want to cancel this Property?"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<h1>
						<field name="name" string="Title"/>
					</h1>
					<field string="Tag" name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
					<hr/>
					<group>
						<group>
							<field name="postcode"/>
							<field name="expected_price"/>
							<field name="selling_price"/>
							<field name="best_price" string="Best Offer"/>
						</group>
						<group>
							<field name="property_type_id" options="{'no_create': true}"/>
							<field name="date_availability" string="Available From"/>
						</group>
					</group>
					<notebook>
						<page string="Description">
							<group>
								<group>
									<field name="description"/>
									<field name="bedrooms"/>
									<field name="living_area" string="Living Area(sqm)"/>
									<field name="facades"/>
									<field name="garage"/>
								</group>
								<group>
									<field name="garden"/>
									<field name="garden_area" string="Garden Area(sqm)" invisible="not garden"/>
									<field name="garden_orientation" invisible="not garden"/>
									<field name="total_area" string="Total Area(sqm)"/>
									<field name="active"/>
								</group>
							</group>
						</page>
						<page string="Offers">
							<field name="offer_ids" readonly="state in ('offer_accepted','sold','cancelled')"/>
						</page>
						<page string="Information">
							<group>
								<field name="salesperson" />
								<field name="customer" />
							</group>
						</page>
					</notebook>
				</sheet>
				<chatter />
			</form>
		</field>
	</record>
	<record id="estate_property_search_options_view" model="ir.ui.view">
		<field name="name">Search Properties</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
			<search string="Property Search">
				<field name="name" string="Title" />
				<field name="postcode" />
				<field name="expected_price" />
				<field name="bedrooms" />
				<field name="living_area" string="Living Area (sqm)"  filter_domain="[('living_area', '&gt;=', self)]" />
				<field name="facades" />
				<filter string="Available" name="available" domain="[('state', '=', 'new')]"/>
				<filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
				<filter string="Postcode" name="postcode" context="{'group_by':'postcode'}"/>
				<filter string="State" name="state" domain="['|',('state', '=', 'new'),('state', '=', 'offer_received')]"/>
			</search>
		</field>
	</record>
	<record id="estate_property_kanban_view" model="ir.ui.view">
		<field name="name">Search Properties</field>
		<field name="model">estate.property</field>
		<field name="arch" type="xml">
		 <kanban default_group_by="property_type_id" records_draggable="False">
                <templates>
                    <t t-name="card"> 
                        <div>
                            <div class="d-flex justify-content-between align-items-center">
							<h3>
                                <field name="name"/>
                            </h3>    
								<field name="state" 
                                       widget="badge" 
                                       decoration-success="state == 'new'" 
                                       decoration-danger="state in ('sold','offer_accepted')" 
                                       decoration-muted="state == 'cancelled'" 
                                       decoration-warning="state == 'offer_received'"/>
                            </div>
                            <div>
                                <span>Expected Price: </span>
                                <field name="expected_price"/>
                            </div>
                            <div t-if="record.best_price.raw_value">
                                <span>Best Offer: </span>
                                <field name="best_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'offer_accepted' or record.state.raw_value == 'sold' ">
                                <span>Selling Price: </span>
                                <field name="selling_price"/>
                            </div>
							<div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
							</div>
						</div>
                    </t>
                </templates>
            </kanban>
		</field>
	</record>
	<record id="main_action_estate" model="ir.actions.act_window">
		<field name="name">Estate Property</field>
		<field name="res_model">estate.property</field>
		<field name="view_mode">kanban,list,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Create your Properties here !</p>
		</field>
	</record>
</odoo>

