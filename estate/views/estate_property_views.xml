<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Title"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="date_availability"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="sold"
                        name="action_sold"
                        type="object"/>
                    <button
                        string="Cancel"
                        name="action_cancel"
                        type="object"/> 
                </header>
                <sheet>
                    <div>
                        <h1>
                            <field name="name" placeholder="Name"/>
                        </h1>
                        <h3>
                            <field name="tag_ids" widget="many2many_tags" placeholder="Tag"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="state" string="State"/>
                            <field name="property_type_id" string="Property Type"/>
                            <field name="postcode" string="Postcode"/>
                            <field name="date_availability" string="Available Form"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price"/>
                            <field name="best_price" string="Best Price"/>
                            <field name="selling_price" string="Selling Price"/>
                        </group>
                    </group>
                    <notebook>
                    <page string="Description">
                        <group>
                            <field name="description" string="Description"/>
                            <field name="bedrooms" string="Bedrooms"/>
                            <field name="living_area" string="Living Area(sqm)"/>
                            <field name="facades" string="Facades"/>
                            <field name="garage" string="Garage"/>
                            <field name="garden" string="Garden"/>
                            <field name="garden_area" string="Garden Area(sqm)"/>
                            <field name="garden_orientation" string="Garden Orientation"/>
                            <field name="total_area"/>
                            <field name="active" string="active"/>
                        </group>
                    </page>
                    <page string="Offers">
                        <field name="offer_ids">
                        </field>
                    </page>
                    <page string="Other Info">
                        <group>
                            <field name="salesperson" string="Salesman"/>
                            <field name="customer" string="Buyer"/>
                        </group>
                    </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <filter name="state" string="State" domain="['|',('state', '=', 'new'), ('state', '=', 'offer received')]"/>
                <filter name="active" string="non-active property" domain="[('active', '=', False)]" />
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by' : 'postcode'}"/>
                </group>
            </search>
        </field>    
    </record>
</odoo>
