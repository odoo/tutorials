<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- PROPERTY VIEWS -->

        <record id="estate_properties_view_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="postcode" />
                    <field name="expected_price" />
                    <field name="bedrooms" />
                    <field name="living_area" />
                    <field name="facades" />
                    <field name="property_type_id" />
                    <filter string="Available" name="available" domain="[('status', 'in', ['new','offer_received'])]" />
                    <filter string="Postcode" name="postcode"  context="{'group_by': 'postcode'}" />
                </search>
            </field>
        </record>

        <record id="estate_properties_view_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <header>
                        <button name="action_set_status_cancelled" string="Cancel"
                            type="object" data-hotkey="w" title="Mark as cancelled"
                            invisible="status == 'cancelled'"/>
                        <button name="action_set_status_sold" string="Sold"
                            type="object" data-hotkey="w" title="Mark as sold"
                            invisible="status == 'sold'"/>
                        <field name="status" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold" options="{'clickable': 1}"/>
                    </header>
                    <sheet>
                        <div class="oe_title mt-2">
                            <h1><field name="name" placeholder="Title" required="True" /></h1>
                            <field name="property_tag_ids" placeholder="Add a tag" widget="many2many_tags" />
                            <group class="mt-4">
                                <group>
                                    <field name="property_type_id"/>
                                    <field name="postcode" />
                                    <field name="date_availability"/>
                                </group>
                                <group>
                                    <field name="expected_price" required="True" />
                                    <field name="best_price" />
                                    <field name="selling_price" />
                                </group>
                            </group>
                            <separator/>
                        </div>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description" />
                                    <field name="bedrooms" />
                                    <field name="living_area" />
                                    <field name="facades" />
                                    <field name="garage" />
                                    <field name="garden"/>
                                    <field name="garden_area" />
                                    <field name="garden_orientation" />
                                    <field name="active"/>
                                    <field name="total_area"/>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="property_offer_ids" />
                            </page>
                            <page string="Other Info">
                                <group>
                                    <field name="salesperson_id" />
                                    <field name="buyer_id" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_properties_view_list" model="ir.ui.view">
            <field name="name">estate.property.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="Properties">
                    <field name="name" width="100px"/>
                    <field name="property_type_id" width="50px"/>
                    <field name="postcode" width="60px"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
                    <field name="date_availability"/>
                </list>
            </field>
        </record>

        <record id="estate_properties_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>


        <!-- PROPERTY TYPE VIEWS -->

        <record id="estate_property_type_view_form" model="ir.ui.view">
            <field name="name">estate.property.type.form</field>
            <field name="model">estate.property.type</field>
            <field name="arch" type="xml">
                <form string="Property Type">
                    <sheet>
                        <div class="oe_title mt-2">
                            <h1><field name="name" placeholder="Name" required="True" /></h1>
                        </div>
                        <notebook>
                            <page string="Properties">
                                <field name="property_id">
                                    <list create="False" delete="False">
                                        <field name="name"/>
                                        <field name="expected_price"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_property_type_action" model="ir.actions.act_window">
            <field name="name">Property Type</field>
            <field name="res_model">estate.property.type</field>
            <field name="view_mode">list,form</field>
        </record>


         <!-- PROPERTY TAGS VIEWS -->

        <record id="estate_property_tags_view_form" model="ir.ui.view">
            <field name="name">estate.property.tag.form</field>
            <field name="model">estate.property.tag</field>
            <field name="arch" type="xml">
                <form string="Property Tag">
                    <sheet>
                        <group>
                            <field name="name" placeholder="Tag Name" required="True" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_property_tags_action" model="ir.actions.act_window">
            <field name="name">Property Tags</field>
            <field name="res_model">estate.property.tag</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- PROPERTY OFFERS VIEWS -->

        <record id="estate_property_offers_view_form" model="ir.ui.view">
            <field name="name">estate.property.offer.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form string="Property Offer">
                    <sheet>
                        <group>
                            <field name="price" required="True" />
                            <field name="partner_id" placeholder="Select a Partner" required="True" />
                            <field name="validity" />
                            <field name="date_deadline" />
                            <field name="status" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="estate_property_offers_view_list" model="ir.ui.view">
            <field name="name">estate.property.offer.list</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <list string="Offers">
                    <field name="price"/>
                    <field name="partner_id" width="150px"/>
                    <field name="validity" width="100px"/>
                    <field name="date_deadline" width="130px" />
                    <button name="action_accept_offer" title="Accept" invisible="status == 'accepted'" type="object" icon="fa-check"/>
                    <button name="action_refuse_offer" title="Refuse" invisible="status == 'refused'" type="object" icon="fa-times"/>
                    <field name="status"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
