<?xml version="1.0"?>
<odoo>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Property List"
                decoration-success="stage in ('offer_received', 'offer_accepted')"
                decoration-bf="stage == 'offer_accepted'" decoration-muted="stage == 'sold'">
                <field name="name" string="Title" />
                <field name="tag_ids" widget="many2many_tags"
                    options="{'color_field': 'color', 'on_tag_click': 'edit_color'}" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" string="Living Area (sqm)" />
                <field name="expected_price" string="Expected Price" />
                <field name="selling_price" string="Selling Price" />
                <field name="date_availability" string="Available From" optional="hide" />
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Sold" name="action_sell" type="object"
                        invisible="stage in ('sold', 'cancelled')" />
                    <button string="Cancel" name="action_cancel" type="object"
                        invisible="stage in ('sold', 'cancelled')" />
                    <field name="stage" widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold" />
                </header>
                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <field name="tag_ids" widget="many2many_tags"
                        options="{'color_field': 'color', 'on_tag_click': 'edit_color'}" />
                    <group>
                        <group>
                            <field name="property_type_id" string="Property Type"
                                options="{'no_create': true}" readonly="id and property_type_id" />
                            <field name="postcode" string="Postcode" />
                            <field name="date_availability" string="Available From" />
                        </group>
                        <group>
                            <field name="expected_price" string="Expected Price" />
                            <field name="selling_price" string="Seling Price" />
                            <field name="best_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"
                                    placeholder="when duplicated, statud and date are not copied" />
                                <field name="bedrooms" string="Bedrooms" />
                                <field name="living_area" string="Living Area (sqm)" />
                                <field name="facades" string="Facades" />
                                <field name="garage" string="Garage" />
                                <field name="garden" string="Garden" />
                                <field name="garden_area" string="Garden Area (sqm)"
                                    invisible="not garden" />
                                <field name="garden_orientation" string="Garden Orientation"
                                    invisible="not garden" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="salesman_id" string="Salesman" />
                                <field name="buyer_id" string="Buyer" />
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids"
                                readonly="stage in ('sold', 'cancelled', 'offer_accepted')" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.view.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="False">
                <field name="stage" />
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="fw-bold fs-5 text-primary">
                                <field name="name" />
                            </div>
                            <div class="text-muted"> 
                                Expected Price: <field name="expected_price" />
                            </div>
                            <div>
                                <field name="tag_ids" widget="many2many_tags"  options="{'color_field': 'color'}" />
                            </div>
                            <div t-if="record.stage.raw_value == 'offer_received'">
                                Best Price: <field name="best_price" />
                            </div>
                            <div t-if="record.stage.raw_value == 'offer_accepted'">
                                Selling Price: <field name="selling_price" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" string="Living Area (sqm)" />
                <field name="expected_price" string="Expected Price" />
                <field name="facades" string="Facades" />
                <filter string="Available" name="available"
                    domain="['|', ('stage', '=', 'new'), ('stage', '=', 'offer_received')]" />
                <filter string="Postcode" name="groupby_postcode" context="{'group_by':'postcode'}" />
            </search>
        </field>
    </record>

</odoo>