<?xml version="1.0"?>
    <odoo>
        <record id="estate_model_action" model="ir.actions.act_window">
            <field name="name">Estate properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">list,form</field>
        </record>


         <!-- List View of the estate properties -->
        <record id="estate_properties_list_view" model="ir.ui.view">
            <field name="name">estate.property.list</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <list string="Estates" >
                    <field name="name" string="Title"  width="150vw"/>
                    <field name="postcode" width="15 %" />
                    <field name="bedrooms" width="100vw" />
                    <field name="living_area" string="Living area (sqm)" width="150vw"/>
                    <field name="expected_price" width="150vw"/>
                    <field name="selling_price" width="150vw"/>
                    <field name="date_availability" string="Available From" width="150vw"/>
                </list>
            </field>
        </record>


        <!-- From view of the estate properties -->
        <record id="estate_properties_form_view" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="name">
                    <sheet>
                        <group>
                            <div class="oe_title">
                                <h1><field name="name" placeholder="e.g. New house"/></h1>
                            </div>
                        </group>

                        <group>    
                            <group>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                            </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


         <!-- Search for the estate properties -->
        <record id="estate_properties_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Searching in estates">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="facades"/>
                    <separator/>
                    <filter string="Available" name="active" domain="['|', ('state', '=', 'new' ),('state', '=', 'offer received' )]"/>
                    <filter string="Postcode" name="postcode"  context="{'group_by':'postcode'}"/>
                </search>
            </field>
        </record>
</odoo>
