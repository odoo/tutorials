<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate.property_model_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate.property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
                <field name="tags_id" widget="many2many_tags" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="estate.property_view_form" model="ir.ui.view">
         <field name="name">estate.property.form</field>
         <field name="model">estate.property</field>
         <field name="arch" type="xml">
            <form string="Property Form">
              <header>
                  <button type="object" name="action_sell_property" class="btn-primary" invisible="state == 'sold' or state == 'cancelled'">Sold</button>
                  <button type="object" name="action_cancel_property" invisible="state == 'sold' or state == 'cancelled'">Cancel</button>

                  <!-- Below code is not working, whenever we try to change the state from any state to sold or cancelled
                       the state doesn't changes and statusbar becomes readonly. -->
                  <!-- <field name="state" widget="statusbar" readonly="state == 'sold' or state == 'cancelled'" options="{'clickable': '1'}" /> -->

                  <!-- Below code is another workaround to make the statusbar readonly when the state is either sold or cancelled. -->

                  <!-- 1. CLICKABLE Status Bar: Visible ONLY when NOT sold or cancelled -->
                  <field name="state" widget="statusbar" options="{'clickable': '1'}" invisible="state == 'sold' or state == 'cancelled'"/>

                  <!-- 2. READ-ONLY Status Bar: Visible ONLY when state IS sold or cancelled -->
                  <field name="state" widget="statusbar" invisible="state != 'sold' and state != 'cancelled'"/>
              </header>
                <sheet>
                    <group>
                        <h1><field name="title"/></h1>
                    </group>
                    <group>
                        <field name="property_type_id" options="{'no_create': true}" />
                        <field name="tags_id" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                    <group>
                        <group>
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="best_price" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="garden_area" invisible="not garden" />
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_orientation" invisible="not garden" />
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ('offer_accepted', 'sold', 'cancelled')" />
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="seller_id" readonly="1" force_save="1" />
                                <field name="buyer_id" readonly="1" force_save="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
         </field>
    </record>
</odoo>
