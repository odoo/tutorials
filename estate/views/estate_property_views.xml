<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <search string="Search Estate Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '>=', self)]"/>
                <field name="facades"/>
                <filter string="Include archived" name="archived" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <separator/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Postcode" name="postcode" context="{'group_by':'postcode', 'residual_visible':True}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <list string="Properties"
                decoration-success="state == 'offer_received' or state == 'offer_accepted'"
                decoration-bf="state == 'offer_accepted'"
                decoration-muted="state == 'sold'">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <form string="Estate Property"> 
                <header>
                    <button name="action_cancel_estate_property" string="Cancel"
                        type="object" data-hotkey="c" title="Mark as cancelled"
                        invisible="state == 'sold'"/>
                    <button name="action_sold_estate_property" string="Sold"
                        type="object" data-hotkey="v" title="Mark as sold"
                        invisible="state == 'canceled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                </header>
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" groups="estate_group_manager"/>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': true}" groups="estate_group_manager">Property Type</field>
                            <field name="company_id" options="{'no_create': true}">Company</field>
                            <field name="postcode">Postcode</field>
                            <field name="date_availability">Availabile From</field>
                        </group>
                        <group>
                            <field name="expected_price">Expected Price</field>
                            <field name="best_price">Best Offer</field>
                            <field name="selling_price">Selling Price</field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <div class="w-50">
                                <div class="row">
                                    <div class="col">
                                        <label for="description" string="Description"/>
                                    </div>
                                    <div class="col">
                                        <field name="description"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="bedrooms" string="Bedrooms"/>
                                    </div>
                                    <div class="col">
                                        <field name="bedrooms"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="living_area" string="Living Area"/>
                                    </div>
                                    <div class="col">
                                        <field name="living_area"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="facades" string="Facades"/>
                                    </div>
                                    <div class="col">
                                        <field name="facades"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="garage" string="Garage"/>
                                    </div>
                                    <div class="col">
                                        <field name="garage"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="garden" string="Garden"/>
                                    </div>
                                    <div class="col">
                                        <field name="garden"/>
                                    </div>
                                </div>
                                <div class="row" invisible="not garden">
                                    <div class="col">
                                        <label for="garden_area" string="Garden Area"/>
                                    </div>
                                    <div class="col">
                                        <field name="garden_area"/>
                                    </div>
                                </div>
                                <div class="row" invisible="not garden">
                                    <div class="col">
                                        <label for="garden_orientation" string="Garden Orientation"/>
                                    </div>
                                    <div class="col">
                                        <field name="garden_orientation"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="total_area" string="Total Area"/>
                                    </div>
                                    <div class="col">
                                        <field name="total_area"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids">
                            </field>
                        </page>
                        <page string="Other Info">
                            <div class="w-50">
                                <div class="row">
                                    <div class="col">
                                        <label for="salesman_id" string="Salesman"/>
                                    </div>
                                    <div class="col">
                                        <field name="salesman_id"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        <label for="buyer_id" string="Buyer"/>
                                    </div>
                                    <div class="col">
                                        <field name="buyer_id"/>
                                    </div>
                                </div>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate_property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="offer_ids"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div>Expected Price: <field name="expected_price"/></div>
                        <div t-if="record.offer_ids.raw_value.length > 0">Best Offer: <field name="best_price"/></div>
                        <div t-if="record.state.raw_value == 'offer_accepted' || record.state.raw_value == 'sold'">
                            Selling Price: <field name="selling_price"/>
                        </div>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate_property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
</odoo>