<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'sold'" decoration-success="offer_ids" decoration-bf="state == 'offer accepted'">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area(sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availibility" optional="hide" string="Availability From"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="tag_ids"/>
            </list>
        </field>
    </record>

    <record id="estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_sold_property" invisible="state == 'sold'" string="Sold" />
                    <button type="object" name="action_cancel_property" invisible="state == 'sold'" string="Cancel" />
                    <button type="object" name="action_accept_best_offer" string="Accept Best Offer" />
                    <field name="state" widget="statusbar" readonly="state in ['sold','cancelled']"/>
                </header>
                <div class="oe_title">
                    <h1>
                        <field name="name" string="Title" placeholder="Property Name..."/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" editable="bottom"/>
                        <field name="property_type_id" options="{'no_create': true}"/>
                        <field name="postcode"/>
                        <field name="date_availibility" string="Availability From"/>
                    </group>
                    <group>
                        <field name="expected_price"/>
                        <field name="selling_price"/>
                        <field name="best_price"/>
                    </group>
                </group>
                <sheet>
                    <notebook>
                        <page string="Description">
                            <group col="2">
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area(sqm)" />
                                <field name="facades" string="Facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field invisible = "not garden" name="garden_area" string="Garden Area(sqm)"/>
                                <field invisible = "not garden" name="garden_orientation"/>
                                <field name="active"/>
                                <field name="total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" readonly="state in ['offer accepted','sold','cancelled']">
                                <list decoration-success= "status == 'accepted'" decoration-danger="status == 'refused'" editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <button icon="fa-check" invisible = "status" title="Accept" string="Accept" name="action_accept_offer" type="object"/>
                                    <button icon="fa-times" invisible = "status" title="Reject" string="Reject" name="action_reject_offer" type="object"/>
                                    <field name="date_deadline"/>
                                    <!-- <field name="property_type"/> -->
                                </list>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="salesperson_id" string="Salesman"/>
                                <field name="buyer_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>

    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search >
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)" filter_domain="[('living_area','>=',self)]"/>
                <field name="expected_price"/>
                <field name="facades"/>
                <field name="property_type_id"/>
                <field name="tag_ids"/>
                <field name="total_area"/>
                <filter string="Available" name="available" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer received')]"/>
                <filter string="active" name="active" domain="[ ('active', '=', 'True')]"/>
                <group>
                    <filter string="Postcode" name="groupby_postcode" context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" records_draggable="False">
                <field name="state"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="tag_ids"/>

                <templates>
                    <t t-name="card">
                        <div>
                            <field name="name"/>
                            <div>
                                <field name="expected_price"/>
                            </div>
                            <div t-if="record.best_price.raw_value">
                                Best Price: <field name="best_price"/>
                            </div>
                            <div t-if="record.state.raw_value == 'sold'">
                                Selling Price: <field name="selling_price" widget="monetary"/>
                            </div>
                            <div>
                                <field name="tag_ids"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property</field>
        <field name="context">{'search_default_available' : 1}</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
