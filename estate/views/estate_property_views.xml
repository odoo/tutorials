<odoo>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">x_estate.property.view.list</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="x_name"/>
                <field name="x_property_type_id"/>
                <field name="x_postcode"/>
                <field name="x_bedrooms"/>
                <field name="x_living_area"/>
                <field name="x_expected_price"/>
                <field name="x_selling_price"/>
                <field name="x_date_available" optional="hidden"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.view.form</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <h1>
                        <field name="x_name"/>
                    </h1>
                    <field name="x_property_tag_ids" widget="many2many_tags"/>
                    <group>
                        <group>
                            <field name="x_postcode"/>
                            <field name="x_property_type_id"/>
                            <field name="x_date_available"/>
                        </group>
                        <group>
                            <field name="x_expected_price"/>
                            <field name="x_selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="x_description"/>
                                <field name="x_bedrooms"/>
                                <field name="x_living_area"/>
                                <field name="x_facades"/>
                                <field name="x_garage"/>
                                <field name="x_garden"/>
                                <field name="x_garden_area"/>
                                <field name="x_garden_orientation"/>
                                <field name="x_total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="x_offer_ids"/>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="x_user_id"/>
                                <field name="x_partner_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Property</field>
        <field name="res_model">x_estate.property</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
