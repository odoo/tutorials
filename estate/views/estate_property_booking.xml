<?xml version="1.0"?>
<odoo>

    <record id="estate_property_active_booking_action" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="res_model">estate.property.booking</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_booking_action" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="res_model">estate.property.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_booking_list" model="ir.ui.view">
        <field name="name">estate.property.booking.list</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <list string="booking">
                <field name="name"/>
                <field name="property_id" string="property"/>
                <field name="customer"/>
                <field name="sales_person"/>
                <field name="time_slot" string="slot"/>
            </list>
        </field>
    </record>

    <record id="estate_property_booking_form" model="ir.ui.view">
        <field name="name">estate.property.booking.form</field>
        <field name="model">estate.property.booking</field>
        <field name="arch" type="xml">
            <form string="booking">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="property_id" string="property" invisible="context.get('default_property_id')"/>
                        <field name="customer"/>
                        <field name="sales_person"/>
                        <field name="rating" widget="priority"/>
                        <field name="time_slot" string="slot"/>
                        <field name="feedback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
