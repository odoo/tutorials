<odoo>

    <record id="estate_property_type_form" model="ir.ui.view">
        <field name="name">Property Type Form</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div  class="oe_clear">
                        <div style="float:left;">
                            <h3><field name="name"/></h3>
                        </div>
                        <div style="float:right;">
                            <button type="action" name="%(estate_property_offer_action)d" class="oe_stat_button" icon="fa-money">
                                <div class="o_field_widget o_stat_info">
                                    <field name="offer_count" widget="statinfo" string="Offers"/>
                                </div>
                            </button>
                        </div>
                    </div>
                    <notebook>
                        <page name="estate_properties_page" string="Properties">
                            <field name="estate_property_ids">
                                <list>
                                    <field name="name" string="Title"/>
                                    <field name="expected_price" string="Expected Price"/>
                                    <field name="status"/>
                                </list>
                            </field>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

       <record id="estate_property_type_list" model="ir.ui.view">
        <field name="name">Property Type List</field>
        <field name="model">estate.property.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="offer_count" string="Offers"/>
            </list>
        </field>
    </record>


</odoo>
