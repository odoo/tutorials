<odoo>

    <record id="res_config_settings_view_form_auction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.auction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//form" position="inside">
                <app string="Real Estate" name="estate">
                    <block title="Auction">
                        <setting id="estate_auction_setting" string="Automated Auction">
                            <field name="module_estate_auction"/>
                                <div class="text-muted">
                                    Enable automated Real Estate Auction to sell properties in auction format.
                                </div>
                        </setting>

                    </block>

                </app>

            </xpath>

        </field>

    </record>

    <record id="action_estate_property_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_auction"/>
        <field name='view_mode'>form</field>
        <field name="context">{'module': 'estate'}</field>
    </record>

</odoo>