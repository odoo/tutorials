<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_estate" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.estate</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Estate" string="Estate" name="estate">
                    <block title="Auction" id="estate_auction_setting">
                        <setting help="Enable and install automated auction features for real estate.">
                            <field name="module_estate_auction"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="estate_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'estate'}</field>
    </record>
</odoo>
