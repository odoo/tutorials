<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="estate_property_visit_action" model="ir.actions.act_window">
        <field name="name">Property Visit</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,calendar,form</field>
    </record>

    <record id="estate_property_visit_list_view" model="ir.ui.view">
        <field name="name">estaee.property.visit.list.view</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list>
            <field name="customer_id"/>
            <field name="property_id"/>
            <field name="agent_id"/>
            <field name="visit_date"/>
            </list>
        </field>
    </record>

    <record id="estate_property_visit_calendar_view" model="ir.ui.view">
        <field name="name">estate.property.visit.calender.view</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="visit_date" string="Scedule visit" mode="month" >
                <field name="customer_id"/>
                <field name="property_id"/>
                <field name="agent_id"/>
                <field name="visit_date"/>
            </calendar>
        </field>
    </record>

    <record id="estate_property_visit_form_view" model="ir.ui.view">
        <field name="name">estate.property.visit.form.view</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" type="object" string="Done"/>
                    <button name="action_cancel" type="object" string="Cancel"/>
                    <field name="status_visit" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="customer_id"/>
                        <field name="property_id"/>
                        <field name="visit_date"/>
                    </group>
                    <group>
                        <field name="agent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
