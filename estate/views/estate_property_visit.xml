<odoo>
    <record id="estate_property_visit_action" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>

    <record id="estate_property_visit_form_view" model="ir.ui.view">
        <field name="name">estate.property.visit.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form string="Property Visit">
                <header>
                    <button name="action_set_done" type="object" string="Mark as Done" 
                            class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_set_cancel" type="object" string="Cancel" 
                            invisible="state != 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id" />
                            <field name="buyer_id" />
                        </group>
                        <group>
                            <field name="user_id" />
                            <field name="schedule_date" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list string="Property Visit">
                <field name="buyer_id"/>
                <field name="user_id"/>
                <field name="schedule_date"/>
            </list>
        </field>
    </record>
</odoo>
