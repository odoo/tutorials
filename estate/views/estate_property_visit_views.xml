<odoo>

    <record id="estate_property_visit_action" model="ir.actions.act_window">
        <field name="name">Property visit</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>

    <record id="view_estate_property_visit_calendar" model="ir.ui.view">
    <field name="name">estate.property.visit.calendar</field>
    <field name="model">estate.property.visit</field>
    <field name="arch" type="xml">
        <calendar string="Visits" date_start="visit_time">
            <field name="partner_id"/>
        </calendar>
    </field>
    </record>

    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list string="visits"> 
                <field name="partner_id"/>
                <field name="visit_time"/>
            </list>
        </field>
    </record>

    <record id="view_property_visit_form" model="ir.ui.view">
    <field name="name">estate.property.visit.form</field>
    <field name="model">estate.property.visit</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="partner_id"/>
                    <field name="visit_time"/>
                </group>
            </sheet>
        </form>
    </field>
    </record>
</odoo>
