<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="estate_property_visit_list" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="property_id"/>
                <field name="state"/>
                <field name="visit_date"/>
            </list>
        </field>
    </record>

    <record id="estate_property_visit_form" model="ir.ui.view">
        <field name="name">estate.property.visit.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="property_id"/>
                        <field name="partner_id"/>
                        <field name="visit_date"/>
                        <field name="state"
                               widget="statusbar"
                                />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_visit_action" model="ir.actions.act_window">
        <field name="name">Property Visits</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>

    <record id="estate_property_visit_calendar" model="ir.ui.view">
        <field name="name">estate.property.visit.calendar</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <calendar 
                date_start="visit_date"
            >       
                    <field name="partner_id"/>
                    <field name="property_id"/>
            </calendar>
        </field>
    </record>

</odoo>