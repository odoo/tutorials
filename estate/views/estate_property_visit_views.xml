<odoo>
    <record id="estate_property_visits_view_list" model="ir.ui.view">
        <field name="name">estate.property.visits.view.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="buyer_id"/>
                <field name="visit_date"/>
            </list>
        </field>
    </record>

    <record id="estate_property_visits_view_form" model="ir.ui.view">
        <field name="name">estate.property.visits.view.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="Scheduled,Done"/>
                </header>
                <sheet>
                    <group>
                        <field name="buyer_id"/>
                        <field name="visit_date"/>
                        <field name="state"/>
                        <field name="stop_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_visit_action_stat" model="ir.actions.act_window">
        <field name="name">Estate Property Stat Button</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
        <field name="context">{'default_property_id': active_id}</field>
    </record>
</odoo>
