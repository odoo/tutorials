<odoo>

    <record id="action_estate_property_visit" model="ir.actions.act_window">
        <field name="name">Property visit</field>
        <field name="res_model">estate.property.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="list_estate_property_visit" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list string="Property Visit">
                <field name="propert_id"/>
                <field name="partner_id"/>
                <field name="visit_date"/>
                <field name="end_date"/>
              
            </list>
        </field>
    </record>

    <record id="form_estate_property_visit" model="ir.ui.view">
        <field name="name">estate.property.visit.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
             <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="propert_id"/>
                        <field name="visit_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>