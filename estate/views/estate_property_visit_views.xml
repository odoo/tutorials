<odoo>
<record id="action_property_visit" model="ir.actions.act_window">
    <field name="name">Visits</field>
    <field name="res_model">estate.property.visit</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('property_id', '=', active_id)]</field>
    <field name="context">{'default_property_id': active_id}</field>
</record>
    <record id="estate_property_visit_list_view" model="ir.ui.view">
        <field name="name">estate.property.visit.list</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <list>
                    <field name="partner_id"/>
                    <field name="visit_date"/>
            </list>
        </field>
    </record>
<record id="estate_property_visit_form_view" model="ir.ui.view">
        <field name="name">estate.property.visit.form</field>
        <field name="model">estate.property.visit</field>
        <field name="arch" type="xml">
            <form>
            <header>
            <field name="stato" widget="statusbar" options="{'clickable': '1'}"/>
        </header>
                <sheet>
                    <div class="oe_title">
                    <group>
                            <field name="partner_id"/>
                            <field name="visit_date"/>
                    </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
