<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available': True}</field>
    </record>
s
    <record id="estate_list" model="ir.ui.view">
        <field name="name">estate.properties.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Channel" decoration-success="state in ['offer_received', 'offer_accepted']" decoration-bf="state == 'offer_accepted'" decoration-muted="state == 'sold'">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="tag_ids" string="Tags" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living area (sqm)"/>
                <field name="expected_price" string="Expected price"/>
                <field name="selling_price" string="Selling price"/>
                <field name="date_availability" string="Available From" optional="hide"/>
                <field name="property_type_id" string="Property Type"/>
            </list>
        </field>
    </record>

    <record id="estate_form" model="ir.ui.view">
        <field name="name">estate.properties.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Channel">
            <header>
                <button name="action_sold" type="object" string="Sold" invisible="state == 'sold' or state == 'cancelled'"/>
                <button name="action_cancel" type="object" string="Cancel" invisible="state == 'sold' or state == 'cancelled'"/>
                <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
            </header>
                <sheet>
                    <h1>
                        <field name="name" string="Name"/>
                    </h1>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group>
                        <group>
                            
                            <field name="postcode" string="Postcode"/>
                            <field name="date_availability" string="Available From"/>
                            <field name="property_type_id" string="Property Type" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="expected_price" string="Expected price"/>
                            <field name="selling_price" string="Selling price"/>       
                            <field name="best_price" string="Best offer"/>          
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living area (sqm)"/>                                 
                                <field name="facades" string="Facades"/>
                                <field name="garage" string="Garage"/>
                                <field name="garden" string="Garden"/>
                                <field name="garden_area" string="Garden area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" string="Garden orientation" invisible="not garden"/>
                                <field name="salesperson_id" string="Salesperson"/>
                                <field name="buyer_id" string="Buyer"/>
                                <field name="total_area" string="Total area (sqm)"/>
                                
                            </group>
                        </page>
                        <page string="Offers">
                                <field name="offer_ids" string="Offers" readonly="state not in ['offer_received', 'new']"/>
                        </page>
                        <page string="Others">
                            <group>
                                <field name="active" string="Active"/>

                            </group>
                        </page>
                    </notebook> 
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_search" model="ir.ui.view">
        <field name="name">estate.properties.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Title"/>
                <field name="postcode" string="Postcode"/>
                <field name="bedrooms" string="Bedrooms"/>
                <field name="living_area" string="Living area (sqm)" filter_domain="[('living_area', '>=', self)]"/>
                <field name="expected_price" string="Expected price"/>
                <field name="selling_price" string="Selling price"/>
                <field name="facades" string="Facades"/>
                <field name="property_type_id" string="Property Type"/>
                <separator/>
                <filter string="Available" name="available" domain="['|',('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
                <filter string="Provider" name="postcode" context="{'group_by':'postcode', 'residual_visible':True}"/>
            </search>
        </field>
    </record>
<record id="estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.properties.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id">
                <field name="best_price"/>
                <field name="expected_price"/>
                <templates>
                    <t t-name="card">
                     
                        <div>
                            <strong><field name="name"/></strong>
                        </div>
                        <div>
                            <span class="badge badge-info">Expected price: <t t-esc="record.expected_price.raw_value"/></span>
                        </div>
                            <div t-if="record.best_price and record.best_price.raw_value">
                                <span class="badge badge-info">Best Offer: <t t-esc="record.best_price.raw_value"/></span>
                            </div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
