<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherited_model_view_form" model="ir.ui.view">
        <field name="name">res.users.form.estate.offer</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='page_security']" position="after">
                <page string="Real Estate Properties" name="estate_properties">
                    <field name="property_ids" readonly="True"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
