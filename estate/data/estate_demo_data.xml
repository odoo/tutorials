<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- property demo -->
        <record id="estate_property_demo_1" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="property_type_id" ref="property_type_residential" />
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">16000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
        </record>

        <record id="estate_property_demo_2" model="estate.property">
            <field name="name">Bigestt Villa</field>
            <field name="property_type_id" ref="property_type_residential" />
            <field name="state">new</field>
            <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">16000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">100000</field>
            <field name="garden_orientation">south</field>
        </record>

        <record id="estate_property_demo_3" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="offer_ids"
                eval="[
                        Command.create({ 'price' : 2023300003, 'partner_id' : ref('base.res_partner_3')}),
                        Command.create({ 'price' : 2000003, 'partner_id' : ref('base.res_partner_1')})
                        ]" />
            <field name="state">cancelled</field>
            <field name="description">Home in a trailer park</field>
            <field name="postcode">54321</field>
            <field name="date_availability">1970-01-01</field>
            <field name="expected_price">1000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage">False</field>
        </record>

        <!-- offer demo -->
        <record id="offer_demo_1" model="estate.property.offer">
            <field name="price">12000220</field>
            <field name="date_deadline"
                eval="datetime.now().date() + timedelta(days=7)" />
            <field name="partner_id" ref="base.res_partner_1" />
            <field name="property_id" ref="estate.estate_property_demo_1" />
        </record>

        <record id="offer_demo_2" model="estate.property.offer">
            <field name="price">654333</field>
            <field name="date_deadline"
                eval="datetime.now().date() + timedelta(days=365)" />
            <field name="partner_id" ref="base.res_partner_2" />
            <field name="property_id" ref="estate.estate_property_demo_2" />
        </record>

        <record id="offer_demo_3" model="estate.property.offer">
            <field name="price">23453336</field>
            <field name="date_deadline"
                eval="datetime.now().date() + timedelta(days=7)" />
            <field name="partner_id" ref="base.res_partner_2" />
            <field name="property_id" ref="estate.estate_property_demo_1" />
        </record>

        <!-- property type demo -->
        <record id="propert_type_demo_1" model="estate.property.type">
            <field name="name">Flat</field>
            <field name="property_ids"
                eval="[
            Command.link(ref('estate_property_demo_3'))
            ]" />
        </record>

        <!-- function calling demo -->
        <function model="estate.property.offer" name="action_accept_offer">
            <value eval="[ref('offer_demo_1')]" />
        </function>
    </data>
</odoo>
