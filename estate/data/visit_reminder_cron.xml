<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ir_cron_visit_reminder"
            model="ir.cron">
        <field name="name">Visit Reminder Cron</field>
        <field name="model_id" ref="model_estate_visit"/>
        <field name="state">code</field>
        <field name="code">model.send_visit_reminder()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>