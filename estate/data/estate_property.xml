<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1"> 
        <record id="id1" model="estate.property">
            <field name="name">Big Villa</field>
            <field name="state">new</field> <field name="description">A nice and big villa</field>
            <field name="postcode">12345</field>
            <field name="date_availability">2020-02-02</field>
            <field name="expected_price">1600000</field>
            <field name="bedrooms">6</field>
            <field name="living_area">100</field>
            <field name="facades">4</field>
            <field name="garage">True</field>
            <field name="garden">True</field>
            <field name="garden_area">1000</field>
            <field name="garden_orientation">south</field>
        </record>

        <record id="id2" model="estate.property">
            <field name="name">Trailer home</field>
            <field name="description">A nice and small trailer home</field>
            <field name="postcode">54321</field>
            <field name="date_availability">2024-01-01</field> <field name="expected_price">100000</field>
            <field name="selling_price">120000</field>
            <field name="bedrooms">1</field>
            <field name="living_area">10</field>
            <field name="facades">4</field>
            <field name="garage">False</field>
        </record>

        <record id="offer_demo_1" model="estate.property.offer">
            <field name="price">10000</field>
            <field name="validity">14</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="property_id" ref="id1"/>
            <field name="create_date" eval="datetime.now()"/>
        </record>

        <record id="offer_demo_2" model="estate.property.offer">
            <field name="price">1500000</field>
            <field name="validity">14</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="property_id" ref="id1"/>
            <field name="create_date" eval="datetime.now() - relativedelta(days=2)"/>
        </record>

        <record id="offer_demo_3" model="estate.property.offer">
            <field name="price">1500001</field>
            <field name="validity">14</field>
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="property_id" ref="id1"/>
            <field name="create_date" eval="datetime.now() - relativedelta(days=5)"/>
        </record>

        <record id="id1" model="estate.property">
            <field name="property_type_id" ref="estate_property_type_residential"/>
        </record>

        <record id="id2" model="estate.property">
            <field name="property_type_id" ref="estate_property_type_residential"/>
        </record>

        <function model="estate.property.offer" name="refuse_offer">
            <value eval="[ref('offer_demo_1')]"/>
        </function>

        <function model="estate.property.offer" name="refuse_offer">
            <value eval="[ref('offer_demo_2')]"/>
        </function>

        <function model="estate.property.offer" name="accept_offer">
            <value eval="[ref('offer_demo_3')]"/>
        </function>

        <record id="demo_property_3" model="estate.property">
            <field name="name">Modern Apartment</field>
            <field name="description">A nice apartment with built-in offers</field>
            <field name="postcode">98765</field>
            <field name="expected_price">200000</field>
            
            <field name="offer_ids" eval="[
                Command.create({
                    'price': 180000,
                    'validity': 7,
                    'partner_id': ref('base.partner_admin')
                }),
                Command.create({
                    'price': 195000,
                    'validity': 14,
                    'partner_id': ref('base.partner_admin')
                })
            ]"/>
        </record>
        
    </data>
</odoo>