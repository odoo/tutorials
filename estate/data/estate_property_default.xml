<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="default_property_type" model="estate.property.type">
        <field name="name">House</field>
    </record>

    <record id="default_property_type2" model="estate.property.type">
        <field name="name">Flat</field>
    </record>

    <record id="default_property_tag" model="estate.property.tag">
        <field name="name">Cozy</field>
    </record>

    <record id="default_property_tag2" model="estate.property.tag">
        <field name="name">Good</field>
    </record>

    <record id="default_property" model="estate.property">
        <field name="name">Demo Property</field>
        <field name="tag_ids" eval="[(6, 0, [ref('default_property_tag')])]"/>
        <field name="property_type_id" ref="default_property_type"/>
        <field name="postcode">360311</field>
        <field name="expected_price">100000</field>
        <field name="description">This is a good house</field>
        <field name="living_area">100</field>
        <field name="bedrooms">3</field>
    </record>

    <record id="demo_property_2" model="estate.property">
        <field name="name">Modern Apartment</field>
        <field name="tag_ids" eval="[(6, 0, [ref('default_property_tag2')])]"/>
        <field name="property_type_id" ref="default_property_type2"/>
        <field name="postcode">380015</field>
        <field name="expected_price">75000</field>
        <field name="description">Modern flat in city center</field>
        <field name="living_area">80</field>
        <field name="bedrooms">2</field>
    </record>

    <record id="demo_property_3" model="estate.property">
        <field name="name">Luxury Villa</field>
        <field name="tag_ids" eval="[(6, 0, [ref('default_property_tag'), ref('default_property_tag2')])]"/>
        <field name="property_type_id" ref="default_property_type"/>
        <field name="postcode">360005</field>
        <field name="expected_price">250000</field>
        <field name="description">Luxury villa with garden</field>
        <field name="living_area">200</field>
        <field name="bedrooms">5</field>
    </record>

    <record id="default_buyer" model="res.partner">
        <field name="name">Mitchell</field>
    </record>

    <record id="default_offer" model="estate.property.offer">
        <field name="price">91</field>
        <field name="partner_id" ref="default_buyer"/>
        <field name="property_id" ref="default_property"/>
    </record>

</odoo>
