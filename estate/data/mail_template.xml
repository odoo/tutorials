<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_booking_confirmation_email" model="mail.template">
        <field name="name">Booking Confirmation</field>
        <field name="model_id" ref="model_estate_property_booking"/>
        <field name="email_from">{{ object.property_id.salesperson_id.email_formatted or object.create_uid.email_formatted }}</field>
        <field name="email_to">{{ object.buyer_id.email }}</field>
        <field name="subject">Booking Confirmed - {{ object.property_id.name }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.buyer_id.name"/>,</p>
                <p>
                    Your booking for
                    <strong>
                        <t t-out="object.property_id.name"/>
                    </strong>
                    has been confirmed.
                </p>
                <p>
                    <strong>Total Amount:</strong>
                    <t t-out="object.total_amount"/>
                </p>
                <p>
                    <strong>Paid Amount:</strong>
                    <t t-out="object.paid_amount"/>
                </p>
                <p>
                    Thank you for choosing us.
                </p>
            </div>
        </field>
    </record>
</odoo>
