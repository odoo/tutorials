<odoo>
    <record id="mail_template_property" model="mail.template">
        <field name="name">Property: Property Sold</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="subject">test_subject </field>
        <field name="email_from">test</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Used by salespeople when the property is sold.</field>
        <field name="body_html" type="html">
            <div style="font-size:13px;">
                <p>
                    Dear <t t-out="object.partner_id.name or 'Customer'"/>
                    ,
                <br/>
                <br/>
                    We are pleased to inform you that the offer for the property
                <strong t-out="object.name"/>
                    has been accepted.
            </p>
            <p>
                <strong>Expected Price:</strong>
                <t t-out="format_amount(object.expected_price, object.env.company.currency_id)"/>
                <br/>
                <strong>Best Offer:</strong>
                <t t-out="format_amount(object.best_price, object.env.company.currency_id)"/>
            </p>
            <p>
                <strong>Property Type:</strong>
                <t t-out="object.property_type_id.name"/>
                <br/>
                <strong>Total Area:</strong>
                <t t-out="object.total_area"/>
                    sqm
            </p>
            <p>Please contact us for further steps.</p>
        </div>
    </field>
    <field name="auto_delete" eval="True"/>
</record>

</odoo>
