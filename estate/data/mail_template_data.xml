<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_edit_sale" model="mail.template">
        <field name="name">Estate Sold</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="subject">{{ object.name }}</field>
        <field name="email_from">{{ object.seller_id.email }}</field>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
            <div>
                Hello,
                The property <strong><t t-out="object.name"/></strong> 
                is sold by <strong><t t-out="object.seller_id.name"/></strong> 
                and purchased by <strong><t t-out="object.buyer_id.name"/></strong>.
                The final selling price is <strong><t t-out="object.selling_price"/></strong>.
            </div>
        </field>
    </record>
</odoo>
