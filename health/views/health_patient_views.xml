<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="health_patient_view_list" model="ir.ui.view">
        <field name="name">health.patient.list</field>
        <field name="model">health.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="age" />
                <field name="gender" />
                <field name="is_minor" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="health_patient_view_form" model="ir.ui.view">
        <field name="name">health.patient.form</field>
        <field name="model">health.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name='state' widget='statusbar' />
                    <button name='action_confirm' type="object" string="Confirm" class='btn-primary' />
                    <button name='action_discharge' type="object" string="Discharge" />
                    <button name='action_esclate_all' type="object" string="Esclate All" />
                </header>
                <sheet>
                    <div class="oe_title mb16">
                        <h1>
                            <label for="name" string="Patient name" />
                            <field name="name" placeholder="Jacob bog" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="rating" widget="rating_widget" />
                            <field name="age" />
                            <field name="gender" />
                            <field name="visit_count" />
                            <field name="discharge_notes" />
                        </group>
                        <group>
                            <field name="is_minor" />
                            <field name="appointment_count" />
                            <field name="last_visit_date" />
                            <field name="is_frequent_visitor" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids">
                                <list>
                                    <field name="patient_id" />
                                    <field name="doctor_id" />
                                    <field name="appointment_date" />
                                    <field name="priority" />
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="health_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">health.patient</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
