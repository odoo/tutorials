<?xml version="1.0"?>
<odoo>

    <record id="estate_account_invoice_action" model="ir.actions.act_window">
        <field name="name">Property Invoice</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_id', '=', active_id)]</field>
    </record>

    <record id="estate_account_invoice_form_view" model="ir.ui.view">
        <field name="name">estate_account_invoice_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_property" type="object" icon="fa-home">
                    <field name="property_id" widget="statinfo" string="Property"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
