<odoo>
    <record id="view_property_form_inherit_invoice" model="ir.ui.view">
        <field name="name">estate.property.form.invoice.button</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_event.view_property_form_inherit_property"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button type="object" name="action_view_invoice" class="oe_stat_button" icon="fa-file-text-o" invisible="invoice_count == 0">
                        <field name="invoice_count" widget="statinfo" string="Invoice"/>
                    </button>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
