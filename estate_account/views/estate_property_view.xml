<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_form_inherit_account" model="ir.ui.view">
        <field name="name">estate.property.view.form.inherit.account</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_partner_invoices" type="object" icon="fa-pencil-square-o">
                    <field name="invoice_count" string="Invoices" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>