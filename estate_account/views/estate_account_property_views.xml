<?xml version="1.0"?>
<odoo>

    <record id="estate_account_property_form_view" model="ir.ui.view">
        <field name="name">estate_account_property_form</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='title']" position="before">
                <div name="button_box">
                    <button name="%(estate_account_invoice_action)d" type="action" 
                    icon="fa-folder-open-o" invisible="not invoice_ids">
                        <field name="invoice_ids" widget="statinfo" string="Invoice"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
