<odoo>

    <record id="estate_property_offer_view_list_inherit" model="ir.ui.view">
        <field name="name">estate.property.offer.list.inherit</field>
        <field name="model">estate.property.offer</field>
        <field name="inherit_id" ref="estate.estate_property_offer_view_list" />
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_accept_offer']" position="attributes">
                <attribute name="invisible">
                    sale_type == 'auction' or status
                </attribute>
            </xpath>

            <xpath expr="//button[@name='action_refuse_offer']" position="attributes">
                <attribute name="invisible">
                    sale_type == 'auction' or status
                </attribute>
            </xpath>

        </field>
    </record>

</odoo>
