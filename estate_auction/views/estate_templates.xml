<odoo>

    <template id="website_estate_properties" name="Estate Website Shop">
        <t t-call="website.layout">
            <div class="container">
                <div class="mb-3">
                    <a href="/properties"
                        t-attf-class="btn #{'btn-primary' if not sale_type else 'btn-outline-primary'}">
                        All
                    </a>

                    <a href="/properties?sale_type=regular"
                        t-attf-class="btn #{'btn-primary' if sale_type == 'regular' else 'btn-outline-primary'}">
                        Regular
                    </a>

                    <a href="/properties?sale_type=auction"
                        t-attf-class="btn #{'btn-primary' if sale_type == 'auction' else 'btn-outline-primary'}">
                        Auction
                    </a>
                </div>
                <t t-call="website.website_search_box_input">
                    <t t-set="search" t-value="search" />
                </t>
                <div class="row">
                    <t t-foreach="properties" t-as="property">
                        <div class="col m-2">
                            <div class="d-flex justify-content-center">
                                <a t-attf-href="/properties/#{property.id}"
                                    style="text-decoration:none">
                                    <div class="card" style="max-width: 300px; width: 100%;">
                                        <img
                                            t-attf-src="/web/image/estate.property/#{property.id}/image"
                                            class="card-img-top" />

                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <t t-esc="property.name" />
                                            </h6>

                                            <t t-esc="property.expected_price" />

                                            <small>
                                                <t t-esc="property.bedrooms" /> Bedrooms </small>
                                        </div>

                                    </div>
                                </a>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="d-flex justify-content-center mt-4">
                    <t t-call="website.pager" />
                </div>
            </div>
        </t>
    </template>

    <template id="property_detail_template" name="Property Detail">
        <t t-call="website.layout">
            <div class="container mt-4">
                <div class="row">

                    <div class="col-md-6">
                        <img t-attf-src="/web/image/estate.property/#{property.id}/image"
                            style="max-width:400px;" />
                    </div>

                    <div class="col-md-6">
                        <h1>
                            <t t-esc="property.name" />
                        </h1>
                        <p>Expected Price: <t t-esc="property.expected_price" /></p>
                        <p>Best Offer: <t t-esc="property.best_offer" /></p>
                        <p>Living Area: <t t-esc="property.living_area" /></p>
                        <p>Status: <t
                                t-esc="dict(property._fields['state'].selection).get(property.state)" /></p>
                        <p>Salesperson: <t t-esc="property.salesman_id.name" /></p>
                        <p>Availability From: <t t-esc="property.date_availability" /></p>
                        <p>Bedrooms: <t t-esc="property.bedrooms" /></p>

                        <t
                            t-if="property.sale_type == 'auction' and property.auction_state == 'running' and property.remaining_time != 'Auction is Ended'">
                            <t t-if="request.env.user._is_public()">
                                <a href="/web/login" class="btn btn-primary">
                                    Login to Make Offer
                                </a>
                            </t>
                            <t t-else="">
                                <form action="/property/make_offer" method="post">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()" />
                                    <input type="hidden" name="property_id"
                                        t-att-value="property.id" />

                                    <div class="mb-2">
                                        <input type="number" name="price" class="form-control"
                                            placeholder="Your Offer" min="1" required='true' />
                                    </div>

                                    <button type="submit" class="btn btn-primary">
                                        Make Offer
                                    </button>
                                    <a t-attf-href="/properties"
                                        class="btn btn-secondary">
                                        Cancel
                                    </a>
                                </form>
                                <div class="col-md-6 mt-3">
                                    <h3>
                                        <t t-esc='property.remaining_time' />
                                    </h3>
                                </div>
                            </t>
                        </t>
                        <t t-if="property.sale_type == 'auction'">

                            <t t-if="property.auction_state == 'cancelled'">
                                <h3>Auction is Cancelled</h3>
                            </t>

                            <t t-elif="property.auction_state == 'draft'">
                                <h3>Auction is not started yet</h3>
                            </t>

                            <t
                                t-elif="property.auction_state != 'cancelled' and property.remaining_time == 'Auction is Ended'">
                                <h3>Auction is Ended</h3>
                            </t>

                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="offer_success_template" name="Offer Success">
        <t t-call="website.layout">
            <div class="container mt-5 text-center">

                <h3 class="text-success">
                    Congratulations!
                </h3>

                <p>
                    Your offer has been successfully placed.
                    We will notify you of the results as soon as possible.
                </p>

                <a t-attf-href="/properties" class="btn btn-primary">
                    Back to Properties
                </a>

            </div>
        </t>
    </template>

    <template id="auction_error_template" name="Auction Error Page">
        <t t-call="website.layout">
            <div class="container my-5 text-center">

                <h3 class="text-danger">
                    Auction Ended
                </h3>

                <p> The auction for property <strong t-esc="property.name" /> has already ended. </p>

                <a t-attf-href="/properties" class="btn btn-primary">
                    Back to Properties
                </a>

            </div>
        </t>
    </template>

</odoo>
