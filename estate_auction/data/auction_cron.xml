<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_close_auction" model="ir.cron">
        <field name="name">close auctions automatically</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_auction(job_count=20)</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_check_signed_agreement" model="ir.cron">
        <field name="name">Check Signed Agreements</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model.search([]).action_check_signed_agreement()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_check_invoice_payment" model="ir.cron">
        <field name="name">Check Auction Invoice Payment</field>
        <field name="model_id" ref="estate.model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model.action_check_invoice_payment()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <record id="ir_cron_process_auto_bids" model="ir.cron">
        <field name="name">Process Auto Bids</field>
        <field name="model_id" ref="estate_auction.model_estate_property_auto_bid"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_auto_bids()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
