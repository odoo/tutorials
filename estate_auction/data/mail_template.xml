<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_auction_winner" model="mail.template">
            <field name="name">Auction: Winner Notification</field>
            <field name="model_id" ref="estate.model_estate_property_offer"/>

            <field name="subject">Congratulations! You won the auction for {{ object.property_id.name }}</field>

            <field name="email_from">{{ user.email or object.create_uid.email }}</field>

            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>

            <field name="description">Sent automatically to the winning bidder when an auction closes.</field>

            <field name="body_html" type="html">
                <div style="margin:0;padding:0;">
                    <p style="font-size:13px;">
                        Dear
                        <t t-out="object.partner_id.name or ''"/>,
                        <br/><br/>

                        Congratulations! Your offer for the property
                        <strong>
                            <t t-out="object.property_id.name"/>
                        </strong>
                        has been accepted.

                        <br/><br/>

                        <strong>Your Offer:</strong>
                        <t t-out="object.price"/>

                        <br/><br/>

                        Our team will contact you shortly with the next steps.

                        <br/><br/>

                        Thank you for participating.

                        <br/><br/>

                        Best regards
                    </p>
                </div>
            </field>

            <field name="auto_delete" eval="False"/>

        </record>

        <record id="mail_template_auction_rejected" model="mail.template">
            <field name="name">Auction: Rejected Notification</field>

            <field name="model_id" ref="estate.model_estate_property_offer"/>

            <field name="subject">Auction Result for {{ object.property_id.name }}</field>

            <field name="email_from">{{ user.email or object.create_uid.email }}</field>

            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>

            <field name="description">Sent automatically to bidders whose offers were not accepted.</field>

            <field name="body_html" type="html">
                <div style="margin:0;padding:0;">
                    <p style="font-size:13px;">
                        Dear
                        <t t-out="object.partner_id.name or ''"/>,
                        <br/><br/>

                        Thank you for participating in the auction for
                        <strong>
                            <t t-out="object.property_id.name"/>
                        </strong>.

                        <br/><br/>

                        Unfortunately, another bidder placed a higher offer and your offer was not selected.

                        <br/><br/>

                        We appreciate your interest and hope you participate in our future auctions.

                        <br/><br/>

                        Best regards
                    </p>
                </div>
            </field>

            <field name="auto_delete" eval="False"/>

        </record>

    </data>
</odoo>
