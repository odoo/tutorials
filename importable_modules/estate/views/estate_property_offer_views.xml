<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Offers" editable="bottom"
                decoration-success="x_status == 'accepted'"
                decoration-danger="x_status == 'refused'">
                <field name="x_price"/>
                <field name="x_partner_id"/>
                <button name="%(action_x_estate_property_accept_offer)d"
                    type="action" title="Accept" icon="check"
                    invisible="'|', (x_status == 'accepted'), (x_status == 'refused')"/>
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.offer.form</field>
        <field name="model">x_estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property Offer"> 
                <sheet>
                    <group>
                        <group>
                            <field name="x_price">Price</field>
                            <field name="x_status">Status</field>
                        </group>
                        <group>
                            <field name="x_partner_id" options="{'no_create': true}" >Partner</field>
                            <field name="x_property_id" options="{'no_create': true}" >Property</field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>