<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_borrow_view_list" model="ir.ui.view">
        <field name="name">library.borrow.list</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_id" />
                <field name="member_id" />
                <field name="borrow_date" />
                <field name="due_date" />
                <field name="return_date" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="library_borrow_view_form" model="ir.ui.view">
        <field name="name">library.borrow.form</field>
        <field name="model">library.borrow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_return" string="Return" type="object" class="btn-primary" />
                    <button name="action_waive_fine" string="Pay Fine" type="object" />
                </header>
                <sheet>
                    <div name="button_box">
                        <button name="action_open_invoice" type="object" icon="fa-book">
                            <field name="account_move_ids" widget="statinfo" string="Invoices" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="book_id" />
                            <field name="member_id" />
                            <field name="borrow_date" />
                            <field name="amount_paid" />
                        </group>
                        <group>
                            <field name="due_date" />
                            <field name="return_date" />
                            <field name="fine_amount" />
                            <field name="state" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_borrorw_action" model="ir.actions.act_window">
        <field name='name'>Borrows</field>
        <field name='res_model'>library.borrow</field>
        <field name='view_mode'>list,form</field>
    </record>
</odoo>