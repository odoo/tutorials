<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="email" widget="email"/>
                <field name="borrow_ids"/>
                <field name="active_borrow_count"/>
                <field name="is_eligible"/>
            </list>
        </field>
    </record>

    <record id="library_member_view_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group>
                            <field name="active_borrow_count"/>
                            <field name="is_eligible"/>
                            <field name="total_fine_amount"/>
                        </group>
                        <notebook>
                            <page string="Borrows">
                                <field name="borrow_ids" widget="table_widget"/>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_member_action" model="ir.actions.act_window">
        <field name='name'>Members</field>
        <field name='res_model'>library.member</field>
        <field name='view_mode'>list,form</field>
    </record>
</odoo>
