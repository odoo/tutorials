<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_deal_action" model="ir.actions.act_window">
        <field name="name">Deals</field>
        <field name="res_model">estate.property.deal</field>
        <field name="view_mode">form</field>
    </record>

    <record id="estate_property_deal_view_form" model="ir.ui.view">
        <field name="name">estate.property.deal.form</field>
        <field name="model">estate.property.deal</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_deal_pdf"
                        type="object"
                        string="Send Mail"
                        class="btn-primary"/>
                    <button name="action_request_signature"
                        type="object"
                        string="Request Signature"
                        class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="buyer_id"/>
                            <field name="salesperson_id"/>
                            <field name="selling_price"/>
                            <field name="state"/>
                            <field name="date_availability"/>
                            <field name="description"/>
                            <field name="property_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
