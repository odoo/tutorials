<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="crm_mention_log_view_list" model="ir.ui.view">
        <field name="name">crm.mention.log.view.list</field>
        <field name="model">crm.mention.log</field>
        <field name="arch" type="xml">
            <list string="Mention Logs" decoration-success="lead_created == True" decoration-muted="lead_created == False">
                <field name="fetched_on"/>
                <field name="subreddit"/>
                <field name="post_title"/>
                <field name="intent_score"/>
                <field name="lead_created"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="crm_mention_log_view_form" model="ir.ui.view">
        <field name="name">crm.mention.log.view.form</field>
        <field name="model">crm.mention.log</field>
        <field name="arch" type="xml">
            <form string="Mention Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Post Details">
                            <field name="post_title"/>
                            <field name="subreddit"/>
                            <field name="reddit_author"/>
                            <field name="post_url" widget="url"/>
                            <field name="fetched_on"/>
                        </group>
                        <group string="Scoring &amp; Outcome">
                            <field name="intent_score"/>
                            <field name="score_reason"/>
                            <field name="lead_created"/>
                            <field name="lead_id"/>
                        </group>
                    </group>
                    <group string="Post Content">
                        <field name="post_body" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_crm_mention_log" model="ir.actions.act_window">
        <field name="name">Mention Logs</field>
        <field name="res_model">crm.mention.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu under CRM -->
    <menuitem id="menu_crm_mention_log" name="Mention Logs" parent="crm.crm_menu_root" action="action_crm_mention_log" sequence="20" />
</odoo>
