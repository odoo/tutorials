<t t-name="awesome_owl.todolist">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h4 class="m-0">
                <i class="fa fa-list-check me-2"/>
Expense</h4>
            <div class="btn-group">
                <button class="btn btn-light btn-sm" t-on-click="markAll">
                    <i class="fa fa-check-double me-1"/>
 Mark All
                </button>
                <button class="btn btn-danger btn-sm" t-on-click="clearAll">
                    <i class="fa fa-eraser me-1"/>
 Clear All
                </button>
            </div>
        </div>

        <div class="card-body bg-light">
            <!-- Input Group -->
            <form t-on-submit.prevent="addTodo">
                <div class="input-group input-group-lg mb-4 shadow-sm">
                    <span class="input-group-text bg-white">
                        <i class="fa fa-plus text-muted"/>
                    </span>
                    <input type="text" class="form-control border-start-0 pl-0" placeholder="What needs to be done?" t-ref="nameInput" />
                </div>

                <div class="input-group input-group-lg mb-4 shadow-sm">
                    <span class="input-group-text bg-white">
                        <i class="fa fa-plus text-muted"/>
                    </span>
                    <input type="number" class="form-control border-start-0 pl-0" placeholder="Amount?" t-ref="amountInput" />

                    <select t-model="state.category">
                        <option>Food</option>
                        <option>More Food</option>

                        <option>Even More Food</option>
                    </select>


                </div>

                <button type="submit" class="btn btn-secondary bg-primary fw-bold text-white">
            Submit
                </button>
            </form>
            <div class="list-group shadow-sm rounded">
                <h4 class="m-0">
Food : ₹
                    <t t-esc="this.state.sumFor1stCategory"/>
                </h4>
                <h4 class="m-0">
                   More Food : ₹
                    <t t-esc="state.sumFor2stCategory"/>
                </h4>
                <h4 class="m-0">
                  Even More Food : ₹
                    <t t-esc="state.sumFor3stCategory"/>
                </h4>

                <h4 class="m-0">
                 Total Expense : ₹
                    <t t-esc="state.TotalExpense"/>
                </h4>


            </div>
            <!-- List Group -->
            <div class="list-group shadow-sm rounded">
                <t t-if="state.todos.length == 0">
                    <div class="list-group-item text-center text-muted p-4">
                            No tasks yet. Add a task above!
                    </div>
                </t>
                <t t-foreach="state.todos" t-as="todo" t-key="todo.id">
                    <TodoItem todo="todo" toggleState.bind="toggleState" handleDelete.bind="handleDelete"/>
                </t>


            </div>

            <select t-on-click="filterExpenses">
                <option>Food</option>
                <option>More Food</option>

                <option>Even More Food</option>
            </select>

            <t t-foreach="state.filteredExpenses" t-as="todo" t-key="todo.id">
                <TodoItem todo="todo" />
            </t>
        </div>
    </div>
</t>
