<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="awesome_gallery.GalleryRenderer">
        <t t-foreach="props.model.records" t-as="record" t-key="record.id">
            <div class="card m-2" style="width:100px;height:100px;">
                <img t-att-src="getImageUrl(record.id)" t-on-click="() => this.openFormView(record.id)" t-att-data-tooltip="record[props.model.tooltipField]"/>
            </div>
        </t>
    </t>

</templates>
