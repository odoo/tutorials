<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_gallery.GalleryRenderer">

        
        <div class="row">
            <t t-foreach="this.props.model.records" t-as="image" t-key="image.id">
                <div class="col-lg-2 col-md-3 col-sm-4 px-2 col-6 d-flex">
                    <GalleryImage record="image" model="props.model" onImageUpload="props.onImageUpload" tooltipTemplate="this.owlTooltipTemplate"/>
                </div>
            </t>
        </div>

    </t>

</templates>
