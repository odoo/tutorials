<?xml version="1.0"?>
<odoo>
    <record id="estate_property_type_action" model="ir.actions.act_window">
        <field name="name">Property Types</field>
        <field name="res_model">x_estate.property.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_type_view_list" model="ir.ui.view">
        <field name="name">x_estate.property.type.view.list</field>
        <field name="model">x_estate.property.type</field>
        <field name="arch" type="xml">
            <list string="Property Types">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <record id="estate_property_type_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.type.view.form</field>
        <field name="model">x_estate.property.type</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <h1>
                        <field name="x_name"/>
                    </h1>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
