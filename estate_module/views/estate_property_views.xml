<?xml version="1.0"?>
<odoo>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">x_estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_x_user_id': uid}</field>
    </record>

    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">x_estate.property.view.list</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="x_name"/>
                <field name="x_postcode"/>
                <field name="x_bedrooms"/>
                <field name="x_living_area"/>
                <field name="x_expected_price"/>
                <field name="x_selling_price"/>
                <field name="x_date_availability" optional="hide"/>
                <field name="x_property_type_id"/>
                <field name="x_property_tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">x_estate.property.view.form</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <label for="x_name"/>
                    <h1>
                        <field name="x_name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="x_property_tag_ids" widget="many2many_tags"/>
                            <field name="x_property_type_id"/>
                            <field name="x_postcode"/>
                            <field name="x_date_availability"/>
                        </group>
                        <group>
                            <field name="x_expected_price"/>
                            <field name="x_selling_price"/>
                            <field name="x_api_published"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="x_description"/>
                                <field name="x_bedrooms"/>
                                <field name="x_living_area"/>
                                <field name="x_facades"/>
                                <field name="x_garage"/>
                                <field name="x_garden"/>
                                <field name="x_garden_area" invisible="not x_garden"/>
                                <field name="x_garden_orientation" invisible="not x_garden"/>
                                <field name="x_total_area"/>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="x_offer_ids"/>
                        </page>
                        <page string="Other Infos">
                            <group>
                                <field name="x_partner_id"/>
                                <field name="x_user_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">x_estate.property.view.search</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="x_name"/>
                <field name="x_postcode"/>
                <field name="x_expected_price"/>
                <field name="x_bedrooms"/>
                <field name="x_living_area" filter_domain="[('x_living_area', '>=', self)]"/>
                <field name="x_facades"/>
                <field name="x_property_type_id"/>
                <separator/>
                <filter name="postcode" string="Postcode" context="{'group_by': 'x_postcode'}"/>
            </search>
        </field>
    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">x_estate.property.view.kanban</field>
        <field name="model">x_estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_property_type_id">
                <templates>
                    <t t-name="card">
                        <field name="x_name" class="fw-bold fs-5"/>
                        <div>Expected Price: <field name="x_expected_price"/></div>
                        <div t-if="record.x_selling_price.raw_value">Selling Price: <field name="x_selling_price"/></div>
                        <field name="x_property_tag_ids" widget="many2many_tags"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
