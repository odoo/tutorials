<?xml version="1.0" encoding="UTF-8"?>
<template xml:space="preserve">
    <t t-name="vanilla_js.Calculator">
        <div class="d-flex gap-3">
            <input id="f-input" class="form-control bg-white" placeholder="enter your first number"/>
            <input id="o-input" class="form-control bg-white" placeholder="enter your operator (+,-,*,/)"/>
            <input id="s-input" class="form-control bg-white" placeholder="enter your second number"/>
            <button class="btn bg-primary text-white" t-on-click="calculate">Calculate</button>
            <div class="card text-bg-dark bg-opacity-75 rounded-2 p-2 d-flex flex-row gap-2" style="width: 100rem">
                <span class="text-secondary text-opacity-50">Output: </span>
                <span class="me-2"><t t-esc="this.output.value"/>
                </span>
            </div>
        </div>
    </t>
</template>
