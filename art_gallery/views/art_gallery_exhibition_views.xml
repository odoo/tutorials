<?xml version="1.0"?>
<odoo>
    <record id="art_gallery_exhibition_action" model="ir.actions.act_window">
        <field name="name">Exhibitions</field>
        <field name="res_model">art.gallery.exhibition</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="art_gallery_exhibition_view_kanban" model="ir.ui.view">
        <field name="name">art.gallery.exhibition.view.kanban</field>
        <field name="model">art.gallery.exhibition</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_finished"/>
                <templates>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Finished" bg_color="text-bg-danger" invisible="not is_finished"/>
                        <field name="name" class="fw-bold fs-5"/>
                        <div>
                            <field name="start_date"/> - <field name="end_date"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="art_gallery_exhibition_view_list" model="ir.ui.view">
        <field name="name">art.gallery.exhibition.view.list</field>
        <field name="model">art.gallery.exhibition</field>
        <field name="arch" type="xml">
            <list string="Exhibitions" decoration-muted="is_finished">
                <field name="is_finished" column_invisible="True"/>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="art_gallery_exhibition_view_form" model="ir.ui.view">
        <field name="name">art.gallery.exhibition.view.form</field>
        <field name="model">art.gallery.exhibition</field>
        <field name="arch" type="xml">
            <form string="Exhibition">
                <sheet>
                    <field name="is_finished" invisible="1"/>
                    <widget name="web_ribbon" title="Finished" bg_color="text-bg-danger" invisible="not is_finished"/>
                    <h1>
                        <field name="name" placeholder="Exhibition name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Artworks" name="artworks">
                            <field name="artwork_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="artist_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="art_gallery_exhibition_view_search" model="ir.ui.view">
        <field name="name">art.gallery.exhibition.view.search</field>
        <field name="model">art.gallery.exhibition</field>
        <field name="arch" type="xml">
            <search string="Exhibitions">
                <field name="name"/>
                <field name="artwork_ids"/>
            </search>
        </field>
    </record>
</odoo>
