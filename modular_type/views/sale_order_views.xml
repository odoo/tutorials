<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_order_form_view_inherit_modular_value" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.modular.value</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="after">
                <button
                    name="action_open_modular_value_wizard"
                    type="object"
                    icon="fa-flask"
                    title="Set Modular Values"
                    invisible="not product_id"
                />
            </xpath>

        </field>
    </record>

</odoo>
