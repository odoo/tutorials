<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_line_modular_value_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.line.modular.value.wizard.form</field>
        <field name="model">sale.line.modular.value.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Modular Values">
                <sheet>
                    <group>
                        <field name="sale_line_id" readonly="1"/>
                    </group>

                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="modular_type_id" readonly="1" force_save="1"/>
                            <field name="value"/>
                        </list>
                    </field>
                </sheet>

                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
