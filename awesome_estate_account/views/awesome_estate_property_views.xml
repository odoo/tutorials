<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- Inject invoice stat button into the property form view -->
    <record id="awesome_estate_account_property_view_form_inherit" model="ir.ui.view">
        <field name="name">awesome.estate.property.form.account.inherit</field>
        <field name="model">awesome.estate.property</field>
        <field name="inherit_id" ref="awesome_estate.awesome_estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" context="{'invoice_count': invoice_count}">
                    <field name="invoice_count" string="Invoice" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
