<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_kiosk_assignees" model="ir.ui.view">
        <field name="name">project.task.form.kiosk.assignees</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids'][@class='o_task_user_field']" position="attributes">
                <attribute name="domain">[('active', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
