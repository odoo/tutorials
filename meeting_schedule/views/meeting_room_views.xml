<odoo>
    <record id="meeting_room_action" model="ir.actions.act_window">
        <field name="name">Meeting Rooms</field>
        <field name="res_model">meeting.room</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="meeting_room_view_tree" model="ir.ui.view">
        <field name="name">meeting.room.tree</field>
        <field name="model">meeting.room</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="seating_capacity"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="building_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="meeting_room_view_form" model="ir.ui.view">
        <field name="name">meeting.room.form</field>
        <field name="model">meeting.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <field name="code"/>
                        <field name="seating_capacity"/>
                        <field name="company_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="building_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Reservations">
                            <field name="reservation_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
