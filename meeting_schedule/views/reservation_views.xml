<odoo>
    <record id="meeting_reservation_action" model="ir.actions.act_window" context="{'active_test': False}">
        <field name="name">Meeting Reservations</field>
        <field name="res_model">meeting.reservation</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

                    <!-- Kanban -->
    <record id="meeting_reservation_view_kanban" model="ir.ui.view">
        <field name="name">meeting.reservation.kanban</field>
        <field name="model">meeting.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="room_id" records_draggable="0" sample="1" group_create="false">
                <field name="name"/>
                <field name="building_id"/>
                <field name="room_id"/>
                <field name="organizer_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div>
                                <strong><field name="name"/></strong>
                                <span><field name="state"/></span>
                            </div>
                            <div>
                                <i class="fa fa-building-o mr-1" title="Building"/>
                                <field name="building_id"/>
                                <field name="room_id"/>
                            </div>
                            <div>
                                <label for="capacity">Max Seating:</label>
                                <field name="capacity"/>
                            </div>
                            <div>
                                <i class="fa fa-clock-o mr-1 text-primary" title="Time"/>
                                <field name="start_time" widget="datetime"/>
                                <span> - </span>
                                <field name="end_time" widget="datetime"/>
                            </div>
                            <div>
                                <field name="organizer_id"/>
                            </div>
                            <div>
                                <button t-if="record.state.raw_value != 'canceled'"
                                        name="action_cancel" type="object"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Cancel Meeting">
                                    Cancel
                                </button>
                                <button t-if="record.state.raw_value != 'confirmed'"
                                        name="action_confirm" type="object"
                                        class="btn btn-sm btn-outline-success"
                                        title="Confirm Meeting">
                                    Confirm
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
                    <!-- Tree -->
    <record id="meeting_reservation_view_tree" model="ir.ui.view">
        <field name="name">meeting.reservation.tree</field>
        <field name="model">meeting.reservation</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'canceled'"
                decoration-success="state == 'confirmed'"
                decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="building_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration" widget="float_time"/>
                <field name="organizer_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
                    <!-- Form -->
    <record id="meeting_reservation_view_form" model="ir.ui.view">
        <field name="name">meeting.reservation.form</field>
        <field name="model">meeting.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Meeting"
                        class="btn-success" attrs="{'invisible': [('state','!=','draft')]}"
                        groups="hr.group_hr_manager"/>
                    <button name="action_cancel" type="object" string="Cancel Meeting"
                        class="btn-danger"
                        attrs="{'invisible': [('state', '=', 'canceled')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Meeting Subject"/>
                        <h1><field name="name" placeholder="e.g. Sprint Planning"/></h1>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="room_id"/>
                            <field name="building_id"/>
                            <field name="organizer_id"/>
                        </group>
                        <group string="Schedule (UTC)">
                            <field name="meeting_date"/>
                            <field name="start_time" options="{'datepicker': {'viewMode': 'times'}}"/>
                            <field name="end_time" options="{'datepicker': {'viewMode': 'times'}}"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda / Notes">
                            <field name="description"
                                placeholder="Add meeting notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
                <!-- Search -->
    <record id="meeting_reservation_view_search" model="ir.ui.view">
        <field name="name">meeting.reservation.search</field>
        <field name="model">meeting.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_id"/>
                <field name="building_id"/>
                <field name="organizer_id"/>
                <filter name="my_meetings" string="My Meetings"
                    domain="[('organizer_id', '=', uid)]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="canceled" string="Canceled" domain="[('state', '=', 'canceled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_building" string="Building" context="{'group_by': 'building_id'}"/>
                    <filter name="group_organizer" string="Organizer" context="{'group_by': 'organizer_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
